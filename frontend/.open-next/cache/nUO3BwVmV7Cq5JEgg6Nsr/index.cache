d\" stroke-linejoin=\"round\"><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"></line><polyline points=\"12 5 19 12 12 19\"></polyline></svg></span></div></a><a class=\"group bg-white border border-brand-navy/8 rounded-2xl p-6 flex flex-col justify-between shadow-sm hover:shadow-lg hover:-translate-y-1 hover:border-brand-navy/20 transition-all duration-200\" href=\"/tools/parafrase\"><div><div class=\"flex items-start justify-between mb-5\"><div class=\"w-11 h-11 rounded-xl bg-brand-sky/15 text-brand-sky flex items-center justify-center\"><svg class=\"w-6 h-6\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"4 7 4 4 20 4 20 7\"></polyline><line x1=\"9\" y1=\"20\" x2=\"15\" y2=\"20\"></line><line x1=\"12\" y1=\"4\" x2=\"12\" y2=\"20\"></line></svg></div><span class=\"px-2 py-0.5 rounded-full text-[10px] font-bold bg-brand-navy/8 text-brand-navy/60\">Lolos Turnitin</span></div><p class=\"text-brand-navy/40 text-[10px] font-bold uppercase tracking-widest mb-1.5\">Bahasa &amp; Makalah</p><h3 class=\"font-heading text-base font-bold text-brand-navy mb-2 group-hover:text-brand-sky transition-colors\">Parafrase Teks &amp; Makalah</h3><p class=\"text-brand-navy/50 text-xs leading-relaxed line-clamp-3\">Ubah kalimat tugas agar natural, santun, dan lolos uji orisinalitas tanpa mengubah inti materi.</p></div><div class=\"mt-5 pt-4 border-t border-brand-navy/6 flex items-center justify-between\"><span class=\"text-brand-navy/30 text-[10px] font-medium\">14.2k digunakan</span><svg class=\"w-4 h-4 text-brand-navy/30 group-hover:text-brand-navy group-hover:translate-x-1 transition-all\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"9 18 15 12 9 6\"></polyline></svg></div></a><a class=\"group bg-white border border-brand-navy/8 rounded-2xl p-6 flex flex-col justify-between shadow-sm hover:shadow-lg hover:-translate-y-1 hover:border-brand-navy/20 transition-all duration-200\" href=\"/tools/rangkuman\"><div><div class=\"flex items-start justify-between mb-5\"><div class=\"w-11 h-11 rounded-xl bg-brand-coral/15 text-brand-coral flex items-center justify-center\"><svg class=\"w-6 h-6\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"></path><polyline points=\"14 2 14 8 20 8\"></polyline><line x1=\"16\" y1=\"13\" x2=\"8\" y2=\"13\"></line><line x1=\"16\" y1=\"17\" x2=\"8\" y2=\"17\"></line></svg></div><span class=\"px-2 py-0.5 rounded-full text-[10px] font-bold bg-brand-navy/8 text-brand-navy/60\">Instant Bullets</span></div><p class=\"text-brand-navy/40 text-[10px] font-bold uppercase tracking-widest mb-1.5\">Belajar Cepat</p><h3 class=\"font-heading text-base font-bold text-brand-navy mb-2 group-hover:text-brand-sky transition-colors\">Rangkuman Materi &amp; Bab</h3><p class=\"text-brand-navy/50 text-xs leading-relaxed line-clamp-3\">Ringkas bab buku cetak tebal, PDF materi guru, atau artikel panjang menjadi poin hafalan dalam hitungan detik.</p></div><div class=\"mt-5 pt-4 border-t border-brand-navy/6 flex items-center justify-between\"><span class=\"text-brand-navy/30 text-[10px] font-medium\">12.8k digunakan</span><svg class=\"w-4 h-4 text-brand-navy/30 group-hover:text-brand-navy group-hover:translate-x-1 transition-all\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"9 18 15 12 9 6\"></polyline></svg></div></a><a class=\"group bg-white border border-brand-navy/8 rounded-2xl p-6 flex flex-col justify-between shadow-sm hover:shadow-lg hover:-translate-y-1 hover:border-brand-navy/20 transition-all duration-200\" href=\"/tools/math-solver\"><div><div class=\"flex items-start justify-between mb-5\"><div class=\"w-11 h-11 rounded-xl bg-brand-gold/15 text-brand-gold flex items-center justify-center\"><svg class=\"w-6 h-6\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"19\" y1=\"5\" x2=\"5\" y2=\"19\"></line><circle cx=\"6.5\" cy=\"6.5\" r=\"2.5\"></circle><circle cx=\"17.5\" cy=\"17.5\" r=\"2.5\"></circle></svg></div><span class=\"px-2 py-0.5 rounded-full text-[10px] font-bold bg-brand-navy/8 text-brand-navy/60\">LaTeX Ready</span></div><p class=\"text-brand-navy/40 text-[10px] font-bold uppercase tracking-widest mb-1.5\">Eksakta</p><h3 class=\"font-heading text-base font-bold text-brand-navy mb-2 group-hover:text-brand-sky transition-colors\">Solver Rumus Matematika &amp; IPA</h3><p class=\"text-brand-navy/50 text-xs leading-relaxed line-clamp-3\">Ketik atau tempel soal hitungan fisika, kimia, matematika. Dapatkan langkah penjabaran rumus tahap demi tahap.</p></div><div class=\"mt-5 pt-4 border-t border-brand-navy/6 flex items-center justify-between\"><span class=\"text-brand-navy/30 text-[10px] font-medium\">11.5k digunakan</span><svg class=\"w-4 h-4 text-brand-navy/30 group-hover:text-brand-navy group-hover:translate-x-1 transition-all\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"9 18 15 12 9 6\"></polyline></svg></div></a></div></div></section><section class=\"py-16 bg-slate-50\"><div class=\"container\"><div class=\"flex justify-between items-end mb-8\"><div><h2 class=\"text-3xl font-heading font-bold text-slate-900 mb-2\">Artikel Terbaru</h2><p class=\"text-slate-600\">Panduan materi dan tips belajar untukmu.</p></div><a class=\"hidden md:block text-sky-600 font-medium hover:text-sky-700\" href=\"/blog\">Lihat Semua Artikel →</a></div><div class=\"grid grid-cols-1 md:grid-cols-3 gap-6\"><a class=\"bg-white border rounded-xl p-6 hover:shadow-md transition-shado