b?\\\",\\\"answer\\\":[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Tidak wajib.\\\"}],\\\" AI kami cukup pintar untuk membaca teks Arab \\\\\\\"gundul\\\\\\\" (tanpa harakat) dan menerjemahkannya berdasarkan konteks kalimat secara keseluruhan, persis seperti metode membaca Kitab Kuning.\\\"]}]},{\\\"question\\\":\\\"Apakah hasil terjemahan (Indo ke Arab) sudah ada harakatnya?\\\",\\\"answer\\\":[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":[\\\"Ya. Saat kamu memilih mode terjemahan dari Bahasa Indonesia ke Bahasa Arab, hasil \\\",[\\\"$\\\",\\\"em\\\",null,{\\\"children\\\":\\\"output\\\"}],\\\"-nya akan dilengkapi dengan harakat penuh (\\\",[\\\"$\\\",\\\"em\\\",null,{\\\"children\\\":\\\"Tasykil\\\"}],\\\") sehingga kamu tidak akan kesulitan saat harus membacanya di depan kelas.\\\"]}]},{\\\"question\\\":\\\"Bisa digunakan untuk menerjemahkan ayat Al-Quran atau Hadits?\\\",\\\"answer\\\":[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"Bisa. Namun disarankan menggunakannya untuk potongan ayat pendek atau kalimat latihan di buku cetak. Untuk tafsir mendalam tentang suatu ayat, akan lebih baik merujuk langsung ke kitab tafsir yang mu'tabar (terpercaya).\\\"}]},{\\\"question\\\":\\\"Kenapa saya harus memilih jenjang MTs atau MA?\\\",\\\"answer\\\":[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"Level penjelasan gramatikal akan disesuaikan. Anak MTs akan mendapatkan penjelasan Nahwu dasar, sedangkan anak MA mungkin akan mendapat penjelasan struktur yang sedikit lebih kompleks atau idiomatik.\\\"}]}]}]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-12 mb-8\\\",\\\"children\\\":[[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"text-xl font-bold text-slate-900 mb-4\\\",\\\"children\\\":\\\"Coba Tools Bermanfaat Lainnya\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"$Lf\\\",null,{\\\"href\\\":\\\"/tools/rangkuman\\