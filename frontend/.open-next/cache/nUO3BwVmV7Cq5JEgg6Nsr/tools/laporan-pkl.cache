{"type":"app","meta":{"headers":{"x-next-cache-tags":"_N_T_/layout,_N_T_/tools/layout,_N_T_/tools/laporan-pkl/layout,_N_T_/tools/laporan-pkl/page,_N_T_/tools/laporan-pkl"}},"html":"<!DOCTYPE html><html lang=\"id\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/css/c70a6d8e0709b465.css\" data-precedence=\"next\"/><link rel=\"stylesheet\" href=\"/_next/static/css/7eb325243a3b1d61.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-37f8c22e297b04f8.js\"/><script src=\"/_next/static/chunks/fd9d1056-2718004965b0207a.js\" async=\"\"></script><script src=\"/_next/static/chunks/2117-c5687b942395652d.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-f30bb01764683cd9.js\" async=\"\"></script><script src=\"/_next/static/chunks/3433-9ddc6f7f78d9421c.js\" async=\"\"></script><script src=\"/_next/static/chunks/2972-8ce94bd856f9372b.js\" async=\"\"></script><script src=\"/_next/static/chunks/4194-e847e413fe1b63d3.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/tools/laporan-pkl/page-2331a42a5f582a2b.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-c819fc26cf8b0e32.js\" async=\"\"></script><link rel=\"preload\" href=\"https://www.googletagmanager.com/gtag/js?id=G-8K10RNGN76\" as=\"script\"/><link rel=\"preload\" href=\"https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXXXXXXXX\" as=\"script\" crossorigin=\"\"/><title>Generator Struktur Laporan PKL &amp; Prakerin SMK - Otomatis Sesuai Jurusan | TugasMu</title><meta name=\"description\" content=\"Buat struktur dan draft laporan PKL (Praktik Kerja Lapangan) atau magang SMK dalam hitungan detik. Lengkap dari Latar Belakang sampai Kesimpulan sesuai jurusanmu.\"/><meta property=\"og:title\" content=\"TugasMu | AI yang ngerti pelajaran kamu\"/><meta property=\"og:description\" content=\"Platform AI Gratis untuk Bantu Belajar Siswa Indonesia\"/><meta property=\"og:url\" content=\"https://tugasmu.com\"/><meta property=\"og:site_name\" content=\"TugasMu\"/><meta property=\"og:locale\" content=\"id_ID\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary\"/><meta name=\"twitter:title\" content=\"TugasMu | AI yang ngerti pelajaran kamu\"/><meta name=\"twitter:description\" content=\"Platform AI Gratis untuk Bantu Belajar Siswa Indonesia\"/><link rel=\"icon\" href=\"/favicon.ico\" type=\"image/x-icon\" sizes=\"16x16\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"font-sans bg-brand-cream text-brand-navy flex flex-col min-h-screen __variable_0d7163 __variable_5667dc\"><header class=\"sticky top-0 z-50 w-full\"><div class=\"bg-brand-cream/95 backdrop-blur-md border-b border-brand-navy/10\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between\"><a class=\"flex items-center gap-2.5 group\" href=\"/\"><div class=\"w-8 h-8 rounded-lg bg-brand-navy flex items-center justify-center shadow-sm group-hover:bg-brand-lime transition-colors duration-300\"><svg class=\"w-4 h-4 fill-brand-cream group-hover:fill-brand-navy transition-colors duration-300\" viewBox=\"0 0 24 24\"><polygon points=\"13 2 3 14 12 14 11 22 21 10 12 10 13 2\"></polygon></svg></div><span class=\"font-heading font-bold text-xl text-brand-navy tracking-tight group-hover:text-brand-navy/70 transition-colors\">TugasMu</span></a><nav class=\"hidden md:flex items-center gap-1\"><a class=\"relative px-4 py-2 text-sm font-semibold rounded-full transition-all duration-200 text-brand-navy bg-brand-lime\" href=\"/tools\">AI Tools</a><a class=\"relative px-4 py-2 text-sm font-semibold rounded-full transition-all duration-200 text-brand-navy/70 hover:text-brand-navy hover:bg-brand-navy/5\" href=\"/harga\">Premium</a><a class=\"relative px-4 py-2 text-sm font-semibold rounded-full transition-all duration-200 text-brand-navy/70 hover:text-brand-navy hover:bg-brand-navy/5\" href=\"/blog\">Blog</a></nav><div class=\"hidden md:flex items-center gap-3\"><a class=\"px-5 py-2.5 rounded-full bg-brand-navy hover:bg-brand-navy/90 text-brand-cream font-bold text-sm transition-all shadow-sm hover:shadow-md active:scale-95 flex items-center gap-2\" href=\"/masuk\">Masuk / Daftar</a></div><div class=\"flex md:hidden items-center gap-3\"><button class=\"p-2 rounded-full text-brand-navy hover:bg-brand-navy/5 transition-colors\" aria-label=\"Toggle Menu\"><svg class=\"w-5 h-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\"><line x1=\"3\" y1=\"8\" x2=\"21\" y2=\"8\"></line><line x1=\"3\" y1=\"16\" x2=\"21\" y2=\"16\"></line></svg></button></div></div></div></header><div class=\"bg-slate-50 border-b\"><div class=\"container py-3\"><nav class=\"flex text-sm text-slate-500\" aria-label=\"Breadcrumb\"><ol class=\"inline-flex items-center space-x-1 md:space-x-3\"><li class=\"inline-flex items-center\"><a class=\"hover:text-slate-900 transition-colors\" href=\"/\">Home</a></li><li><div class=\"flex items-center\"><span class=\"mx-2 text-slate-400\">/</span><a class=\"hover:text-slate-900 transition-colors\" href=\"/tools\">Tools</a></div></li><li><div class=\"flex items-center\"><span class=\"mx-2 text-slate-400\">/</span><span class=\"text-slate-900 font-medium\" aria-current=\"page\">Laporan pkl</span></div></li></ol></nav></div></div><main class=\"flex-1\"><div class=\"container py-8 md:py-12 max-w-5xl\"><div class=\"mb-8 max-w-3xl\"><h1 class=\"text-3xl md:text-4xl font-heading font-bold text-slate-900 mb-4\">Generator Laporan PKL SMK (Otomatis)</h1><p class=\"text-slate-600 text-lg\">Baru selesai magang dan bingung cara nulis laporan? Masukkan jurusan dan tempat PKL-mu, AI akan membuatkan draft struktur laporan resmi bab per bab yang siap kamu lengkapi.</p></div><form class=\"space-y-6\"><div class=\"space-y-space-md mb-6\"><div class=\"space-y-space-xs\"><label class=\"block font-label-md text-label-md text-on-surface\">Jenjang Pendidikan</label><div class=\"grid grid-cols-4 gap-1.5 bg-surface-container-low p-1 rounded-xl\"><button type=\"button\" class=\"py-1.5 rounded-lg text-center font-label-sm text-label-sm transition-colors text-on-surface-variant hover:text-on-surface\">SD</button><button type=\"button\" class=\"py-1.5 rounded-lg text-center font-label-sm text-label-sm transition-colors text-on-surface-variant hover:text-on-surface\">SMP</button><button type=\"button\" class=\"py-1.5 rounded-lg text-center font-label-sm text-label-sm transition-colors text-on-surface-variant hover:text-on-surface\">SMA</button><button type=\"button\" class=\"py-1.5 rounded-lg text-center font-label-sm text-label-sm transition-colors bg-primary-container text-on-primary font-bold shadow-sm\">SMK</button><button type=\"button\" class=\"py-1.5 rounded-lg text-center font-label-sm text-label-sm transition-colors text-on-surface-variant hover:text-on-surface\">MADRASAH</button></div></div><div class=\"grid grid-cols-1 md:grid-cols-2 gap-space-md\"><div class=\"space-y-space-xs\"><label class=\"block font-label-md text-label-md text-on-surface\">Kelas</label><div class=\"relative\"><select class=\"w-full h-11 px-3.5 pr-10 rounded-xl bg-surface-container-low text-on-surface font-body-md text-body-md focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary-container outline-none transition-all appearance-none disabled:opacity-50\" required=\"\"><option value=\"\" disabled=\"\">Pilih Kelas</option><option value=\"10\">Kelas <!-- -->10</option><option value=\"11\" selected=\"\">Kelas <!-- -->11</option><option value=\"12\">Kelas <!-- -->12</option></select><span class=\"material-symbols-outlined pointer-events-none absolute right-3 top-2.5 text-on-surface-variant text-[20px]\">expand_more</span></div></div><div class=\"space-y-space-xs\"><label class=\"block font-label-md text-label-md text-on-surface\">Mata Pelajaran</label><div class=\"relative\"><select class=\"w-full h-11 px-3.5 pr-10 rounded-xl bg-surface-container-low text-on-surface font-body-md text-body-md focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary-container outline-none transition-all appearance-none disabled:opacity-50\" required=\"\"><option value=\"\" disabled=\"\" selected=\"\">Pilih Mapel</option><option value=\"Bahasa Indonesia\">Bahasa Indonesia</option><option value=\"Matematika\">Matematika</option><option value=\"Bahasa Inggris\">Bahasa Inggris</option><option value=\"Agama\">Agama</option><option value=\"PPKn\">PPKn</option><option value=\"Sejarah Indonesia\">Sejarah Indonesia</option><option value=\"PJOK\">PJOK</option><option value=\"Kejuruan\">Kejuruan</option></select><span class=\"material-symbols-outlined pointer-events-none absolute right-3 top-2.5 text-on-surface-variant text-[20px]\">expand_more</span></div></div></div><div class=\"space-y-space-xs\"><label class=\"block font-label-md text-label-md text-on-surface\">Kurikulum</label><div class=\"flex gap-2\"><label class=\"flex items-center gap-2 p-2 px-3 rounded-xl bg-surface-container-low cursor-pointer hover:bg-surface-container transition-colors flex-1\"><input type=\"radio\" class=\"w-4 h-4 accent-primary-container cursor-pointer\" name=\"kurikulum\" checked=\"\" value=\"merdeka\"/><span class=\"font-label-sm text-label-sm text-on-surface\">Merdeka</span></label><label class=\"flex items-center gap-2 p-2 px-3 rounded-xl bg-surface-container-low cursor-pointer hover:bg-surface-container transition-colors flex-1\"><input type=\"radio\" class=\"w-4 h-4 accent-primary-container cursor-pointer\" name=\"kurikulum\" value=\"k13\"/><span class=\"font-label-sm text-label-sm text-on-surface\">2013 (K13)</span></label></div></div></div><div class=\"space-y-4\"><div class=\"space-y-2\"><label class=\"block font-label-md text-label-md text-on-surface\">Nama Lengkap</label><input type=\"text\" placeholder=\"Contoh: Budi Santoso\" class=\"w-full px-3.5 py-3 rounded-xl bg-surface-container-low text-on-surface font-body-md text-body-md focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary-container outline-none transition-all disabled:opacity-50\" value=\"\"/></div><div class=\"grid grid-cols-1 md:grid-cols-2 gap-4\"><div class=\"space-y-2\"><label class=\"block font-label-md text-label-md text-on-surface\">Tempat PKL (Nama Perusahaan)</label><input type=\"text\" placeholder=\"Contoh: PT Telkom Indonesia\" class=\"w-full px-3.5 py-3 rounded-xl bg-surface-container-low text-on-surface font-body-md text-body-md focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary-container outline-none transition-all disabled:opacity-50\" value=\"\"/></div><div class=\"space-y-2\"><label class=\"block font-label-md text-label-md text-on-surface\">Lama Magang</label><select class=\"w-full px-3.5 py-3 rounded-xl bg-surface-container-low text-on-surface font-body-md text-body-md focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary-container outline-none transition-all disabled:opacity-50 appearance-none\"><option value=\"1 Bulan\">1 Bulan</option><option value=\"2 Bulan\">2 Bulan</option><option value=\"3 Bulan\" selected=\"\">3 Bulan</option><option value=\"6 Bulan\">6 Bulan</option></select></div></div><div class=\"space-y-2\"><label class=\"block font-label-md text-label-md text-on-surface\">Divisi/Bagian (Opsional)</label><input type=\"text\" placeholder=\"Contoh: IT Support\" class=\"w-full px-3.5 py-3 rounded-xl bg-surface-container-low text-on-surface font-body-md text-body-md focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary-container outline-none transition-all disabled:opacity-50\" value=\"\"/></div></div><button type=\"submit\" class=\"w-full h-12 rounded-xl bg-primary-container hover:bg-primary text-on-primary font-label-lg text-label-lg transition-all shadow-sm disabled:opacity-60 disabled:cursor-not-allowed flex items-center justify-center gap-2\"><span class=\"material-symbols-outlined text-[20px]\">file_copy</span><span>Buat Struktur Laporan</span></button></form><div class=\"mt-16 bg-white rounded-3xl p-8 border border-slate-200 shadow-sm\"><div class=\"prose prose-slate max-w-none prose-headings:font-heading prose-a:text-sky-600\"><h2 class=\"text-2xl font-bold text-slate-900 mb-4 flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-file-text w-6 h-6 text-sky-500\" aria-hidden=\"true\"><path d=\"M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z\"></path><path d=\"M14 2v5a1 1 0 0 0 1 1h5\"></path><path d=\"M10 9H8\"></path><path d=\"M16 13H8\"></path><path d=\"M16 17H8\"></path></svg>Cara Membuat Laporan PKL SMK yang Baik dan Benar</h2><p>Membuat <strong>Laporan Praktik Kerja Lapangan (PKL)</strong> atau Prakerin seringkali menjadi tugas yang membingungkan bagi siswa SMK kelas 11 atau 12 yang baru menyelesaikan masa magangnya. Laporan ini merupakan syarat wajib untuk kenaikan kelas maupun kelulusan, karena membuktikan bahwa kamu telah benar-benar terjun ke dunia industri (DU/DI).</p><h3>Mengapa Struktur Laporan PKL Sangat Penting?</h3><p>Banyak siswa SMK ditolak laporannya oleh pembimbing karena format penulisan yang berantakan atau isi yang tidak relevan dengan jurusannya. Misalnya, siswa jurusan Teknik Komputer Jaringan (TKJ) namun isi kegiatannya lebih banyak membantu administrasi tata usaha.</p><p>Laporan yang baik harus memiliki struktur yang runut:</p><ul class=\"space-y-2 mb-6\"><li class=\"flex items-start gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check-big lucide-check-circle w-5 h-5 text-emerald-500 shrink-0 mt-0.5\" aria-hidden=\"true\"><path d=\"M21.801 10A10 10 0 1 1 17 3.335\"></path><path d=\"m9 11 3 3L22 4\"></path></svg><span><strong>BAB I Pendahuluan:</strong> Latar belakang mengapa PKL diadakan, serta apa tujuan dan manfaat spesifik bagi sekolah maupun industri.</span></li><li class=\"flex items-start gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check-big lucide-check-circle w-5 h-5 text-emerald-500 shrink-0 mt-0.5\" aria-hidden=\"true\"><path d=\"M21.801 10A10 10 0 1 1 17 3.335\"></path><path d=\"m9 11 3 3L22 4\"></path></svg><span><strong>BAB II Gambaran Umum:</strong> Sejarah dan profil perusahaan tempat kamu magang. Ini bisa didapatkan dari profil instansi.</span></li><li class=\"flex items-start gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check-big lucide-check-circle w-5 h-5 text-emerald-500 shrink-0 mt-0.5\" aria-hidden=\"true\"><path d=\"M21.801 10A10 10 0 1 1 17 3.335\"></path><path d=\"m9 11 3 3L22 4\"></path></svg><span><strong>BAB III Pelaksanaan PKL:</strong> Ini adalah inti dari laporanmu. Berisi uraian kegiatan harian, kendala teknis yang dihadapi, dan cara penyelesaiannya sesuai kompetensi keahlianmu.</span></li><li class=\"flex items-start gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check-big lucide-check-circle w-5 h-5 text-emerald-500 shrink-0 mt-0.5\" aria-hidden=\"true\"><path d=\"M21.801 10A10 10 0 1 1 17 3.335\"></path><path d=\"m9 11 3 3L22 4\"></path></svg><span><strong>BAB IV Penutup:</strong> Kesimpulan dari pengalaman magang dan saran perbaikan untuk adik kelas maupun pihak industri.</span></li></ul><h3>Tips Lulus Sidang Laporan PKL</h3><p>Setelah laporan tercetak, kamu biasanya akan menghadapi presentasi atau sidang di depan guru pembimbing. Pastikan kamu benar-benar menguasai BAB III, karena pertanyaan penguji akan fokus pada apa yang <em>benar-benar</em> kamu kerjakan selama di industri, bukan sekadar teori.</p></div></div><div class=\"mt-12\"><section class=\"mt-space-xl pt-space-lg flex flex-col gap-space-md\"><div class=\"mb-2\"><h2 class=\"font-headline-md text-headline-md text-on-surface flex items-center gap-2\"><span class=\"material-symbols-outlined text-primary text-[24px]\">help</span>Pertanyaan Seputar Laporan PKL SMK</h2><p class=\"font-body-md text-body-md text-on-surface-variant mt-1 max-w-3xl\">Panduan singkat terkait penyusunan laporan magang dan penggunaan AI Generator ini.</p></div><div class=\"flex flex-col gap-3\"><details class=\"group bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 overflow-hidden [&amp;_summary::-webkit-details-marker]:hidden\"><summary class=\"flex items-center justify-between p-4 md:p-5 cursor-pointer list-none hover:bg-surface-container-low transition-colors outline-none focus-visible:ring-2 focus-visible:ring-primary-container\"><h3 class=\"font-label-lg text-label-lg md:text-headline-sm md:font-headline-sm text-on-surface font-semibold pr-4\">Apakah hasil dari tool ini bisa langsung di-copy paste untuk dikumpulkan?</h3><span class=\"material-symbols-outlined text-on-surface-variant group-open:-rotate-180 transition-transform duration-300 shrink-0\">keyboard_arrow_down</span></summary><div class=\"p-4 md:p-5 pt-0 border-t border-outline-variant/20 font-body-md text-body-md text-on-surface-variant leading-relaxed bg-surface-container-lowest animate-in fade-in slide-in-from-top-2 duration-300\"><div class=\"prose prose-sm md:prose-base prose-slate max-w-none prose-p:mb-3 prose-p:last:mb-0\"><p><strong>Tidak.</strong> Tool ini menghasilkan <em>draft struktur dan kerangka tulisan (outline)</em>. Kami sudah membuatkan kalimat pembuka, teori dasar, dan struktur bab yang sangat rapi. Namun, untuk detail kegiatan harian dan sejarah spesifik perusahaan, kamu WAJIB mengisinya sendiri sesuai pengalaman aslimu. Ini agar laporanmu tetap otentik dan lolos dari deteksi plagiarisme pembimbing.</p></div></div></details><details class=\"group bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 overflow-hidden [&amp;_summary::-webkit-details-marker]:hidden\"><summary class=\"flex items-center justify-between p-4 md:p-5 cursor-pointer list-none hover:bg-surface-container-low transition-colors outline-none focus-visible:ring-2 focus-visible:ring-primary-container\"><h3 class=\"font-label-lg text-label-lg md:text-headline-sm md:font-headline-sm text-on-surface font-semibold pr-4\">Tool ini cocok untuk jurusan SMK apa saja?</h3><span class=\"material-symbols-outlined text-on-surface-variant group-open:-rotate-180 transition-transform duration-300 shrink-0\">keyboard_arrow_down</span></summary><div class=\"p-4 md:p-5 pt-0 border-t border-outline-variant/20 font-body-md text-body-md text-on-surface-variant leading-relaxed bg-surface-container-lowest animate-in fade-in slide-in-from-top-2 duration-300\"><div class=\"prose prose-sm md:prose-base prose-slate max-w-none prose-p:mb-3 prose-p:last:mb-0\"><p>Tool ini menggunakan kecerdasan buatan yang memahami kurikulum SMK. Jadi, alat ini cocok untuk <strong>semua jurusan</strong>, mulai dari TKJ, RPL, Akuntansi (AKL), Otomotif (TKRO/TBSM), Tata Boga, Perhotelan, hingga Multimedia/DKV. Cukup ketik jurusanmu di kolom form, dan AI akan menyesuaikan isi laporannya.</p></div></div></details><details class=\"group bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 overflow-hidden [&amp;_summary::-webkit-details-marker]:hidden\"><summary class=\"flex items-center justify-between p-4 md:p-5 cursor-pointer list-none hover:bg-surface-container-low transition-colors outline-none focus-visible:ring-2 focus-visible:ring-primary-container\"><h3 class=\"font-label-lg text-label-lg md:text-headline-sm md:font-headline-sm text-on-surface font-semibold pr-4\">Bagaimana jika tempat magang saya bukan perusahaan besar (misal bengkel atau UMKM)?</h3><span class=\"material-symbols-outlined text-on-surface-variant group-open:-rotate-180 transition-transform duration-300 shrink-0\">keyboard_arrow_down</span></summary><div class=\"p-4 md:p-5 pt-0 border-t border-outline-variant/20 font-body-md text-body-md text-on-surface-variant leading-relaxed bg-surface-container-lowest animate-in fade-in slide-in-from-top-2 duration-300\"><div class=\"prose prose-sm md:prose-base prose-slate max-w-none prose-p:mb-3 prose-p:last:mb-0\"><p>Tidak masalah. Tetap ketik nama UMKM atau bengkel tersebut di kolom &quot;Nama Perusahaan&quot;. Laporan PKL tidak membedakan apakah kamu magang di BUMN atau di toko lokal; yang dinilai adalah kesesuaian antara pekerjaan yang dilakukan dengan jurusan kompetensi keahlianmu.</p></div></div></details><details class=\"group bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 overflow-hidden [&amp;_summary::-webkit-details-marker]:hidden\"><summary class=\"flex items-center justify-between p-4 md:p-5 cursor-pointer list-none hover:bg-surface-container-low transition-colors outline-none focus-visible:ring-2 focus-visible:ring-primary-container\"><h3 class=\"font-label-lg text-label-lg md:text-headline-sm md:font-headline-sm text-on-surface font-semibold pr-4\">Apakah format laporannya sesuai dengan aturan sekolah saya?</h3><span class=\"material-symbols-outlined text-on-surface-variant group-open:-rotate-180 transition-transform duration-300 shrink-0\">keyboard_arrow_down</span></summary><div class=\"p-4 md:p-5 pt-0 border-t border-outline-variant/20 font-body-md text-body-md text-on-surface-variant leading-relaxed bg-surface-container-lowest animate-in fade-in slide-in-from-top-2 duration-300\"><div class=\"prose prose-sm md:prose-base prose-slate max-w-none prose-p:mb-3 prose-p:last:mb-0\"><p>Tool ini menggunakan format standar Laporan PKL Nasional yang digunakan 90% SMK di Indonesia (Sistem 4 Bab). Jika sekolahmu memiliki pedoman penulisan khusus (misal 5 Bab), kamu tinggal menyesuaikan kerangka ini dan memindahkan isinya sesuai buku panduan dari sekolah.</p></div></div></details></div></section></div><div class=\"mt-12 mb-8\"><h3 class=\"text-xl font-bold text-slate-900 mb-4\">Coba Tools Bermanfaat Lainnya</h3><div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\"><a class=\"p-4 rounded-2xl border border-slate-200 bg-white hover:border-sky-300 hover:shadow-md transition-all group\" href=\"/tools/parafrase\"><div class=\"flex items-center gap-3 mb-2\"><div class=\"w-8 h-8 rounded-lg bg-sky-100 flex items-center justify-center text-sky-600\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-file-text w-4 h-4\" aria-hidden=\"true\"><path d=\"M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z\"></path><path d=\"M14 2v5a1 1 0 0 0 1 1h5\"></path><path d=\"M10 9H8\"></path><path d=\"M16 13H8\"></path><path d=\"M16 17H8\"></path></svg></div><h4 class=\"font-semibold text-slate-800 group-hover:text-sky-600 transition-colors\">Parafrase Makalah</h4></div><p class=\"text-sm text-slate-600\">Hindari plagiasi saat menyalin teori dari internet ke dalam laporanmu.</p></a><a class=\"p-4 rounded-2xl border border-slate-200 bg-white hover:border-sky-300 hover:shadow-md transition-all group\" href=\"/tools/grammar-eyd\"><div class=\"flex items-center gap-3 mb-2\"><div class=\"w-8 h-8 rounded-lg bg-indigo-100 flex items-center justify-center text-indigo-600\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check-big lucide-check-circle w-4 h-4\" aria-hidden=\"true\"><path d=\"M21.801 10A10 10 0 1 1 17 3.335\"></path><path d=\"m9 11 3 3L22 4\"></path></svg></div><h4 class=\"font-semibold text-slate-800 group-hover:text-indigo-600 transition-colors\">Cek Ejaan (EYD)</h4></div><p class=\"text-sm text-slate-600\">Pastikan laporan resmimu tidak ada typo dan sesuai kaidah bahasa baku.</p></a></div></div></div></main><footer class=\"bg-slate-50 border-t border-slate-200 py-10 mt-auto\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\"><div class=\"flex flex-col md:flex-row items-center justify-between gap-6\"><div class=\"flex flex-col sm:flex-row items-center gap-3 sm:gap-6 text-center sm:text-left\"><div class=\"flex items-center gap-2\"><div class=\"w-7 h-7 rounded-lg bg-sky-500 flex items-center justify-center text-white\"><svg class=\"w-3.5 h-3.5 fill-white\" viewBox=\"0 0 24 24\"><polygon points=\"13 2 3 14 12 14 11 22 21 10 12 10 13 2\"></polygon></svg></div><span class=\"font-bold text-slate-900 text-base font-heading\">TugasMu.com</span></div><span class=\"text-xs sm:text-sm text-slate-500\">© 2026 TugasMu.com. Hak cipta dilindungi.</span></div><div class=\"flex flex-wrap justify-center items-center gap-x-6 gap-y-3 text-xs sm:text-sm font-medium text-slate-500\"><a class=\"hover:text-slate-900 transition-colors\" href=\"/\">Beranda</a><a class=\"hover:text-slate-900 transition-colors\" href=\"/harga\">Premium</a><a class=\"hover:text-slate-900 transition-colors\" href=\"/blog\">Blog</a><a class=\"hover:text-slate-900 transition-colors\" href=\"/privasi\">Privacy Policy</a><a class=\"hover:text-slate-900 transition-colors\" href=\"/syarat\">Terms of Service</a><a class=\"hover:text-slate-900 transition-colors\" href=\"/kontak\">Kontak</a></div></div></div></footer><script src=\"/_next/static/chunks/webpack-37f8c22e297b04f8.js\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0]);self.__next_f.push([2,null])</script><script>self.__next_f.push([1,\"1:HL[\\\"/_next/static/css/c70a6d8e0709b465.css\\\",\\\"style\\\"]\\n2:HL[\\\"/_next/static/css/7eb325243a3b1d61.css\\\",\\\"style\\\"]\\n\"])</script><script>self.__next_f.push([1,\"3:I[2846,[],\\\"\\\"]\\n5:I[1995,[\\\"3433\\\",\\\"static/chunks/3433-9ddc6f7f78d9421c.js\\\",\\\"2972\\\",\\\"static/chunks/2972-8ce94bd856f9372b.js\\\",\\\"4194\\\",\\\"static/chunks/4194-e847e413fe1b63d3.js\\\",\\\"5553\\\",\\\"static/chunks/app/tools/laporan-pkl/page-2331a42a5f582a2b.js\\\"],\\\"default\\\"]\\n6:I[9468,[\\\"3433\\\",\\\"static/chunks/3433-9ddc6f7f78d9421c.js\\\",\\\"2972\\\",\\\"static/chunks/2972-8ce94bd856f9372b.js\\\",\\\"4194\\\",\\\"static/chunks/4194-e847e413fe1b63d3.js\\\",\\\"5553\\\",\\\"static/chunks/app/tools/laporan-pkl/page-2331a42a5f582a2b.js\\\"],\\\"default\\\"]\\ne:I[1693,[\\\"3433\\\",\\\"static/chunks/3433-9ddc6f7f78d9421c.js\\\",\\\"2972\\\",\\\"static/chunks/2972-8ce94bd856f9372b.js\\\",\\\"4194\\\",\\\"static/chunks/4194-e847e413fe1b63d3.js\\\",\\\"5553\\\",\\\"static/chunks/app/tools/laporan-pkl/page-2331a42a5f582a2b.js\\\"],\\\"default\\\"]\\nf:I[2972,[\\\"3433\\\",\\\"static/chunks/3433-9ddc6f7f78d9421c.js\\\",\\\"2972\\\",\\\"static/chunks/2972-8ce94bd856f9372b.js\\\",\\\"4194\\\",\\\"static/chunks/4194-e847e413fe1b63d3.js\\\",\\\"5553\\\",\\\"static/chunks/app/tools/laporan-pkl/page-2331a42a5f582a2b.js\\\"],\\\"\\\"]\\n1c:I[4707,[],\\\"\\\"]\\n1d:I[6423,[],\\\"\\\"]\\n1e:I[8003,[\\\"3433\\\",\\\"static/chunks/3433-9ddc6f7f78d9421c.js\\\",\\\"2972\\\",\\\"static/chunks/2972-8ce94bd856f9372b.js\\\",\\\"3185\\\",\\\"static/chunks/app/layout-c819