\\"path\\\",{\\\"d\\\":\\\"m9 11 3 3L22 4\\\",\\\"key\\\":\\\"1pflzl\\\"}]],\\\"aliases\\\":[\\\"check-circle\\\"]},\\\"className\\\":\\\"w-5 h-5 text-emerald-500 shrink-0 mt-0.5\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Subject-Verb Agreement:\\\"}],\\\" Ketidaksesuaian antara subjek dan kata kerja. Contoh salah: \\\",[\\\"$\\\",\\\"em\\\",null,{\\\"children\\\":\\\"\\\\\\\"She go to school.\\\\\\\"\\\"}],\\\" (Seharusnya \\\",[\\\"$\\\",\\\"em\\\",null,{\\\"children\\\":\\\"\\\\\\\"She goes\\\\\\\"\\\"}],\\\").\\\"]}]]}],[\\\"$\\\",\\\"li\\\",null,{\\\"className\\\":\\\"flex items-start gap-2\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L6\\\",null,{\\\"icon\\\":\\\"$7\\\",\\\"className\\\":\\\"w-5 h-5 text-emerald-500 shrink-0 mt-0.5\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Tenses yang Tertukar:\\\"}],\\\" Menceritakan pengalaman liburan masa lalu (Recount Text) tetapi menggunakan Present Tense (V1) alih-alih Past Tense (V2).\\\"]}]]}],[\\\"$\\\",\\\"li\\\",null,{\\\"className\\\":\\\"flex items-start gap-2\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L6\\\",null,{\\\"icon\\\":\\\"$7\\\",\\\"className\\\":\\\"w-5 h-5 text-emerald-500 shrink-0 mt-0.5\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Penggunaan Artikel (a, an, the):\\\"}],\\\" Menulis \\\",[\\\"$\\\",\\\"em\\\",null,{\\\"children\\\":\\\"\\\\\\\"an university\\\\\\\"\\\"}],\\\" padahal seharusnya \\\",[\\\"$\\\",\\\"em\\\",null,{\\\"children\\\":\\\"\\\\\\\"a university\\\\\\\"\\\"}],\\\" karena pelafalannya diawali huruf konsonan /j/.\\\"]}]]}]]}],[\\\"$\\\",\\\"h3\\\",null,{\\\"children\\\":\\\"Lebih dari Sekadar Mengecek Kesalahan\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":[\\\"Tool Grammar Checker TugasMu tidak hanya berfungsi seperti Grammarly yang menggarisbawahi teks yang salah. AI kami dirancang khusus sebagai \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Tutor Virtual\\\"}],\\\". Setelah memperbaiki teksmu, AI akan memberikan penjelasan \\\",[\\\"$\\\",\\\"em\\\",null,{\\\"children\\\":\\\"mengapa\\\"}],\\\" kalimatmu salah dalam Bahasa Indonesia yang mudah dipahami. Selain itu, kamu akan mendapat rekomendasi \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"kosakata tingkat lanjut (Advanced Vocabulary)\\\"}],\\\" untuk meningkatkan level CEFR tulisanmu dari A2/B1 menjadi B2/C1.\\\"]}]]}]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"mt-12\\\",\\\"children\\\":[\\\"$\\\",\\\"$Le\\\",null,{\\\"title\\\":\\\"Pertanyaan Seputar Pengecekan Grammar\\\",\\\"description\\\":\\\"Panduan singkat tentang cara kerja korektor grammar ini.\\\",\\\"faqs\\\":[{\\\"question\\\":\\\"Apakah hasil perbaikan teks bisa mengubah makna cerita saya?\\\",\\\"answer\\\":[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"Tidak. AI kami dirancang hanya untuk memperbaiki struktur tata bahasa (grammar), tanda baca, dan pilihan kata tanpa mengubah inti cerita atau makna dari opini yang kamu tuliskan.\\\"}]},{\\\"question\\\":\\\"Berapa panjang teks maksimal yang bisa diperiksa?\\\",\\\"answer\\\":[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"Kamu bisa memasukkan hingga sekitar 3.000 kata sekaligus dalam satu kali pengecekan. Jika tugasmu berupa makalah panjang atau skripsi, kami sarankan untuk membaginya menjadi beberapa bagian (misal per paragraf atau per bab).\\\"}]},{\\\"question\\\":\\\"Apakah tool ini gratis digunakan?\\\",\\\"answer\\\":[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":\\\"Ya, fitur Grammar Checker gratis digunakan hingga batas harian tertentu untuk pengguna non-login. Untuk batas yang lebih besar, kamu bisa mendaftar akun gratis atau berlangganan paket Premium.\\\"}]},{\\\"question\\\":\\\"Apa bedanya memilih jenjang SMP, SMA, atau Mahasiswa?\\\",\\\"answer\\\":[\\\"$\\\",\\\"p\\\",null,{\\\"children\\\":[\\\"Pilihan jenjang mempengaruhi \\\",[\\\"$\\\",\\\"st