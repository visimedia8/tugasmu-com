\"children\":[\"grammar-checker\",{\"children\":[\"__PAGE__\",{}]}]}]},\"$undefined\",\"$undefined\",true],[\"\",{\"children\":[\"tools\",{\"children\":[\"grammar-checker\",{\"children\":[\"__PAGE__\",{},[[\"$L1\",[\"$\",\"div\",null,{\"className\":\"container py-8 md:py-12 max-w-5xl\",\"children\":[[\"$\",\"div\",null,{\"className\":\"mb-8 max-w-3xl\",\"children\":[[\"$\",\"h1\",null,{\"className\":\"text-3xl md:text-4xl font-heading font-bold text-slate-900 mb-4\",\"children\":\"Korektor Grammar & Essay Bahasa Inggris\"}],[\"$\",\"p\",null,{\"className\":\"text-slate-600 text-lg\",\"children\":\"Jangan biarkan tugas essay atau PR bahasa Inggrismu penuh coretan merah. AI kami akan memperbaiki grammar, tenses, dan memberikan saran kosakata yang bikin tulisanmu terlihat lebih pro.\"}]]}],[\"$\",\"$L2\",null,{}],[\"$\",\"div\",null,{\"className\":\"mt-16 bg-white rounded-3xl p-8 border border-slate-200 shadow-sm\",\"children\":[\"$\",\"div\",null,{\"className\":\"prose prose-slate max-w-none prose-headings:font-heading prose-a:text-indigo-600\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-slate-900 mb-4 flex items-center gap-2\",\"children\":[[\"$\",\"$L3\",null,{\"icon\":{\"name\":\"book-open\",\"size\":24,\"node\":[[\"path\",{\"d\":\"M12 5v16\",\"key\":\"1f6ucr\"}],[\"path\",{\"d\":\"M20.001 19A2 2 0 0022 17V5a2 2 0 00-1.999-2L16 3.002A5 5 0 0012 5a5 5 0 00-4-2H4a2 2 0 00-2 2v12a2 2 0 001.999 2H8a5 5 0 014 2 5 5 0 014-2z\",\"key\":\"1fyvmf\"}]]},\"className\":\"w-6 h-6 text-indigo-500\"}],\"Pentingnya Mengecek Grammar Sebelum Mengumpulkan Tugas\"]}],[\"$\",\"p\",null,{\"children\":[\"Menulis dalam Bahasa Inggris (English writing) adalah salah satu tantangan terbesar bagi siswa SMP, SMA, maupun mahasiswa. Seringkali, kita menerjemahkan kalimat secara mentah-mentah dari Bahasa Indonesia ke Bahasa Inggris di kepala kita. Hasilnya? Susunan kata (\",[\"$\",\"em\",null,{\"children\":\"syntax\"}],\") menjadi aneh, dan \",[\"$\",\"strong\",null,{\"children\":\"tenses\"}],\" yang digunakan berantakan.\"]}],[\"$\",\"h3\",null,{\"children\":\"Kesalahan Grammar yang Paling Sering Terjadi\"}],[\"$\",\"p\",null,{\"children\":\"Berdasarkan analisis jutaan tugas siswa, berikut adalah kesalahan yang paling sering mengurangi nilai essay kamu:\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-2 mb-6\",\"children\":[[\"$\",\"li\",null,{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"$L3\",null,{\"icon\":{\"name\":\"circle-check-big\",\"size\":24,\"node\":[[\"path\",{\"d\":\"M21.801 10A10 10 0 1 1 17 3.335\",\"key\":\"yps3ct\"}],[\"path\",{\"d\":\"m9 11 3 3L22 4\",\"key\":\"1pflzl\"}]],\"aliases\":[\"check-circle\"]},\"className\":\"w-5 h-5 text-emerald-500 shrink-0 mt-0.5\"}],[\"$\",\"span\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Subject-Verb Agreement:\"}],\" Ketidaksesuaian antara subjek dan kata kerja. Contoh salah: \",[\"$\",\"em\",null,{\"children\":\"\\\"She go to school.\\\"\"}],\" (Seharusnya \",[\"$\",\"em\",null,{\"children\":\"\\\"She goes\\\"\"}],\").\"]}]]}],[\"$\",\"li\",null,{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"$L3\",null,{\"icon\":\"$4\",\"className\":\"w-5 h-5 text-emerald-500 shrink-0 mt-0.5\"}],[\"$\",\"span\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Tenses yang Tertukar:\"}],\" Menceritakan pengalaman liburan masa lalu (Recount Text) tetapi menggunakan Present Tense (V1) alih-alih Past Tense (V2).\"]}]]}],[\"$\",\"li\",null,{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"$L3\",null,{\"icon\":\"$4\",\"className\":\"w-5 h-5 text-emerald-500 shrink-0 mt-0.5\"}],[\"$\",\"span\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Penggunaan Artikel (a, an, the):\"}],\" Menulis \",[\"$\",\"em\",null,{\"children\":\"\\\"an university\\\"\"}],\" padahal seharusnya \",[\"$\",\"em\",null,{\"children\":\"\\\"a university\\\"\"}],\" karena pelafalannya diawali huruf konsonan /j/.\"]}]]}]]}],[\"$\",\"h3\",null,{\"children\":\"Lebih dari Sekadar Mengecek Kesalahan\"}],[\"$\",\"p\",null,{\"children\":[\"Tool Grammar Checker TugasMu tidak hanya berfungsi seperti Grammarly yang menggarisbawahi teks yang salah. AI kami dirancang khusus sebagai \",[\"$\",\"strong\",null,{\"children\":\"Tutor Virtual\"}],\". Setelah memperbaiki teksmu, AI akan memberikan penjelasan \",[\"$\",\"em\",null,{\"children\":\"mengapa\"}],\" kalimatmu salah dalam Bahasa Indonesia yang mudah dipahami. Selain itu, kamu akan mendapat rekomendasi \",[\"$\",\"strong\",null,{\"children\":\"kosakata tingkat lanjut (Advanced Vocabulary)\"}],\" untuk meningkatkan level CEFR tulisanmu dari A2/B1 menjadi B2/C1.\"]}]]}]}],[\"$\",\"div\",null,{\"className\":\"mt-12\",\"children\":[\"$\",\"$Lb\",null,{\"title\":\"Pertanyaan Seputar Pengecekan Grammar\",\"description\":\"Panduan singkat tentang cara kerja korektor grammar ini.\",\"faqs\":[{\"question\":\"Apakah hasil perbaikan teks bisa mengubah makna cerita saya?\",\"answer\":[\"$\",\"p\",null,{\"children\":\"Tidak. AI kami dirancang hanya untuk memperbaiki struktur tata bahasa (grammar), tanda baca, dan pilihan kata tanpa mengubah inti cerita atau makna dari opini yang kamu tuliskan.\"}]},{\"question\":\"Berapa panjang teks maksimal yang bisa diperiksa?\",\"answer\":[\"$\",\"p\",null,{\"children\":\"Kamu bisa memasukkan hingga sekitar 3.000 kata sekaligus dalam satu kali pengecekan. Jika tugasmu berupa makalah panjang atau skripsi, kami sarankan untuk membaginya menjadi beberapa bagian (misal per paragraf atau per bab).\"}]},{\"question\":\"Apakah tool ini gratis digunakan?\",\"answer\":[\"$\",\"p\",null,{\"children\":\"Ya, fitur Grammar Checker gratis digunakan hingga batas harian tertentu untuk pengguna non-login. Untuk batas yang lebih besar, kamu bisa mendaftar akun gratis atau berlangganan paket Premium.\"}]},{\"question\":\"Apa bedanya memilih jenjang SMP, SMA, atau Mahasiswa?\",\"answer\":[\"$\",\"p\",null,{\"children\":[\"Pilihan jenjang mempengaruhi \",[\"$\",\"strong\",null,{\"children\":\"tingkat formalitas dan kompleksitas vocabulary\"}],\" yang akan disarankan oleh AI. Untuk jenjang SMP, AI akan menjaga kalimat tetap sederhana namun benar. Untuk level Mahasiswa, AI akan merekomendasikan gaya bahasa akademik (Academic English) yang cocok untuk jurnal atau paper.\"]}]}]}]}],[\"$\",\"div\",null,{\"className\":\"mt-12 mb-8\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-xl font-bold text-slate-900 mb-4\",\"children\":\"Coba Tools Bermanfaat Lainnya\"}],[\"$\",\"div\",null,{\"className\":\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\",\"children\":[[\"$\",\"$Lc\",null,{\"href\":\"/tools/parafrase\",\"className\":\"p-4 rounded-2xl border border-slate-200 bg-white hover:border-indigo-300 hover:shadow-md transition-all group\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 mb-2\",\"children\":[[\"$\",\"div\",null,{\"className\":\"w-8 h-8 rounded-lg bg-indigo-100 flex items-center justify-center text-indigo-600\",\"children\":[\"$\",\"$L3\",null,{\"icon\":\"$d\",\"className\":\"w-4 h-4\"}]}],[\"$\",\"h4\",null,{\"className\":\"font-semibold text-slate-800 group-hover:text-indigo-600 transition-colors\",\"children\":\"Parafrase Makalah\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-slate-600\",\"children\":\"Ubah susunan kalimat teks yang terdeteksi plagiat menjadi tulisan yang segar dan orisinil.\"}]]}],[\"$\",\"$Lc\",null,{\"href\":\"/tools/penerjemah-daerah\",\"className\":\"p-4 rounded-2xl border border-slate-200 bg-white hover:border-sky-300 hover:shadow-md transition-all group\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 mb-2\",\"children\":[[\"$\",\"div\",null,{\"className\":\"w-8 h-8 rounded-lg bg-sky-100 flex items-center justify-center text-sky-600\",\"children\":[\"$\",\"$L3\",null,{\"icon\":\"$4\",\"className\":\"w-4 h-4\"}]}],[\"$\",\"h4\",null,{\"className\":\"font-semibold text-slate-800 group-hover:text-sky-600 transition