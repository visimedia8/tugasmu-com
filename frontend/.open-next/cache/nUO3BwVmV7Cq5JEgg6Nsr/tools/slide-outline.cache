donesia\"/><meta property=\"og:url\" content=\"https://tugasmu.com\"/><meta property=\"og:site_name\" content=\"TugasMu\"/><meta property=\"og:locale\" content=\"id_ID\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary\"/><meta name=\"twitter:title\" content=\"TugasMu | AI yang ngerti pelajaran kamu\"/><meta name=\"twitter:description\" content=\"Platform AI Gratis untuk Bantu Belajar Siswa Indonesia\"/><link rel=\"icon\" href=\"/favicon.ico\" type=\"image/x-icon\" sizes=\"16x16\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"font-sans bg-brand-cream text-brand-navy flex flex-col min-h-screen __variable_0d7163 __variable_5667dc\"><header class=\"sticky top-0 z-50 w-full\"><div class=\"bg-brand-cream/95 backdrop-blur-md border-b border-brand-navy/10\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between\"><a class=\"flex items-center gap-2.5 group\" href=\"/\"><div class=\"w-8 h-8 rounded-lg bg-brand-navy flex items-center justify-center shadow-sm group-hover:bg-brand-lime transition-colors duration-300\"><svg class=\"w-4 h-4 fill-brand-cream group-hover:fill-brand-navy transition-colors duration-300\" viewBox=\"0 0 24 24\"><polygon points=\"13 2 3 14 12 14 11 22 21 10 12 10 13 2\"></polygon></svg></div><span class=\"font-heading font-bold text-xl text-brand-navy tracking-tight group-hover:text-brand-navy/70 transition-colors\">TugasMu</span></a><nav class=\"hidden md:flex items-center gap-1\"><a class=\"relative px-4 py-2 text-sm font-semibold rounded-full transition-all duration-200 text-brand-navy bg-brand-lime\" href=\"/tools\">AI Tools</a><a class=\"relative px-4 py-2 text-sm font-semibold rounded-full transition-all duration-200 text-brand-navy/70 hover:text-brand-navy hover:bg-brand-navy/5\" href=\"/harga\">Premium</a><a class=\"relative px-4 py-2 text-sm font-semibold rounded-full transition-all duration-200 text-brand-navy/70 hover:text-brand-navy hover:bg-brand-navy/5\" href=\"/blog\">Blog</a></nav><div class=\"hidden md:flex items-center gap-3\"><a class=\"px-5 py-2.5 rounded-full bg-brand-navy hover:bg-brand-navy/90 text-brand-cream font-bold text-sm transition-all shadow-sm hover:shadow-md active:scale-95 flex items-center gap-2\" href=\"/masuk\">Masuk / Daftar</a></div><div class=\"flex md:hidden items-center gap-3\"><button class=\"p-2 rounded-full text-brand-navy hover:bg-brand-navy/5 transition-colors\" aria-label=\"Toggle Menu\"><svg class=\"w-5 h-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\"><line x1=\"3\" y1=\"8\" x2=\"21\" y2=\"8\"></line><line x1=\"3\" y1=\"16\" x2=\"21\" y2=\"16\"></line></svg></button></div></div></div></header><div class=\"bg-slate-50 border-b\"><div class=\"container py-3\"><nav class=\"flex text-sm text-slate-500\" aria-label=\"Breadcrumb\"><ol class=\"inline-flex items-center space-x-1 md:space-x-3\"><li class=\"inline-flex items-center\"><a class=\"hover:text-slate-900 transition-colors\" href=\"/\">Home</a></li><li><div class=\"flex items-center\"><span class=\"mx-2 text-slate-400\">/</span><a class=\"hover:text-slate-900 transition-colors\" href=\"/tools\">Tools</a></div></li><li><div class=\"flex items-center\"><span class=\"mx-2 text-slate-400\">/</span><span class=\"text-slate-900 font-medium\" aria-current=\"page\">Slide outline</span></div></li></ol></nav></div></div><main class=\"flex-1\"><div class=\"container py-8 md:py-12 max-w-5xl\"><div class=\"mb-8 max-w-3xl\"><h1 class=\"text-3xl md:text-4xl font-heading font-bold text-slate-900 mb-4\">Pembuat Outline Presentasi (Slide PPT/Canva)</h1><p class=\"text-slate-600 text-lg\">Ada tugas presentasi besok pagi tapi belum nyentuh PowerPoint atau Canva? Masukkan topik tugasmu, tentukan jumlah slide, dan AI kami akan menyusunkan apa saja isi tiap slide-nya beserta contekan naskah bicara (<em>speaker notes</em>).</p></div><form class=\"space-y-6\"><div class=\"space-y-4\"><div class=\"space-y-2\"><label class=\"block font-label-md text-label-md text-on-surface\">Topik Presentasi</label><input type=\"text\" placeholder=\"Contoh: Sejarah Perang Dunia 2 dan Dampaknya bagi Indonesia\" class=\"w-full px-3.5 py-3 rounded-xl bg-surface-container-low text-on-surface font-body-md text-body-md focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary-container outline-none transition-all disabled:opacity-50\" value=\"\"/></div><div class=\"grid grid-cols-1 md:grid-cols-2 gap-4\"><div class=\"space-y-2\"><label class=\"block font-label-md text-label-md text-on-surface\">Jumlah Slide</label><select class=\"w-full px-3.5 py-3 rounded-xl bg-surface-container-low text-on-surface font-body-md text-body-md focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary-container outline-none transition-all disabled:opacity-50 appearance-none\"><option value=\"5\">5 Slide (Sangat Singkat)</option><option value=\"7\" selected=\"\">7 Slide (Standar)</option><option value=\"10\">10 Slide (Lengkap)</option><option value=\"15\">15 Slide (Sangat Lengkap)</option></select></div><div class=\"space-y-2\"><label class=\"block font-label-md text-label-md text-on-surface\">Target Audiens</label><select class=\"w-full px-3.5 py-3 rounded-xl bg-surface-container-low text-on-surface font-body-md text-body-md focus:bg-surface-container-lowest focus:ring-2 focus:ring-primary-container outline-none transition-all disabled:opacity-50 appearance-none\"><option value=\"Teman Sekelas &amp; Guru\" selected=\"\">Teman Sekelas &amp; Guru Pembimbing</option><option value=\"Guru Penguji Sidang\">Guru Penguji Sidang (Formal)</option><option value=\"Anak-anak / Junior\">Adik Kelas (Santai &amp; Visual)</option></select></div></div></div><button type=\"submit\" class=\"w-full h-12 rounded-xl bg-primary-container hover:bg-primary text-on-primary font-label-lg text-label-lg transition-all shadow-sm disabled:opacity-60 disabled:cursor-not-allowed flex items-center justify-center gap-2\"><span class=\"material-symbols-outlined text-[20px]\">slideshow</span><span>Buat Outline Presentasi</span></button></form><div class=\"mt-16 bg-white rounded-3xl p-8 border border-slate-200 shadow-sm\"><div class=\"prose prose-slate max-w-none prose-headings:font-heading prose-a:text-sky-600\"><h2 class=\"text-2xl font-bold text-slate-900 mb-4 flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-presentation w-6 h-6 text-sky-500\" aria-hidden=\"true\"><path d=\"M2 3h20\"></path><path d=\"M21 3v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V3\"></path><path d=\"m7 21 5-5 5 5\"></path></svg>Rahasia Bikin Guru Terpukau Saat Kamu Presentasi</h2><p>Masalah terbesar siswa (dan mahasiswa) saat membuat presentasi adalah memasukkan semua teks panjang dari makalah/buku cetak ke dalam slide. Ini bukan presentasi namanya, ini <strong>Slide-ument (Slide + Document)</strong>. Penonton akan sibuk membaca dan mengabaikan kamu yang sedang bicara.</p><h3>Aturan Emas: Less is More</h3><ul class=\"space-y-2 mb-6\"><li class=\"flex items-start gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check-big lucide-check-circle w-5 h-5 text-emerald-500 shrink-0 mt-0.5\" aria-hidden=\"true\"><path d=\"M21.801 10A10 10 0 1 1 17 3.335\"></path><path d=\"m9 11 3 3L22 4\"></path></svg><span><strong>Maksimal 6 Poin Per Slide:</strong> Jangan buat penonton membaca paragraf. Tulis poin utamanya saja. Penjelasan detailnya? Ucapkan lewat mulutmu. Itulah fungsinya fitur <em>Speaker Notes</em> yang dibuat oleh AI kami.</span></li><li class=\"flex items-start gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check-big lucide-check-circle w-5 h-5 text-emerald-500 shrink-0 mt-0.5\" aria-hidden=\"true\"><path d=\"M21.801 10A10 10 0 1 1 17 3.335\"></path><path d=\"m9 11 3 3L22 4\"></path></svg><span><strong>Visual yang Kuat:</strong> Satu gambar yang relevan jauh lebih baik daripada satu layar penuh tulisan Arial ukuran 12. Di output AI, kami memberikan saran visual apa yang sebaiknya kamu cari di Canva untuk setiap slide.</span></li><li class=\"flex items-start gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check-big lucide-check-circle w-5 h-5 text-emerald-500 shrink-0 mt-0.5\" aria-hidden=\"true\"><path d=\"M21.801 10A10 10 0 1 1 17 3.335\"></path><path d=\"m9 11 3 3L22 4\"></path></svg><span><strong>Punya Struktur Hook:</strong> Jangan buka dengan &quot;Assalamualaikum kami dari kelompok 3 akan membahas sejarah kemerdekaan.&quot; Buka dengan kalimat <em>Hook</em> (pancingan) seperti &quot;Tahukah kalian bahwa Indonesia hampir tidak merdeka pada tanggal 17 Agustus jika bukan karena satu kejadian ini?&quot;</span></li></ul><p>Dengan tool ini, kamu tidak perlu lagi bengong di depan layar putih Canva. Tinggal <em>copy-paste</em> instruksi yang diberikan, pilih template favoritmu, dan mulailah latihan berbicara dengan pede.</p></div></div></div></main><footer class=\"bg-slate-50 border-t border-slate-200 py-10 mt-auto\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\"><div class=\"flex flex-col md:flex-row items-center justify-between gap-6\"><div class=\"flex flex-col sm:flex-row items-center gap-3 sm:gap-6 text-center sm:text-left\"><div class=\"flex items-center gap-2\"><div class=\"w-7 h-7 rounded-lg bg-sky-500 flex items-center justify-center text-white\"><svg class=\"w-3.5 h-3.5 fill-white\" viewBox=\"0 0 24 24\"><polygon points=\"13 2 3 14 12 14 11 22 21 10 12 10 13 2\"></polygon></svg></div><span class=\"font-bold text-slate-900 text-base font-heading\">TugasMu.com</span></div><span class=\"text-xs sm:text-sm text-slate-500\">© 2026 TugasMu.com. Hak cipta dilindungi.</span></div><div class=\"flex flex-wrap justify-center items-center gap-x-6 gap-y-3 text-xs sm:text-sm font-medium text-slate-500\"><a class=\"hover:text-slate-900 transition-colors\" href=\"/\">Beranda</a><a class=\"hover:text-slate-900 transition-colors\" href=\"/harga\">Premium</a><a class=\"hover:text-slate-900 transition-colors\" href=\"/blog\">Blog</a><a class=\"hover:text-slate-900 transition-colors\" href=\"/privasi\">Privacy Policy</a><a class=\"hover:text-slate-900 transition-colors\" href=\"/syarat\">Terms of Service</a><a class=\"hover:text-slate-900 transition-colors\" href=\"/kontak\">Kontak</a></div></div></div></footer><script src=\"/_next/static/chunks/webpack-37f8c22e297b04f8.js\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0]);self.__next_f.push([2,null])</script><script>self.__next_f.push([1,\"1:HL[\\\"/_next/static/css/c70a6d8e0709b465.css\\\",\\\"style\\\"]\\n2:HL[\\\"/_next/static/css/7eb325243a3b1d61.css\\\",\\\"style\\\"]\\n\"])</script><script>self.__next_f.push([1,\"3:I[2846,[],\\\"\\\"]\\n5:I[5498,[\\\"3433\\\",\\\"static/chunks/3433-9ddc6f7f78d9421c.js\\\",\\\"5717\\\",\\\"static/chunks/app/tools/slide-outline/page-e47601f7e2bb193d.js\\\"],\\\"default\\\"]\\n6:I[9468,[\\\"3433\\\",\\\"static/chunks/3433-9ddc6f7f78d9421c.js\\\",\\\"5717\\\",\\\"static/chunks/app/tools/slide-outline/page-e47601f7e2bb193d.js\\\"],\\\"default\\\"]\\ne:I[4707,[],\\\"\\\"]\\nf:I[6423,[],\\\"\\\"]\\n10:I[8003,[\\\"3433\\\",\\\"static/chunks/3433-9ddc6f7f78d9421c.js\\\",\\\"2972\\\",\\\"static/chunks/2972-8ce94bd856f9372b.js\\\",\\\"3185