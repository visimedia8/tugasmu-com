efined\",\"$undefined\",true],[\"\",{\"children\":[\"tools\",{\"children\":[\"cv-lamaran\",{\"children\":[\"__PAGE__\",{},[[\"$L1\",[\"$\",\"div\",null,{\"className\":\"container py-8 md:py-12 max-w-5xl\",\"children\":[[\"$\",\"div\",null,{\"className\":\"mb-8 max-w-3xl\",\"children\":[[\"$\",\"h1\",null,{\"className\":\"text-3xl md:text-4xl font-heading font-bold text-slate-900 mb-4\",\"children\":\"Generator CV & Surat Lamaran Kerja (Otomatis)\"}],[\"$\",\"p\",null,{\"className\":\"text-slate-600 text-lg\",\"children\":[\"Baru lulus SMK dan bingung cara melamar kerja? Masukkan jurusan dan tempat PKL-mu, AI HRD kami akan membuatkan draf \",[\"$\",\"em\",null,{\"children\":\"Cover Letter\"}],\" dan teks CV berstandar ATS yang dilirik oleh perusahaan.\"]}]]}],[\"$\",\"$L2\",null,{}],[\"$\",\"div\",null,{\"className\":\"mt-16 bg-white rounded-3xl p-8 border border-slate-200 shadow-sm\",\"children\":[\"$\",\"div\",null,{\"className\":\"prose prose-slate max-w-none prose-headings:font-heading prose-a:text-sky-600\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-slate-900 mb-4 flex items-center gap-2\",\"children\":[[\"$\",\"$L3\",null,{\"icon\":{\"name\":\"briefcase\",\"size\":24,\"node\":[[\"path\",{\"d\":\"M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16\",\"key\":\"jecpp\"}],[\"rect\",{\"width\":\"20\",\"height\":\"14\",\"x\":\"2\",\"y\":\"6\",\"rx\":\"2\",\"key\":\"i6l2r4\"}]]},\"className\":\"w-6 h-6 text-sky-500\"}],\"Rahasia Lolos Seleksi HRD bagi Fresh Graduate SMK\"]}],[\"$\",\"p\",null,{\"children\":[\"Mencari kerja bagi lulusan baru (\",[\"$\",\"em\",null,{\"children\":\"Fresh Graduate\"}],\") SMK memiliki tantangannya sendiri. Kamu bersaing dengan ribuan pelamar lain yang mungkin memiliki jenjang pendidikan lebih tinggi atau pengalaman lebih banyak. Kunci utamanya ada pada dokumen pertamamu: \",[\"$\",\"strong\",null,{\"children\":\"Surat Lamaran (Cover Letter)\"}],\" dan \",[\"$\",\"strong\",null,{\"children\":\"Curriculum Vitae (CV)\"}],\".\"]}],[\"$\",\"h3\",null,{\"children\":\"Apa itu ATS-Friendly?\"}],[\"$\",\"p\",null,{\"children\":[\"Banyak perusahaan besar sekarang menggunakan \",[\"$\",\"em\",null,{\"children\":\"Applicant Tracking System\"}],\" (ATS). Ini adalah software robot milik HRD yang menyeleksi CV secara otomatis sebelum dibaca oleh manusia. CV yang terlalu banyak desain, warna-warni, atau grafik aneh-aneh (seperti \",[\"$\",\"em\",null,{\"children\":\"skill bar\"}],\") akan otomatis \",[\"$\",\"strong\",null,{\"children\":\"DITOLAK\"}],\" oleh sistem ini karena tidak terbaca.\"]}],[\"$\",\"ul\",null,{\"className\":\"space-y-2 mb-6\",\"children\":[[\"$\",\"li\",null,{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"$L3\",null,{\"icon\":{\"name\":\"circle-check-big\",\"size\":24,\"node\":[[\"path\",{\"d\":\"M21.801 10A10 10 0 1 1 17 3.335\",\"key\":\"yps3ct\"}],[\"path\",{\"d\":\"m9 11 3 3L22 4\",\"key\":\"1pflzl\"}]],\"aliases\":[\"check-circle\"]},\"className\":\"w-5 h-5 text-emerald-500 shrink-0 mt-0.5\"}],[\"$\",\"span\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Gunakan Template Minimalis:\"}],\" Hindari template Canva yang terlalu penuh desain. Gunakan format teks standar dengan *bullet points*.\"]}]]}],[\"$\",\"li\",null,{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"$L3\",null,{\"icon\":\"$4\",\"className\":\"w-5 h-5 text-emerald-500 shrink-0 mt-0.5\"}],[\"$\",\"span\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Kata Kunci (Keywords):\"}],\" Robot ATS mencari kata kunci yang cocok dengan lowongan kerja. Oleh karena itu, penting memasukkan *hard skills* jurusanmu.\"]}]]}],[\"$\",\"li\",null,{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"$L3\",null,{\"icon\":\"$4\",\"className\":\"w-5 h-5 text-emerald-500 shrink-0 mt-0.5\"}],[\"$\",\"span\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Tonjolkan Pengalaman PKL:\"}],\" Sebagai lulusan SMK, nilai jual utamamu adalah masa magang (Prakerin/PKL). Tuliskan sebagai pengalaman kerja pertamamu.\"]}]]}]]}],[\"$\",\"h3\",null,{\"children\":\"Peran Penting Surat Lamaran (Cover Letter)\"}],[\"$\",\"p\",null,{\"children\":\"Surat lamaran bukan sekadar formalitas \\\"berikut saya lampirkan CV\\\". Surat ini adalah tempat kamu 'menjual diri'. Paragraf pertama harus langsung menarik perhatian, paragraf kedua membuktikan kamu punya *skill* yang dibutuhkan, dan paragraf penutup menunjukkan antusiasme. AI TugasMu sudah merancang struktur psikologis ini secara otomatis.\"}]]}]}],[\"$\",\"div\",null,{\"className\":\"mt-12\",\"children\":[\"$\",\"$Lb\",null,{\"title\":\"Pertanyaan Seputar Pembuatan CV & Lamaran\",\"description\":\"Panduan tentang cara memaksimalkan tool ini untuk persiapan karirmu.\",\"faqs\":[{\"question\":\"Apakah CV yang dihasilkan berbentuk PDF/Gambar?\",\"answer\":[\"$\",\"p\",null,{\"children\":[[\"$\",\"strong\",null,{\"children\":\"Tidak.\"}],\" Tool ini menghasilkan \",[\"$\",\"em\",null,{\"children\":\"teks (copywriting)\"}],\" berstandar ATS. Kamu harus menyalin (\",[\"$\",\"em\",null,{\"children\":\"copy\"}],\") teks ini dan menempelkannya (\",[\"$\",\"em\",null,{\"children\":\"paste\"}],\") ke dalam Microsoft Word, Google Docs, atau template CV minimalis favoritmu.\"]}]},{\"question\":\"Saya belum pernah bekerja, apa yang harus ditulis di pengalaman?\",\"answer\":[\"$\",\"p\",null,{\"children\":\"Sebagai siswa SMK, pengalaman Praktik Kerja Lapangan (PKL), magang, atau keterlibatan aktif di Organisasi Siswa (OSIS/Pramuka/Ekskul) sangat dihitung oleh HRD. Ketikkan saja nama tempat PKL-mu beserta kegiatan yang kamu lakukan.\"}]},{\"question\":\"Apakah bahasa yang digunakan sudah formal?\",\"answer\":[\"$\",\"p\",null,{\"children\":\"Tentu saja. AI telah diprogram (sebagai konsultan karir) untuk menggunakan bahasa Indonesia baku yang sangat profesional, bebas dari *typo*, dan terstruktur rapi.\"}]}]}]}],[\"$\",\"div\",null,{\"className\":\"mt-12 mb-8\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-xl font-bold text-slate-900 mb-4\",\"children\":\"Persiapan Kerja Lainnya\"}],[\"$\",\"div\",null,{\"className\":\"grid grid-cols-1 md:grid-cols-2 gap-4\",\"children\":[[\"$\",\"$Lc\",null,{\"href\":\"/tools/laporan-pkl\",\"className\":\"p-4 rounded-2xl border border-slate-200 bg-white hover:border-sky-300 hover:shadow-md transition-all group\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 mb-2\",\"children\":[[\"$\",\"div\",null,{\"className\":\"w-8 h-8 rounded-lg bg-sky-100 flex items-center justify-center text-sky-600\",\"children\":[\"$\",\"$L3\",null,{\"icon\":{\"name\":\"file-text\",\"size\":24,\"node\":[[\"path\",{\"d\":\"M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z\",\"key\":\"1oefj6\"}],[\"path\",{\"d\":\"M14 2v5a1 1 0 0 0 1 1h5\",\"key\":\"wfsgrz\"}],[\"path\",{\"d\":\"M10 9H8\",\"key\":\"b1mrlr\"}],[\"path\",{\"d\":\"M16 13H8\",\"key\":\"t4e002\"}],[\"path\",{\"d\":\"M16 17H8\",\"key\":\"z1uh3a\"}]]},\"className\":\"w-4 h-4\"}]}],[\"$\",\"h4\",null,{\"className\":\"font-semibold text-slate-800 group-hover:text-sky-600 transition-colors\",\"children\":\"Laporan PKL\"}]]}],[\"$\",\"p\",null,{\"className\":\"text-sm text-slate-600\",\"children\":\"Masih magang? Buat laporan PKL-mu di sini untuk memastikan nilai kelulusanmu maksimal sebelum melamar kerja.\"}]]}],[\"$\",\"$Lc\",null,{\"href\":\"/tools/grammar-eyd\",\"className\":\"p-4 rounded-2xl border border-slate-200 bg-white hover:border-sky-300 hover:shadow-md transition-all group\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-3 mb-2\",\"children\":[[\"$\",\"div\",null,{\"className\":\"w-8 h-8 rounded-lg bg-indigo-100 flex items-center justify-center text-indigo-600\",\"children\":[\"$\",\"$L3\",null,{\"icon\":\"$4\",\"className\":\"w-4 h-4\"}]}],[\"$\",\"h4\",null,{\"className\":\"font-semibold text-slate-800 group-hover:text-indigo-600 transition-colors\",\"childre