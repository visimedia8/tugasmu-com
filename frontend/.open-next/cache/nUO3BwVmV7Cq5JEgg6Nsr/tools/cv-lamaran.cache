",\"2\",{\"children\":\"Generator CV & Surat Lamaran Kerja ATS Friendly - Khusus Lulusan SMK | TugasMu\"}],[\"$\",\"meta\",\"3\",{\"name\":\"description\",\"content\":\"Buat CV dan Surat Lamaran Kerja otomatis yang lolos sistem ATS HRD. Dirancang khusus untuk Fresh Graduate lulusan SMK agar cepat dapat panggilan kerja.\"}],[\"$\",\"meta\",\"4\",{\"property\":\"og:title\",\"content\":\"TugasMu | AI yang ngerti pelajaran kamu\"}],[\"$\",\"meta\",\"5\",{\"property\":\"og:description\",\"content\":\"Platform AI Gratis untuk Bantu Belajar Siswa Indonesia\"}],[\"$\",\"meta\",\"6\",{\"property\":\"og:url\",\"content\":\"https://tugasmu.com\"}],[\"$\",\"meta\",\"7\",{\"property\":\"og:site_name\",\"content\":\"TugasMu\"}],[\"$\",\"meta\",\"8\",{\"property\":\"og:locale\",\"content\":\"id_ID\"}],[\"$\",\"meta\",\"9\",{\"property\":\"og:type\",\"content\":\"website\"}],[\"$\",\"meta\",\"10\",{\"name\":\"twitter:card\",\"content\":\"summary\"}],[\"$\",\"meta\",\"11\",{\"name\":\"twitter:title\",\"content\":\"TugasMu | AI yang ngerti pelajaran kamu\"}],[\"$\",\"meta\",\"12\",{\"name\":\"twitter:description\",\"content\":\"Platform AI Gratis untuk Bantu Belajar Siswa Indonesia\"}],[\"$\",\"link\",\"13\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}]]\n1:null\n"}