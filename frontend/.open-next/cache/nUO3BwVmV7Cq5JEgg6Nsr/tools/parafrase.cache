\",{\"children\":[\"tools\",{\"children\":[\"parafrase\",{\"children\":[\"__PAGE__\",{},[[\"$L1\",[\"$\",\"div\",null,{\"className\":\"w-full bg-surface min-h-screen\",\"children\":[[\"$\",\"$L2\",null,{\"schema\":{\"@context\":\"https://schema.org\",\"@type\":\"HowTo\",\"name\":\"Cara Memparafrase Teks dengan AI TugasMu\",\"description\":\"Langkah mudah menggunakan alat parafrase gratis dari TugasMu\",\"step\":[{\"@type\":\"HowToStep\",\"name\":\"Pilih Konteks\",\"text\":\"Pilih jenjang, kelas, kurikulum, dan mata pelajaran.\"},{\"@type\":\"HowToStep\",\"name\":\"Masukkan Teks\",\"text\":\"Tempel teks yang ingin diparafrase ke dalam kotak.\"},{\"@type\":\"HowToStep\",\"name\":\"Generate & Salin\",\"text\":\"Klik tombol 'Parafrase Sekarang' dan salin hasilnya.\"}]}}],[\"$\",\"$L2\",null,{\"schema\":{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Apa itu Parafrase?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Parafrase adalah menulis ulang sebuah teks menggunakan kata-kata sendiri tanpa mengubah makna dasar dari teks aslinya.\"}},{\"@type\":\"Question\",\"name\":\"Mengapa menggunakan TugasMu?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"TugasMu dirancang khusus untuk memahami konteks siswa Indonesia sehingga hasil parafrase terdengar lebih natural dan disesuaikan dengan tingkat sekolah.\"}}]}}],[\"$\",\"section\",null,{\"className\":\"max-w-[1200px] mx-auto w-full px-margin md:px-margin-desktop py-space-lg\",\"children\":[[\"$\",\"nav\",null,{\"aria-label\":\"Breadcrumb\",\"className\":\"flex items-center gap-space-xs text-on-surface-variant font-body-sm text-body-sm mb-space-md\",\"children\":[[\"$\",\"$L3\",null,{\"className\":\"hover:text-primary transition-colors flex items-center gap-1\",\"href\":\"/\",\"children\":[[\"$\",\"span\",null,{\"className\":\"material-symbols-outlined text-[16px]\",\"children\":\"home\"}],[\"$\",\"span\",null,{\"children\":\"Beranda\"}]]}],[\"$\",\"span\",