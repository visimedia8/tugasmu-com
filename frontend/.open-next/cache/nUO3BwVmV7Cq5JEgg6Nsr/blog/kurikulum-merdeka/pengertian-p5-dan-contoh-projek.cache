{"type":"app","meta":{"headers":{"x-next-cache-tags":"_N_T_/layout,_N_T_/blog/layout,_N_T_/blog/[kategori]/layout,_N_T_/blog/[kategori]/[slug]/layout,_N_T_/blog/[kategori]/[slug]/page,_N_T_/blog/kurikulum-merdeka/pengertian-p5-dan-contoh-projek"}},"html":"<!DOCTYPE html><html lang=\"id\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/css/c70a6d8e0709b465.css\" data-precedence=\"next\"/><link rel=\"stylesheet\" href=\"/_next/static/css/7eb325243a3b1d61.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-37f8c22e297b04f8.js\"/><script src=\"/_next/static/chunks/fd9d1056-2718004965b0207a.js\" async=\"\"></script><script src=\"/_next/static/chunks/2117-c5687b942395652d.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-f30bb01764683cd9.js\" async=\"\"></script><script src=\"/_next/static/chunks/3433-9ddc6f7f78d9421c.js\" async=\"\"></script><script src=\"/_next/static/chunks/2972-8ce94bd856f9372b.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-c819fc26cf8b0e32.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/blog/%5Bkategori%5D/%5Bslug%5D/page-66ee61aaeae9a3c2.js\" async=\"\"></script><link rel=\"preload\" href=\"https://www.googletagmanager.com/gtag/js?id=G-8K10RNGN76\" as=\"script\"/><link rel=\"preload\" href=\"https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXXXXXXXX\" as=\"script\" crossorigin=\"\"/><title>Projek Penguatan Profil Pelajar Pancasila (P5): Panduan Lengkap | TugasMu | TugasMu</title><meta property=\"og:title\" content=\"Projek Penguatan Profil Pelajar Pancasila (P5): Panduan Lengkap\"/><meta property=\"og:type\" content=\"article\"/><meta property=\"article:published_time\" content=\"Tue Sep 22 2026 08:00:00 GMT+0800 (Central Indonesia Time)\"/><meta name=\"twitter:card\" content=\"summary\"/><meta name=\"twitter:title\" content=\"Projek Penguatan Profil Pelajar Pancasila (P5): Panduan Lengkap\"/><link rel=\"icon\" href=\"/favicon.ico\" type=\"image/x-icon\" sizes=\"16x16\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"font-sans bg-brand-cream text-brand-navy flex flex-col min-h-screen __variable_0d7163 __variable_5667dc\"><header class=\"sticky top-0 z-50 w-full\"><div class=\"bg-brand-cream/95 backdrop-blur-md border-b border-brand-navy/10\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between\"><a class=\"flex items-center gap-2.5 group\" href=\"/\"><div class=\"w-8 h-8 rounded-lg bg-brand-navy flex items-center justify-center shadow-sm group-hover:bg-brand-lime transition-colors duration-300\"><svg class=\"w-4 h-4 fill-brand-cream group-hover:fill-brand-navy transition-colors duration-300\" viewBox=\"0 0 24 24\"><polygon points=\"13 2 3 14 12 14 11 22 21 10 12 10 13 2\"></polygon></svg></div><span class=\"font-heading font-bold text-xl text-brand-navy tracking-tight group-hover:text-brand-navy/70 transition-colors\">TugasMu</span></a><nav class=\"hidden md:flex items-center gap-1\"><a class=\"relative px-4 py-2 text-sm font-semibold rounded-full transition-all duration-200 text-brand-navy/70 hover:text-brand-navy hover:bg-brand-navy/5\" href=\"/tools\">AI Tools</a><a class=\"relative px-4 py-2 text-sm font-semibold rounded-full transition-all duration-200 text-brand-navy/70 hover:text-brand-navy hover:bg-brand-navy/5\" href=\"/harga\">Premium</a><a class=\"relative px-4 py-2 text-sm font-semibold rounded-full transition-all duration-200 text-brand-navy bg-brand-lime\" href=\"/blog\">Blog</a></nav><div class=\"hidden md:flex items-center gap-3\"><a class=\"px-5 py-2.5 rounded-full bg-brand-navy hover:bg-brand-navy/90 text-brand-cream font-bold text-sm transition-all shadow-sm hover:shadow-md active:scale-95 flex items-center gap-2\" href=\"/masuk\">Masuk / Daftar</a></div><div class=\"flex md:hidden items-center gap-3\"><button class=\"p-2 rounded-full text-brand-navy hover:bg-brand-navy/5 transition-colors\" aria-label=\"Toggle Menu\"><svg class=\"w-5 h-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\"><line x1=\"3\" y1=\"8\" x2=\"21\" y2=\"8\"></line><line x1=\"3\" y1=\"16\" x2=\"21\" y2=\"16\"></line></svg></button></div></div></div></header><div class=\"bg-slate-50 border-b\"><div class=\"container py-3\"><nav class=\"flex text-sm text-slate-500\" aria-label=\"Breadcrumb\"><ol class=\"inline-flex items-center space-x-1 md:space-x-3\"><li class=\"inline-flex items-center\"><a class=\"hover:text-slate-900 transition-colors\" href=\"/\">Home</a></li><li><div class=\"flex items-center\"><span class=\"mx-2 text-slate-400\">/</span><a class=\"hover:text-slate-900 transition-colors\" href=\"/blog\">Blog</a></div></li><li><div class=\"flex items-center\"><span class=\"mx-2 text-slate-400\">/</span><a class=\"hover:text-slate-900 transition-colors\" href=\"/blog/kurikulum-merdeka\">Kurikulum merdeka</a></div></li><li><div class=\"flex items-center\"><span class=\"mx-2 text-slate-400\">/</span><span class=\"text-slate-900 font-medium\" aria-current=\"page\">Pengertian p5 dan contoh projek</span></div></li></ol></nav></div></div><main class=\"flex-1\"><div class=\"w-full max-w-[1200px] mx-auto px-margin md:px-margin-desktop py-space-lg md:py-space-xl\"><nav aria-label=\"Breadcrumb\" class=\"flex items-center gap-space-xs text-on-surface-variant font-body-sm text-body-sm mb-space-lg overflow-x-auto whitespace-nowrap scrollbar-none\"><a class=\"hover:text-primary transition-colors flex items-center gap-1\" href=\"/\"><span class=\"material-symbols-outlined text-[16px]\">home</span><span>Home</span></a><span class=\"material-symbols-outlined text-[14px] text-outline\">chevron_right</span><a class=\"hover:text-primary transition-colors\" href=\"/blog\">Blog</a><span class=\"material-symbols-outlined text-[14px] text-outline\">chevron_right</span><a class=\"hover:text-primary transition-colors capitalize\" href=\"/blog/kurikulum-merdeka\">kurikulum merdeka</a><span class=\"material-symbols-outlined text-[14px] text-outline\">chevron_right</span><span class=\"text-primary truncate max-w-[200px] md:max-w-none font-medium\">Projek Penguatan Profil Pelajar Pancasila (P5): Panduan Lengkap</span></nav><div class=\"grid grid-cols-1 lg:grid-cols-12 gap-space-xl items-start\"><article class=\"lg:col-span-8 flex flex-col\"><div class=\"flex flex-wrap items-center gap-space-sm mb-space-md\"><span class=\"px-space-md py-1 rounded-xl bg-primary-fixed text-on-primary-fixed font-label-sm text-label-sm tracking-wide uppercase\">kurikulum merdeka</span><span class=\"px-space-md py-1 rounded-xl bg-surface-container text-on-surface-variant font-label-sm text-label-sm flex items-center gap-1\"><span class=\"material-symbols-outlined text-[14px] text-primary\">schedule</span>5 menit baca</span></div><h1 class=\"font-headline-lg text-headline-lg md:text-display-lg text-on-surface tracking-tight mb-space-lg leading-tight\">Projek Penguatan Profil Pelajar Pancasila (P5): Panduan Lengkap</h1><div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-space-md p-space-md md:p-space-lg rounded-xl bg-surface-container-low mb-space-xl border border-slate-100\"><div class=\"flex items-center gap-space-md\"><div class=\"w-12 h-12 rounded-full bg-primary-container text-on-primary font-headline-sm text-headline-sm flex items-center justify-center font-bold shadow-sm ring-2 ring-primary-fixed\">TM</div><div><div class=\"flex items-center gap-1.5\"><span class=\"font-label-lg text-label-lg text-on-surface font-bold\">Tim Kurasi TugasMu</span><span class=\"material-symbols-outlined text-primary text-[16px]\" title=\"Terverifikasi\">verified</span></div><p class=\"font-body-sm text-body-sm text-on-surface-variant\">Diterbitkan pada <!-- -->22 September 2026</p></div></div><div class=\"flex items-center gap-2 pt-space-xs sm:pt-0\"><button class=\"inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-surface-container-lowest hover:bg-surface-container text-secondary font-label-md text-label-md transition-all shadow-sm\"><span class=\"material-symbols-outlined text-[18px]\">share</span><span class=\"hidden sm:inline\">Bagikan</span></button></div></div><div class=\"prose-content flex flex-col gap-space-lg text-on-surface font-body-lg text-body-lg leading-relaxed bg-surface-container-lowest p-space-lg md:p-space-xl rounded-xl shadow-sm border border-slate-100\"><h1 class=\"font-headline-lg text-headline-lg text-on-surface tracking-tight mb-space-lg leading-tight\">Projek Penguatan Profil Pelajar Pancasila (P5): Panduan Lengkap</h1>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Projek Penguatan Profil Pelajar Pancasila (P5) merupakan pembelajaran kokurikuler dalam kerangka <a href=\"/blog/kurikulum-merdeka\">Kurikulum Merdeka</a> yang dirancang untuk membangun karakter serta kompetensi aplikatif siswa lewat eksplorasi isu nyata di lingkungan sekitar. Pendekatan berbasis projek ini mengalihkan fokus belajarmu dari sekadar hafalan materi ujian menuju pengasahan daya nalar, kreativitas, dan kolaborasi tim. Seluruh proses pelaksanaan tugasmu sepanjang semester dinilai melalui pengamatan proses kerja dan portofolio karya nyata di P5.</p>\n<h2 class=\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\">6 Dimensi Profil Pelajar Pancasila yang Dinilai di P5</h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">P5 mengevaluasi enam dimensi karakter esensial agar kamu mampu mengaplikasikan ilmu pengetahuan dalam kehidupan bermasyarakat. Guru pembimbing tidak menguji hafalan rumus, melainkan mengamati caramu memecahkan masalah saat bekerja sama di dalam kelompok. Untuk menguji pemahaman konsep lintas mata pelajaran sebelum terjun ke lapangan, kamu bisa memanfaatkan <a href=\"/tools/generator-soal\">latihan soal berbasis materi P5</a> dengan bimbingan AI sebagai teman pintar belajar. Asesmen karakter ini memetakan perkembangan pribadimu secara utuh melalui enam pilar utama dimensi.</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Dimensi karakter yang menjadi target evaluasi dalam projek ini mencakup aspek berikut:</p>\n<ul>\n<li><strong>Beriman, bertakwa kepada Tuhan YME, dan berakhlak mulia</strong>: membimbing etika spiritual, integritas personal, dan kepedulian sosial terhadap sesama serta lingkungan alam.</li>\n<li><strong>Berkebinekaan global</strong>: menumbuhkan sikap menghargai keberagaman budaya nusantara dan keterbukaan terhadap peradaban dunia.</li>\n<li><strong>Bergotong royong</strong>: melatih kapasitas kerja sama sukarela, kepedulian timbal balik, dan pembagian peran yang adil.</li>\n<li><strong>Mandiri</strong>: membentuk tanggung jawab otonom dalam mengelola waktu, rencana belajar, serta regulasi emosi diri.</li>\n<li><strong>Bernalar kritis</strong>: mempertajam kemampuan memproses informasi objektif, menganalisis argumen logis, dan mendeteksi bias data.</li>\n<li><strong>Kreatif</strong>: menghasilkan gagasan baru yang orisinal, memodifikasi karya fungsional, dan mengeksekusi solusi inovatif.</li>\n</ul>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Inovatif dalam konteks dimensi ini menuntut siswa mengubah ide abstrak menjadi tindakan nyata yang memberi faedah langsung bagi lingkungan sekolah. Kamu diajak mengidentifikasi persoalan di sekitarmu, lalu merancang strategi penyelesaian bersama rekan sekelas. Pahami konsepnya bahwa setiap penugasan diarahkan untuk mematangkan cara berpikir, bukan sekadar memproduksi barang pajangan. Bagaimana caramu membuktikan ketercapaian seluruh dimensi tersebut saat menghadapi silang pendapat di kelompok kerja sebagai insan beriman?</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">Dimensi Beriman, Bertakwa, dan Berakhlak Mulia</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Beriman, bertakwa, dan berakhlak mulia di P5 menuntun kamu menerapkan nilai spiritual ke dalam etika sosial harian. Pengamalan akhlak ini tidak berhenti pada ritual ibadah pribadi, melainkan diwujudkan lewat kejujuran mengumpulkan data riset dan empati terhadap rekan kerja. Kamu juga dilatih menjaga kebersihan serta kelestarian lingkungan sekolah sebagai wujud syukur kepada Tuhan. Pembiasaan nyata ini membentuk karakter siswa yang bertanggung jawab sekaligus bernalar kritis.</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">Dimensi Bernalar Kritis dan Kreatif</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Bernalar kritis dan kreatif menjadi dua dimensi P5 yang mengasah ketajaman intelektualmu saat mengolah data mentah di lapangan. Pada fase bernalar kritis, kamu memeriksa keabsahan sumber rujukan, membedakan fakta dari klaim keliru, serta merumuskan simpulan logis. Sementara pada dimensi kreatif, kamu merancang sudut pandang unik untuk menjawab permasalahan komunitas yang belum terselesaikan. Perpaduan kedua kecakapan ini membuat belajarmu lebih berdampak karena kamu menghasilkan solusi orisinal yang terukur. Kesiapan karakter dari seluruh dimensi ini memerlukan wadah implementasi kontekstual berupa tema.</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Tema kegiatan yang ditentukan sekolah menjadi wahana praktik langsung untuk membuktikan kematangan dimensi karaktermu dalam pelaksanaan P5.</p>\n<h2 class=\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\">7 Tema Resmi P5 dan Cara Sekolah Memilihnya</h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">P5 menetapkan tujuh tema resmi bagi jenjang pendidikan dasar dan menengah agar satuan pendidikan memiliki panduan kontekstual yang jelas. Tim fasilitator guru memilih dua hingga tiga tema dalam satu tahun ajaran berdasarkan isu riil yang sedang dihadapi lingkungan sekitar sekolah. Pemilihan tema tersebut mempertimbangkan ketersediaan sarana belajar, potensi kearifan daerah, dan tingkat kesiapan siswa pada fase terkait. Pembatasan jumlah tema tahunan menjaga agar fokus belajarmu tetap mendalam tanpa mengganggu ketuntasan materi intrakurikuler berkelanjutan.</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">Tema Gaya Hidup Berkelanjutan (Paling Sering Dipakai)</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Berkelanjutan menjadi tema P5 yang paling sering diterapkan sekolah karena bersentuhan langsung dengan persoalan ekologis di sekitar kita. Lewat tema gaya hidup berkelanjutan, kamu belajar mengaudit volume sampah harian, mendaur ulang limbah plastik, dan merawat instalasi tanaman sekolah. Tugasmu mencakup investigasi dampak limbah terhadap ekosistem lokal, dilanjutkan penyusunan aksi nyata untuk mengurangi penggunaan wadah sekali pakai. Pahami konsepnya bahwa kebiasaan peduli lingkungan ini membentuk kedisiplinan hidup yang setara nilainya dengan pembelajaran wirausaha.</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">Tema Kewirausahaan dan Cara Kerjanya</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Wirausaha di dalam kerangka P5 membimbing siswa membangun pola pikir bisnis mandiri yang beretika. Kamu bersama kelompok merumuskan gagasan produk, menyusun anggaran biaya produksi, dan menguji kelayakan pasar di sekolah. Projek ini berpuncak pada kegiatan <em>market day</em>, tempat kamu menjual produk makanan sehat, kriya daur ulang, atau menawarkan jasa kreatif. Seluruh transaksi riil tersebut melatih ketangguhan mentalmu saat menghadapi dinamika penjualan barang. Bagaimana strategi tim kelompokmu menghitung harga pokok penjualan agar kegiatan bazar tidak merugi dan tercatat transparan di rapor?</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Rapor capaian projek dari berbagai tema tersebut tidak menggunakan angka kuantitatif, melainkan diolah secara kualitatif lewat mekanisme penilaian P5.</p>\n<h2 class=\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\">Sistem Penilaian P5 di Rapor Kurikulum Merdeka</h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Penilaian P5 tidak menggunakan skala angka nol sampai seratus layaknya ulangan harian, melainkan memakai rubrik capaian kualitatif. Guru pembimbing memantau konsistensi perilakumu sejak tahap perumusan gagasan, aksi lapangan, sampai pameran gelar karya. Evaluasi berbasis proses ini meniadakan standar KKM yang memicu stres akademik. Fokus utama guru adalah menilai perkembangan inisiatif, kolaborasi, dan daya tahan belajarmu saat menghadapi rintangan kelompok. Guru mendokumentasikan pengamatan tersebut menggunakan skala BB, MB, BSH, dan SAB.</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">Skala BB, MB, BSH, SAB: Definisi dan Makna</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Skala BB, MB, BSH, dan SAB di P5 mengelompokkan perkembangan karakter siswa ke dalam empat predikat bertingkat. Tingkat Belum Berkembang (BB) menunjukkan siswa masih memerlukan bimbingan rutin dari guru untuk memulai aksi. Tingkat Mulai Berkembang (MB) memperlihatkan siswa sudah berinisiatif, meski konsistensinya masih fluktuatif. Tingkat Berkembang Sesuai Harapan (BSH) merupakan standar ketercapaian fase, di mana siswa mampu berkolaborasi dan berpikir mandiri secara teratur. Tingkat Sangat Berkembang (SAB) dicapai saat siswa mampu melampaui target fase serta menjadi penggerak bagi teman-temannya. Karakteristik rubrik deskriptif ini mencerminkan perbedaan nilai P5.</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">Perbedaan Nilai P5 vs Nilai Mata Pelajaran Biasa</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Perbedaan nilai P5 dibandingkan mata pelajaran biasa terletak pada fokus asesmen perilaku daripada penguasaan materi ujian. Rapor reguler mengukur penguasaan kognitif terhadap materi silabus, sedangkan rapor projek mendokumentasikan kematangan sikap sosial dan emosional. Pada lembar rapor projek, fasilitator menyematkan catatan reflektif mengenai kontribusi personalmu di kelompok serta area sikap yang perlu kamu asah di periode berikutnya. Mekanisme ini memastikan nilaimu mencerminkan kompetensi riil siswa di setiap jenjang.</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Jenjang pendidikan yang kamu tempuh menentukan tingkat kesulitan dan format tantangan yang tertuang dalam perencanaan contoh projek P5.</p>\n<h2 class=\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\">Contoh Projek P5 Konkret per Jenjang</h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Contoh projek P5 di setiap jenjang pendidikan disesuaikan dengan tingkat perkembangan emosional dan daya nalar siswa. Peserta didik SD mempraktikkan pembiasaan karakter sederhana di lingkungan terdekat, sedangkan siswa jenjang SMP dan SMA membedah isu komunitas yang membutuhkan pemikiran multidisiplin. Fleksibilitas ini memberi ruang bagimu untuk bereksplorasi tanpa tekanan ujian kertas. Rincian perbedaan alur kegiatan antarfase dapat kamu pelajari pada tabel perbandingan berikut:</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Tabel implementasi tema, fase belajar, dan bentuk kegiatan nyata P5 di berbagai jenjang pendidikan adalah sebagai berikut:</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">| Jenjang Pendidikan | Fase Belajar | Tema Terpilih | Fokus Aksi Nyata Siswa | Bentuk Luaran Akhir Projek |\r\n| :--- | :--- | :--- | :--- | :--- |\r\n| SD (Kelas 4-6) | Fase B &amp; C | Gaya Hidup Berkelanjutan | Pengolahan sisa makanan kantin menjadi kompos cair | Pupuk cair untuk tanaman sekolah |\r\n| SMP (Kelas 7-9) | Fase D | Suara Demokrasi | Simulasi pemilihan ketua OSIS berbasis digital mandiri | Aplikasi pemungutan suara kelas |\r\n| SMA (Kelas 10-12) | Fase E &amp; F | Bangunlah Jiwa dan Raganya | Riset tingkat stres belajar dan posko konseling sebaya | Modul panduan kesehatan mental remaja |\r\n| SMK (Kelas 10-12) | Fase E &amp; F | Kebekerjaan | Pemanfaatan limbah tekstil menjadi barang berdaya jual | Portofolio katalog produk kriya |</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Katalog produk kriya dan aneka karya fisik lainnya dipamerkan secara terbuka saat perayaan akhir semester. Fasilitator mengapresiasi proses penemuan ide hingga penyelesaian masalah yang kamu tempuh bersama rekan tim. Bukan tools curang, tapi teman pintar belajarmu yang membantu mengurai konsep rumit menjadi langkah eksekusi terstruktur. Apa saja persiapan teknis yang perlu kamu tuntaskan sebelum menjalankan projek P5 untuk SMP?</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">Contoh Projek P5 untuk SMP</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Projek P5 untuk SMP dilaksanakan pada Fase D dengan sasaran utama mengasah nalar kritis dan kepedulian sosial siswa. Contoh kegiatan yang paling aplikatif adalah tema Suara Demokrasi melalui penyelenggaraan pemilihan OSIS. Kamu belajar menyusun kriteria calon ketua, menyelenggarakan debat publik, dan merancang sistem pemungutan suara transparan. Aktivitas ini menanamkan kesadaran berdemokrasi yang adil serta menghargai suara mayoritas maupun minoritas. Pengalaman berorganisasi ini memberikan bekal berharga sebelum kamu melanjutkan ke projek P5 untuk SMA/SMK.</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">Contoh Projek P5 untuk SMA/SMK</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Projek P5 untuk SMA/SMK diselenggarakan pada Fase E dan F dengan tingkat kompleksitas riset yang lebih tinggi. Pada jenjang SMA, kamu dapat mengangkat tema Bangunlah Jiwa dan Raganya dengan mengedukasi pencegahan perundungan siber lewat kampanye media sosial. Pada jenjang SMK, tema Kebekerjaan menantang kamu menciptakan produk bernilai jual tinggi yang selaras dengan kebutuhan dunia industri. Kamu menyusun laporan analisis lapangan, menguji efektivitas purwarupa, dan mempresentasikan hasilnya secara profesional. Ketuntasan portofolio projek ini membentuk kedewasaan berpikirmu dalam menyongsong masa depan.</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Masa depan karir dan perjalanan akademikmu terbangun melalui pengalaman memecahkan masalah nyata di P5.</p>\n<h2 class=\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\">Rangkuman Utama Pelaksanaan P5</h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">P5 membuktikan bahwa transformasi pendidikan nasional bertumpu pada penguatan watak dan keterampilan aplikatif siswa. Pertama, enam dimensi profil membekali kamu dengan keseimbangan antara nilai spiritual, kecakapan nalar kritis, dan solidaritas tim. Kedua, tujuh tema resmi menyajikan kurikulum kontekstual yang menghubungkan teori pelajaran dengan masalah nyata di sekitar sekolah. Ketiga, format penilaian kualitatif BB hingga SAB menilai proses bertumbuhmu tanpa rasa takut pada angka KKM. Keempat, variasi projek berjenjang dari SMP hingga SMA melatih portofolio kepemimpinan yang langsung dapat kamu terapkan di dunia industri.</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Industri modern dan perguruan tinggi saat ini memprioritaskan individu yang tangguh bekerja sama dan cakap mengurai masalah. Untuk memperdalam wawasanmu tentang pembaruan kurikulum, pelajari ulasan komparatif mengenai <a href=\"/blog/kurikulum-merdeka/perbedaan-kurikulum-merdeka-dan-k13\">perbedaan Kurikulum Merdeka dan K13</a> serta telusuri artikel penunjang lainnya di kategori <a href=\"/blog/kurikulum-merdeka\">Kurikulum Merdeka</a>. Tetaplah percaya pada proses belajarmu dan manfaatkan <a href=\"/tools/generator-soal\">latihan soal berbasis materi P5</a> sebagai teman pintar belajar yang membimbing caramu berpikir logis agar kamu selalu paham konsepnya.</p></div><section class=\"mt-space-xl p-space-lg md:p-space-xl rounded-xl bg-surface-container-lowest shadow-sm flex flex-col sm:flex-row items-start sm:items-center gap-space-lg border border-slate-100\"><div class=\"w-16 h-16 rounded-full bg-primary-container text-on-primary flex items-center justify-center font-headline-lg text-headline-lg font-bold shrink-0 shadow-md ring-4 ring-primary-fixed\">TM</div><div class=\"flex flex-col gap-1.5 flex-1\"><div class=\"flex flex-wrap items-center gap-2\"><h4 class=\"font-headline-sm text-headline-sm text-on-surface font-bold\">Redaksi TugasMu</h4><span class=\"px-2.5 py-0.5 rounded-full bg-secondary text-on-secondary font-label-sm text-label-sm\">Tim Edukasi</span></div><p class=\"font-body-md text-body-md text-on-surface-variant\">Tim kurator konten yang berdedikasi untuk membagikan tips belajar, pembaruan kurikulum, dan cara cerdas memanfaatkan AI bagi pelajar Indonesia.</p></div></section></article><aside class=\"lg:col-span-4 flex flex-col gap-space-lg lg:sticky lg:top-24\"><div class=\"p-space-lg rounded-xl bg-gradient-to-b from-surface-container to-surface-container-high shadow-sm flex flex-col gap-space-md border border-slate-100\"><div class=\"w-10 h-10 rounded-xl bg-primary-container text-on-primary flex items-center justify-center shadow-xs\"><span class=\"material-symbols-outlined text-[22px]\">auto_awesome</span></div><div><h4 class=\"font-headline-sm text-headline-sm text-on-surface font-bold\">Butuh Bantuan Tugas?</h4><p class=\"font-body-sm text-body-sm text-on-surface-variant mt-1\">Gunakan asisten AI TugasMu secara gratis. Buat soal, parafrase makalah, dan temukan jawaban dari PR-mu.</p></div><a class=\"w-full inline-flex items-center justify-center gap-2 bg-primary-container hover:bg-primary text-on-primary py-2.5 px-4 rounded-xl font-label-md text-label-md transition-all shadow-sm\" href=\"/tools\"><span>Buka Tools AI</span><span class=\"material-symbols-outlined text-[16px]\">arrow_forward</span></a></div></aside></div><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"headline\":\"Projek Penguatan Profil Pelajar Pancasila (P5): Panduan Lengkap\",\"description\":\"\",\"datePublished\":\"2026-09-22T00:00:00.000Z\",\"author\":{\"@type\":\"Organization\",\"name\":\"TugasMu\"}}</script></div></main><footer class=\"bg-slate-50 border-t border-slate-200 py-10 mt-auto\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\"><div class=\"flex flex-col md:flex-row items-center justify-between gap-6\"><div class=\"flex flex-col sm:flex-row items-center gap-3 sm:gap-6 text-center sm:text-left\"><div class=\"flex items-center gap-2\"><div class=\"w-7 h-7 rounded-lg bg-sky-500 flex items-center justify-center text-white\"><svg class=\"w-3.5 h-3.5 fill-white\" viewBox=\"0 0 24 24\"><polygon points=\"13 2 3 14 12 14 11 22 21 10 12 10 13 2\"></polygon></svg></div><span class=\"font-b