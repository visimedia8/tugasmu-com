{"type":"app","meta":{"headers":{"x-next-cache-tags":"_N_T_/layout,_N_T_/blog/layout,_N_T_/blog/[kategori]/layout,_N_T_/blog/[kategori]/[slug]/layout,_N_T_/blog/[kategori]/[slug]/page,_N_T_/blog/kurikulum-merdeka/memahami-sistem-fase-sekolah"}},"html":"<!DOCTYPE html><html lang=\"id\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/css/c70a6d8e0709b465.css\" data-precedence=\"next\"/><link rel=\"stylesheet\" href=\"/_next/static/css/7eb325243a3b1d61.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-37f8c22e297b04f8.js\"/><script src=\"/_next/static/chunks/fd9d1056-2718004965b0207a.js\" async=\"\"></script><script src=\"/_next/static/chunks/2117-c5687b942395652d.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-f30bb01764683cd9.js\" async=\"\"></script><script src=\"/_next/static/chunks/3433-9ddc6f7f78d9421c.js\" async=\"\"></script><script src=\"/_next/static/chunks/2972-8ce94bd856f9372b.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-c819fc26cf8b0e32.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/blog/%5Bkategori%5D/%5Bslug%5D/page-66ee61aaeae9a3c2.js\" async=\"\"></script><link rel=\"preload\" href=\"https://www.googletagmanager.com/gtag/js?id=G-8K10RNGN76\" as=\"script\"/><link rel=\"preload\" href=\"https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXXXXXXXX\" as=\"script\" crossorigin=\"\"/><title>Sistem Fase Kurikulum Merdeka: Dari Fase A hingga F | TugasMu | TugasMu</title><meta property=\"og:title\" content=\"Sistem Fase Kurikulum Merdeka: Dari Fase A hingga F\"/><meta property=\"og:type\" content=\"article\"/><meta property=\"article:published_time\" content=\"Tue Sep 22 2026 08:00:00 GMT+0800 (Central Indonesia Time)\"/><meta name=\"twitter:card\" content=\"summary\"/><meta name=\"twitter:title\" content=\"Sistem Fase Kurikulum Merdeka: Dari Fase A hingga F\"/><link rel=\"icon\" href=\"/favicon.ico\" type=\"image/x-icon\" sizes=\"16x16\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"font-sans bg-brand-cream text-brand-navy flex flex-col min-h-screen __variable_0d7163 __variable_5667dc\"><header class=\"sticky top-0 z-50 w-full\"><div class=\"bg-brand-cream/95 backdrop-blur-md border-b border-brand-navy/10\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between\"><a class=\"flex items-center gap-2.5 group\" href=\"/\"><div class=\"w-8 h-8 rounded-lg bg-brand-navy flex items-center justify-center shadow-sm group-hover:bg-brand-lime transition-colors duration-300\"><svg class=\"w-4 h-4 fill-brand-cream group-hover:fill-brand-navy transition-colors duration-300\" viewBox=\"0 0 24 24\"><polygon points=\"13 2 3 14 12 14 11 22 21 10 12 10 13 2\"></polygon></svg></div><span class=\"font-heading font-bold text-xl text-brand-navy tracking-tight group-hover:text-brand-navy/70 transition-colors\">TugasMu</span></a><nav class=\"hidden md:flex items-center gap-1\"><a class=\"relative px-4 py-2 text-sm font-semibold rounded-full transition-all duration-200 text-brand-navy/70 hover:text-brand-navy hover:bg-brand-navy/5\" href=\"/tools\">AI Tools</a><a class=\"relative px-4 py-2 text-sm font-semibold rounded-full transition-all duration-200 text-brand-navy/70 hover:text-brand-navy hover:bg-brand-navy/5\" href=\"/harga\">Premium</a><a class=\"relative px-4 py-2 text-sm font-semibold rounded-full transition-all duration-200 text-brand-navy bg-brand-lime\" href=\"/blog\">Blog</a></nav><div class=\"hidden md:flex items-center gap-3\"><a class=\"px-5 py-2.5 rounded-full bg-brand-navy hover:bg-brand-navy/90 text-brand-cream font-bold text-sm transition-all shadow-sm hover:shadow-md active:scale-95 flex items-center gap-2\" href=\"/masuk\">Masuk / Daftar</a></div><div class=\"flex md:hidden items-center gap-3\"><button class=\"p-2 rounded-full text-brand-navy hover:bg-brand-navy/5 transition-colors\" aria-label=\"Toggle Menu\"><svg class=\"w-5 h-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\"><line x1=\"3\" y1=\"8\" x2=\"21\" y2=\"8\"></line><line x1=\"3\" y1=\"16\" x2=\"21\" y2=\"16\"></line></svg></button></div></div></div></header><div class=\"bg-slate-50 border-b\"><div class=\"container py-3\"><nav class=\"flex text-sm text-slate-500\" aria-label=\"Breadcrumb\"><ol class=\"inline-flex items-center space-x-1 md:space-x-3\"><li class=\"inline-flex items-center\"><a class=\"hover:text-slate-900 transition-colors\" href=\"/\">Home</a></li><li><div class=\"flex items-center\"><span class=\"mx-2 text-slate-400\">/</span><a class=\"hover:text-slate-900 transition-colors\" href=\"/blog\">Blog</a></div></li><li><div class=\"flex items-center\"><span class=\"mx-2 text-slate-400\">/</span><a class=\"hover:text-slate-900 transition-colors\" href=\"/blog/kurikulum-merdeka\">Kurikulum merdeka</a></div></li><li><div class=\"flex items-center\"><span class=\"mx-2 text-slate-400\">/</span><span class=\"text-slate-900 font-medium\" aria-current=\"page\">Memahami sistem fase sekolah</span></div></li></ol></nav></div></div><main class=\"flex-1\"><div class=\"w-full max-w-[1200px] mx-auto px-margin md:px-margin-desktop py-space-lg md:py-space-xl\"><nav aria-label=\"Breadcrumb\" class=\"flex items-center gap-space-xs text-on-surface-variant font-body-sm text-body-sm mb-space-lg overflow-x-auto whitespace-nowrap scrollbar-none\"><a class=\"hover:text-primary transition-colors flex items-center gap-1\" href=\"/\"><span class=\"material-symbols-outlined text-[16px]\">home</span><span>Home</span></a><span class=\"material-symbols-outlined text-[14px] text-outline\">chevron_right</span><a class=\"hover:text-primary transition-colors\" href=\"/blog\">Blog</a><span class=\"material-symbols-outlined text-[14px] text-outline\">chevron_right</span><a class=\"hover:text-primary transition-colors capitalize\" href=\"/blog/kurikulum-merdeka\">kurikulum merdeka</a><span class=\"material-symbols-outlined text-[14px] text-outline\">chevron_right</span><span class=\"text-primary truncate max-w-[200px] md:max-w-none font-medium\">Sistem Fase Kurikulum Merdeka: Dari Fase A hingga F</span></nav><div class=\"grid grid-cols-1 lg:grid-cols-12 gap-space-xl items-start\"><article class=\"lg:col-span-8 flex flex-col\"><div class=\"flex flex-wrap items-center gap-space-sm mb-space-md\"><span class=\"px-space-md py-1 rounded-xl bg-primary-fixed text-on-primary-fixed font-label-sm text-label-sm tracking-wide uppercase\">kurikulum merdeka</span><span class=\"px-space-md py-1 rounded-xl bg-surface-container text-on-surface-variant font-label-sm text-label-sm flex items-center gap-1\"><span class=\"material-symbols-outlined text-[14px] text-primary\">schedule</span>5 menit baca</span></div><h1 class=\"font-headline-lg text-headline-lg md:text-display-lg text-on-surface tracking-tight mb-space-lg leading-tight\">Sistem Fase Kurikulum Merdeka: Dari Fase A hingga F</h1><div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-space-md p-space-md md:p-space-lg rounded-xl bg-surface-container-low mb-space-xl border border-slate-100\"><div class=\"flex items-center gap-space-md\"><div class=\"w-12 h-12 rounded-full bg-primary-container text-on-primary font-headline-sm text-headline-sm flex items-center justify-center font-bold shadow-sm ring-2 ring-primary-fixed\">TM</div><div><div class=\"flex items-center gap-1.5\"><span class=\"font-label-lg text-label-lg text-on-surface font-bold\">Tim Kurasi TugasMu</span><span class=\"material-symbols-outlined text-primary text-[16px]\" title=\"Terverifikasi\">verified</span></div><p class=\"font-body-sm text-body-sm text-on-surface-variant\">Diterbitkan pada <!-- -->22 September 2026</p></div></div><div class=\"flex items-center gap-2 pt-space-xs sm:pt-0\"><button class=\"inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-surface-container-lowest hover:bg-surface-container text-secondary font-label-md text-label-md transition-all shadow-sm\"><span class=\"material-symbols-outlined text-[18px]\">share</span><span class=\"hidden sm:inline\">Bagikan</span></button></div></div><div class=\"prose-content flex flex-col gap-space-lg text-on-surface font-body-lg text-body-lg leading-relaxed bg-surface-container-lowest p-space-lg md:p-space-xl rounded-xl shadow-sm border border-slate-100\"><h1 class=\"font-headline-lg text-headline-lg text-on-surface tracking-tight mb-space-lg leading-tight\">Sistem Fase Kurikulum Merdeka: Dari Fase A hingga F</h1>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Sistem Fase Kurikulum Merdeka menetapkan pembagian jenjang belajar dari Fase A hingga Fase F berdasarkan tahap perkembangan kognitif siswa untuk menggantikan sekat kenaikan kelas tahunan. Pembagian fase ini memberikan rentang waktu belajar selama dua hingga tiga tahun agar guru mendampingi kamu menuntaskan materi tanpa tekanan kurikulum yang terburu-buru. Pendekatan berbasis capaian ini memastikan setiap siswa memahami konsep dasar secara mendalam sebelum beralih ke jenjang materi berikutnya dalam Sistem Fase Kurikulum Merdeka.</p>\n<h2 class=\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\">Apa Itu Sistem Fase dan Mengapa Berbeda dari Kelas?</h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Sistem Fase Kurikulum Merdeka adalah pendekatan baru dalam pengorganisasian pembelajaran yang mengelompokkan siswa berdasarkan kesiapan kompetensi, bukan semata-mata usia biologis atau angka tingkatan kelas. Langkah pembaruan ini memberi ruang bagi kamu untuk mengatur ritme belajar secara mandiri ketika membedah materi pelajaran menggunakan <a href=\"/tools/rangkuman\">Alat Rangkuman TugasMu</a>. Mengapa fleksibilitas durasi belajar ini menjadi pondasi perubahan kurikulum nasional? Kemendikbudristek merancang fase belajar multi-tahun agar pendidik leluasa menyesuaikan kecepatan mengajar dengan daya serap murid di dalam Sistem Fase Kurikulum Merdeka.</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">Definisi Fase vs Tingkat Kelas di Sistem Lama</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Sistem Fase Kurikulum Merdeka membedakan diri dari format kelas konvensional yang mematok target materi dalam siklus satu tahun ajaran. Satuan pendidikan kini tidak memaksa seluruh murid menuntaskan materi lembar kerja serentak pada akhir semester genap. Perbedaan operasional antara sistem kelas konvensional dan sistem fase mencakup tiga dimensi utama berikut:</p>\n<ul>\n<li>Durasi Belajar: Sistem kelas membatasi penguasaan materi selama satu tahun, sedangkan sistem fase menyediakan rentang waktu dua hingga tiga tahun.</li>\n<li>Orientasi Target: Sistem kelas mengejar penuntasan bab buku pelajaran, sedangkan sistem fase memprioritaskan pemahaman konsep esensial.</li>\n<li>Penanganan Kesulitan: Sistem kelas melabeli murid tertinggal dengan ancaman tinggal kelas, sedangkan sistem fase memberikan bimbingan belajar berkelanjutan.</li>\n</ul>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Berkelanjutan dalam bimbingan belajar berarti guru kelas berikutnya melanjutkan pendampingan materi yang belum kamu pahami tanpa mengulang seluruh mata pelajaran dari awal. Pahami konsepnya dari bagian paling mendasar agar kamu mampu menyelesaikan setiap tugas belajarmu di dalam Sistem Fase Kurikulum Merdeka.</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">Filosofi di Balik Sistem Fase: Belajar Berbasis Capaian</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Sistem Fase Kurikulum Merdeka berpijak pada prinsip pedagogi <em>Teaching at the Right Level</em> yang mengutamakan tingkat kesiapan kognitif siswa daripada target administratif kurikulum. Pendekatan ini memandang bahwa setiap anak mempunyai kecepatan unik saat memahami konsep sains, rumus hitungan, maupun kaidah bahasa. Bagaimana kamu memanfaatkan filosofi belajar mandiri ini saat menyelesaikan tugas sekolah di rumah? Kamu membutuhkan bimbingan AI yang melatih alur berpikir logis, bukan alat penyedia jawaban instan. Bukan tools curang, tapi teman pintar belajarmu yang kami hadirkan melalui TugasMu untuk membimbing setiap langkah penalaran belajarmu. Pahami konsepnya secara runtut agar kamu memiliki fondasi pengetahuan yang kukuh untuk menuntaskan materi pelajaran berikutnya di dalam Sistem Fase Kurikulum Merdeka.</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Sistem Fase Kurikulum Merdeka meletakkan dasar filosofis ini agar guru dan siswa memahami pembagian tingkatan belajar pada Sistem Fase Kurikulum Merdeka.</p>\n<h2 class=\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\">Peta Lengkap 6 Fase dan Jenjang yang Dicakup</h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Sistem Fase Kurikulum Merdeka membagi jenjang pendidikan formal dari tingkat sekolah dasar hingga menengah atas menjadi enam tahapan belajar berkesinambungan. Penetapan fase ini merangkum rentang usia 6 hingga 18 tahun guna menyelaraskan muatan pelajaran dengan tahap kematangan berpikir siswa. Struktur pembagian enam fase pendidikan nasional tertera pada tabel pemetaan berikut:</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">| Nama Fase | Jenjang Sekolah | Tingkatan Kelas | Rentang Usia | Fokus Capaian Pembelajaran |\r\n| :--- | :--- | :--- | :--- | :--- |\r\n| Fase A | SD / MI | Kelas 1 dan 2 | 6 - 8 Tahun | Fondasi literasi huruf dan numerasi hitung dasar |\r\n| Fase B | SD / MI | Kelas 3 dan 4 | 8 - 10 Tahun | Pemahaman teks narasi dan logika matematika terapan |\r\n| Fase C | SD / MI | Kelas 5 dan 6 | 10 - 12 Tahun | Keterampilan bernalar kritis dan pemecahan masalah konkret |\r\n| Fase D | SMP / MTs | Kelas 7, 8, dan 9 | 12 - 15 Tahun | Analisis sains terpadu dan literasi digital kritis |\r\n| Fase E | SMA / SMK / MA | Kelas 10 | 15 - 16 Tahun | Eksplorasi materi umum holistik tanpa penjurusan kelas |\r\n| Fase F | SMA / SMK / MA | Kelas 11 dan 12 | 16 - 18 Tahun | Pendalaman mata pelajaran pilihan untuk persiapan studi lanjut |</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Studi lanjut ke perguruan tinggi menuntut penguasaan kompetensi bertahap yang berakar kuat sejak siswa menempuh pendidikan dasar pada Sistem Fase Kurikulum Merdeka.</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">Fase A, B, C: Untuk Jenjang SD</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Sistem Fase Kurikulum Merdeka pada jenjang dasar mengelompokkan enam tahun masa studi sekolah dasar menjadi tiga fase perkembangan kognitif. Fase A mengasah literasi baca tulis awal dan pengenalan angka bagi siswa kelas 1 dan 2. Fase B membina siswa kelas 3 dan 4 agar mampu menganalisis teks cerita serta operasi perkalian pecahan terapan. Fase C mengantarkan siswa kelas 5 dan 6 menuju penguasaan nalar analitis melalui soal pemecahan masalah nyata. Apakah siswa jenjang dasar harus menghafal banyak teori rumit? Guru tidak membebani murid dengan hafalan teks kaku, melainkan mengajak siswa mengeksplorasi konsep konkret di lingkungan sekitar dalam Sistem Fase Kurikulum Merdeka.</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">Fase D, E, F: Untuk Jenjang SMP dan SMA</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Sistem Fase Kurikulum Merdeka pada jenjang menengah melanjutkan pengembangan kompetensi siswa melalui Fase D, Fase E, dan Fase F. Fase D menyatukan jenjang SMP selama tiga tahun guna mengasah daya kritis dalam menanggapi fenomena alam dan dinamika sosial. Siswa kelas 10 memasuki Fase E di SMA untuk mendalami mata pelajaran umum tanpa penjurusan IPA atau IPS. Masa studi menengah berpuncak pada Fase F untuk kelas 11 dan 12, tempat kamu leluasa menentukan kombinasi mata pelajaran peminatan sesuai arah kariermu. Bagaimana cara kamu memilih mata pelajaran peminatan secara tepat? Guru bimbingan konseling memetakan minat belajarmu sejak Fase E agar pilihan matamu terarah di bawah panduan Sistem Fase Kurikulum Merdeka.</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Sistem Fase Kurikulum Merdeka memetakan enam tahapan jenjang tersebut agar setiap target kompetensi siswa terukur jelas dalam Capaian Pembelajaran dalam Sistem Fase Kurikulum Merdeka.</p>\n<h2 class=\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\">Capaian Pembelajaran (CP): Apa yang Harus Dikuasai per Fase?</h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Capaian Pembelajaran dalam Sistem Fase Kurikulum Merdeka merupakan rumusan kompetensi utama yang memadukan ranah pengetahuan kognitif, keterampilan terapan, dan sikap karakter siswa. Dokumen kurikulum ini menggantikan deretan materi teoritis terpisah yang sebelumnya membebani buku pelajaran sekolah. Pemerintah menetapkan capaian belajar ini sebagai standar acuan akhir yang harus kamu kuasai saat menuntaskan seluruh tingkatan kelas pada fase tertentu. Apa indikator bahwa kamu telah menguasai capaian tersebut? Pendidik menilai kompetensimu melalui tugas portofolio, asesmen formatif berkala, dan proyek pemecahan masalah konkret di dalam target Capaian Pembelajaran dalam Sistem Fase Kurikulum Merdeka.</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">CP Berbeda dari KD (Kompetensi Dasar) K13</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Capaian Pembelajaran dalam Sistem Fase Kurikulum Merdeka menghadirkan paradigma baru yang berbeda dari format Kompetensi Dasar pada kurikulum terdahulu. Format Kompetensi Dasar memilah kompetensi ke dalam butir angka terpisah antara teori pengetahuan dan keterampilan praktik. Capaian Pembelajaran mengintegrasikan penguasaan teori dengan kecakapan aksi nyata ke dalam satu narasi deskriptif utuh. Tiga perbedaan mendasar antara kedua acuan kurikulum ini terlihat jelas pada perbandingan berikut:</p>\n<ul>\n<li>Format Penulisan: Kompetensi Dasar berupa daftar butir terpisah per nomor urut, sedangkan Capaian Pembelajaran berupa narasi terintegrasi.</li>\n<li>Masa Berlaku Target: Kompetensi Dasar membatasi ketuntasan belajar tahunan, sedangkan Capaian Pembelajaran berdurasi dua hingga tiga tahun fase.</li>\n<li>Dimensi Penilaian: Kompetensi Dasar memisahkan skor teori dan skor praktik, sedangkan Capaian Pembelajaran menilai penguasaan kompetensi holistik.</li>\n</ul>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Holistik dalam penilaian hasil belajar memastikan bahwa guru tidak sekadar menguji daya ingat teks hafalan ujian. Kamu dilatih berpikir mandiri saat mengurai materi tugas yang membutuhkan nalar analitis di rumah. Bagaimana kamu melatih pemahaman materi pelajaran secara mendalam di luar jam sekolah? Kamu dapat menggunakan bimbingan AI untuk menguji alur berpikir logismu agar selaras dengan target Capaian Pembelajaran dalam Sistem Fase Kurikulum Merdeka.</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">Cara Membaca CP di Rapor Kamu</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Capaian Pembelajaran dalam Sistem Fase Kurikulum Merdeka tertera jelas pada lembar deskripsi rapor semester yang kamu terima dari sekolah. Rapor kurikulum baru tidak hanya menyajikan deretan angka tunggal tanpa penjelasan makna nilai belajarmu. Guru merumuskan narasi kualitatif yang menerangkan materi yang telah kamu kuasai serta aspek keterampilan yang memerlukan pendampingan lebih lanjut. Mengapa penjelasan narasi rapor ini bermanfaat bagi belajarmu? Penjelasan deskriptif membantumu mengenali kekuatan nalar sekaligus bagian materi yang perlu kamu latih kembali. Pahami konsepnya dari akar masalah agar tugas belajarmu pada semester berikutnya membuahkan hasil memuaskan di dalam Sistem Fase Kurikulum Merdeka.</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Sistem Fase Kurikulum Merdeka menghubungkan evaluasi capaian rapor ini dengan penetapan mekanisme kenaikan kelas pada Sistem Fase Kurikulum Merdeka.</p>\n<h2 class=\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\">Dampak Sistem Fase terhadap Kenaikan Kelas dan Kelulusan</h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Sistem Fase Kurikulum Merdeka memengaruhi mekanisme kenaikan kelas dan kelulusan dengan mengutamakan perlindungan psikologis serta hak belajar setiap siswa. Satuan pendidikan meniadakan batasan Kriteria Ketuntasan Minimal (KKM) kaku yang kerap memicu beban stres berlebihan pada murid. Pendidik menilai kelayakan promosi kelas secara komprehensif melalui portofolio karya harian dan asesmen sumatif di akhir semester. Apakah murid yang mengalami kesulitan belajar tetap dapat naik ke tingkatan kelas berikutnya? Pendidik tetap menaikkan siswa bersangkutan ke tingkatan kelas selanjutnya dengan catatan pendampingan khusus pada materi pelajaran yang belum tuntas di bawah naungan Sistem Fase Kurikulum Merdeka.</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">Status Kenaikan Kelas Tanpa Tinggal Kelas</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Sistem Fase Kurikulum Merdeka menegaskan bahwa keputusan tinggal kelas merupakan pilihan darurat terakhir yang sedapat mungkin dihindari oleh pihak sekolah. Riset pendidikan global membuktikan bahwa menahan siswa di kelas yang sama tidak terbukti mendongkrak prestasi belajar anak. Siswa kelas 1 yang belum lancar membaca tetap naik ke kelas 2 karena keduanya berada dalam satu naungan Fase A yang sama. Guru kelas 2 bertanggung jawab melanjutkan bimbingan kompetensi yang belum selesai tanpa menahan anak di kelas sebelumnya. Mekanisme pendampingan kenaikan kelas lintas fase mencakup tiga langkah konkret berikut:</p>\n<ul>\n<li>Remediasi Terarah: Pendidik menyusun latihan mandiri bertahap untuk menuntaskan konsep dasar yang belum tuntas di kelas sebelumnya.</li>\n<li>Pengajaran Berdiferensiasi: Guru membagi kelompok belajar berdasarkan kesiapan nalar murid agar siswa berkecepatan lambat memperoleh bimbingan lebih intensif.</li>\n<li>Kolaborasi Orang Tua: Pihak sekolah mengomunikasikan rekam jejak siswa kepada keluarga guna menyelaraskan pendampingan belajar di rumah.</li>\n</ul>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Rumah menjadi ruang pendukung terbaik bagimu untuk mengejar ketertinggalan materi pelajaran tanpa kecemasan akademik. Bukan tools curang, tapi teman pintar belajarmu yang senantiasa menemanimu memahami langkah demi langkah penyelesaian soal menantang. Bagaimana cara membagi waktu belajar agar tugas sekolah baru tidak terbengkalai? Alokasikan waktu 25 menit secara teratur setiap hari untuk mengulang materi lama hingga nalar analisismu terbangun kukuh di dalam Sistem Fase Kurikulum Merdeka.</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">Standar Kelulusan Berdasarkan Fase</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Sistem Fase Kurikulum Merdeka memusatkan penentuan kelulusan pada ketercapaian kompetensi di akhir fase terminal pendidikan. Garis evaluasi kelulusan sekolah berlangsung pada akhir Fase C untuk SD, akhir Fase D untuk SMP, serta akhir Fase F untuk SMA. Satuan pendidikan menetapkan kelulusan siswa melalui musyawarah dewan guru dengan mempertimbangkan nilai asesmen sekolah, portofolio karya, dan kepribadian profil pelajar Pancasila. Apakah siswa yang lulus harus mengikuti ujian nasional terpusat dari pemerintah? Pemerintah meniadakan ujian nasional dan memberi wewenang penuh bagi sekolah untuk menyelenggarakan asesmen sumatif akhir secara mandiri. Disiplin belajarmu sepanjang fase menentukan keberhasilan kelulusan sekolah dalam Sistem Fase Kurikulum Merdeka.</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Sistem Fase Kurikulum Merdeka membuktikan pembaruan pendidikan yang berpusat pada perkembangan siswa di dalam Sistem Fase Kurikulum Merdeka.</p>\n<h2 class=\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\">Ringkasan Capaian Belajar dalam Sistem Fase Kurikulum Merdeka</h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Sistem Fase Kurikulum Merdeka merangkum arah baru pendidikan nasional melalui empat prinsip utama berikut:</p>\n<ul>\n<li>Fleksibilitas Waktu: Pengelompokan fase menyediakan rentang waktu belajar dua hingga tiga tahun agar penyerapan materi berjalan tuntas tanpa beban kalender tahunan.</li>\n<li>Kontinuitas Jenjang: Pemetaan Fase A sampai F menyelaraskan perkembangan nalar siswa dari jenjang sekolah dasar hingga menengah atas secara berkesinambungan.</li>\n<li>Keutuhan Standar: Capaian Pembelajaran memadukan teori dan keterampilan ke dalam evaluasi deskriptif pada rapor sekolah.</li>\n<li>Promosi Berkeadilan: Mekanisme kenaikan kelas meniadakan vonis tinggal kelas dengan memprioritaskan bimbingan remediasi bagi setiap siswa.</li>\n</ul>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Siswa yang ingin memahami teknis penghitungan nilai rapor deskriptif dapat membaca panduan lengkap <a href=\"/blog/kurikulum-merdeka/cara-menghitung-nilai-rapor\">cara menghitung nilai rapor</a> untuk memantau perkembangan kompetensi akademis. Kamu juga dapat menelusuri ragam kebijakan kurikulum terbaru lainnya melalui pusat artikel <a href=\"/blog/kurikulum-merdeka\">Kurikulum Merdeka</a>. Jangan biarkan materi pelajaran yang padat membuatmu cemas saat menghadapi tahun ajaran baru. Manfaatkan <a href=\"/tools/rangkuman\">Alat Rangkuman TugasMu</a> untuk menyarikan materi pelajaran panjang menjadi intisari ringkas yang mudah dipahami, sehingga kamu selalu percaya diri menuntaskan setiap fase belajarmu.</p></div><section class=\"mt-space-xl p-space-lg md:p-space-xl rounded-xl bg-surface-container-lowest shadow-sm flex flex-col sm:flex-row items-start sm:items-center gap-space-lg border border-slate-100\"><div class=\"w-16 h-16 rounded-full bg-primary-container text-on-primary flex items-center justify-center font-headline-lg text-headline-lg font-bold shrink-0 shadow-md ring-4 ring-primary-fixed\">TM</div><div class=\"flex flex-col gap-1.5 flex-1\"><div class=\"flex flex-wrap items-center gap-2\"><h4 class=\"font-headline-sm text-headline-sm text-on-surface font-bold\">Redaksi TugasMu</h4><span class=\"px-2.5 py-0.5 rounded-full bg-secondary text-on-secondary font-label-sm text-label-sm\">Tim Edukasi</span></div><p class=\"font-body-md text-body-md text-on-surface-variant\">Tim kurator konten yang berdedikasi untuk membagikan tips belajar, pembaruan kurikulum, dan cara cerdas memanfaatkan AI bagi pelajar Indonesia.</p></div></section></article><aside class=\"lg:col-span-4 flex flex-col gap-space-lg lg:sticky lg:top-24\"><div class=\"p-space-lg rounded-xl bg-gradient-to-b from-surface-container to-surface-container-high shadow-sm flex flex-col gap-space-md border border-slate-100\"><div class=\"w-10 h-10 rounded-xl bg-primary-container text-on-primary flex items-center justify-center shadow-xs\"><span class=\"material-symbols-outlined text-[22px]\">auto_awesome</span></div><div><h4 class=\"font-headline-sm text-headline-sm text-on-surface font-bold\">Butuh Bantuan Tugas?</h4><p class=\"font-body-sm text-body-sm text-on-surface-variant mt-1\">Gunakan asisten AI TugasMu secara gratis. Buat soal, parafrase makalah, dan temukan jawaban dari PR-mu.</p></div><a class=\"w-full inline-flex items-center justify-center gap-2 bg-primary-container hover:bg-primary text-on-primary py-2.5 px-4 rounded-xl font-label-md text-label-md transition-all shadow-sm\" href=\"/tools\"><span>Buka Tools AI</span><span class=\"material-symbols-outlined text-[16px]\">arrow_forward</span></a></div></aside></div><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"headline\":\"Sistem Fase Kurikulum Merdeka: Dari Fase A hingga F\",\"description\":\"\",\"datePublished\":\"2026-09-22T00:00:00.000Z\",\"author\":{\"@type\":\"Organization\",\"name\":\"TugasMu\"}}</script></div></main><footer class=\"bg-slate-50 border-t border-slate-200 py-10 mt-auto\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\"><div class=\"flex flex-col md:flex-row items-center justify-between gap-6\"><div class=\"flex flex-col sm:flex-row items-center gap-3 sm:gap-6 text-center sm:text-left\"><div class=\"flex items-center gap-2\"><div class=\"w-7 h-7 rounded-lg bg-sky-500 flex items-center justify-center text-white\"><svg class=\"w-3.5 h-3.5 fill-white\" viewBox=\"0 0 24 24\"><polygon points=\"13 2 3 14 12 14 11 22 21 10 12 10 13 2\"></polygon></svg></div><span class=\"font-bold text-slate-900 text-base font-heading\">TugasMu.com</span></div><span class=\"text-xs sm:text-sm text-slate-500\">© 2026 TugasMu.com. Hak cipta dilindungi.</s