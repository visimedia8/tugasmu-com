{"type":"app","meta":{"headers":{"x-next-cache-tags":"_N_T_/layout,_N_T_/blog/layout,_N_T_/blog/[kategori]/layout,_N_T_/blog/[kategori]/[slug]/layout,_N_T_/blog/[kategori]/[slug]/page,_N_T_/blog/kurikulum-merdeka/cara-menghitung-nilai-rapor"}},"html":"<!DOCTYPE html><html lang=\"id\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/css/c70a6d8e0709b465.css\" data-precedence=\"next\"/><link rel=\"stylesheet\" href=\"/_next/static/css/7eb325243a3b1d61.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-37f8c22e297b04f8.js\"/><script src=\"/_next/static/chunks/fd9d1056-2718004965b0207a.js\" async=\"\"></script><script src=\"/_next/static/chunks/2117-c5687b942395652d.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-f30bb01764683cd9.js\" async=\"\"></script><script src=\"/_next/static/chunks/3433-9ddc6f7f78d9421c.js\" async=\"\"></script><script src=\"/_next/static/chunks/2972-8ce94bd856f9372b.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-c819fc26cf8b0e32.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/blog/%5Bkategori%5D/%5Bslug%5D/page-66ee61aaeae9a3c2.js\" async=\"\"></script><link rel=\"preload\" href=\"https://www.googletagmanager.com/gtag/js?id=G-8K10RNGN76\" as=\"script\"/><link rel=\"preload\" href=\"https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXXXXXXXX\" as=\"script\" crossorigin=\"\"/><title>Cara Menghitung Nilai Rapor Kurikulum Merdeka | TugasMu | TugasMu</title><meta property=\"og:title\" content=\"Cara Menghitung Nilai Rapor Kurikulum Merdeka\"/><meta property=\"og:type\" content=\"article\"/><meta property=\"article:published_time\" content=\"Tue Sep 22 2026 08:00:00 GMT+0800 (Central Indonesia Time)\"/><meta name=\"twitter:card\" content=\"summary\"/><meta name=\"twitter:title\" content=\"Cara Menghitung Nilai Rapor Kurikulum Merdeka\"/><link rel=\"icon\" href=\"/favicon.ico\" type=\"image/x-icon\" sizes=\"16x16\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"font-sans bg-brand-cream text-brand-navy flex flex-col min-h-screen __variable_0d7163 __variable_5667dc\"><header class=\"sticky top-0 z-50 w-full\"><div class=\"bg-brand-cream/95 backdrop-blur-md border-b border-brand-navy/10\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between\"><a class=\"flex items-center gap-2.5 group\" href=\"/\"><div class=\"w-8 h-8 rounded-lg bg-brand-navy flex items-center justify-center shadow-sm group-hover:bg-brand-lime transition-colors duration-300\"><svg class=\"w-4 h-4 fill-brand-cream group-hover:fill-brand-navy transition-colors duration-300\" viewBox=\"0 0 24 24\"><polygon points=\"13 2 3 14 12 14 11 22 21 10 12 10 13 2\"></polygon></svg></div><span class=\"font-heading font-bold text-xl text-brand-navy tracking-tight group-hover:text-brand-navy/70 transition-colors\">TugasMu</span></a><nav class=\"hidden md:flex items-center gap-1\"><a class=\"relative px-4 py-2 text-sm font-semibold rounded-full transition-all duration-200 text-brand-navy/70 hover:text-brand-navy hover:bg-brand-navy/5\" href=\"/tools\">AI Tools</a><a class=\"relative px-4 py-2 text-sm font-semibold rounded-full transition-all duration-200 text-brand-navy/70 hover:text-brand-navy hover:bg-brand-navy/5\" href=\"/harga\">Premium</a><a class=\"relative px-4 py-2 text-sm font-semibold rounded-full transition-all duration-200 text-brand-navy bg-brand-lime\" href=\"/blog\">Blog</a></nav><div class=\"hidden md:flex items-center gap-3\"><a class=\"px-5 py-2.5 rounded-full bg-brand-navy hover:bg-brand-navy/90 text-brand-cream font-bold text-sm transition-all shadow-sm hover:shadow-md active:scale-95 flex items-center gap-2\" href=\"/masuk\">Masuk / Daftar</a></div><div class=\"flex md:hidden items-center gap-3\"><button class=\"p-2 rounded-full text-brand-navy hover:bg-brand-navy/5 transition-colors\" aria-label=\"Toggle Menu\"><svg class=\"w-5 h-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\"><line x1=\"3\" y1=\"8\" x2=\"21\" y2=\"8\"></line><line x1=\"3\" y1=\"16\" x2=\"21\" y2=\"16\"></line></svg></button></div></div></div></header><div class=\"bg-slate-50 border-b\"><div class=\"container py-3\"><nav class=\"flex text-sm text-slate-500\" aria-label=\"Breadcrumb\"><ol class=\"inline-flex items-center space-x-1 md:space-x-3\"><li class=\"inline-flex items-center\"><a class=\"hover:text-slate-900 transition-colors\" href=\"/\">Home</a></li><li><div class=\"flex items-center\"><span class=\"mx-2 text-slate-400\">/</span><a class=\"hover:text-slate-900 transition-colors\" href=\"/blog\">Blog</a></div></li><li><div class=\"flex items-center\"><span class=\"mx-2 text-slate-400\">/</span><a class=\"hover:text-slate-900 transition-colors\" href=\"/blog/kurikulum-merdeka\">Kurikulum merdeka</a></div></li><li><div class=\"flex items-center\"><span class=\"mx-2 text-slate-400\">/</span><span class=\"text-slate-900 font-medium\" aria-current=\"page\">Cara menghitung nilai rapor</span></div></li></ol></nav></div></div><main class=\"flex-1\"><div class=\"w-full max-w-[1200px] mx-auto px-margin md:px-margin-desktop py-space-lg md:py-space-xl\"><nav aria-label=\"Breadcrumb\" class=\"flex items-center gap-space-xs text-on-surface-variant font-body-sm text-body-sm mb-space-lg overflow-x-auto whitespace-nowrap scrollbar-none\"><a class=\"hover:text-primary transition-colors flex items-center gap-1\" href=\"/\"><span class=\"material-symbols-outlined text-[16px]\">home</span><span>Home</span></a><span class=\"material-symbols-outlined text-[14px] text-outline\">chevron_right</span><a class=\"hover:text-primary transition-colors\" href=\"/blog\">Blog</a><span class=\"material-symbols-outlined text-[14px] text-outline\">chevron_right</span><a class=\"hover:text-primary transition-colors capitalize\" href=\"/blog/kurikulum-merdeka\">kurikulum merdeka</a><span class=\"material-symbols-outlined text-[14px] text-outline\">chevron_right</span><span class=\"text-primary truncate max-w-[200px] md:max-w-none font-medium\">Cara Menghitung Nilai Rapor Kurikulum Merdeka</span></nav><div class=\"grid grid-cols-1 lg:grid-cols-12 gap-space-xl items-start\"><article class=\"lg:col-span-8 flex flex-col\"><div class=\"flex flex-wrap items-center gap-space-sm mb-space-md\"><span class=\"px-space-md py-1 rounded-xl bg-primary-fixed text-on-primary-fixed font-label-sm text-label-sm tracking-wide uppercase\">kurikulum merdeka</span><span class=\"px-space-md py-1 rounded-xl bg-surface-container text-on-surface-variant font-label-sm text-label-sm flex items-center gap-1\"><span class=\"material-symbols-outlined text-[14px] text-primary\">schedule</span>5 menit baca</span></div><h1 class=\"font-headline-lg text-headline-lg md:text-display-lg text-on-surface tracking-tight mb-space-lg leading-tight\">Cara Menghitung Nilai Rapor Kurikulum Merdeka</h1><div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-space-md p-space-md md:p-space-lg rounded-xl bg-surface-container-low mb-space-xl border border-slate-100\"><div class=\"flex items-center gap-space-md\"><div class=\"w-12 h-12 rounded-full bg-primary-container text-on-primary font-headline-sm text-headline-sm flex items-center justify-center font-bold shadow-sm ring-2 ring-primary-fixed\">TM</div><div><div class=\"flex items-center gap-1.5\"><span class=\"font-label-lg text-label-lg text-on-surface font-bold\">Tim Kurasi TugasMu</span><span class=\"material-symbols-outlined text-primary text-[16px]\" title=\"Terverifikasi\">verified</span></div><p class=\"font-body-sm text-body-sm text-on-surface-variant\">Diterbitkan pada <!-- -->22 September 2026</p></div></div><div class=\"flex items-center gap-2 pt-space-xs sm:pt-0\"><button class=\"inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-surface-container-lowest hover:bg-surface-container text-secondary font-label-md text-label-md transition-all shadow-sm\"><span class=\"material-symbols-outlined text-[18px]\">share</span><span class=\"hidden sm:inline\">Bagikan</span></button></div></div><div class=\"prose-content flex flex-col gap-space-lg text-on-surface font-body-lg text-body-lg leading-relaxed bg-surface-container-lowest p-space-lg md:p-space-xl rounded-xl shadow-sm border border-slate-100\"><h1 class=\"font-headline-lg text-headline-lg text-on-surface tracking-tight mb-space-lg leading-tight\">Cara Menghitung Nilai Rapor Kurikulum Merdeka</h1>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Nilai Rapor Kurikulum Merdeka mencerminkan pencapaian kompetensi siswa melalui akumulasi asesmen sumatif materi dan evaluasi akhir semester tanpa patokan KKM numerik. Sistem penilaian pada <a href=\"/blog/kurikulum-merdeka\">panduan Kurikulum Merdeka</a> ini mengedepankan perkembangan belajar berkala serta pembentukan karakter Profil Pelajar Pancasila. Kamu dapat mengatur strategi belajarmu secara terarah demi mengoptimalkan seluruh capaian Nilai Rapor Kurikulum Merdeka.</p>\n<h2 class=\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\">Komponen Nilai Rapor Kurikulum Merdeka</h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Nilai Rapor Kurikulum Merdeka terdiri dari dua komponen utama yang menentukan nilai akhir semestermu, yaitu asesmen formatif dan asesmen sumatif. Guru memanfaatkan asesmen formatif untuk memantau kemajuan belajarmu saat pembelajaran aktif berlangsung, sedangkan nilai rapor murni ditarik dari hasil asesmen sumatif. Kamu bisa memanfaatkan <a href=\"/tools/rangkuman\">Alat Rangkuman TugasMu</a> untuk meringkas materi sebelum sumatif agar kamu menguasai setiap tujuan pembelajaran tanpa panik. Bagaimana sekolah membedakan fungsi kedua instrumen asesmen ini dalam Komponen Nilai Rapor Kurikulum Merdeka?</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">Nilai Sumatif dan Formatif: Perbedaannya</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Komponen Nilai Rapor Kurikulum Merdeka membedakan peran asesmen formatif dan sumatif secara tegas dalam proses evaluasi. Asesmen formatif bertindak sebagai alat pantau perkembangan harian tanpa menyumbang angka numerik pada lembar rapor final. Guru memakai kuis singkat, diskusi kelas, dan lembar kerja mandiri untuk memeriksa pemahaman konsepmu. Asesmen sumatif menguji penguasaan materi secara resmi untuk menghasilkan nilai rapor kuantitatif.</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Kuantitatif atau tidaknya hasil asesmen ditentukan oleh karakteristik fungsi masing-masing pengujian sebagai berikut:</p>\n<ul>\n<li>Asesmen formatif mendeteksi kelemahan belajar harian siswa tanpa memengaruhi nilai angka di rapor.</li>\n<li>Asesmen sumatif lingkup materi mengukur pencapaian tujuan pembelajaran per bab dan menyumbang nilai kuantitatif rapor.</li>\n<li>Asesmen sumatif akhir semester menguji seluruh materi semester untuk mengonfirmasi ketahanan daya ingat konseptual.</li>\n</ul>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Konseptual dan berbobot menjadi ciri utama nilai sumatif lingkup materi yang dihimpun guru setelah kamu menyelesaikan setiap bab pelajaran. Guru mengolah nilai ulangan bab ini secara bertahap sepanjang semester aktif berlangsung. Kamu dapat mengecek materi mana yang membutuhkan pengulangan sebelum ujian semester tiba. Bagaimana ketentuan pembagian porsi kedua jenis sumatif ini dalam Nilai Rapor Kurikulum Merdeka?</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">Bobot Nilai Sumatif Akhir Semester</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Nilai Rapor Kurikulum Merdeka menempatkan asesmen sumatif akhir semester sebagai pelengkap ulangan bab, bukan penentu tunggal kelulusan. Satuan pendidikan menetapkan persentase bobot sumatif lingkup materi dan sumatif akhir semester secara mandiri. Sebagian besar sekolah memilih rasio 60 persen untuk rata-rata sumatif lingkup materi dan 40 persen untuk sumatif akhir semester. Skema pembobotan ini memberi porsi lebih besar pada kedisiplinan belajar harianmu daripada satu kali ujian semester. Nilai yang stabil sepanjang bab menjamin perolehan skor akhir yang aman.</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Aman dari risiko penurunan nilai dapat kamu capai jika kamu tidak mengabaikan persiapan ujian akhir semester. Apabila sekolahmu tidak mengadakan ujian akhir semester, guru menghitung seratus persen nilai rapor dari rata-rata sumatif lingkup materi. TugasMu sebagai teman pintar belajar mengajakmu memahami konsepnya secara menyeluruh agar nilai ujianmu konsisten. Pemahaman yang kuat menjaga kestabilan Nilai Rapor Kurikulum Merdeka.</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Nilai Rapor Kurikulum Merdeka menghargai konsistensi belajar harian sebelum guru mengolah seluruh angka asesmen menggunakan formula Nilai Rapor Kurikulum Merdeka.</p>\n<h2 class=\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\">Cara Menghitung Nilai Akhir Mapel</h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Nilai Rapor Kurikulum Merdeka dihitung dengan formula gabungan antara nilai rata-rata sumatif lingkup materi dan nilai sumatif akhir semester. Guru mengalikan masing-masing komponen dengan bobot persentase sekolah untuk menghasilkan skor akhir berskala 0 sampai 100. Pahami konsepnya bahwa nilai rapor akhirmu mencerminkan akumulasi kerja kerasmu di setiap bab pelajaran. Bagaimana langkah teknis menghitung nilai tersebut pada lembar kerja Nilai Rapor Kurikulum Merdeka?</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">Rumus Dasar Penghitungan Nilai</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Nilai Rapor Kurikulum Merdeka menggunakan formula agregasi nilai sumatif materi dan sumatif akhir semester sesuai petunjuk operasional asesmen kementerian. Perhitungan nilai akhir mata pelajaran menggabungkan komponen ulangan bab dan ujian akhir semester secara matematis.</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Matematis dan terstandar, rumus perhitungan nilai akhir mata pelajaran dirumuskan sebagai berikut:</p>\n<pre><code>Nilai Akhir = (Bobot Rata-rata SLM x Rata-rata SLM) + (Bobot SAS x Nilai SAS)\n</code></pre>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Empat variabel operasional yang membangun rumus perhitungan tersebut meliputi:</p>\n<ul>\n<li>SLM (Sumatif Lingkup Materi) adalah skor ulangan harian atau tugas per bab pokok bahasan.</li>\n<li>Rata-rata SLM dihitung dari total skor seluruh bab dibagi total bab yang dipelajari pada semester aktif.</li>\n<li>SAS (Sumatif Akhir Semester) adalah skor ujian evaluasi terpadu pada akhir kalender semester.</li>\n<li>Bobot SLM dan SAS dinyatakan dalam pecahan desimal dengan total akumulasi 100 persen.</li>\n</ul>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Persen pembobotan 60 persen SLM dan 40 persen SAS merupakan rasio paling umum di berbagai sekolah. Guru memasukkan data nilai tersebut ke dalam aplikasi rapor untuk menentukan predikat dan narasi capaian belajarmu. Simulasi hitungan konkret memudahkanmu memahami pergerakan angka pada lembar Nilai Rapor Kurikulum Merdeka.</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">Contoh Hitungan Nyata (Matematika Kelas 10)</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Nilai Rapor Kurikulum Merdeka pada mata pelajaran Matematika kelas 10 dapat kamu simulasikan dengan data angka nyata. Misalnya, kamu menyelesaikan empat kali Sumatif Lingkup Materi (SLM) dengan skor 80, 75, 85, dan 80, serta meraih skor 85 pada Sumatif Akhir Semester (SAS). Sekolahmu menetapkan aturan bobot 60 persen untuk rata-rata SLM dan 40 persen untuk SAS.</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">SAS dan rata-rata ulangan harian bab diolah oleh guru ke dalam tabel rekapitulasi nilai akhir mata pelajaran Matematika berikut:</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">| Komponen Asesmen | Materi Pokok | Nilai Siswa | Bobot | Kontribusi Skor |\r\n| :--- | :--- | :--- | :--- | :--- |\r\n| SLM 1 | Eksponen dan Logaritma | 80 | - | - |\r\n| SLM 2 | Barisan dan Deret | 75 | - | - |\r\n| SLM 3 | Vektor dan Geometri | 85 | - | - |\r\n| SLM 4 | Trigonometri Dasar | 80 | - | - |\r\n| <strong>Rata-rata SLM</strong> | <strong>(80 + 75 + 85 + 80) : 4</strong> | <strong>80</strong> | <strong>60% (0,6)</strong> | <strong>48,0</strong> |\r\n| <strong>SAS</strong> | <strong>Ujian Akhir Semester</strong> | <strong>85</strong> | <strong>40% (0,4)</strong> | <strong>34,0</strong> |\r\n| <strong>Nilai Akhir Rapor</strong> | <strong>Skor Agregasi (48,0 + 34,0)</strong> | <strong>82</strong> | <strong>100%</strong> | <strong>82,0</strong> |</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">82,0 menjadi nilai akhir Matematika pada rapormu berkat konsistensi nilai harian bab. Jika skor SAS kamu turun ke angka 70, nilai akhirmu masih bertahan pada angka 76 karena tertolong rata-rata harian yang kuat. Bimbingan AI di TugasMu membantu kamu menganalisis kelemahan konsep materi sebelum ujian tiba agar nilaimu tetap stabil. Penilaian angka mata pelajaran ini berjalan beriringan dengan pemantauan karakter Profil Pelajar Pancasila.</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Pancasila menjadi landasan evaluasi karakter yang membedakan nilai angka mata pelajaran dari lembar penilaian sikap pada Nilai P5 di rapor Kurikulum Merdeka.</p>\n<h2 class=\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\">Nilai P5 di Rapor: Cara Membacanya</h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Nilai P5 di rapor Kurikulum Merdeka berbeda format secara mendasar jika dibandingkan dengan rapor mata pelajaran akademik. Rapor Projek Penguatan Profil Pelajar Pancasila tidak menggunakan nilai angka numerik, melainkan menyajikan predikat capaian deskriptif. Guru menilai keaktifanmu dalam bergotong royong, bernalar kritis, dan berkreasi menyelesaikan masalah nyata di sekolah. Lembar rapor projek diterbitkan satu kali setahun pada akhir semester genap. Bagaimana cara memahami makna predikat huruf pada lembar Nilai P5 di rapor Kurikulum Merdeka?</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">Arti BB, MB, BSH, SAB di Rapor P5</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Nilai P5 di rapor Kurikulum Merdeka memakai empat kategori predikat perkembangan karakter untuk mencatat partisipasi belajarmu sepanjang projek. Empat tingkatan predikat capaian dalam rapor projek penguatan profil pelajar pancasila dirinci sebagai berikut:</p>\n<ul>\n<li>BB (Belum Berkembang) berarti siswa memerlukan bimbingan rutin dari guru untuk memulai tindakan projek.</li>\n<li>MB (Mulai Berkembang) berarti siswa mulai menunjukkan keterlibatan aktif meskipun belum konsisten.</li>\n<li>BSH (Berkembang Sesuai Harapan) berarti siswa telah mencapai target fase perkembangan karakter secara mandiri.</li>\n<li>SAB (Sangat Berkembang) berarti siswa melampaui target fase dan mampu menjadi teladan bagi rekan kelompoknya.</li>\n</ul>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Kelompoknya dan guru pembimbing menjadi pendukung utama dalam mendorong peningkatan predikatmu menuju BSH. Target minimal kelulusan fase yang diharapkan oleh satuan pendidikan adalah predikat Berkembang Sesuai Harapan. TugasMu menekankan bahwa proses kerja sama dan penalaran kritis jauh lebih penting daripada hasil fisik projek. Apakah predikat kualitatif ini menentukan status kelanjutan studimu menurut Nilai P5 di rapor Kurikulum Merdeka?</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">Pengaruh Nilai P5 terhadap Kenaikan Kelas</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Nilai P5 di rapor Kurikulum Merdeka menjadi salah satu bahan pertimbangan rapat pleno dewan guru dalam menentukan kenaikan kelas siswa. Partisipasi aktif dalam kegiatan projek merupakan kewajiban kokurikuler yang harus kamu penuhi setiap tahun ajaran. Siswa yang memperoleh predikat Belum Berkembang (BB) tidak otomatis tinggal kelas, melainkan mendapat bimbingan remedial portofolio dari guru fasilitator sebelum keputusan akhir ditetapkan.</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Ditetapkan atau tidaknya kenaikan kelasmu bergantung pada ketuntasan revisi portofolio karya projek yang belum selesai. Pahami konsepnya bahwa rapor P5 berfungsi mendidik karakter sosial siswa, bukan menjadi vonis kegagalan belajar. Sikap tanggung jawab dan kepedulian di lingkungan sekolah sudah cukup untuk membawamu meraih predikat BSH. Keseimbangan nilai akademik dan karakter sosial melengkapi pemahaman atas Nilai Rapor Kurikulum Merdeka.</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Nilai Rapor Kurikulum Merdeka memadukan asesmen sikap dan angka akademis, namun perubahan mekanisme ini sering memicu kekeliruan mengenai Nilai Rapor Kurikulum Merdeka.</p>\n<h2 class=\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\">Kesalahan Umum Siswa dalam Memahami Rapor Baru</h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Nilai Rapor Kurikulum Merdeka sering disalahpahami karena menghapus kriteria ketuntasan minimal numerik yang selama ini menjadi patokan kelulusan. Banyak siswa beranggapan ketiadaan KKM berarti tidak ada lagi standar kompetensi yang mengikat kelulusan kelas. Asumsi keliru ini memicu rasa malas belajar harian dan kebiasaan menunda penyelesaian tugas modul. Kurikulum Merdeka mengganti KKM dengan instrumen Kriteria Ketercapaian Tujuan Pembelajaran (KKTP) yang jauh lebih terukur. Mengapa salah paham ketiadaan KKM ini merugikan posisimu dalam Nilai Rapor Kurikulum Merdeka?</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">Salah Paham: Tidak Ada KKM = Nilai Tidak Penting</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Nilai Rapor Kurikulum Merdeka sering dianggap bebas beban karena ketiadaan KKM nasional, padahal instrumen KKTP menuntut penguasaan materi secara nyata. KKTP menggunakan deskripsi indikator pencapaian konkret untuk memastikan siswa benar-benar memahami materi yang diajarkan. Jika kamu belum memenuhi target indikator materi bab, guru akan memberikan bimbingan remedial sampai kamu tuntas menguasainya. Semester aktif sering diwarnai oleh kekeliruan umum siswa dalam menyikapi ketiadaan batas KKM numerik sebagai berikut:</p>\n<ul>\n<li>Menganggap remeh tugas mingguan karena berkeyakinan bahwa seluruh siswa pasti naik kelas.</li>\n<li>Mengabaikan persiapan ulangan bab dan hanya mengandalkan nilai tes akhir semester.</li>\n<li>Mengira angka nilai rapor berdiri sendiri tanpa catatan deskripsi capaian pembelajaran guru.</li>\n</ul>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Guru mencatat setiap kelemahan dan kekuatan kompetensimu secara transparan di dalam lembar rapor. TugasMu bukan tools curang, tapi teman pintar belajarmu yang membantumu menguasai setiap indikator materi yang terasa sulit. Kamu dapat mendiskusikan catatan evaluasi guru untuk menyusun rencana belajar yang lebih efektif. Bagaimana cara membaca catatan narasi tersebut pada lembaran Nilai Rapor Kurikulum Merdeka?</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">Cara Membaca Capaian Pembelajaran (CP) di Rapor</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Nilai Rapor Kurikulum Merdeka menyajikan narasi Capaian Pembelajaran yang menerangkan kompetensi nyata milikmu pada setiap mata pelajaran. Tepat di samping nilai angka akhir, guru menuliskan dua jenis kalimat deskripsi capaian. Kalimat pertama memaparkan kompetensi tertinggi yang berhasil kamu kuasai dengan sangat baik. Kalimat kedua menjelaskan materi yang masih memerlukan bimbingan tambahan agar pemahamanmu semakin kuat. Kuat dan jelasnya arah evaluasi belajar siswa terlihat dari fungsi utama narasi capaian pembelajaran pada rapor sebagai berikut:</p>\n<ul>\n<li>Menyediakan umpan balik spesifik bagi siswa mengenai materi yang sudah dikuasai dan materi yang perlu penguatan.</li>\n<li>Memberikan panduan praktis bagi orang tua dalam mendampingi fokus belajar anak di rumah.</li>\n<li>Membantu guru di kelas berikutnya untuk menyesuaikan tingkat kesulitan materi pengajaran.</li>\n</ul>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Pengajaran di kelas lanjutan akan berjalan lebih mudah jika kamu mempelajari ulang bab yang masih diberi catatan bimbingan oleh guru. Bimbingan AI di TugasMu siap membantumu memahami materi sulit secara terarah agar nilai rapormu terus meningkat. Belajarmu kini fokus pada kemajuan diri sendiri, bukan sekadar membandingkan nilai rapormu dengan teman lain. Pemahaman ini mengantarkanmu pada kesimpulan akhir mengenai Nilai Rapor Kurikulum Merdeka.</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Nilai Rapor Kurikulum Merdeka menuntut kesadaran belajar mandiri atas angka ujian dan deskripsi capaian sebelum meninjau ringkasan akhir pada Rangkuman Nilai Rapor Kurikulum Merdeka.</p>\n<h2 class=\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\">Rangkuman Nilai Rapor Kurikulum Merdeka</h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Nilai Rapor Kurikulum Merdeka menggabungkan evaluasi angka mata pelajaran dan deskripsi karakter projek untuk mencerminkan perkembangan belajar siswa secara nyata. Komponen nilai intrakurikuler bersumber dari asesmen sumatif lingkup materi dan sumatif akhir semester tanpa memasukkan nilai asesmen formatif. Formula perhitungan nilai akhir mata pelajaran menerapkan pembobotan proporsional yang umumnya memakai rasio 60 persen nilai ulangan bab dan 40 persen ujian akhir semester. Evaluasi karakter P5 dilaporkan secara terpisah memakai predikat kualitatif BB, MB, BSH, dan SAB sesuai <a href=\"/blog/kurikulum-merdeka/pengertian-p5-dan-contoh-projek\">pengertian P5</a>. Batas kelulusan KKM resmi digantikan oleh kriteria ketercapaian tujuan pembelajaran berbasis narasi yang memetakan kompetensi spesifik siswa.</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Siswa dapat mempelajari regulasi asesmen lainnya melalui artikel panduan pada rubrik <a href=\"/blog/kurikulum-merdeka\">Kurikulum Merdeka</a> untuk memperkaya strategi belajar. Jangan biarkan tugas sekolah menumpuk atau materi ujian membuatmu tertekan menjelang pekan asesmen sumatif. Manfaatkan <a href=\"/tools/rangkuman\">Alat Rangkuman TugasMu</a> untuk meringkas materi sebelum sumatif agar kamu dapat memahami konsep intinya dengan tenang dan meraih nilai rapor impianmu!</p></div><section class=\"mt-space-xl p-space-lg md:p-space-xl rounded-xl bg-surface-container-lowest shadow-sm flex flex-col sm:flex-row items-start sm:items-center gap-space-lg border border-slate-100\"><div class=\"w-16 h-16 rounded-full bg-primary-container text-on-primary flex items-center justify-center font-headline-lg text-headline-lg font-bold shrink-0 shadow-md ring-4 ring-primary-fixed\">TM</div><div class=\"flex flex-col gap-1.5 flex-1\"><div class=\"flex flex-wrap items-center gap-2\"><h4 class=\"font-headline-sm text-headline-sm text-on-surface font-bold\">Redaksi TugasMu</h4><span class=\"px-2.5 py-0.5 rounded-full bg-secondary text-on-secondary font-label-sm text-label-sm\">Tim Edukasi</span></div><p class=\"font-body-md text-body-md text-on-surface-variant\">Tim kurator konten yang berdedikasi untuk membagikan tips belajar, pembaruan kurikulum, dan cara cerdas memanfaatkan AI bagi pelajar Indonesia.</p></div></section></article><aside class=\"lg:col-span-4 flex flex-col gap-space-lg lg:sticky lg:top-24\"><div class=\"p-space-lg rounded-xl bg-gradient-to-b from-surface-container to-surface-container-high shadow-sm flex flex-col gap-space-md border border-slate-100\"><div class=\"w-10 h-10 rounded-xl bg-primary-container text-on-primary flex items-center justify-center shadow-xs\"><span class=\"material-symbols-outlined text-[22px]\">auto_awesome</span></div><div><h4 class=\"font-headline-sm text-headline-sm text-on-surface font-bold\">Butuh Bantuan Tugas?</h4><p class=\"font-body-sm text-body-sm text-on-surface-variant mt-1\">Gunakan asisten AI TugasMu secara gratis. Buat soal, parafrase makalah, dan temukan jawaban dari PR-mu.</p></div><a class=\"w-full inline-flex items-center justify-center gap-2 bg-primary-container hover:bg-primary text-on-primary py-2.5 px-4 rounded-xl font-label-md text-label-md transition-all shadow-sm\" href=\"/tools\"><span>Buka Tools AI</span><span class=\"material-symbols-outlined text-[16px]\">arrow_forward</span></a></div></aside></div><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"headline\":\"Cara Menghitung Nilai Rapor Kurikulum Merdeka\",\"description\":\"\",\"datePublished\":\"2026-09-22T00:00:00.000Z\",\"author\":{\"@type\":\"Organization\",\"name\":\"TugasMu\"}}</script></div></main><footer class=\"bg-slate-50 border-t border-slate-200 py-10 mt-auto\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\"><div class=\"flex flex-col md:flex-row items-center justify-between gap-6\"><div class=\"flex flex-col sm:flex-row items-center gap-3 sm:gap-6 text-center sm:text-left\"><div class=\"flex items-center gap-2\"><div class=\"w-7 h-7 rounded-lg bg-sky-500 flex items-center justify-center text-white\"><svg class=\"w-3.5 h-3.5 fill-white\" viewBox=\"0 0 24 24\"><polygon points=\"13 2 3 14 12 14 11 22 21 10 12 10 13 2\"></polygon></svg></div><span class=\"font-bold text-slate-900 text-base font-heading\">TugasMu.com</span></div><span class=\"text-xs sm:text-sm text-slate-500\">© 2026 TugasMu.com. Hak cipta dilindungi.</span></div><div class=\"flex flex-wrap justify-center items-center gap-x-6 gap-y-3 text-xs sm:text-sm font-medium text-slate-500\"><a class=\"hover:text-slate-900 transition-colors\" href=\"/\">Beranda</a><a class=\"hover:text-slate-900 transition-colors\" href=\"/harga\">Premium</a><a class=\"hover:text-slate-900 transition-colors\" href=\"/blog\">Blog</a><a class=\"hover:text-slate-900 transition-colors\" href=\"/privasi\">Privacy Policy</a><a class=\"hover:text-slate-900 transition-colors\" href=\"/syarat\">Terms of Service</a><a class=\"hover:text-slate-900 transition-colors\" href=\"/kontak\">Kontak</a></div></div></div></footer><script src=\"/_next/static/chunks/webpack-37f8c22e297b04f8.js\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0]);self.__next_f.push([2,null])</script><script>self.__next_f.push([1,\"1:HL[\\\"/_next/static/css/c70a6d8e0709b465.css\\\",\\\"style\\\"]\\n2:HL[\\\"/_next/static/css/7eb325243a3b1d61.css\\\",\\\"style\\\"]\\n\"])</script><script>self.__next_f.push([1,\"3:I[2846,[],\\\"\\\"]\\n6:I[4707,[],\\\"\\\"]\\n9:I[6423,[],\\\"\\\"]\\na:I[8003,[\\\"3433\\\",\\\"static/chunks/3433-9ddc6f7f78d9421c.js\\\",\\\"2972\\\",\\\"static/chunks/2972-8ce94bd856f9372b.js\\\",\\\"3185\\\",\\\"static/chunks/app/layout-c819fc26cf8b0e32.js\\\"],\\\"\\\"]\\nb:I[9314,[\\\"3433\\\",\\\"static/chunks/3433-9ddc6f7f78d9421c.js\\\",\\\"2972\\\",\\\"static/chunks/2972-8ce94bd856f9372b.js\\\",\\\"3185\\\",\\\"static/chunks/app/layout-c819fc26cf8b0e32.js\\\"],\\\"default\\\"]\\nc:I[6454,[\\\"3433\\\",\\\"static/chunks/3433-9ddc6f7f78d9421c.js\\\",\\\"2972\\\",\\\"static/chunks/2972-8ce94bd856f9372b.js\\\",\\\"3185\\\",\\\"static/chunks/app/layout-c819fc26cf8b0e32.js\\\"],\\\"Navbar\\\"]\\nd:I[482,[\\\"3433\\\",\\\"static/chunks/3433-9ddc6f7f78d9421c.js\\\",\\\"2972\\\",\\\"static/chunks/2972-8ce94bd856f9372b.js\\\",\\\"3185\\\",\\\"static/chunks/app/layout-c819fc26cf8b0e32.js\\\"],\\\"default\\\"]\\ne:I[2972,[\\\"2972\\\",\\\"static/chunks/2972-8ce94bd856f9372b.js\\\",\\\"9064\\\",\\\"static/chunks/app/blog/%5Bkategori%5D/%5Bslug%5D/page-66ee61aaeae9a3c2.js\\\"],\\\"\\\"]\\n10:I[1060,[],\\\"\\\"]\\n7:[\\\"kategori\\\",\\\"kurikulum-merdeka\\\",\\\"d\\\"]\\n8:[\\\"slug\\\",\\\"cara-menghitung-nilai-rapor\\\",\\\"d\\\"]\\n11:[]\\n\"])</script><script>self.__next_f.push([1,\"0:[\\\"$\\\",\\\"$L3\\\",null,{\\\"buildId\\\":\\\"nUO3BwVmV7Cq5JEgg6Nsr\\\",\\\"assetPrefix\\\":\\\"\\\",\\\"urlParts\\\":[\\\"\\\",\\\"blog\\\",\\\"kurikulum-merdeka\\\",\\\"cara-menghitung-nilai-rapor\\\"],\\\"initialTree\\\":[\\\"\\\",{\\\"children\\\":[\\\"blog\\\",{\\\"children\\\":[[\\\"katego