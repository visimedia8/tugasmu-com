{"type":"app","meta":{"headers":{"x-next-cache-tags":"_N_T_/layout,_N_T_/blog/layout,_N_T_/blog/[kategori]/layout,_N_T_/blog/[kategori]/[slug]/layout,_N_T_/blog/[kategori]/[slug]/page,_N_T_/blog/kurikulum-merdeka/mata-pelajaran-pilihan-sma"}},"html":"<!DOCTYPE html><html lang=\"id\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/css/c70a6d8e0709b465.css\" data-precedence=\"next\"/><link rel=\"stylesheet\" href=\"/_next/static/css/7eb325243a3b1d61.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-37f8c22e297b04f8.js\"/><script src=\"/_next/static/chunks/fd9d1056-2718004965b0207a.js\" async=\"\"></script><script src=\"/_next/static/chunks/2117-c5687b942395652d.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-f30bb01764683cd9.js\" async=\"\"></script><script src=\"/_next/static/chunks/3433-9ddc6f7f78d9421c.js\" async=\"\"></script><script src=\"/_next/static/chunks/2972-8ce94bd856f9372b.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-c819fc26cf8b0e32.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/blog/%5Bkategori%5D/%5Bslug%5D/page-66ee61aaeae9a3c2.js\" async=\"\"></script><link rel=\"preload\" href=\"https://www.googletagmanager.com/gtag/js?id=G-8K10RNGN76\" as=\"script\"/><link rel=\"preload\" href=\"https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXXXXXXXX\" as=\"script\" crossorigin=\"\"/><title>Mata Pelajaran SMA Kurikulum Merdeka: Wajib dan Pilihan | TugasMu | TugasMu</title><meta property=\"og:title\" content=\"Mata Pelajaran SMA Kurikulum Merdeka: Wajib dan Pilihan\"/><meta property=\"og:type\" content=\"article\"/><meta property=\"article:published_time\" content=\"Tue Sep 22 2026 08:00:00 GMT+0800 (Central Indonesia Time)\"/><meta name=\"twitter:card\" content=\"summary\"/><meta name=\"twitter:title\" content=\"Mata Pelajaran SMA Kurikulum Merdeka: Wajib dan Pilihan\"/><link rel=\"icon\" href=\"/favicon.ico\" type=\"image/x-icon\" sizes=\"16x16\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"font-sans bg-brand-cream text-brand-navy flex flex-col min-h-screen __variable_0d7163 __variable_5667dc\"><header class=\"sticky top-0 z-50 w-full\"><div class=\"bg-brand-cream/95 backdrop-blur-md border-b border-brand-navy/10\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between\"><a class=\"flex items-center gap-2.5 group\" href=\"/\"><div class=\"w-8 h-8 rounded-lg bg-brand-navy flex items-center justify-center shadow-sm group-hover:bg-brand-lime transition-colors duration-300\"><svg class=\"w-4 h-4 fill-brand-cream group-hover:fill-brand-navy transition-colors duration-300\" viewBox=\"0 0 24 24\"><polygon points=\"13 2 3 14 12 14 11 22 21 10 12 10 13 2\"></polygon></svg></div><span class=\"font-heading font-bold text-xl text-brand-navy tracking-tight group-hover:text-brand-navy/70 transition-colors\">TugasMu</span></a><nav class=\"hidden md:flex items-center gap-1\"><a class=\"relative px-4 py-2 text-sm font-semibold rounded-full transition-all duration-200 text-brand-navy/70 hover:text-brand-navy hover:bg-brand-navy/5\" href=\"/tools\">AI Tools</a><a class=\"relative px-4 py-2 text-sm font-semibold rounded-full transition-all duration-200 text-brand-navy/70 hover:text-brand-navy hover:bg-brand-navy/5\" href=\"/harga\">Premium</a><a class=\"relative px-4 py-2 text-sm font-semibold rounded-full transition-all duration-200 text-brand-navy bg-brand-lime\" href=\"/blog\">Blog</a></nav><div class=\"hidden md:flex items-center gap-3\"><a class=\"px-5 py-2.5 rounded-full bg-brand-navy hover:bg-brand-navy/90 text-brand-cream font-bold text-sm transition-all shadow-sm hover:shadow-md active:scale-95 flex items-center gap-2\" href=\"/masuk\">Masuk / Daftar</a></div><div class=\"flex md:hidden items-center gap-3\"><button class=\"p-2 rounded-full text-brand-navy hover:bg-brand-navy/5 transition-colors\" aria-label=\"Toggle Menu\"><svg class=\"w-5 h-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\"><line x1=\"3\" y1=\"8\" x2=\"21\" y2=\"8\"></line><line x1=\"3\" y1=\"16\" x2=\"21\" y2=\"16\"></line></svg></button></div></div></div></header><div class=\"bg-slate-50 border-b\"><div class=\"container py-3\"><nav class=\"flex text-sm text-slate-500\" aria-label=\"Breadcrumb\"><ol class=\"inline-flex items-center space-x-1 md:space-x-3\"><li class=\"inline-flex items-center\"><a class=\"hover:text-slate-900 transition-colors\" href=\"/\">Home</a></li><li><div class=\"flex items-center\"><span class=\"mx-2 text-slate-400\">/</span><a class=\"hover:text-slate-900 transition-colors\" href=\"/blog\">Blog</a></div></li><li><div class=\"flex items-center\"><span class=\"mx-2 text-slate-400\">/</span><a class=\"hover:text-slate-900 transition-colors\" href=\"/blog/kurikulum-merdeka\">Kurikulum merdeka</a></div></li><li><div class=\"flex items-center\"><span class=\"mx-2 text-slate-400\">/</span><span class=\"text-slate-900 font-medium\" aria-current=\"page\">Mata pelajaran pilihan sma</span></div></li></ol></nav></div></div><main class=\"flex-1\"><div class=\"w-full max-w-[1200px] mx-auto px-margin md:px-margin-desktop py-space-lg md:py-space-xl\"><nav aria-label=\"Breadcrumb\" class=\"flex items-center gap-space-xs text-on-surface-variant font-body-sm text-body-sm mb-space-lg overflow-x-auto whitespace-nowrap scrollbar-none\"><a class=\"hover:text-primary transition-colors flex items-center gap-1\" href=\"/\"><span class=\"material-symbols-outlined text-[16px]\">home</span><span>Home</span></a><span class=\"material-symbols-outlined text-[14px] text-outline\">chevron_right</span><a class=\"hover:text-primary transition-colors\" href=\"/blog\">Blog</a><span class=\"material-symbols-outlined text-[14px] text-outline\">chevron_right</span><a class=\"hover:text-primary transition-colors capitalize\" href=\"/blog/kurikulum-merdeka\">kurikulum merdeka</a><span class=\"material-symbols-outlined text-[14px] text-outline\">chevron_right</span><span class=\"text-primary truncate max-w-[200px] md:max-w-none font-medium\">Mata Pelajaran SMA Kurikulum Merdeka: Wajib dan Pilihan</span></nav><div class=\"grid grid-cols-1 lg:grid-cols-12 gap-space-xl items-start\"><article class=\"lg:col-span-8 flex flex-col\"><div class=\"flex flex-wrap items-center gap-space-sm mb-space-md\"><span class=\"px-space-md py-1 rounded-xl bg-primary-fixed text-on-primary-fixed font-label-sm text-label-sm tracking-wide uppercase\">kurikulum merdeka</span><span class=\"px-space-md py-1 rounded-xl bg-surface-container text-on-surface-variant font-label-sm text-label-sm flex items-center gap-1\"><span class=\"material-symbols-outlined text-[14px] text-primary\">schedule</span>5 menit baca</span></div><h1 class=\"font-headline-lg text-headline-lg md:text-display-lg text-on-surface tracking-tight mb-space-lg leading-tight\">Mata Pelajaran SMA Kurikulum Merdeka: Wajib dan Pilihan</h1><div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-space-md p-space-md md:p-space-lg rounded-xl bg-surface-container-low mb-space-xl border border-slate-100\"><div class=\"flex items-center gap-space-md\"><div class=\"w-12 h-12 rounded-full bg-primary-container text-on-primary font-headline-sm text-headline-sm flex items-center justify-center font-bold shadow-sm ring-2 ring-primary-fixed\">TM</div><div><div class=\"flex items-center gap-1.5\"><span class=\"font-label-lg text-label-lg text-on-surface font-bold\">Tim Kurasi TugasMu</span><span class=\"material-symbols-outlined text-primary text-[16px]\" title=\"Terverifikasi\">verified</span></div><p class=\"font-body-sm text-body-sm text-on-surface-variant\">Diterbitkan pada <!-- -->22 September 2026</p></div></div><div class=\"flex items-center gap-2 pt-space-xs sm:pt-0\"><button class=\"inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-surface-container-lowest hover:bg-surface-container text-secondary font-label-md text-label-md transition-all shadow-sm\"><span class=\"material-symbols-outlined text-[18px]\">share</span><span class=\"hidden sm:inline\">Bagikan</span></button></div></div><div class=\"prose-content flex flex-col gap-space-lg text-on-surface font-body-lg text-body-lg leading-relaxed bg-surface-container-lowest p-space-lg md:p-space-xl rounded-xl shadow-sm border border-slate-100\"><h1 class=\"font-headline-lg text-headline-lg text-on-surface tracking-tight mb-space-lg leading-tight\">Mata Pelajaran SMA Kurikulum Merdeka: Wajib dan Pilihan</h1>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Mata Pelajaran SMA Kurikulum Merdeka mengelompokkan struktur belajar siswa ke dalam kelompok umum wajib, pilihan peminatan, serta projek kokurikuler terintegrasi. Sistem Fase E dan Fase F ini memberi fleksibilitas penuh bagimu merancang kombinasi bidang studi tanpa sekat jurusan kaku. Perencanaan kombinasi bidang studi sejak awal memperbesar peluang kelulusanmu pada program studi perguruan tinggi impian lewat penguasaan kompetensi Mata Pelajaran SMA Kurikulum Merdeka.</p>\n<h2 class=\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\">Daftar Mata Pelajaran Wajib SMA Kurikulum Merdeka</h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Mata Pelajaran SMA Kurikulum Merdeka dibagi menjadi dua kelompok utama, yaitu kelompok mata pelajaran umum wajib dan kelompok mata pelajaran pilihan sesuai minat bakatmu. Siswa menempuh kelompok umum untuk membangun kompetensi literasi, numerasi, dan karakter kebangsaan. Kamu dapat menguji pemahaman konsep setiap bidang studi melalui <a href=\"/tools/generator-soal\">latihan soal per mata pelajaran dengan Generator Soal TugasMu</a> agar nilai rapor semestermu tetap konsisten unggul. Konsistensi nilai akademik ini ditentukan langsung oleh ketuntasanmu menyelesaikan target capaian mata pelajaran wajib SMA Kurikulum Merdeka.</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">Kelompok Umum: Mapel yang Harus Diambil Semua Siswa</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Mata pelajaran wajib SMA Kurikulum Merdeka pada kelompok umum mencakup delapan disiplin ilmu pokok yang wajib dipelajari seluruh siswa kelas 10 hingga 12. Regulasi pemerintah mengatur jam belajar mingguan guna menjamin penguasaan fondasi berpikir kritis siswa. Rincian beban belajar kelompok umum diatur secara nasional dengan alokasi jam pelajaran sebagai berikut:</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">| Kelompok Mapel Umum | Alokasi Fase E (Kelas 10) | Alokasi Fase F (Kelas 11-12) | Total per Tahun |\r\n| :--- | :--- | :--- | :--- |\r\n| Agama &amp; Pancasila | 5 JP (4 Tatap Muka + 1 P5) | 5 JP (4 Tatap Muka + 1 P5) | 180 JP |\r\n| Bahasa Indonesia &amp; Matematika | 8 JP (6 Tatap Muka + 2 P5) | 8 JP (6 Tatap Muka + 2 P5) | 288 JP |\r\n| Bahasa Inggris &amp; PJOK | 5 JP (3.5 Tatap Muka + 1.5 P5) | 5 JP (3.5 Tatap Muka + 1.5 P5) | 180 JP |\r\n| Sejarah &amp; Seni Budaya | 4 JP (3 Tatap Muka + 1 P5) | 4 JP (3 Tatap Muka + 1 P5) | 144 JP |\r\n| IPA &amp; IPS Terpadu | 14 JP (Fasilitasi Eksplorasi) | Dialihkan ke Mapel Pilihan | 504 JP |</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Data alokasi waktu tersebut membuktikan fokus kurikulum pada penguatan kompetensi esensial daripada hafalan materi pada Mata Pelajaran SMA Kurikulum Merdeka.</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">Beban Jam Belajar vs K13: Komparasi Alokasi Waktu</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Mata Pelajaran SMA Kurikulum Merdeka sering kali dinilai memiliki beban belajar yang jauh lebih ringan jika dibandingkan dengan Kurikulum 2013. Total beban belajar tahunan sesungguhnya berkisar 42 hingga 44 JP per minggu, setara dengan era K13. Perbedaan mendasar terletak pada porsi tatap muka reguler yang dialihkan 20 hingga 30 persen untuk pembelajaran berbasis projek. Bagaimana alokasi waktu tersebut memengaruhi ritme belajarmu? Jam belajar di kelas terasa lebih fleksibel karena guru mengutamakan asesmen diagnostik untuk memperkokoh fondasi akademik mata pelajaran umum.</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Mata pelajaran umum yang tuntas dipelajari memberikan bekal kompetensi esensial bagi setiap siswa sebelum menentukan kombinasi Mata Pelajaran pilihan di SMA Kurikulum Merdeka.</p>\n<h2 class=\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\">Mata Pelajaran Pilihan: Cara Memilih yang Tepat</h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Mata Pelajaran pilihan di SMA Kurikulum Merdeka memberikan fleksibilitas bagi siswa kelas 11 dan 12 Fase F untuk menentukan 4 hingga 5 mata pelajaran yang relevan dengan rencana masa depan. Skema ini resmi menghapus penjurusan kaku demi membuka kebebasan eksplorasi minat siswa SMA di Indonesia. Kamu sekarang leluasa meracik kombinasi mata pelajaran lintas disiplin ilmu, seperti memadukan Fisika dengan Ekonomi. Fleksibilitas ini menuntut perencanaan terarah bersama pihak sekolah dalam menentukan kelompok mata pelajaran pilihan.</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">Kelompok Pilihan: Klasifikasi IPA, IPS, Bahasa, dan Vokasi</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Kelompok mata pelajaran pilihan di SMA Kurikulum Merdeka diklasifikasikan ke dalam empat rumpun keilmuan utama. Rumpun MIPA mencakup Matematika Tingkat Lanjut, Fisika, Kimia, Biologi, dan Informatika. Rumpun IPS menyediakan Sosiologi, Ekonomi, Geografi, serta Antropologi. Rumpun Bahasa menawarkan Bahasa Indonesia Tingkat Lanjut, Bahasa Inggris Tingkat Lanjut, dan bahasa asing, sedangkan rumpun Vokasi menghadirkan keterampilan terapan praktis. Keberhasilan memilih kombinasi rumpun ini diawali dengan memastikan kesesuaian target prodi pada Mata Pelajaran pilihan di kelas 11.</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">Tips Memilih Mapel Pilihan Sesuai Jurusan Kuliah Target</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Mata Pelajaran pilihan di kelas 11 harus kamu sesuaikan dengan jurusan kuliah target sebagai penentu utama kelulusan seleksi perguruan tinggi. Kementerian Pendidikan menetapkan daftar mata pelajaran pendukung prodi sebagai komponen utama jalur SNBP. Calon mahasiswa Kedokteran wajib memperkuat Biologi dan Kimia, sedangkan calon mahasiswa Teknik membutuhkan Fisika serta Matematika Tingkat Lanjut. Tahapan terencana yang perlu kamu terapkan saat memilih mata pelajaran pilihan di sekolah adalah:</p>\n<ul>\n<li><strong>Periksa Regulasi Mapel Pendukung</strong>: Cocokkan prodi target dengan daftar resmi kementerian agar rapormu berbobot maksimal saat seleksi SNBP.</li>\n<li><strong>Konsultasikan Hasil Minat Bakat</strong>: Diskusikan hasil asesmen dengan guru BK untuk memetakan kapasitas belajarmu secara objektif.</li>\n<li><strong>Pahami Konsepnya Bukan Sekadar Menghafal Jawaban</strong>: Pelajari materi bersama teman pintar belajar agar logika berpikirmu terbentuk kuat.</li>\n<li><strong>Hindari Ikut-Ikutan Teman</strong>: Tentukan pilihan berdasarkan cita-cita pribadimu guna menghindari salah jurusan saat menempuh perkuliahan.</li>\n</ul>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Perkuliahan masa depan membutuhkan kematangan karakter dan kecakapan kolaboratif yang diasah secara terstruktur melalui Mata Pelajaran kokurikuler P5 di SMA Kurikulum Merdeka.</p>\n<h2 class=\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\">Proyek Penguatan Profil Pelajar Pancasila (P5) sebagai Mapel Kokurikuler</h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Mata Pelajaran kokurikuler P5 di SMA Kurikulum Merdeka merupakan kegiatan pembelajaran berbasis projek yang dirancang khusus untuk menguatkan pencapaian kompetensi Profil Pelajar Pancasila. Skema P5 berdiri mandiri dan terpisah dari capaian intrakurikuler kelas reguler. Kamu bersama tim belajar ditantang menyelesaikan isu nyata di lingkungan sekitar, mulai dari perubahan iklim hingga kewirausahaan sosial. Enam dimensi utama yang dibangun melalui kegiatan kokurikuler ini membekali siswa dengan karakter tangguh selama pelaksanaan kegiatan P5.</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">P5 Berbeda dari Mapel Biasa: Tidak Ada Ujian Tertulis</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">P5 di SMA Kurikulum Merdeka dinilai tanpa menggunakan instrumen ujian tertulis seperti tes pilihan ganda atau ulangan akhir semester. Guru fasilitator memantau perkembangan kompetensimu melalui lembar observasi perilaku, jurnal refleksi, serta portofolio karya kelompok. Hasil evaluasi dituangkan dalam dokumen Rapor Projek terpisah menggunakan predikat deskriptif capaian bertahap. Sistem evaluasi kualitatif ini memotivasimu berfokus pada aksi nyata tanpa terbebani persaingan angka ujian demi keberhasilan pelaksanaan kegiatan P5 di SMA Kurikulum Merdeka.</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">Porsi P5 dalam Beban Belajar Total</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">P5 di SMA Kurikulum Merdeka mengalokasikan porsi waktu 20 hingga 30 persen dari total jam pelajaran tahunan sekolah. Siswa kelas 10 menempuh beban P5 sebesar 486 JP per tahun, sedangkan siswa kelas 11 dan 12 menyelesaikan 432 JP per tahun. Bagaimana sekolah mengatur alokasi waktu ini secara efektif? Satuan pendidikan dapat memilih salah satu dari tiga skema implementasi jadwal P5 sebagai berikut:</p>\n<ul>\n<li><strong>Sistem Jam Berkala</strong>: Menjadwalkan P5 sebanyak 1 hingga 2 JP pada akhir hari tertentu mingguan reguler.</li>\n<li><strong>Sistem Hari Khusus</strong>: Mengalokasikan satu hari penuh setiap pekan khusus untuk aktivitas projek tanpa adanya kelas biasa.</li>\n<li><strong>Sistem Blok Waktu</strong>: Memusatkan tatap muka kelas reguler selama 2 hingga 3 pekan demi pengerjaan projek tuntas.</li>\n</ul>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Penetapan model jadwal yang adaptif ini menjamin kelancaran aktivitas projek karakter pada setiap satuan pendidikan menengah.</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Satuan pendidikan menengah memberikan ruang eksplorasi karakter yang berbeda tergantung jalur pendidikan yang kamu pilih pada Mata Pelajaran di SMA dan SMK Kurikulum Merdeka.</p>\n<h2 class=\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\">Perbandingan Pilihan Mapel SMA vs SMK di Kurikulum Merdeka</h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Mata Pelajaran di SMA dan SMK Kurikulum Merdeka memiliki perbedaan signifikan pada orientasi kompetensi lulusan dan struktur penjurusan. Jalur SMA memfokuskan kurikulum pada teori akademik umum guna mempermudah transisi ke jenjang perguruan tinggi. Jalur SMK menitikberatkan porsi belajar pada keahlian vokasi teknis, praktik bengkel industri, dan sertifikasi kerja. Matriks komparasi kurikulum berikut menyajikan perbedaan struktural mata pelajaran antara jenjang SMA dan SMK:</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">| Dimensi Komparasi | SMA Kurikulum Merdeka | SMK Kurikulum Merdeka |\r\n| :--- | :--- | :--- |\r\n| <strong>Fokus Belajar</strong> | Teori konseptual akademik | Kejuruan praktis industri |\r\n| <strong>Mapel Pilihan</strong> | 4-5 mapel lintas rumpun ilmu | Konsentrasi keahlian vokasi |\r\n| <strong>Mapel Wajib</strong> | Literasi dan numerasi umum | Muatan umum plus dasar kejuruan |\r\n| <strong>Alokasi P5</strong> | 20-30% total JP isu sosial | Sekitar 30% total JP tema kerja |\r\n| <strong>Praktik Lapangan</strong> | Tanpa kewajiban magang industri | Wajib PKL industri minimal 6 bulan |\r\n| <strong>Arah Kelulusan</strong> | Studi sarjana akademik (S1) | Bekerja langsung atau kuliah terapan |</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Keputusan memilih antara kedua jalur pendidikan menengah ini harus kamu dasarkan pada minat profesi serta keunggulan akademik Mata Pelajaran SMA Kurikulum Merdeka.</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">Keunggulan Jalur SMA untuk Persiapan UTBK</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Mata Pelajaran SMA Kurikulum Merdeka memberikan keuntungan kompetitif untuk persiapan UTBK berkat kedalaman materi ujian seleksi nasional. Struktur mata pelajaran pilihan seperti Matematika Tingkat Lanjut, Fisika, Kimia, Biologi, dan Ekonomi beririsan langsung dengan materi Tes Skolastik serta Literasi SNBT. Siswa SMA terbiasa memecahkan penalaran kuantitatif tingkat tinggi selama belajar di Fase F. Kamu dapat memanfaatkan bimbingan AI untuk membantu mendalami logika soal tanpa merasa tertinggal dari rekan sekelas. Keunggulan teori akademik ini berbeda dengan orientasi kerja lulusan pada Mata Pelajaran SMK Kurikulum Merdeka.</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">Keunggulan Jalur SMK untuk Karir Langsung</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Mata Pelajaran SMK Kurikulum Merdeka menempatkan karir langsung sebagai prioritas utama bagi siswa jalur vokasi. Peserta didik SMK menghabiskan porsi waktu signifikan di bengkel praktik serta berkesempatan meraih sertifikasi dari Badan Nasional Sertifikasi Profesi (BNSP). Program Praktik Kerja Lapangan selama minimal satu semester membekali siswa dengan etos kerja profesional nyata. Lulusan SMK tetap berhak mendaftar UTBK-SNBT apabila berkeinginan melanjutkan pendidikan tinggi. Kesesuaian antara minat kerja dan bakat akademik menjadi penentu utama jalur pendidikan yang kamu pilih.</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Jalur pendidikan yang kamu pilih menentukan fokus pengembangan diri harianmu dalam menuntaskan target belajar Mata Pelajaran SMA Kurikulum Merdeka.</p>\n<h2 class=\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\">Intisari Mata Pelajaran SMA Kurikulum Merdeka</h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Mata Pelajaran SMA Kurikulum Merdeka menghadirkan transformasi pendidikan yang memerdekakan siswa untuk menentukan rute kesuksesan belajarnya sendiri. Struktur kurikulum memastikan penguasaan dasar lewat mata pelajaran umum wajib, kebebasan eksplorasi 4 hingga 5 mata pelajaran pilihan sesuai target kuliah, pembentukan karakter melalui 20 hingga 30 persen porsi kokurikuler P5, serta pemetaan jalur SMA dan SMK yang terarah. Kamu dapat memahami penjenjangan kompetensi belajar secara runtut dengan mempelajari <a href=\"/blog/kurikulum-merdeka/memahami-sistem-fase-sekolah\">sistem fase kurikulum merdeka</a> agar persiapan studimu semakin terarah. Kunjungi kategori <a href=\"/blog/kurikulum-merdeka\">Kurikulum Merdeka</a> untuk mendapatkan panduan regulasi sekolah terkini.</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Panduan regulasi sekolah terkini perlu kamu imbangi dengan konsistensi belajar harian terarah bersama teman pintar belajar. TugasMu mendampingi persiapan akademismu dengan prinsip bukan tools curang, tapi teman pintar belajarmu yang membimbingmu memahami konsep dasar secara mendalam. Maksimalkan penguasaan setiap materi pelajaran pilihan dan wajib dengan berlatih mandiri menggunakan <a href=\"/tools/generator-soal\">Generator Soal TugasMu</a> sekarang juga agar impian menembus kampus idamanmu tercapai nyata!</p></div><section class=\"mt-space-xl p-space-lg md:p-space-xl rounded-xl bg-surface-container-lowest shadow-sm flex flex-col sm:flex-row items-start sm:items-center gap-space-lg border border-slate-100\"><div class=\"w-16 h-16 rounded-full bg-primary-container text-on-primary flex items-center justify-center font-headline-lg text-headline-lg font-bold shrink-0 shadow-md ring-4 ring-primary-fixed\">TM</div><div class=\"flex flex-col gap-1.5 flex-1\"><div class=\"flex flex-wrap items-center gap-2\"><h4 class=\"font-headline-sm text-headline-sm text-on-surface font-bold\">Redaksi TugasMu</h4><span class=\"px-2.5 py-0.5 rounded-full bg-secondary text-on-secondary font-label-sm text-label-sm\">Tim Edukasi</span></div><p class=\"font-body-md text-body-md text-on-surface-variant\">Tim kurator konten yang berdedikasi untuk membagikan tips belajar, pembaruan kurikulum, dan cara cerdas memanfaatkan AI bagi pelajar Indonesia.</p></div></section></article><aside class=\"lg:col-span-4 flex flex-col gap-space-lg lg:sticky lg:top-24\"><div class=\"p-space-lg rounded-xl bg-gradient-to-b from-surface-container to-surface-container-high shadow-sm flex flex-col gap-space-md border border-slate-100\"><div class=\"w-10 h-10 rounded-xl bg-primary-container text-on-primary flex items-center justify-center shadow-xs\"><span class=\"material-symbols-outlined text-[22px]\">auto_awesome</span></div><div><h4 class=\"font-headline-sm text-headline-sm text-on-surface font-bold\">Butuh Bantuan Tugas?</h4><p class=\"font-body-sm text-body-sm text-on-surface-variant mt-1\">Gunakan asisten AI TugasMu secara gratis. Buat soal, parafrase makalah, dan temukan jawaban dari PR-mu.</p></div><a class=\"w-full inline-flex items-center justify-center gap-2 bg-primary-container hover:bg-primary text-on-primary py-2.5 px-4 rounded-xl font-label-md text-label-md transition-all shadow-sm\" href=\"/tools\"><span>Buka Tools AI</span><span class=\"material-symbols-outlined text-[16px]\">arrow_forward</span></a></div></aside></div><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"headline\":\"Mata Pelajaran SMA Kurikulum Merdeka: Wajib dan Pilihan\",\"description\":\"\",\"datePublished\":\"2026-09-22T00:00:00.000Z\",\"author\":{\"@type\":\"Organization\",\"name\":\"TugasMu\"}}</script></div></main><footer class=\"bg-slate-50 border-t border-slate-200 py-10 mt-auto\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\"><div class=\"flex flex-col md:flex-row items-center justify-between gap-6\"><div class=\"flex flex-col sm:flex-row items-center gap-3 sm:gap-6 text-center sm:text-left\"><div class=\"flex items-center gap-2\"><div class=\"w-7 h-7 rounded-lg bg-sky-500 flex items-center justify-center text-white\"><svg class=\"w-3.5 h-3.5 fill-white\" viewBox=\"0 0 24 24\"><polygon points=\"13 2 3 14 12 14 11 22 21 10 12 10 13 2\"></polygon></svg></div><span class=\"font-bold text-slate-900 text-base font-heading\">TugasMu.com</span></div><span class=\"text-xs sm:text-sm text-slate-500\">© 2026 TugasMu.com. Hak cipta dilindungi.</span></div><div class=\"flex flex-wrap justify-center items-center gap-x-6 gap-y-3 text-xs sm:text-sm font-medium text-slate-500\"><a class=\"ho