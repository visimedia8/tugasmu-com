\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"w-10 h-10 rounded-xl bg-primary-container text-on-primary flex items-center justify-center shadow-xs\\\",\\\"children\\\":[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"material-symbols-outlined text-[22px]\\\",\\\"children\\\":\\\"auto_awesome\\\"}]}],[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"h4\\\",null,{\\\"className\\\":\\\"font-headline-sm text-headline-sm text-on-surface font-bold\\\",\\\"children\\\":\\\"Butuh Bantuan Tugas?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-sm text-body-sm text-on-surface-variant mt-1\\\",\\\"children\\\":\\\"Gunakan asisten AI TugasMu secara gratis. Buat soal, parafrase makalah, dan temukan jawaban dari PR-mu.\\\"}]]}],[\\\"$\\\",\\\"$Le\\\",null,{\\\"href\\\":\\\"/tools\\\",\\\"className\\\":\\\"w-full inline-flex items-center justify-center gap-2 bg-primary-container hover:bg-primary text-on-primary py-2.5 px-4 rounded-xl font-label-md text-label-md transition-all shadow-sm\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"Buka Tools AI\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"material-symbols-outlined text-[16px]\\\",\\\"children\\\":\\\"arrow_forward\\\"}]]}]]}]}]]}],[\\\"$\\\",\\\"script\\\",null,{\\\"type\\\":\\\"application/ld+json\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"{\\\\\\\"@context\\\\\\\":\\\\\\\"https://schema.org\\\\\\\",\\\\\\\"@type\\\\\\\":\\\\\\\"Article\\\\\\\",\\\\\\\"headline\\\\\\\":\\\\\\\"Perbedaan Kurikulum Merdeka dan K13: Panduan Siswa\\\\\\\",\\\\\\\"description\\\\\\\":\\\\\\\"\\\\\\\",\\\\\\\"datePublished\\\\\\\":\\\\\\\"2026-09-22T00:00:00.000Z\\\\\\\",\\\\\\\"author\\\\\\\":{\\\\\\\"@type\\\\\\\":\\\\\\\"Organization\\\\\\\",\\\\\\\"name\\\\\\\":\\\\\\\"TugasMu\\\\\\\"}}\\\"}}]]}]\\n\"])</script><script>self.__next_f.push([1,\"f:[[\\\"$\\\",\\\"meta\\\",\\\"0\\\",{\\\"name\\\":\\\"viewport\\\",\\\"content\\\":\\\"width=device-width, initial-scale=1\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"charSet\\\":\\\"utf-8\\\"}],[\\\"$\\\",\\\"title\\\",\\\"2\\\",{\\\"children\\\":\\\"Perbedaan Kurikulum Merdeka dan K13: Panduan Siswa | TugasMu | TugasMu\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"3\\\",{\\\"property\\\":\\\"og:title\\\",\\\"content\\\":\\\"Perbedaan Kurikulum Merdeka dan K13: Panduan Siswa\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"4\\\",{\\\"property\\\":\\\"og:type\\\",\\\"content\\\":\\\"article\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"5\\\",{\\\"property\\\":\\\"article:published_time\\\",\\\"content\\\":\\\"Tue Sep 22 2026 08:00:00 GMT+0800 (Central Indonesia Time)\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"6\\\",{\\\"name\\\":\\\"twitter:card\\\",\\\"content\\\":\\\"summary\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"7\\\",{\\\"name\\\":\\\"twitter:title\\\",\\\"content\\\":\\\"Perbedaan Kurikulum Merdeka dan K13: Panduan Siswa\\\"}],[\\\"$\\\",\\\"link\\\",\\\"8\\\",{\\\"rel\\\":\\\"icon\\\",\\\"href\\\":\\\"/favicon.ico\\\",\\\"type\\\":\\\"image/x-icon\\\",\\\"sizes\\\":\\\"16x16\\\"}]]\\n4:null\\n\"])</script><script>self.__next_f.push([1,\"12:[[\\\"$\\\",\\\"h1\\\",null,{\\\"className\\\":\\\"font-headline-lg text-headline-lg text-on-surface tracking-tight mb-space-lg leading-tight\\\",\\\"children\\\":\\\"Perbedaan Kurikulum Merdeka dan K13: Panduan Siswa\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":[\\\"Perbedaan Kurikulum Merdeka dan K13 berfokus pada pembaruan format penilaian, fleksibilitas jam belajar, dan perombakan struktur mata pelajaran SMP serta SMA. Kamu mengakses ulasan komprehensif ini melalui panduan \\\",[\\\"$\\\",\\\"$Le\\\",null,{\\\"href\\\":\\\"/blog/kurikulum-merdeka/\\\",\\\"children\\\":\\\"artikel Kurikulum Merdeka\\\"}],\\\" kami untuk memetakan arah belajar mandiri. Perubahan regulasi pendidikan nasional ini menegaskan dinamika perbedaan Kurikulum Merdeka dan K13.\\\"]}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\\\",\\\"children\\\":\\\"Perbedaan Sistem Penilaian: Angka vs Deskriptif\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":[\\\"Perbedaan Kurikulum Merdeka dan K13 paling terasa saat kamu menerima lembar laporan hasil belajar pada akhir semester. K13 berpatokan pada batas angka KKM kaku, sedangkan Kurikulum Merdeka memakai deskripsi KKTP untuk mengukur kompetensimu. TugasMu mendampingi belajarmu membedah capaian materi melalui \\\",[\\\"$\\\",\\\"$Le\\\",null,{\\\"href\\\":\\\"/tools/rangkuman\\\",\\\"children\\\":\\\"rangkuman materi Kurikulum Merdeka\\\"}],\\\" agar kamu siap menghadapi asesmen harian. Platform bimbingan AI ini bukan tools curang, tapi teman pintar belajarmu dalam memahami indikator sistem angka KKM di K13.\\\"]}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\\\",\\\"children\\\":\\\"Sistem Angka KKM di K13\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Sistem angka KKM di K13 menetapkan nilai numerik tunggal seperti 75 sebagai syarat mutlak kelulusan siswa pada setiap mata pelajaran. Pola ujian tertulis berkala menuntut hafalan materi tanpa memberi ruang pemahaman konsep yang mendalam. Siswa yang nilainya berada di bawah batas wajib mengikuti remedial berulang hingga mencapai angka target tersebut. Bagaimana dampak remedial yang hanya mengejar angka target? Pola tersebut membuat siswa cemas dan memicu budaya hafalan singkat yang berlawanan dengan sistem deskriptif fase di Kurikulum Merdeka.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\\\",\\\"children\\\":\\\"Sistem Deskriptif Fase di Kurikulum Merdeka\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Sistem deskriptif fase di Kurikulum Merdeka meniadakan batas angka KKM dan menggantinya dengan narasi ketercapaian kompetensi sesuai fase usia belajar. Jenjang SMP menempati Fase D, sedangkan SMA menempati Fase E untuk kelas 10 dan Fase F untuk kelas 11-12. Asesmen diagnostik dan formatif berkala membantu guru mendeteksi kesulitan belajarmu sejak awal pertemuan kelas. Apakah guru masih mencantumkan angka pada rapor akhir? Skor numerik tetap hadir melengkapi laporan, tetapi didampingi ulasan kualitatif mengenai materi yang memerlukan bimbingan lanjutan.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Bimbingan lanjutan bagi siswa dalam Kurikulum Merdeka mengacu pada kriteria ketercapaian tujuan pembelajaran ke dalam empat kategori operasional:\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"ul\\\",null,{\\\"children\\\":[\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":\\\"Belum mencapai tujuan: siswa memerlukan bimbingan remedial penuh pada seluruh materi dasar.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":\\\"Cukup mencapai tujuan: siswa memerlukan remedial pada bagian indikator materi tertentu.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":\\\"Sudah mencapai tujuan: siswa langsung mempelajari topik materi berikutnya tanpa remedial.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":\\\"Melampaui tujuan: siswa menerima tugas pengayaan materi untuk mempertajam kompetensi analitis.\\\"}],\\\"\\\\n\\\"]}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Kompetensi analitis dalam penilaian deskriptif ini selaras dengan perubahan tata kelola perbedaan Kurikulum Merdeka dan K13 dalam struktur mapel.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\\\",\\\"children\\\":\\\"Perbedaan Struktur Mata Pelajaran dan Beban Jam\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Perbedaan Kurikulum Merdeka dan K13 dalam struktur mapel memengaruhi alokasi jam tatap muka mingguan dan kebebasan siswa memilih bidang studi. K13 mengunci jadwal mingguan secara kaku, sedangkan Kurikulum Merdeka menghitung total jam tahunan dengan menyisihkan 20-30% waktu untuk projek kokurikuler. Perbandingan mendasar tata kelola mata pelajaran kedua kurikulum terlihat pada tabel komparasi berikut:\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":[\\\"| Parameter Pembanding | Kurikulum 2013 (K13) | Kurikulum Merdeka |\\\\r\\\\n| :--- | :--- | :--- |\\\\r\\\\n| \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Sistem Penjurusan SMA\\\"}],\\\" | Wajib memilih IPA, IPS, atau Bahasa sejak kelas 10 | Tidak ada penjurusan di kelas 10; memilih mapel peminatan di kelas 11-12 |\\\\r\\\\n| \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Pelajaran Informatika SMP\\\"}],\\\" | Muatan lokal opsional atau bimbingan TIK | Mata pelajaran wajib nasional mulai kelas 7 SMP |\\\\r\\\\n| \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Mata Pelajaran IPA \\u0026 IPS SMP\\\"}],\\\" | Diajarkan sebagai mata pelajaran terpadu terpisah | Sekolah bebas memilih format terpadu, paralel, atau sistem blok |\\\\r\\\\n| \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Alokasi Jam Belajar\\\"}],\\\" | Dihitung tetap per minggu (38-44 JP/minggu) | Dihitung total per tahun dengan fleksibilitas jadwal sistem blok |\\\\r\\\\n| \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Porsi Kokurikuler\\\"}],\\\" | Kegiatan ekstrakurikuler di luar jam wajib | P5 mengambil 20-30% dari total jam pelajaran resmi |\\\"]}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Total jam pelajaran resmi tahunan memberikan fleksibilitas bagi sekolah merancang jadwal blok terpadu tanpa terikat batasan rutin mingguan. Siswa jenjang SMP dan SMA dituntut mandiri mengatur waktu belajar agar tidak menumpuk tugas sekolah. Pengaturan waktu yang adaptif ini mengubah batasan kaku pada regulasi mata pelajaran wajib di K13.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\\\",\\\"children\\\":\\\"Mata Pelajaran Wajib di K13\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Mata pelajaran wajib di K13 mengikat siswa pada penjurusan kaku IPA, IPS, atau Bahasa sejak awal kelas 10 SMA. Siswa jurusan IPA tidak mendapat ruang formal mempelajari Ekonomi, sedangkan siswa IPS tidak dapat mendalami Fisika. Pada jenjang SMP, mata pelajaran Informatika hanya berstatus muatan lokal tanpa alokasi tatap muka wajib yang merata. Pembatasan rumpun ilmu ini membatasi eksplorasi bakat siswa sebelum hadirnya sistem mata pelajaran pilihan di Kurikulum Merdeka.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\\\",\\\"children\\\":\\\"Mata Pelajaran Pilihan di Kurikulum Merdeka\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Mata pelajaran pilihan di Kurikulum Merdeka membebaskan siswa kelas 11 dan 12 meracik kombinasi mata pelajaran lintas minat sesuai rencana studi lanjutan. Kamu dapat mengombinasikan Matematika Tingkat Lanjut dengan Ekonomi jika berminat pada jurusan Aktuaria atau Manajemen Bisnis. Jenjang SMP juga menetapkan Informatika sebagai pelajaran wajib untuk mengasah nalar komputasi digital sejak dini. Kebebasan memilih materi ini mendukung kesiapan siswa menyusun portofolio akademik berbasis kompetensi literasi kecerdasan buatan sejak dini.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Literasi kecerdasan buatan sejak dini tersebut mempertegas transformasi praktis perbedaan Kurikulum Merdeka dan K13 dalam metode belajar.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\\\",\\\"children\\\":\\\"Perbedaan Cara Belajar: Hafalan vs Proyek\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Perbedaan Kurikulum Merdeka dan K13 dalam metode belajar menandai peralihan drastis dari budaya hafalan teks menuju penyelidikan kontekstual. K13 mengandalkan penuntasan materi silabus yang padat sehingga membatasi ruang diskusi interaktif di kelas. Kurikulum Merdeka memangkas materi esensial agar kamu memiliki waktu memadai untuk memahami konsep pelajaran secara mendalam. TugasMu hadir sebagai teman pintar belajar yang melatih nalar kritismu lewat bimbingan AI interaktif agar kamu siap mengatasi kelemahan pendekatan tematik integratif K13.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\\\",\\\"children\\\":\\\"Pendekatan Tematik Integratif K13\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Pendekatan tematik integratif K13 menggabungkan aneka mata pelajaran ke dalam tema tunggal yang sering membingungkan batasan keilmuan siswa. Beban penuntasan Kompetensi Dasar (KD) yang banyak mendorong guru berceramah satu arah demi mengejar target kurikulum. Siswa terbiasa menghafal rumus dan definisi faktual secara mekanis untuk menghadapi ujian pilihan ganda akhir bab. Bagaimana retensi daya ingat siswa dari metode hafalan ini? Penguasaan materi berbasis hafalan jangka pendek cepat memudar setelah ujian usai, berbeda dengan retensi hasil pembelajaran berbasis projek (PBL) di Kurikulum Merdeka.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\\\",\\\"children\\\":\\\"Pembelajaran Berbasis Projek (PBL) di Kurikulum Merdeka\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Pembelajaran berbasis projek (PBL) di Kurikulum Merdeka mewajibkan alokasi waktu kokurikuler Projek Penguatan Profil Pelajar Pancasila (P5) sebesar 20-30% jam belajar. Siswa SMP menyelesaikan 3 tema projek setahun, sementara SMA menuntaskan 2 tema projek per tahun dengan topik kontekstual seperti mitigasi sampah atau kewirausahaan digital. Metode ini mengasah karakter gotong royong, nalar kritis, dan keterampilan komunikasi publik melalui gelar karya pameran sekolah. Keterlibatan aktif menyelesaikan tantangan nyata membekali siswa dengan kompetensi abad ke-21.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Kompetensi abad ke-21 yang terbentuk melalui kegiatan proyek ini menjadi landasan evaluasi objektif mengenai kurikulum mana yang paling mendukung masa depanmu, sekaligus menegaskan bahwa Kurikulum Merdeka memberikan keuntungan spesifik.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\\\",\\\"children\\\":\\\"Kurikulum Mana yang Lebih Menguntungkan Siswa?\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Kurikulum Merdeka memberikan keuntungan spesifik dalam memfasilitasi kemandirian belajar, sedangkan K13 tetap memiliki nilai keteraturan bagi pembelajar konvensional. Data BSKAP menunjukkan kenaikan indeks literasi sebesar 3,2 poin pada sekolah pelaksana Kurikulum Merdeka berkat fokus materi esensial. Penilaian efektivitas kedua kurikulum ini bergantung pada kesiapan sarana sekolah dan adaptasi cara belajar siswa dalam mengoptimalkan aspek keunggulan K13 yang masih relevan.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\\\",\\\"children\\\":\\\"Keunggulan K13 yang Masih Relevan\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Keunggulan K13 yang masih relevan terletak pada standarisasi bahan ajar yang matang dan ketersediaan bank soal ujian terstruktur selama satu dekade. Kejelasan ambang batas KKM numerik memberi target nilai objektif tanpa risiko multitafsir bagi siswa. Siswa yang memprioritaskan persiapan tes masuk perguruan tinggi jalur seleksi berbasis tes (UTBK-SNBT) terbantu oleh latihan soal hitungan sains intensif. Struktur kepastian ini memberi rasa aman bagi tipe pembelajar terarah sebelum mereka menimbang keunggulan Kurikulum Merdeka untuk karir masa depan.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\\\",\\\"children\\\":\\\"Keunggulan Kurikulum Merdeka untuk Karir Masa Depan\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Keunggulan Kurikulum Merdeka untuk karir masa depan tercermin dari fleksibilitas lintas peminatan studi dan portofolio karya nyata yang diakui industri modern. Siswa SMA dapat mengombinasikan Biologi dan Ekonomi untuk membidik program studi Agribisnis atau Manajemen Lingkungan di perguruan tinggi. Asesmen Nasional menggantikan UN untuk menguji nalar membaca serta numerasi secara kontekstual tanpa hafalan mekanis. Pola evaluasi terpadu ini memotivasi siswa merancang strategi belajar mandiri.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Strategi belajar mandiri ini mengantarkanmu pada intisari evaluasi akhir yang merangkum perbedaan Kurikulum Merdeka dan K13.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\\\",\\\"children\\\":\\\"Kesimpulan Perbedaan Kurikulum Merdeka dan K13\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Perbedaan Kurikulum Merdeka dan K13 menegaskan pergeseran orientasi pendidikan dari kepatuhan angka menuju kemandirian kompetensi siswa SMP dan SMA. Empat intisari utama perubahan kurikulum ini mencakup: pertama, sistem penilaian beralih dari batas angka KKM kaku menuju deskripsi fase perkembangan kompetensi belajar siswa. Kedua, alokasi jam pelajaran menerapkan hitungan fleksibel tahunan serta menghapus sekat penjurusan kelas 10 SMA. Ketiga, metode belajar menggeser beban hafalan materi menjadi pelaksanaan pembelajaran berbasis projek kontekstual lewat P5. Keempat, kebebasan memilih rumpun mata pelajaran memperkuat portofolio akademik tanpa mengorbankan penguasaan materi esensial.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":[\\\"Penguasaan materi esensial tersebut mempermudah adaptasi belajarmu saat menghadapi format laporan rapor terbaru. Pelajari panduan teknis \\\",[\\\"$\\\",\\\"$Le\\\",null,{\\\"href\\\":\\\"/blog/kurikulum-merdeka/cara-menghitung-nilai-rapor\\\",\\\"children\\\":\\\"cara menghitung nilai rapor Kurikulum Merdeka\\\"}],\\\" untuk memahami mekanisme konversi nilai secara transparan. Jelajahi juga artikel panduan lainnya pada pusat referensi \\\",[\\\"$\\\",\\\"$Le\\\",null,{\\\"href\\\":\\\"/blog/kurikulum-merdeka/\\\",\\\"children\\\":\\\"Kurikulum Merdeka\\\"}],\\\" kami agar wawasan akademikmu semakin lengkap. Maksimalkan persiapan belajarmu sekarang melalui fitur ringkasan cerdas di \\\",[\\\"$\\\",\\\"$Le\\\",null,{\\\"href\\\":\\\"/tools/rangkuman\\\",\\\"children\\\":\\\"rangkuman materi Kurikulum Merdeka\\\"}],\\\" untuk memahami konsep pelajaran secara terarah bersama teman pintar belajarmu.\\\"]}]]\\n\"])</script></body></html>","rsc":"3:I[4707,[],\"\"]\n6:I[6423,[],\"\"]\n7:I[8003,[\"3433\",\"static/chunks/3433-9ddc6f7f78d9421c.js\",\"2972\",\"static/chunks/2972-8ce94bd856f9372b.js\",\"3185\",\"static/chunks/app/layout-c819fc26cf8b0e32.js\"],\"\"]\n8:I[9314,[\"3433\",\"static/chunks/3433-9ddc6f7f78d9421c.js\",\"2972\",\"static/chunks/2972-8ce94bd856f9372b.js\",\"3185\",\"static/chunks/app/layout-c819fc26cf8b0e32.js\"],\"default\"]\n9:I[6454,[\"3433\",\"static/chunks/3433-9ddc6f7f78d9421c.js\",\"2972\",\"static/chunks/2972-8ce94bd856f9372b.js\",\"3185\",\"static/chunks/app/layout-c819fc26cf8b0e32.js\"],\"Navbar\"]\na:I[482,[\"3433\",\"static/chunks/3433-9ddc6f7f78d9421c.js\",\"2972\",\"static/chunks/2972-8ce94bd856f9372b.js\",\"3185\",\"static/chunks/app/layout-c819fc26cf8b0e32.js\"],\"default\"]\nb:I[2972,[\"2972\",\"static/chunks/2972-8ce94bd856f9372b.js\",\"9064\",\"static/chunks/app/blog/%5Bkategori%5D/%5Bslug%5D/page-66ee61aaeae9a3c2.js\"],\"\"]\n4:[\"kategori\",\"kurikulum-merdeka\",\"d\"]\n5:[\"slug\",\"perbedaan-kurikulum-merdeka-dan-k13\",\"d\"]\n0:[\"nUO3BwVmV7Cq5JEgg6Nsr\",[[[\"\",{\"children\":[\"blog\",{\"children\":[[\"kategori\",\"kurikulum-merdeka\",\"d\"],{\"children\":[[\"slug\",\"perbedaan-kurikulum-merdeka-dan-k13\",\"d\"],{\"children\":[\"__PAGE__?{\\\"kategori\\\":\\\"kurikulum-merdeka\\\",\\\"slug\\\":\\\"perbedaan-kurikulum-merdeka-dan-k13\\\"}\",{}]}]}]}]},\"$undefined\",\"$undefined\",true],[\"\",{\"children\":[\"blog\",{\"children\":[[\"kategori\",\"kurikulum-merdeka\",\"d\"],{\"children\":[[\"slug\",\"perbedaan-kurikulum-merdeka-dan-k13\",\"d\"],{\"children\":[\"__PAGE__\",{},[[\"$L1\",\"$L2\",null],null],null]},[null,[\"$\",\"$L3\",null,{\"parallelRouterKey\":\"children\",\"segmentPath\":[\"children\",\"blog\",\"children\",\"$4\",\"children\",\"$5\",\"children\"],\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L6\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"notFoundStyles\":\"$undefined\"}]],null]},[null,[\"$\",\"$L3\",null,{\"parallelRouterKey\":\"children\",\"segmentPath\":[\"children\",\"blog\",\"children\",\"$4\",\"children\"],\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L6\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"notFoundStyles\":\"$undefined\"}]],null]},[null,[\"$\",\"$L3\",null,{\"parallelRouterKey\":\"children\",\"segmentPath\":[\"children\",\"blog\",\"children\"],\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L6\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"notFoundStyles\":\"$undefined\"}]],null]},[[[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/css/c70a6d8e0709b465.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\"}],[\"$\",\"link\",\"1\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/css/7eb325243a3b1d61.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\"}]],[\"$\",\"html\",null,{\"lang\":\"id\",\"children\":[[\"$\",\"head\",null,{\"children\":[[\"$\",\"$L7\",null,{\"src\":\"https://www.googletagmanager.com/gtag/js?id=G-8K10RNGN76\",\"strategy\":\"afterInteractive\"}],[\"$\",\"$L7\",null,{\"id\":\"google-analytics\",\"strategy\":\"afterInteractive\",\"children\":\"\\n            window.dataLayer = window.dataLayer || [];\\n            function gtag(){window.dataLayer.push(arguments);}\\n            gtag('js', new Date());\\n            gtag('config', 'G-8K10RNGN76');\\n          \"}],[\"$\",\"$L7\",null,{\"id\":\"adsbygoogle-init\",\"strategy\":\"afterInteractive\",\"crossOrigin\":\"anonymous\",\"src\":\"https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXXXXXXXX\"}]]}],[\"$\",\"body\",null,{\"className\":\"font-sans bg-brand-cream text-brand-navy flex flex-col min-h-screen __variable_0d7163 __variable_5667dc\",\"children\":[\"$\",\"$L8\",null,{\"children\":[[\"$\",\"$L9\",null,{}],[\"$\",\"$La\",null,{}],[\"$\",\"main\",null,{\"className\":\"flex-1\",\"children\":[\"$\",\"$L3\",null,{\"parallelRouterKey\":\"children\",\"segmentPath\":[\"children\"],\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L6\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":[\"$\",\"div\",null,{\"className\":\"container flex flex-col items-center justify-center min-h-[60vh] py-16 text-center\",\"children\":[[\"$\",\"h1\",null,{\"className\":\"text-8xl font-heading font-black text-slate-200 mb-6\",\"children\":\"404\"}],[\"$\",\"h2\",null,{\"className\":\"text-3xl font-bold text-slate-900 mb-4\",\"children\":\"Waduh, Kesasar Ya?\"}],[\"$\",\"p\",null,{\"className\":\"text-lg text-slate-600 max-w-md mx-auto mb-8\",\"children\":\"Halaman yang kamu cari mungkin sudah dihapus, dipindahkan, atau memang tidak pernah ada.\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-col sm:flex-row gap-4\",\"children\":[[\"$\",\"$Lb\",null,{\"href\":\"/\",\"className\":\"bg-sky-600 text-white font-bold py-3 px-6 rounded-xl hover:bg-sky-700 transition-colors\",\"children\":\"Kembali ke Beranda\"}],[\"$\",\"$Lb\",null,{\"href\":\"/tools\",\"className\":\"bg-white border-2 border-slate-200 text-slate-700 font-bold py-3 px-6 rounded-xl hover:border-slate-300 hover:bg-slate-50 transition-colors\",\"children\":\"Jelajahi Tools AI\"}]]}]]}],\"notFoundStyles\":[]}]}],[\"$\",\"footer\",null,{\"className\":\"bg-slate-50 border-t border-slate-200 py-10 mt-auto\",\"children\":[\"$\",\"div\",null,{\"className\":\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex flex-col md:flex-row items-center justify-between gap-6\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-col sm:flex-row items-center gap-3 sm:gap-6 text-center sm:text-left\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2\",\"children\":[[\"$\",\"div\",null,{\"className\":\"w-7 h-7 rounded-lg bg-sky-500 flex items-center justify-center text-white\",\"children\":[\"$\",\"svg\",null,{\"className\":\"w-3.5 h-3.5 fill-white\",\"viewBox\":\"0 0 24 24\",\"children\":[\"$\",\"polygon\",null,{\"points\":\"13 2 3 14 12 14 11 22 21 10 12 10 13 2\"}]}]}],[\"$\",\"span\",null,{\"