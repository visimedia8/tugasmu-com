ri, dan Contoh\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"4\\\",{\\\"property\\\":\\\"og:type\\\",\\\"content\\\":\\\"article\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"5\\\",{\\\"property\\\":\\\"article:published_time\\\",\\\"content\\\":\\\"Tue Sep 22 2026 08:00:00 GMT+0800 (Central Indonesia Time)\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"6\\\",{\\\"name\\\":\\\"twitter:card\\\",\\\"content\\\":\\\"summary\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"7\\\",{\\\"name\\\":\\\"twitter:title\\\",\\\"content\\\":\\\"Kalimat Aktif dan Pasif: Perbedaan, Ciri, dan Contoh\\\"}],[\\\"$\\\",\\\"link\\\",\\\"8\\\",{\\\"rel\\\":\\\"icon\\\",\\\"href\\\":\\\"/favicon.ico\\\",\\\"type\\\":\\\"image/x-icon\\\",\\\"sizes\\\":\\\"16x16\\\"}]]\\n4:null\\n\"])</script><script>self.__next_f.push([1,\"12:[[\\\"$\\\",\\\"h1\\\",null,{\\\"className\\\":\\\"font-headline-lg text-headline-lg text-on-surface tracking-tight mb-space-lg leading-tight\\\",\\\"children\\\":\\\"Kalimat Aktif dan Pasif: Perbedaan, Ciri, dan Contoh\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Kalimat Aktif dan Pasif membedakan peran subjek dalam tata bahasa Indonesia, baik sebagai pelaku kegiatan maupun penerima akibat tindakan. Pemahaman relasi kedua pola klausa ini membantumu menyusun tugas esai sekolah secara variatif sekaligus membaca teks bacaan secara kritis. Kamu dapat menganalisis perbedaan struktur tersebut lewat pengamatan predikat dan posisi objek dalam Kalimat Aktif dan Pasif.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\\\",\\\"children\\\":\\\"Apa Itu Kalimat Aktif dan Pasif: Perbedaan Mendasar\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":[\\\"Kalimat Aktif dan Pasif dibedakan dari posisi subjek terhadap predikat kerja di dalam klausa. Subjek pada kalimat aktif menjalankan pekerjaan secara mandiri, sedangkan subjek pada kalimat pasif menerima dampak perbuatan predikat. Kamu bisa memanfaatkan \\\",[\\\"$\\\",\\\"$Le\\\",null,{\\\"href\\\":\\\"/tools/rangkuman\\\",\\\"children\\\":\\\"Alat Rangkuman TugasMu\\\"}],\\\" untuk meringkas materi kalimat panjang menjadi ikhtisar konsep yang padat saat belajar di rumah. Rangkuman materi tersebut mempermudah pemetaan parameter pembeda klausa melalui tabel perbandingan:\\\"]}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":[\\\"| Parameter Pembeda | Kalimat Aktif | Kalimat Pasif |\\\\r\\\\n| :--- | :--- | :--- |\\\\r\\\\n| \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Fokus Kalimat\\\"}],\\\" | Pelaku tindakan (aktor) | Sasaran perbuatan |\\\\r\\\\n| \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Peran Subjek\\\"}],\\\" | Melakukan pekerjaan | Menerima perlakuan |\\\\r\\\\n| \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Afiks Predikat\\\"}],\\\" | \\\",[\\\"$\\\",\\\"em\\\",null,{\\\"children\\\":\\\"me-\\\"}],\\\", \\\",[\\\"$\\\",\\\"em\\\",null,{\\\"children\\\":\\\"ber-\\\"}],\\\" | \\\",[\\\"$\\\",\\\"em\\\",null,{\\\"children\\\":\\\"di-\\\"}],\\\", \\\",[\\\"$\\\",\\\"em\\\",null,{\\\"children\\\":\\\"ter-\\\"}],\\\", bentuk klitika |\\\\r\\\\n| \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Status Objek\\\"}],\\\" | Berada di belakang verba | Berpindah posisi menjadi subjek |\\\\r\\\\n| \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Kata Perangkai\\\"}],\\\" | Tanpa preposisi pelaku | Memerlukan preposisi \\\",[\\\"$\\\",\\\"em\\\",null,{\\\"children\\\":\\\"oleh\\\"}],\\\" |\\\\r\\\\n| \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Contoh Klausa\\\"}],\\\" | Rian membaca novel | Novel dibaca oleh Rian |\\\"]}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Tabel perbandingan di atas memperlihatkan bagaimana fokus informasi bergeser saat posisi subjek bertukar peran dengan objek. Pergeseran fokus sintaksis tersebut memunculkan pertanyaan penting: mengapa kamu perlu memahami ciri spesifik masing-masing konstruksi kalimat sebelum mengubah strukturnya? Pertanyaan lanjutan tersebut terjawab saat kamu membedah karakteristik pembentuk klausa kalimat aktif.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\\\",\\\"children\\\":\\\"Ciri Kalimat Aktif: Subjek Melakukan Tindakan\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Kalimat aktif menempatkan aktor atau pelaku utama di awal klausa sebelum kata kerja predikat. Penempatan ini menegaskan bahwa subjek memegang kendali penuh atas aktivitas yang berlangsung. Karakteristik gramatikal yang menandai klausa aktif dalam teks meliputi:\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"ul\\\",null,{\\\"children\\\":[\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":\\\"Subjek bertindak langsung sebagai eksekutor kegiatan dalam peristiwa.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":\\\"Predikat memakai verba aktif transitif atau intransitif.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":\\\"Kalimat aktif transitif mewajibkan objek penderita, contohnya \\\\\\\"Siswa menulis laporan penelitian\\\\\\\".\\\"}],\\\"\\\\n\\\"]}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Karakteristik aktif yang menonjolkan inisiatif pelaku ini berpasangan langsung dengan kalimat pasif.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\\\",\\\"children\\\":\\\"Ciri Kalimat Pasif: Subjek Dikenai Tindakan\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Kalimat pasif menempatkan objek penderita atau sasaran perbuatan pada posisi subjek di awal klausa. Pola ini mengalihkan perhatian pembaca menuju objek yang menerima perlakuan. Karakteristik struktural pembentuk klausa pasif mencakup:\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"ul\\\",null,{\\\"children\\\":[\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":\\\"Subjek berstatus sebagai sasaran atau korban dari pekerjaan pihak luar.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":\\\"Predikat memakai kata kerja pasif berawalan khusus.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":\\\"Objek pelaku dapat disertai preposisi \\\\\\\"oleh\\\\\\\", contohnya \\\\\\\"Laporan penelitian ditulis oleh siswa\\\\\\\".\\\"}],\\\"\\\\n\\\"]}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Penonjolan sasaran ini memunculkan pertanyaan lanjutan: bagaimana memastikan fungsi predikat pasif jika kata perangkai pelaku dihilangkan? Predikat pasif tetap terbaca jelas lewat variasi imbuhan.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Imbuhan pembentuk verba menjadi indikator morfologis paling konsisten untuk membedakan fungsi klausa pada Kalimat Aktif dan Pasif.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-spa