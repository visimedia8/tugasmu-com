{"type":"app","meta":{"headers":{"x-next-cache-tags":"_N_T_/layout,_N_T_/blog/layout,_N_T_/blog/[kategori]/layout,_N_T_/blog/[kategori]/[slug]/layout,_N_T_/blog/[kategori]/[slug]/page,_N_T_/blog/bahasa-indonesia/perbedaan-kalimat-aktif-pasif"}},"html":"<!DOCTYPE html><html lang=\"id\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/css/c70a6d8e0709b465.css\" data-precedence=\"next\"/><link rel=\"stylesheet\" href=\"/_next/static/css/7eb325243a3b1d61.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-37f8c22e297b04f8.js\"/><script src=\"/_next/static/chunks/fd9d1056-2718004965b0207a.js\" async=\"\"></script><script src=\"/_next/static/chunks/2117-c5687b942395652d.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-f30bb01764683cd9.js\" async=\"\"></script><script src=\"/_next/static/chunks/3433-9ddc6f7f78d9421c.js\" async=\"\"></script><script src=\"/_next/static/chunks/2972-8ce94bd856f9372b.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-c819fc26cf8b0e32.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/blog/%5Bkategori%5D/%5Bslug%5D/page-66ee61aaeae9a3c2.js\" async=\"\"></script><link rel=\"preload\" href=\"https://www.googletagmanager.com/gtag/js?id=G-8K10RNGN76\" as=\"script\"/><link rel=\"preload\" href=\"https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXXXXXXXX\" as=\"script\" crossorigin=\"\"/><title>Kalimat Aktif dan Pasif: Perbedaan, Ciri, dan Contoh | TugasMu | TugasMu</title><meta property=\"og:title\" content=\"Kalimat Aktif dan Pasif: Perbedaan, Ciri, dan Contoh\"/><meta property=\"og:type\" content=\"article\"/><meta property=\"article:published_time\" content=\"Tue Sep 22 2026 08:00:00 GMT+0800 (Central Indonesia Time)\"/><meta name=\"twitter:card\" content=\"summary\"/><meta name=\"twitter:title\" content=\"Kalimat Aktif dan Pasif: Perbedaan, Ciri, dan Contoh\"/><link rel=\"icon\" href=\"/favicon.ico\" type=\"image/x-icon\" sizes=\"16x16\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"font-sans bg-brand-cream text-brand-navy flex flex-col min-h-screen __variable_0d7163 __variable_5667dc\"><header class=\"sticky top-0 z-50 w-full\"><div class=\"bg-brand-cream/95 backdrop-blur-md border-b border-brand-navy/10\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between\"><a class=\"flex items-center gap-2.5 group\" href=\"/\"><div class=\"w-8 h-8 rounded-lg bg-brand-navy flex items-center justify-center shadow-sm group-hover:bg-brand-lime transition-colors duration-300\"><svg class=\"w-4 h-4 fill-brand-cream group-hover:fill-brand-navy transition-colors duration-300\" viewBox=\"0 0 24 24\"><polygon points=\"13 2 3 14 12 14 11 22 21 10 12 10 13 2\"></polygon></svg></div><span class=\"font-heading font-bold text-xl text-brand-navy tracking-tight group-hover:text-brand-navy/70 transition-colors\">TugasMu</span></a><nav class=\"hidden md:flex items-center gap-1\"><a class=\"relative px-4 py-2 text-sm font-semibold rounded-full transition-all duration-200 text-brand-navy/70 hover:text-brand-navy hover:bg-brand-navy/5\" href=\"/tools\">AI Tools</a><a class=\"relative px-4 py-2 text-sm font-semibold rounded-full transition-all duration-200 text-brand-navy/70 hover:text-brand-navy hover:bg-brand-navy/5\" href=\"/harga\">Premium</a><a class=\"relative px-4 py-2 text-sm font-semibold rounded-full transition-all duration-200 text-brand-navy bg-brand-lime\" href=\"/blog\">Blog</a></nav><div class=\"hidden md:flex items-center gap-3\"><a class=\"px-5 py-2.5 rounded-full bg-brand-navy hover:bg-brand-navy/90 text-brand-cream font-bold text-sm transition-all shadow-sm hover:shadow-md active:scale-95 flex items-center gap-2\" href=\"/masuk\">Masuk / Daftar</a></div><div class=\"flex md:hidden items-center gap-3\"><button class=\"p-2 rounded-full text-brand-navy hover:bg-brand-navy/5 transition-colors\" aria-label=\"Toggle Menu\"><svg class=\"w-5 h-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\"><line x1=\"3\" y1=\"8\" x2=\"21\" y2=\"8\"></line><line x1=\"3\" y1=\"16\" x2=\"21\" y2=\"16\"></line></svg></button></div></div></div></header><div class=\"bg-slate-50 border-b\"><div class=\"container py-3\"><nav class=\"flex text-sm text-slate-500\" aria-label=\"Breadcrumb\"><ol class=\"inline-flex items-center space-x-1 md:space-x-3\"><li class=\"inline-flex items-center\"><a class=\"hover:text-slate-900 transition-colors\" href=\"/\">Home</a></li><li><div class=\"flex items-center\"><span class=\"mx-2 text-slate-400\">/</span><a class=\"hover:text-slate-900 transition-colors\" href=\"/blog\">Blog</a></div></li><li><div class=\"flex items-center\"><span class=\"mx-2 text-slate-400\">/</span><a class=\"hover:text-slate-900 transition-colors\" href=\"/blog/bahasa-indonesia\">Bahasa indonesia</a></div></li><li><div class=\"flex items-center\"><span class=\"mx-2 text-slate-400\">/</span><span class=\"text-slate-900 font-medium\" aria-current=\"page\">Perbedaan kalimat aktif pasif</span></div></li></ol></nav></div></div><main class=\"flex-1\"><div class=\"w-full max-w-[1200px] mx-auto px-margin md:px-margin-desktop py-space-lg md:py-space-xl\"><nav aria-label=\"Breadcrumb\" class=\"flex items-center gap-space-xs text-on-surface-variant font-body-sm text-body-sm mb-space-lg overflow-x-auto whitespace-nowrap scrollbar-none\"><a class=\"hover:text-primary transition-colors flex items-center gap-1\" href=\"/\"><span class=\"material-symbols-outlined text-[16px]\">home</span><span>Home</span></a><span class=\"material-symbols-outlined text-[14px] text-outline\">chevron_right</span><a class=\"hover:text-primary transition-colors\" href=\"/blog\">Blog</a><span class=\"material-symbols-outlined text-[14px] text-outline\">chevron_right</span><a class=\"hover:text-primary transition-colors capitalize\" href=\"/blog/bahasa-indonesia\">bahasa indonesia</a><span class=\"material-symbols-outlined text-[14px] text-outline\">chevron_right</span><span class=\"text-primary truncate max-w-[200px] md:max-w-none font-medium\">Kalimat Aktif dan Pasif: Perbedaan, Ciri, dan Contoh</span></nav><div class=\"grid grid-cols-1 lg:grid-cols-12 gap-space-xl items-start\"><article class=\"lg:col-span-8 flex flex-col\"><div class=\"flex flex-wrap items-center gap-space-sm mb-space-md\"><span class=\"px-space-md py-1 rounded-xl bg-primary-fixed text-on-primary-fixed font-label-sm text-label-sm tracking-wide uppercase\">bahasa indonesia</span><span class=\"px-space-md py-1 rounded-xl bg-surface-container text-on-surface-variant font-label-sm text-label-sm flex items-center gap-1\"><span class=\"material-symbols-outlined text-[14px] text-primary\">schedule</span>5 menit baca</span></div><h1 class=\"font-headline-lg text-headline-lg md:text-display-lg text-on-surface tracking-tight mb-space-lg leading-tight\">Kalimat Aktif dan Pasif: Perbedaan, Ciri, dan Contoh</h1><div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-space-md p-space-md md:p-space-lg rounded-xl bg-surface-container-low mb-space-xl border border-slate-100\"><div class=\"flex items-center gap-space-md\"><div class=\"w-12 h-12 rounded-full bg-primary-container text-on-primary font-headline-sm text-headline-sm flex items-center justify-center font-bold shadow-sm ring-2 ring-primary-fixed\">TM</div><div><div class=\"flex items-center gap-1.5\"><span class=\"font-label-lg text-label-lg text-on-surface font-bold\">Tim Kurasi TugasMu</span><span class=\"material-symbols-outlined text-primary text-[16px]\" title=\"Terverifikasi\">verified</span></div><p class=\"font-body-sm text-body-sm text-on-surface-variant\">Diterbitkan pada <!-- -->22 September 2026</p></div></div><div class=\"flex items-center gap-2 pt-space-xs sm:pt-0\"><button class=\"inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-surface-container-lowest hover:bg-surface-container text-secondary font-label-md text-label-md transition-all shadow-sm\"><span class=\"material-symbols-outlined text-[18px]\">share</span><span class=\"hidden sm:inline\">Bagikan</span></button></div></div><div class=\"prose-content flex flex-col gap-space-lg text-on-surface font-body-lg text-body-lg leading-relaxed bg-surface-container-lowest p-space-lg md:p-space-xl rounded-xl shadow-sm border border-slate-100\"><h1 class=\"font-headline-lg text-headline-lg text-on-surface tracking-tight mb-space-lg leading-tight\">Kalimat Aktif dan Pasif: Perbedaan, Ciri, dan Contoh</h1>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Kalimat Aktif dan Pasif membedakan peran subjek dalam tata bahasa Indonesia, baik sebagai pelaku kegiatan maupun penerima akibat tindakan. Pemahaman relasi kedua pola klausa ini membantumu menyusun tugas esai sekolah secara variatif sekaligus membaca teks bacaan secara kritis. Kamu dapat menganalisis perbedaan struktur tersebut lewat pengamatan predikat dan posisi objek dalam Kalimat Aktif dan Pasif.</p>\n<h2 class=\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\">Apa Itu Kalimat Aktif dan Pasif: Perbedaan Mendasar</h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Kalimat Aktif dan Pasif dibedakan dari posisi subjek terhadap predikat kerja di dalam klausa. Subjek pada kalimat aktif menjalankan pekerjaan secara mandiri, sedangkan subjek pada kalimat pasif menerima dampak perbuatan predikat. Kamu bisa memanfaatkan <a href=\"/tools/rangkuman\">Alat Rangkuman TugasMu</a> untuk meringkas materi kalimat panjang menjadi ikhtisar konsep yang padat saat belajar di rumah. Rangkuman materi tersebut mempermudah pemetaan parameter pembeda klausa melalui tabel perbandingan:</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">| Parameter Pembeda | Kalimat Aktif | Kalimat Pasif |\r\n| :--- | :--- | :--- |\r\n| <strong>Fokus Kalimat</strong> | Pelaku tindakan (aktor) | Sasaran perbuatan |\r\n| <strong>Peran Subjek</strong> | Melakukan pekerjaan | Menerima perlakuan |\r\n| <strong>Afiks Predikat</strong> | <em>me-</em>, <em>ber-</em> | <em>di-</em>, <em>ter-</em>, bentuk klitika |\r\n| <strong>Status Objek</strong> | Berada di belakang verba | Berpindah posisi menjadi subjek |\r\n| <strong>Kata Perangkai</strong> | Tanpa preposisi pelaku | Memerlukan preposisi <em>oleh</em> |\r\n| <strong>Contoh Klausa</strong> | Rian membaca novel | Novel dibaca oleh Rian |</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Tabel perbandingan di atas memperlihatkan bagaimana fokus informasi bergeser saat posisi subjek bertukar peran dengan objek. Pergeseran fokus sintaksis tersebut memunculkan pertanyaan penting: mengapa kamu perlu memahami ciri spesifik masing-masing konstruksi kalimat sebelum mengubah strukturnya? Pertanyaan lanjutan tersebut terjawab saat kamu membedah karakteristik pembentuk klausa kalimat aktif.</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">Ciri Kalimat Aktif: Subjek Melakukan Tindakan</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Kalimat aktif menempatkan aktor atau pelaku utama di awal klausa sebelum kata kerja predikat. Penempatan ini menegaskan bahwa subjek memegang kendali penuh atas aktivitas yang berlangsung. Karakteristik gramatikal yang menandai klausa aktif dalam teks meliputi:</p>\n<ul>\n<li>Subjek bertindak langsung sebagai eksekutor kegiatan dalam peristiwa.</li>\n<li>Predikat memakai verba aktif transitif atau intransitif.</li>\n<li>Kalimat aktif transitif mewajibkan objek penderita, contohnya &quot;Siswa menulis laporan penelitian&quot;.</li>\n</ul>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Karakteristik aktif yang menonjolkan inisiatif pelaku ini berpasangan langsung dengan kalimat pasif.</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">Ciri Kalimat Pasif: Subjek Dikenai Tindakan</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Kalimat pasif menempatkan objek penderita atau sasaran perbuatan pada posisi subjek di awal klausa. Pola ini mengalihkan perhatian pembaca menuju objek yang menerima perlakuan. Karakteristik struktural pembentuk klausa pasif mencakup:</p>\n<ul>\n<li>Subjek berstatus sebagai sasaran atau korban dari pekerjaan pihak luar.</li>\n<li>Predikat memakai kata kerja pasif berawalan khusus.</li>\n<li>Objek pelaku dapat disertai preposisi &quot;oleh&quot;, contohnya &quot;Laporan penelitian ditulis oleh siswa&quot;.</li>\n</ul>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Penonjolan sasaran ini memunculkan pertanyaan lanjutan: bagaimana memastikan fungsi predikat pasif jika kata perangkai pelaku dihilangkan? Predikat pasif tetap terbaca jelas lewat variasi imbuhan.</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Imbuhan pembentuk verba menjadi indikator morfologis paling konsisten untuk membedakan fungsi klausa pada Kalimat Aktif dan Pasif.</p>\n<h2 class=\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\">Imbuhan Penanda Kalimat Aktif dan Pasif</h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Kalimat Aktif dan Pasif dibedakan juga melalui imbuhan pembentuk verba yang melekat pada kata dasar predikat. Afiksasi morfologis tersebut berfungsi sebagai penanda gramatikal yang mengarahkan pembaca mengenali peran subjek. Kamu dapat mengidentifikasi pembagian kelompok imbuhan tersebut lewat klasifikasi kata kerja aktif.</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">Imbuhan me- dan me-kan untuk Kalimat Aktif</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Kata kerja aktif umumnya dibentuk oleh prefiks <em>me-</em>, konfiks <em>me-kan</em>, atau konfiks <em>me-i</em>. Prefiks <em>me-</em> mengalami variasi alomorf seperti <em>mem-</em>, <em>men-</em>, <em>meng-</em>, dan <em>meny-</em> menyesuaikan huruf awal kata dasar. Ragam fungsi imbuhan aktif dalam tugas sekolah terdiri atas:</p>\n<ul>\n<li>Awalan <em>me-</em> pada verba tindakan langsung, contohnya &quot;Doni <em>membaca</em> buku biologi&quot;.</li>\n<li>Konfiks <em>me-kan</em> yang menyatakan membuat sesuatu terjadi, contohnya &quot;Ibu <em>membersihkan</em> meja makan&quot;.</li>\n<li>Konfiks <em>me-i</em> yang menyatakan perbuatan berulang, contohnya &quot;Polisi <em>mendatangi</em> lokasi kejadian&quot;.</li>\n</ul>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Perubahan alomorf ini memunculkan pertanyaan lanjutan: apa yang terjadi jika kata dasar diawali huruf K, T, S, atau P? Fonem tersebut luluh menjadi bunyi sengau jika diikuti vokal, berbeda dengan pembentukan kata kerja pasif.</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">Imbuhan di- dan ter- untuk Kalimat Pasif</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Kata kerja pasif dibentuk melalui prefiks <em>di-</em>, prefiks <em>ter-</em>, konfiks <em>ke-an</em>, serta klitika pronomina. Awalan <em>di-</em> menandakan perbuatan sengaja, sedangkan awalan <em>ter-</em> menyatakan kejadian spontan atau kondisi selesai. Klasifikasi imbuhan pasif dalam bahasa Indonesia meliputi:</p>\n<ul>\n<li>Awalan <em>di-</em> untuk tindakan pasif terencana, contohnya &quot;Buku biologi <em>dibaca</em> oleh Doni&quot;.</li>\n<li>Awalan <em>ter-</em> untuk kejadian tanpa sengaja, contohnya &quot;Gelas kaca <em>tersenggol</em> siku hingga pecah&quot;.</li>\n<li>Konfiks <em>ke-an</em> untuk menyatakan terkena keadaan, contohnya &quot;Rombongan siswa <em>kehujanan</em> di jalan&quot;.</li>\n<li>Klitika pronomina persona yang melekat pada kata dasar, contohnya &quot;Surat itu sudah <em>kutulis</em> kemarin&quot;.</li>\n</ul>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Bentuk pasif dengan klitika maupun prefiks ini menjadi fondasi sebelum kamu mempraktikkan konversi klausa pada Kalimat Aktif.</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Kalimat Aktif dengan predikat berimbuhan transitif tersebut membutuhkan ketepatan prosedur teknis saat kamu mempelajari cara mengubah Kalimat Aktif.</p>\n<h2 class=\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\">Cara Mengubah Kalimat Aktif menjadi Pasif (dan Sebaliknya)</h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Kalimat Aktif dapat diubah menjadi Pasif dengan merotasi fungsi sintaksis antarunsur klausa tanpa mengubah makna semantik pesan. Transformasi ini menuntut pertukaran posisi subjek dan objek disertai pergantian morfem predikat. Bimbingan AI di TugasMu melatihmu memahami logika berpikir di balik aturan tata bahasa ini, bukan sekadar menghafal jawaban instan. Pahami konsepnya secara runtut agar kamu terampil menyelesaikan tugas perubahan kalimat aktif.</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">Langkah Mengubah Kalimat Aktif ke Pasif</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Kalimat aktif transitif dapat kamu ubah menjadi bentuk pasif melalui tiga tahapan teknis berikut:</p>\n<ul>\n<li>Pertama, pindahkan objek penderita kalimat aktif menjadi subjek di posisi awal kalimat pasif.</li>\n<li>Kedua, ganti awalan <em>me-</em> pada verba predikat menjadi awalan pasif <em>di-</em> atau bentuk klitika.</li>\n<li>Ketiga, tempatkan subjek kalimat aktif di belakang predikat dengan menambahkan kata &quot;oleh&quot;.</li>\n</ul>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Contoh perubahan ini tampak pada kalimat: &quot;Arsitek (S) merancang (P) gedung (O)&quot; yang bertransformasi menjadi &quot;Gedung (S) dirancang (P) oleh arsitek (Pel)&quot;. Langkah konversi ini memunculkan pertanyaan lanjutan: bisakah kamu mempasifkan kalimat intransitif seperti &quot;Burung terbang tinggi&quot;? Kalimat intransitif tidak dapat dipasifkan karena tidak memiliki objek untuk dijadikan subjek kalimat pasif.</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">Langkah Mengubah Kalimat Pasif ke Aktif</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Kalimat pasif dapat kamu kembalikan menjadi klausa aktif dengan membalik urutan langkah gramatikal:</p>\n<ul>\n<li>Pertama, pindahkan objek pelaku di belakang predikat menjadi subjek di awal kalimat aktif.</li>\n<li>Kedua, ubah awalan pasif <em>di-</em> pada predikat kembali menjadi awalan aktif <em>me-</em>.</li>\n<li>Ketiga, posisikan subjek penderita kalimat pasif menjadi objek di belakang verba aktif.</li>\n</ul>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Penerapan langkah ini terlihat pada contoh: &quot;Laporan (S) diselesaikan (P) oleh peneliti (Pel)&quot; yang dikonversi kembali menjadi &quot;Peneliti (S) menyelesaikan (P) laporan (O)&quot;. Penguasaan prosedur transformasi dua arah ini melatih kecakapan sintaksis saat kamu menulis ragam Kalimat Aktif dan Pasif.</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Kalimat Aktif dan Pasif yang telah kamu kuasai secara mekanis menuntut ketepatan pemilihan format sesuai tujuan komunikasi dalam teks tertulis Kalimat Aktif dan Pasif.</p>\n<h2 class=\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\">Kapan Menggunakan Kalimat Aktif vs Pasif dalam Teks</h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Kalimat Aktif dan Pasif memiliki konteks penggunaan yang berbeda tergantung genre teks dan target pembaca. Penulis memadukan kedua jenis kalimat secara proporsional guna membangun ritme tulisan yang runtut dan efektif. Penerapan gaya penulisan ini terlihat nyata saat kamu menyusun paragraf dengan kalimat aktif.</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">Kalimat Aktif untuk Teks Narasi dan Berita</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Kalimat aktif menjadi pilihan utama dalam teks narasi, cerpen, dan berita langsung karena menonjolkan ketegasan aksi. Susunan aktif mengalirkan energi gerak yang cepat sehingga pembaca terhubung erat dengan tokoh cerita. Keunggulan pemakaian kalimat aktif dalam teks penceritaan mencakup:</p>\n<ul>\n<li>Menegaskan sosok tokoh yang mengambil inisiatif tindakan penting dalam alur cerita.</li>\n<li>Membentuk kalimat lugas dan padat, misalnya &quot;Pemerintah meresmikan jembatan baru kemarin&quot;.</li>\n</ul>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Ketegasan aksi aktif memunculkan pertanyaan lanjutan: mengapa gaya dinamis ini dibatasi dalam karya ilmiah yang mengutamakan kalimat pasif? Teks ilmiah memprioritaskan netralitas metode riset daripada figur personal peneliti yang diwakili oleh kalimat pasif.</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">Kalimat Pasif untuk Teks Ilmiah dan Formal</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Kalimat pasif memegang fungsi sentral dalam laporan praktikum, artikel jurnal, dan surat resmi kenegaraan. Format pasif membantu penulis menjaga objektivitas laporan agar terbebas dari bias opini pribadi. Alasan struktural penggunaan kalimat pasif dalam karya ilmiah meliputi:</p>\n<ul>\n<li>Menghindari kata ganti orang pertama seperti &quot;saya&quot; agar perhatian tertuju pada objek uji, misalnya &quot;Sampel dipanaskan pada suhu 60 derajat Celsius&quot;.</li>\n<li>Menyorot metodologi dan temuan data daripada individu yang mengoperasikan alat laboratorium.</li>\n</ul>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Penggunaan kalimat pasif yang tepat pada laporan ilmiah menjaga standar akademis dalam penulisan Kalimat Aktif dan Pasif.</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Kalimat Aktif dan Pasif yang kamu gunakan secara seimbang menghasilkan tulisan yang logis, tajam, dan mudah dipahami oleh pembaca Kalimat Aktif dan Pasif.</p>\n<h2 class=\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\">Rangkuman Inti Kalimat Aktif dan Pasif</h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Kalimat Aktif dan Pasif memegang peranan kunci dalam struktur tata bahasa Indonesia dengan empat rangkuman deklaratif pokok:</p>\n<ul>\n<li>Perbedaan mendasar terletak pada posisi subjek, di mana subjek aktif menjadi pelaku tindakan sedangkan subjek pasif menjadi penerima perbuatan.</li>\n<li>Imbuhan predikat menjadi pembeda morfologis, dengan awalan <em>me-</em> membentuk verba aktif serta awalan <em>di-</em> atau <em>ter-</em> membentuk verba pasif.</li>\n<li>Transformasi antarbentuk menuntut pertukaran posisi subjek dan objek yang hanya berlaku pada verba aktif transitif.</li>\n<li>Konteks pemakaian ditentukan oleh genre teks, dengan kalimat aktif memperkuat teks narasi dan kalimat pasif menjaga objektivitas teks ilmiah.</li>\n</ul>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Teks ilmiah maupun tulisan narasi menuntut kecermatan berbahasa agar gagasanmu tersampaikan secara utuh. Kamu dapat memperluas wawasan kebahasaan lainnya di kategori <a href=\"/blog/bahasa-indonesia\">Bahasa Indonesia</a>, termasuk membaca panduan <a href=\"/blog/bahasa-indonesia/cara-mencari-ide-pokok-paragraf\">cara mencari ide pokok paragraf</a> untuk menyusun wacana berbobot. TugasMu hadir sebagai teman pintar belajar yang mendampingimu memahami konsep kebahasaan secara mendalam melalui bimbingan AI. Bukan tools curang, tapi teman pintar belajarmu yang mengasah logika berpikir dalam menuntaskan tugas sekolah. Gunakan <a href=\"/tools/rangkuman\">Alat Rangkuman TugasMu</a> untuk meringkas materi kalimat dan konsep pelajaran lainnya secara praktis dan terstruktur.</p></div><section class=\"mt-space-xl p-space-lg md:p-space-xl rounded-xl bg-surface-container-lowest shadow-sm flex flex-col sm:flex-row items-start sm:items-center gap-space-lg border border-slate-100\"><div class=\"w-16 h-16 rounded-full bg-primary-container text-on-primary flex items-center justify-center font-headline-lg text-headline-lg font-bold shrink-0 shadow-md ring-4 ring-primary-fixed\">TM</div><div class=\"flex flex-col gap-1.5 flex-1\"><div class=\"flex flex-wrap items-center gap-2\"><h4 class=\"font-headline-sm text-headline-sm text-on-surface font-bold\">Redaksi TugasMu</h4><span class=\"px-2.5 py-0.5 rounded-full bg-secondary text-on-secondary font-label-sm text-label-sm\">Tim Edukasi</span></div><p class=\"font-body-md text-body-md text-on-surface-variant\">Tim kurator konten yang berdedikasi untuk membagikan tips belajar, pembaruan kurikulum, dan cara cerdas memanfaatkan AI bagi pelajar Indonesia.</p></div></section></article><aside class=\"lg:col-span-4 flex flex-col gap-space-lg lg:sticky lg:top-24\"><div class=\"p-space-lg rounded-xl bg-gradient-to-b from-surface-container to-surface-container-high shadow-sm flex flex-col gap-space-md border border-slate-100\"><div class=\"w-10 h-10 rounded-xl bg-primary-container text-on-primary flex items-center justify-center shadow-xs\"><span class=\"material-symbols-outlined text-[22px]\">auto_awesome</span></div><div><h4 class=\"font-headline-sm text-headline-sm text-on-surface font-bold\">Butuh Bantuan Tugas?</h4><p class=\"font-body-sm text-body-sm text-on-surface-variant mt-1\">Gunakan asisten AI TugasMu secara gratis. Buat soal, parafrase makalah, dan temukan jawaban dari PR-mu.</p></div><a class=\"w-full inline-flex items-center justify-center gap-2 bg-primary-container hover:bg-primary text-on-primary py-2.5 px-4 rounded-xl font-label-md text-label-md transition-all shadow-sm\" href=\"/tools\"><span>Buka Tools AI</span><span class=\"material-symbols-outlined text-[16px]\">arrow_forward</span></a></div></aside></div><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"headline\":\"Kalimat Aktif dan Pasif: Perbedaan, Ciri, dan Contoh\",\"description\":\"\",\"datePublished\":\"2026-09-22T00:00:00.000Z\",\"author\":{\"@type\":\"Organization\",\"name\":\"TugasMu\"}}</script></div></main><footer class=\"bg-slate-50 border-t border-slate-200 py-10 mt-auto\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\"><div class=\"flex flex-col md:flex-row items-center justify-between gap-6\"><div class=\"flex flex-col sm:flex-row items-center gap-3 sm:gap-6 text-center sm:text-left\"><div class=\"flex items-center gap-2\"><div class=\"w-7 h-7 rounded-lg bg-sky-500 flex items-center justify-center text-white\"><svg class=\"w-3.5 h-3.5 fill-white\" viewBox=\"0 0 24 24\"><polygon points=\"13 2 3 14 12 14 11 22 21 10 12 10 13 2\"></polygon></svg></div><span class=\"font-bold text-slate-900 text-base font-heading\">TugasMu.com</span></div><span class=\"text-xs sm:text-sm text-slate-