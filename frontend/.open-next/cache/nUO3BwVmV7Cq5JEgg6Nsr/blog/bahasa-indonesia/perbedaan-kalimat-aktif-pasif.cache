,{\"className\":\"flex flex-col gap-1.5 flex-1\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-2\",\"children\":[[\"$\",\"h4\",null,{\"className\":\"font-headline-sm text-headline-sm text-on-surface font-bold\",\"children\":\"Redaksi TugasMu\"}],[\"$\",\"span\",null,{\"className\":\"px-2.5 py-0.5 rounded-full bg-secondary text-on-secondary font-label-sm text-label-sm\",\"children\":\"Tim Edukasi\"}]]}],[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant\",\"children\":\"Tim kurator konten yang berdedikasi untuk membagikan tips belajar, pembaruan kurikulum, dan cara cerdas memanfaatkan AI bagi pelajar Indonesia.\"}]]}]]}]]}],[\"$\",\"aside\",null,{\"className\":\"lg:col-span-4 flex flex-col gap-space-lg lg:sticky lg:top-24\",\"children\":[\"$\",\"div\",null,{\"className\":\"p-space-lg rounded-xl bg-gradient-to-b from-surface-container to-surface-container-high shadow-sm flex flex-col gap-space-md border border-slate-100\",\"children\":[[\"$\",\"div\",null,{\"className\":\"w-10 h-10 rounded-xl bg-primary-container text-on-primary flex items-center justify-center shadow-xs\",\"children\":[\"$\",\"span\",null,{\"className\":\"material-symbols-outlined text-[22px]\",\"children\":\"auto_awesome\"}]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h4\",null,{\"className\":\"font-headline-sm text-headline-sm text-on-surface font-bold\",\"children\":\"Butuh Bantuan Tugas?\"}],[\"$\",\"p\",null,{\"className\":\"font-body-sm text-body-sm text-on-surface-variant mt-1\",\"children\":\"Gunakan asisten AI TugasMu secara gratis. Buat soal, parafrase makalah, dan temukan jawaban dari PR-mu.\"}]]}],[\"$\",\"$Lb\",null,{\"href\":\"/tools\",\"className\":\"w-full inline-flex items-center justify-center gap-2 bg-primary-container hover:bg-primary text-on-primary py-2.5 px-4 rounded-xl font-label-md text-label-md transition-all shadow-sm\",\"children\":[[\"$\",\"span\",null,{\"children\":\"Buka Tools AI\"}],[\"$\",\"span\",null,{\"className\":\"material-symbols-outlined text-[16px]\",\"children\":\"arrow_forward\"}]]}]]}]}]]}],[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"Article\\\",\\\"headline\\\":\\\"Kalimat Aktif dan Pasif: Perbedaan, Ciri, dan Contoh\\\",\\\"description\\\":\\\"\\\",\\\"datePublished\\\":\\\"2026-09-22T00:00:00.000Z\\\",\\\"author\\\":{\\\"@type\\\":\\\"Organization\\\",\\\"name\\\":\\\"TugasMu\\\"}}\"}}]]}]\nc:[[\"$\",\"meta\",\"0\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}],[\"$\",\"meta\",\"1\",{\"charSet\":\"utf-8\"}],[\"$\",\"title\",\"2\",{\"children\":\"Kalimat Aktif dan Pasif: Perbedaan, Ciri, dan Contoh | TugasMu | TugasMu\"}],[\"$\",\"meta\",\"3\",{\"property\":\"og:title\",\"content\":\"Kalimat Aktif dan Pasif: Perbedaan, Ciri, dan Contoh\"}],[\"$\",\"meta\",\"4\",{\"property\":\"og:type\",\"content\":\"article\"}],[\"$\",\"meta\",\"5\",{\"property\":\"article:published_time\",\"content\":\"Tue Sep 22 2026 08:00:00 GMT+0800 (Central Indonesia Time)\"}],[\"$\",\"meta\",\"6\",{\"name\":\"twitter:card\",\"content\":\"summary\"}],[\"$\",\"meta\",\"7\",{\"name\":\"twitter:title\",\"content\":\"Kalimat Aktif dan Pasif: Perbedaan, Ciri, dan Contoh\"}],[\"$\",\"link\",\"8\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}]]\n1:null\nd:[[\"$\",\"h1\",null,{\"className\":\"font-headline-lg text-headline-lg text-on-surface tracking-tight mb-space-lg leading-tight\",\"children\":\"Kalimat Aktif dan Pasif: Perbedaan, Ciri, dan Contoh\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Kalimat Aktif dan Pasif membedakan peran subjek dalam tata bahasa Indonesia, baik sebagai pelaku kegiatan maupun penerima akibat tindakan. Pemahaman relasi kedua pola klausa ini membantumu menyusun tugas esai sekolah secara variatif sekaligus membaca teks bacaan secara kritis. Kamu dapat menganalisis perbedaan struktur tersebut lewat pengamatan predikat dan posisi objek dalam Kalimat Aktif dan Pasif.\"}],\"\\n\",[\"$\",\"h2\",null,{\"className\":\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\",\"children\":\"Apa Itu Kalimat Aktif dan Pasif: Perbedaan Mendasar\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":[\"Kalimat Aktif dan Pasif dibedakan dari posisi subjek terhadap predikat kerja di dalam klausa. Subjek pada kalimat aktif menjalankan pekerjaan secara mandiri, sedangkan subjek pada kalimat pasif menerima dampak perbuatan predikat. Kamu bisa memanfaatkan \",[\"$\",\"$Lb\",null,{\"href\":\"/tools/rangkuman\",\"children\":\"Alat Rangkuman TugasMu\"}],\" untuk meringkas materi kalimat panjang menjadi ikhtisar konsep yang padat saat belajar di rumah. Rangkuman materi tersebut mempermudah pemetaan parameter pembeda klausa melalui tabel perbandingan:\"]}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":[\"| Parameter Pembeda | Kalimat Aktif | Kalimat Pasif |\\r\\n| :--- | :--- | :--- |\\r\\n| \",[\"$\",\"strong\",null,{\"children\":\"Fokus Kalimat\"}],\" | Pelaku tindakan (aktor) | Sasaran perbuatan |\\r\\n| \",[\"$\",\"strong\",null,{\"children\":\"Peran Subjek\"}],\" | Melakukan pekerjaan | Menerima perlakuan |\\r\\n| \",[\"$\",\"strong\",null,{\"children\":\"Afiks Predikat\"}],\" | \",[\"$\",\"em\",null,{\"children\":\"me-\"}],\", \",[\"$\",\"em\",null,{\"children\":\"ber-\"}],\" | \",[\"$\",\"em\",null,{\"children\":\"di-\"}],\", \",[\"$\",\"em\",null,{\"children\":\"ter-\"}],\", bentuk klitika |\\r\\n| \",[\"$\",\"strong\",null,{\"children\":\"Status Objek\"}],\" | Berada di belakang verba | Berpindah posisi menjadi subjek |\\r\\n| \",[\"$\",\"strong\",null,{\"children\":\"Kata Perangkai\"}],\" | Tanpa preposisi pelaku | Memerlukan preposisi \",[\"$\",\"em\",null,{\"children\":\"oleh\"}],\" |\\r\\n| \",[\"$\",\"strong\",null,{\"children\":\"Contoh Klausa\"}],\" | Rian membaca novel | Novel dibaca oleh Rian |\"]}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Tabel perbandingan di atas memperlihatkan bagaimana fokus informasi bergeser saat posisi subjek bertukar peran dengan objek. Pergeseran fokus sintaksis tersebut memunculkan pertanyaan penting: mengapa kamu perlu memahami ciri spesifik masing-masing konstruksi kalimat sebelum mengubah strukturnya? Pertanyaan lanjutan tersebut terjawab saat kamu membedah karakteristik pembentuk klausa kalimat aktif.\"}],\"\\n\",[\"$\",\"h3\",null,{\"className\":\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\",\"children\":\"Ciri Kalimat Aktif: Subjek Melakukan Tindakan\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Kalimat aktif menempatkan aktor atau pelaku utama di awal klausa sebelum kata kerja predikat. Penempatan ini menegaskan bahwa subjek memegang kendali penuh atas aktivitas yang berlangsung. Karakteristik gramatikal yang menandai klausa aktif dalam teks meliputi:\"}],\"\\n\",[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"Subjek bertindak langsung sebagai eksekutor kegiatan dalam peristiwa.\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Predikat memakai verba aktif transitif atau intransitif.\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Kalimat aktif transitif mewajibkan objek penderita, contohnya \\\"Siswa menulis laporan penelitian\\\".\"}],\"\\n\"]}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Karakteristik aktif yang menonjolkan inisiatif pelaku ini berpasangan langsung dengan kalimat pasif.\"}],\"\\n\",[\"$\",\"h3\",null,{\"className\":\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\",\"children\":\"Ciri Kalimat Pasif: Subjek Dikenai Tindakan\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Kalimat pasif menempatkan objek penderita atau sasaran perbuatan pada posisi subjek di awal klausa. Pola ini mengalihkan perhatian pembaca menuju objek yang menerima perlakuan. Karakteristik struktural pembentuk klausa pasif mencakup:\"}],\"\\n\",[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"Subjek berstatus sebagai sasaran atau korban dari pekerjaan pihak luar.\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Predikat memakai kata kerja pasif berawalan khusus.\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Objek pelaku dapat disertai preposisi \\\"oleh\\\", contohnya \\\"Laporan penelitian ditulis oleh siswa\\\".\"}],\"\\n\"]}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Penonjolan sasaran ini memunculkan pertanyaan lanjutan: bagaimana memastikan fungsi predikat pasif jika kata perangkai pelaku dihilangkan? Predikat pasif tetap terbaca jelas lewat variasi imbuhan.\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Imbuhan pembentuk verba menjadi indikator morfologis paling konsisten untuk membedakan fungsi klausa pada Kalimat Aktif dan Pasif.\"}],\"\\n\",[\"$\",\"h2\",null,{\"className\":\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\",\"children\":\"Imbuhan Penanda Kalimat Aktif dan Pasif\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Kalimat Aktif dan Pasif dibedakan juga melalui imbuhan pembentuk verba yang melekat pada kata dasar predikat. Afiksasi morfologis tersebut berfungsi sebagai penanda gramatikal yang mengarahkan pembaca mengenali peran subjek. Kamu dapat mengidentifikasi pembagian kelompok imbuhan tersebut lewat klasifikasi kata kerja aktif.\"}],\"\\n\",[\"$\",\"h3\",null,{\"className\":\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\",\"children\":\"Imbuhan me- dan me-kan untuk Kalimat Aktif\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":[\"Kata kerja aktif umumnya dibentuk oleh prefiks \",[\"$\",\"em\",null,{\"children\":\"me-\"}],\", konfiks \",[\"$\",\"em\",null,{\"children\":\"me-kan\"}],\", atau konfiks \",[\"$\",\"em\",null,{\"children\":\"me-i\"}],\". Prefiks \",[\"$\",\"em\",null,{\"children\":\"me-\"}],\" mengalami variasi alomorf seperti \",[\"$\",\"em\",null,{\"children\":\"mem-\"}],\", \",[\"$\",\"em\",null,{\"children\":\"men-\"}],\", \",[\"$\",\"em\",null,{\"children\":\"meng-\"}],\", dan \",[\"$\",\"em\",null,{\"children\":\"meny-\"}],\" menyesuaikan huruf awal kata dasar. Ragam fungsi imbuhan aktif dalam tugas sekolah terdiri atas:\"]}],\"\\n\",[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[\"Awalan \",[\"$\",\"em\",null,{\"children\":\"me-\"}],\" pada verba tindakan langsung, contohnya \\\"Doni \",[\"$\",\"em\",null,{\"children\":\"membaca\"}],\" buku biologi\\\".\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"Konfiks \",[\"$\",\"em\",null,{\"children\":\"me-kan\"}],\" yang menyatakan membuat sesuatu terjadi, contohnya \\\"Ibu \",[\"$\",\"em\",null,{\"children\":\"membersihkan\"}],\" meja makan\\\".\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"Konfiks \",[\"$\",\"em\",null,{\"children\":\"me-i\"}],\" yang menyatakan perbuatan berulang, contohnya \\\"Polisi \",[\"$\",\"em\",null,{\"children\":\"mendatangi\"}],\" lokasi kejadian\\\".\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Perubahan alomorf ini memunculkan pertanyaan lanjutan: apa yang terjadi jika kata dasar diawali huruf K, T, S, atau P? Fonem tersebut luluh menjadi bunyi sengau jika diikuti vokal, berbeda dengan pembentukan kata kerja pasif.\"}],\"\\n\",[\"$\",\"h3\",null,{\"className\":\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\",\"children\":\"Imbuhan di- dan ter- untuk Kalimat Pasif\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":[\"Kata kerja pasif dibentuk melalui prefiks \",[\"$\",\"em\",null,{\"children\":\"di-\"}],\", prefiks \",[\"$\",\"em\",null,{\"children\":\"ter-\"}],\", konfiks \",[\"$\",\"em\",null,{\"children\":\"ke-an\"}],\", serta klitika pronomina. Awalan \",[\"$\",\"em\",null,{\"children\":\"di-\"}],\" menandakan perbuatan sengaja, sedangkan awalan \",[\"$\",\"em\",null,{\"children\":\"ter-\"}],\" menyatakan kejadian spontan atau kondisi selesai. Klasifikasi imbuhan pasif dalam bahasa Indonesia meliputi:\"]}],\"\\n\",[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":[\"Awalan \",[\"$\",\"em\",null,{\"children\":\"di-\"}],\" untuk tindakan pasif terencana, contohnya \\\"Buku biologi \",[\"$\",\"em\",null,{\"children\":\"dibaca\"}],\" oleh Doni\\\".\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"Awalan \",[\"$\",\"em\",null,{\"children\":\"ter-\"}],\" untuk kejadian tanpa sengaja, contohnya \\\"Gelas kaca \",[\"$\",\"em\",null,{\"children\":\"tersenggol\"}],\" siku hingga pecah\\\".\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"Konfiks \",[\"$\",\"em\",null,{\"children\":\"ke-an\"}],\" untuk menyatakan terkena keadaan, contohnya \\\"Rombongan siswa \",[\"$\",\"em\",null,{\"children\":\"kehujanan\"}],\" di jalan\\\".\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"Klitika pronomina persona yang melekat pada kata dasar, contohnya \\\"Surat itu sudah \",[\"$\",\"em\",null,{\"children\":\"kutulis\"}],\" kemarin\\\".\"]}],\"\\n\"]}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Bentuk pasif dengan klitika maupun prefiks ini menjadi fondasi sebelum kamu mempraktikkan konversi klausa pada Kalimat Aktif.\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Kalimat Aktif dengan predikat berimbuhan transitif tersebut membutuhkan ketepatan prosedur teknis saat kamu mempelajari cara mengubah Kalimat Aktif.\"}],\"\\n\",[\"$\",\"h2\",null,{\"className\":\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\",\"children\":\"Cara Mengubah Kalimat Aktif menjadi Pasif (dan Sebaliknya)\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Kalimat Aktif dapat diubah menjadi Pasif dengan merotasi fungsi sintaksis antarunsur klausa tanpa mengubah makna semantik pesan. Transformasi ini menuntut pertukaran posisi subjek dan objek disertai pergantian morfem predikat. Bimbingan AI di TugasMu melatihmu memahami logika berpikir di balik aturan tata bahasa ini, bukan sekadar menghafal jawaban instan. Pahami konsepnya secara runtut agar kamu terampil menyelesaikan tugas perubahan kalimat aktif.\"}],\"\\n\",[\"$\",\"h3\",null,{\"className\":\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\",\"children\":\"Langkah Mengubah Kalimat Aktif ke Pasif\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Kalimat aktif transitif dapat kamu ubah menjadi bentuk pasif melalui tiga tahapan teknis berikut:\"}],\"\\n\",[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"Pertama, pindahkan objek penderita kalimat aktif menjadi subjek di posisi awal kalimat pasif.\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"Kedua, ganti awalan \",[\"$\",\"em\",null,{\"children\":\"me-\"}],\" pada verba predikat menjadi awalan pasif \",[\"$\",\"em\",null,{\"children\":\"di-\"}],\" atau bentuk klitika.\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Ketiga, tempatkan subjek kalimat aktif di belakang predikat dengan menambahkan kata \\\"oleh\\\".\"}],\"\\n\"]}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Contoh perubahan ini tampak pada kalimat: \\\"Arsitek (S) merancang (P) gedung (O)\\\" yang bertransformasi menjadi \\\"Gedung (S) dirancang (P) oleh arsitek (Pel)\\\". Langkah konversi ini memunculkan pertanyaan lanjutan: bisakah kamu mempasifkan kalimat intransitif seperti \\\"Burung terbang tinggi\\\"? Kalimat intransitif tidak dapat dipasifkan karena tidak memiliki objek untuk dijadikan subjek kalimat pasif.\"}],\"\\n\",[\"$\",\"h3\",null,{\"className\":\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\",\"children\":\"Langkah Mengubah Kalimat Pasif ke Aktif\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Kalimat pasif dapat kamu kembalikan menjadi klausa aktif dengan membalik urutan langkah gramatikal:\"}],\"\\n\",[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"Pertama, pindahkan objek pelaku di belakang predikat menjadi subjek di awal kalimat aktif.\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"Kedua, ubah awalan pasif \",[\"$\",\"em\",null,{\"children\":\"di-\"}],\" pada predikat kembali menjadi awalan aktif \",[\"$\",\"em\",null,{\"children\":\"me-\"}],\".\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Ketiga, posisikan subjek penderita kalimat pasif menjadi objek di belakang verba aktif.\"}],\"\\n\"]}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Penerapan langkah ini terlihat pada contoh: \\\"Laporan (S) diselesaikan (P) oleh peneliti (Pel)\\\" yang dikonversi kembali menjadi \\\"Peneliti (S) menyelesaikan (P) laporan (O)\\\". Penguasaan prosedur transformasi dua arah ini melatih kecakapan sintaksis saat kamu menulis ragam Kalimat Aktif dan Pasif.\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Kalimat Aktif dan Pasif yang telah kamu kuasai secara mekanis menuntut ketepatan pemilihan format sesuai tujuan komunikasi dalam teks tertulis Kalimat Aktif dan Pasif.\"}],\"\\n\",[\"$\",\"h2\",null,{\"className\":\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\",\"children\":\"Kapan Menggunakan Kalimat Aktif vs Pasif dalam Teks\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Kalimat Aktif dan Pasif memiliki konteks penggunaan yang berbeda tergantung genre teks dan target pembaca. Penulis memadukan kedua jenis kalimat secara proporsional guna membangun ritme tulisan yang runtut dan efektif. Penerapan gaya penulisan ini terlihat nyata saat kamu menyusun paragraf dengan kalimat aktif.\"}],\"\\n\",[\"$\",\"h3\",null,{\"className\":\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\",\"children\":\"Kalimat Aktif untuk Teks Narasi dan Berita\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Kalimat aktif menjadi pilihan utama dalam teks narasi, cerpen, dan berita langsung karena menonjolkan ketegasan aksi. Susunan aktif mengalirkan energi gerak yang cepat sehingga pembaca terhubung erat dengan tokoh cerita. Keunggulan pemakaian kalimat aktif dalam teks penceritaan mencakup:\"}],\"\\n\",[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"Menegaskan sosok tokoh yang mengambil inisiatif tindakan penting dalam alur cerita.\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Membentuk kalimat lugas dan padat, misalnya \\\"Pemerintah meresmikan jembatan baru kemarin\\\".\"}],\"\\n\"]}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Ketegasan aksi aktif memunculkan pertanyaan lanjutan: mengapa gaya dinamis ini dibatasi dalam karya ilmiah yang mengutamakan kalimat pasif? Teks ilmiah memprioritaskan netralitas metode riset daripada figur personal peneliti yang diwakili oleh kalimat pasif.\"}],\"\\n\",[\"$\",\"h3\",null,{\"className\":\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\",\"children\":\"Kalimat Pasif untuk Teks Ilmiah dan Formal\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Kalimat pasif memegang fungsi sentral dalam laporan praktikum, artikel jurnal, dan surat resmi kenegaraan. Format pasif membantu penulis menjaga objektivitas laporan agar terbebas dari bias opini pribadi. Alasan struktural penggunaan kalimat pasif dalam karya ilmiah meliputi:\"}],\"\\n\",[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"Menghindari kata ganti orang pertama seperti \\\"saya\\\" agar perhatian tertuju pada objek uji, misalnya \\\"Sampel dipanaskan pada suhu 60 derajat Celsius\\\".\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Menyorot metodologi dan temuan data daripada individu yang mengoperasikan alat laboratorium.\"}],\"\\n\"]}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Penggunaan kalimat pasif yang tepat pada laporan ilmiah menjaga standar akademis dalam penulisan Kalimat Aktif dan Pasif.\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Kalimat Aktif dan Pasif yang kamu gunakan secara seimbang menghasilkan tulisan yang logis, tajam, dan mudah dipahami oleh pembaca Kalimat Aktif dan Pasif.\"}],\"\\n\",[\"$\",\"h2\",null,{\"className\":\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\",\"children\":\"Rangkuman Inti Kalimat Aktif dan Pasif\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Kalimat Aktif dan Pasif memegang peranan kunci dalam struktur tata bahasa Indonesia dengan empat rangkuman deklaratif pokok:\"}],\"\\n\",[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"Perbedaan mendasar terletak pada posisi subjek, di mana subjek aktif menjadi pelaku tindakan sedangkan subjek pasif menjadi penerima perbuatan.\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":[\"Imbuhan predikat menjadi pembeda morfologis, dengan awalan \",[\"$\",\"em\",null,{\"children\":\"me-\"}],\" membentuk verba aktif serta awalan \",[\"$\",\"em\",null,{\"children\":\"di-\"}],\" atau \",[\"$\",\"em\",null,{\"children\":\"ter-\"}],\" membentuk verba pasif.\"]}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Transformasi antarbentuk menuntut pertukaran posisi subjek dan objek yang hanya berlaku pada verba aktif transitif.\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Konteks pemakaian ditentukan oleh genre teks, dengan kalimat aktif memperkuat teks narasi dan kalimat pasif menjaga objektivitas teks ilmiah.\"}],\"\\n\"]}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":[\"Teks ilmiah maupun tulisan narasi menuntut kecermatan berbahasa agar gagasanmu tersampaikan secara utuh. Kamu dapat memperluas wawasan kebahasaan lainnya di kategori \",[\"$\",\"$Lb\",null,{\"href\":\"/blog/bahasa-indonesia/\",\"children\":\"Bahasa Indonesia\"}],\", termasuk membaca panduan \",[\"$\",\"$Lb\",null,{\"href\":\"/blog/bahasa-indonesia/cara-mencari-ide-pokok-paragraf\",\"children\":\"cara mencari ide pokok paragraf\"}],\" untuk menyusun wacana berbobot. TugasMu hadir sebagai teman pintar belajar yang mendampingimu memahami konsep kebahasaan secara mendalam melalui bimbingan AI. Bukan tools curang, tapi teman pintar belajarmu yang mengasah logika berpikir dalam menuntaskan tugas sekolah. Gunakan \",[\"$\",\"$Lb\",null,{\"href\":\"/tools/rangkuman\",\"children\":\"Alat Rangkuman TugasMu\"}],\" untuk meringkas materi kalimat dan konsep pelajaran lainnya secara praktis dan terstruktur.\"]}]]\n"}