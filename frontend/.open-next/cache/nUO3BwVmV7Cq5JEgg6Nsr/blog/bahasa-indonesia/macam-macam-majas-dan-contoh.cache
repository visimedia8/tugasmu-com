 sudah dihapus, dipindahkan, atau memang tidak pernah ada.\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex flex-col sm:flex-row gap-4\\\",\\\"children\\\":[[\\\"$\\\",\\\"$Le\\\",null,{\\\"href\\\":\\\"/\\\",\\\"className\\\":\\\"bg-sky-600 text-white font-bold py-3 px-6 rounded-xl hover:bg-sky-700 transition-colors\\\",\\\"children\\\":\\\"Kembali ke Beranda\\\"}],[\\\"$\\\",\\\"$Le\\\",null,{\\\"href\\\":\\\"/tools\\\",\\\"className\\\":\\\"bg-white border-2 border-slate-200 text-slate-700 font-bold py-3 px-6 rounded-xl hover:border-slate-300 hover:bg-slate-50 transition-colors\\\",\\\"children\\\":\\\"Jelajahi Tools AI\\\"}]]}]]}],\\\"notFoundStyles\\\":[]}]}],[\\\"$\\\",\\\"footer\\\",null,{\\\"className\\\":\\\"bg-slate-50 border-t border-slate-200 py-10 mt-auto\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex flex-col md:flex-row items-center justify-between gap-6\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex flex-col sm:flex-row items-center gap-3 sm:gap-6 text-center sm:text-left\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex items-center gap-2\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"w-7 h-7 rounded-lg bg-sky-500 flex items-center justify-center text-white\\\",\\\"children\\\":[\\\"$\\\",\\\"svg\\\",null,{\\\"className\\\":\\\"w-3.5 h-3.5 fill-white\\\",\\\"viewBox\\\":\\\"0 0 24 24\\\",\\\"children\\\":[\\\"$\\\",\\\"polygon\\\",null,{\\\"points\\\":\\\"13 2 3 14 12 14 11 22 21 10 12 10 13 2\\\"}]}]}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"font-bold text-slate-900 text-base font-heading\\\",\\\"children\\\":\\\"TugasMu.com\\\"}]]}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-xs sm:text-sm text-slate-500\\\",\\\"children\\\":\\\"© 2026 TugasMu.com. Hak cipta dilindungi.\\\"}]]}],[\\\"$\\\