\\"]}]]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex items-center gap-2 pt-space-xs sm:pt-0\\\",\\\"children\\\":[\\\"$\\\",\\\"button\\\",null,{\\\"className\\\":\\\"inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-surface-container-lowest hover:bg-surface-container text-secondary font-label-md text-label-md transition-all shadow-sm\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"material-symbols-outlined text-[18px]\\\",\\\"children\\\":\\\"share\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"hidden sm:inline\\\",\\\"children\\\":\\\"Bagikan\\\"}]]}]}]]}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"prose-content flex flex-col gap-space-lg text-on-surface font-body-lg text-body-lg leading-relaxed bg-surface-container-lowest p-space-lg md:p-space-xl rounded-xl shadow-sm border border-slate-100\\\",\\\"children\\\":\\\"$L12\\\"}],[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"mt-space-xl p-space-lg md:p-space-xl rounded-xl bg-surface-container-lowest shadow-sm flex flex-col sm:flex-row items-start sm:items-center gap-space-lg border border-slate-100\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"w-16 h-16 rounded-full bg-primary-container text-on-primary flex items-center justify-center font-headline-lg text-headline-lg font-bold shrink-0 shadow-md ring-4 ring-primary-fixed\\\",\\\"children\\\":\\\"TM\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex flex-col gap-1.5 flex-1\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"flex flex-wrap items-center gap-2\\\",\\\"children\\\":[[\\\"$\\\",\\\"h4\\\",null,{\\\"className\\\":\\\"font-headline-sm text-headline-sm text-on-surface font-bold\\\",\\\"children\\\":\\\"Redaksi TugasMu\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"px-2.5 py-0.5 rounded-full bg-secondary text-on-secondary font-label-sm text-label-sm\\\",\\\"children\\\":\\\"Tim Edukasi\\\"}]]}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant\\\",\\\"children\\\":\\\"Tim kurator konten yang berdedikasi untuk membagikan tips belajar, pembaruan kurikulum, dan cara cerdas memanfaatkan AI bagi pelajar Indonesia.\\\"}]]}]]}]]}],[\\\"$\\\",\\\"aside\\\",null,{\\\"className\\\":\\\"lg:col-span-4 flex flex-col gap-space-lg lg:sticky lg:top-24\\\",\\\"children\\\":[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"p-space-lg rounded-xl bg-gradient-to-b from-surface-container to-surface-container-high shadow-sm flex flex-col gap-space-md border border-slate-100\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"w-10 h-10 rounded-xl bg-primary-container text-on-primary flex items-center justify-center shadow-xs\\\",\\\"children\\\":[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"material-symbols-outlined text-[22px]\\\",\\\"children\\\":\\\"auto_awesome\\\"}]}],[\\\"$\\\",\\\"div\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"h4\\\",null,{\\\"className\\\":\\\"font-headline-sm text-headline-sm text-on-surface font-bold\\\",\\\"children\\\":\\\"Butuh Bantuan Tugas?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-sm text-body-sm text-on-surface-variant mt-1\\\",\\\"children\\\":\\\"Gunakan asisten AI TugasMu secara gratis. Buat soal, parafrase makalah, dan temukan jawaban dari PR-mu.\\\"}]]}],[\\\"$\\\",\\\"$Le\\\",null,{\\\"href\\\":\\\"/tools\\\",\\\"className\\\":\\\"w-full inline-flex items-center justify-center gap-2 bg-primary-container hover:bg-primary text-on-primary py-2.5 px-4 rounded-xl font-label-md text-label-md transition-all shadow-sm\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"children\\\":\\\"Buka Tools AI\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"material-symbols-outlined text-[16px]\\\",\\\"children\\\":\\\"arrow_forward\\\"}]]}]]}]}]]}],[\\\"$\\\",\\\"script\\\",null,{\\\"type\\\":\\\"application/ld+json\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"{\\\\\\\"@context\\\\\\\":\\\\\\\"https://schema.org\\\\\\\",\\\\\\\"@type\\\\\\\":\\\\\\\"Article\\\\\\\",\\\\\\\"headline\\\\\\\":\\\\\\\"Hukum Newton 1, 2, dan 3: Bunyi, Rumus, dan Contoh\\\\\\\",\\\\\\\"description\\\\\\\":\\\\\\\"\\\\\\\",\\\\\\\"datePublished\\\\\\\":\\\\\\\"2026-09-22T00:00:00.000Z\\\\\\\",\\\\\\\"author\\\\\\\":{\\\\\\\"@type\\\\\\\":\\\\\\\"Organization\\\\\\\",\\\\\\\"name\\\\\\\":\\\\\\\"TugasMu\\\\\\\"}}\\\"}}]]}]\\n\"])</script><script>self.__next_f.push([1,\"f:[[\\\"$\\\",\\\"meta\\\",\\\"0\\\",{\\\"name\\\":\\\"viewport\\\",\\\"content\\\":\\\"width=device-width, initial-scale=1\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"charSet\\\":\\\"utf-8\\\"}],[\\\"$\\\",\\\"title\\\",\\\"2\\\",{\\\"children\\\":\\\"Hukum Newton 1, 2, dan 3: Bunyi, Rumus, dan Contoh | TugasMu | TugasMu\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"3\\\",{\\\"property\\\":\\\"og:title\\\",\\\"content\\\":\\\"Hukum Newton 1, 2, dan 3: Bunyi, Rumus, dan Contoh\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"4\\\",{\\\"property\\\":\\\"og:type\\\",\\\"content\\\":\\\"article\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"5\\\",{\\\"property\\\":\\\"article:published_time\\\",\\\"content\\\":\\\"Tue Sep 22 2026 08:00:00 GMT+0800 (Central Indonesia Time)\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"6\\\",{\\\"name\\\":\\\"twitter:card\\\",\\\"content\\\":\\\"summary\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"7\\\",{\\\"name\\\":\\\"twitter:title\\\",\\\"content\\\":\\\"Hukum Newton 1, 2, dan 3: Bunyi, Rumus, dan Contoh\\\"}],[\\\"$\\\",\\\"link\\\",\\\"8\\\",{\\\"rel\\\":\\\"icon\\\",\\\"href\\\":\\\"/favicon.ico\\\",\\\"type\\\":\\\"image/x-icon\\\",\\\"sizes\\\":\\\"16x16\\\"}]]\\n4:null\\n\"])</script><script>self.__next_f.push([1,\"12:[[\\\"$\\\",\\\"h1\\\",null,{\\\"className\\\":\\\"font-headline-lg text-headline-lg text-on-surface tracking-tight mb-space-lg leading-tight\\\",\\\"children\\\":\\\"Hukum Newton 1, 2, dan 3: Bunyi, Rumus, dan Contoh\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":[\\\"Hukum Newton membentuk fondasi utama mekanika klasik yang menjelaskan bagaimana gaya mempengaruhi gerak benda dalam kehidupan sehari-hari maupun \\\",[\\\"$\\\",\\\"$Le\\\",null,{\\\"href\\\":\\\"/blog/ipa/\\\",\\\"children\\\":\\\"Ilmu Pengetahuan Alam\\\"}],\\\". Teman pintar belajar dapat memanfaatkan \\\",[\\\"$\\\",\\\"$Le\\\",null,{\\\"href\\\":\\\"/tools/generator-soal\\\",\\\"children\\\":\\\"Generator Soal TugasMu\\\"}],\\\" untuk mengasah kemampuan analisis melalui latihan soal interaktif. Pahami konsepnya agar tugasmu dalam menyelesaikan persoalan fisika menjadi jauh lebih terstruktur dan menyenangkan.\\\"]}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\\\",\\\"children\\\":\\\"Sejarah Singkat dan Pengertian Hukum Newton\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Hukum Newton adalah sekumpulan prinsip fundamental yang dirumuskan oleh fisikawan terkemuka dunia untuk menjelaskan hubungan antara gaya yang bekerja pada suatu benda dan pergerakan yang ditimbulkannya. Bagaimana fisikawan abad ke-17 menyusun prinsip mekanika tersebut secara sistematis? Ilmuwan asal Inggris bernama Sir Isaac Newton mempublikasikan hukum ini dalam karya monumentalnya yang berjudul Philosophiæ Naturalis Principia Mathematica pada tahun 1687.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\\\",\\\"children\\\":\\\"Penemuan Hukum Newton oleh Sir Isaac Newton\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Hukum Newton lahir dari pengamatan mendalam terhadap fenomena alam di sekitar laboratorium riset sang penemu. Penemuan ini merangkum tiga prinsip utama yang mengatur dinamika benda diam maupun benda bergerak dengan kecepatan tertentu. Pertanyaan mendasar mengenai mengapa sebuah apel jatuh ke tanah mengarahkan sang jenius pada pemahaman gravitasi universal. Gravitasi universal tersebut kemudian berkembang menjadi fondasi mekanika klasik yang bertahan hingga era modern saat ini.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\\\",\\\"children\\\":\\\"Konsep Dasar Gaya dan Gerak dalam Fisika\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Gaya dan gerak merupakan dua variabel fisik yang saling terikat erat dalam setiap eksperimen laboratorium maupun peristiwa harian. Konsep dasar ini menyatakan bahwa perubahan posisi benda selalu dipengaruhi oleh tarikan atau dorongan luar yang bekerja secara kontinu. Mengapa benda yang didorong di atas lantai kasar lebih cepat berhenti dibandingkan lantai licin? Hambatan gesek antarpermukaan memberikan gaya perlawanan yang mengurangi kecepatan gerak benda tersebut secara drastis.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Transisi dari pemahaman teoretis menuju perhitungan matematis memerlukan penguasaan prinsip dasar dinamika benda secara menyeluruh sebelum melangkah ke rumus lanjutan.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\\\",\\\"children\\\":\\\"Bunyi Hukum Newton 1, 2, dan 3 beserta Rumusnya\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Hukum Newton terbagi menjadi tiga hukum utama yang masing-masing memiliki karakteristik unik dalam menjelaskan perilaku mekanis benda. Apa saja perbedaan mendasar dari ketiga hukum tersebut dalam lembar kerja fisikamu? Perhatikan rangkuman bunyi hukum dan persamaan matematisnya melalui tabel perbandingan struktur berikut.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":[\\\"| Hukum Fisika | Bunyi Prinsip Utama | Persamaan Matematis | Keterangan Variabel |\\\\n| --- | --- | --- | --- |\\\\n| Hukum I Newton | Resultan gaya pada benda bernilai nol, sehingga benda diam tetap diam dan benda bergerak lurus beraturan tetap bergerak. | $\\\\\\\\Sigma F = 0$ | $\\\\\\\\Sigma F$ = Jumlah gaya (Newton) |\\\\n| Hukum II Newton | Percepatan sebuah benda berbanding lurus dengan resultan gaya dan berbanding terbalik dengan massa benda. | $F = m \\\\\\\\times a$ | $F$ = Gaya, $m$ = Massa, $a$ = Percepatan |\\\\n| Hukum III Newton | Gaya aksi dan reaksi dari dua benda besarnya sama tetapi berlawanan arah ($F_\\\",\\\" = -F_\\\",\\\"$$). | $F_\\\",\\\" = -F_\\\",\\\"$$ | Tanda minus menunjukkan arah berlawanan |\\\"]}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\\\",\\\"children\\\":\\\"Hukum I Newton (Kelembaman/Inersia)\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Hukum I Newton menjelaskan sifat kelembaman atau kecenderungan suatu benda untuk mempertahankan keadaan gerak awalnya secara konstan. Sifat kelembaman ini membuat penumpang bus terdorong ke depan saat sopir mendadak menginjak rem darurat. Bagaimana cara menghitung besar inersia pada benda bermassa besar? Massa benda yang lebih besar memiliki kelembaman yang jauh lebih tinggi sehingga lebih sulit untuk diubah keadaan geraknya.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\\\",\\\"children\\\":\\\"Hukum II Newton (F = m.a) dan Hukum III Newton (Aksi-Reaksi)\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Hukum II Newton menghubungkan percepatan benda dengan massa serta besar gaya total yang bekerja padanya. Hubungan matematis tersebut menunjukkan bahwa penambahan gaya dorong pada massa tetap akan memperbesar percepatan benda secara proporsional. Bagaimanakah penerapan Hukum III Newton dalam peristiwa sehari-hari? Aktivitas melompat ke depan dari atas perahu mendorong perahu tersebut bergerak mundur ke arah sebaliknya.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Penerapan rumus matematika dalam lembar ujian menuntut ketelitian tinggi dalam mengonversi satuan besaran pokok fisika secara tepat.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\\\",\\\"children\\\":\\\"Cara Mengerjakan Soal Fisika tentang Hukum Newton\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Hukum Newton dapat dihitung dengan langkah-langkah sistematis yang memudahkanmu menemukan solusi akhir tanpa kebingungan. Langkah pengerjaan yang benar menghindarkanmu dari kesalahan fatal dalam menentukan arah gaya atau nilai massa. Apa saja tahapan penting yang wajib kamu lakukan saat menghadapi soal cerita ujian? Tahapan penyelesaian soal fisika meliputi identifikasi variabel, penggambaran diagram gaya, penentuan rumus, dan kalkulasi akhir.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\\\",\\\"children\\\":\\\"Mengidentifikasi Gaya yang Bekerja pada Benda\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Mengidentifikasi gaya yang bekerja pada benda merupakan langkah awal paling krusial dalam menyelesaikan persoalan mekanika fisika. Identifikasi ini mencakup gaya berat, gaya normal, gaya gesek, serta gaya tarik tali yang terpasang pada sistem. Mengapa diagram gaya bebas sangat membantu siswa dalam menganalisis soal rumit? Diagram gaya visual menyederhanakan interaksi kompleks antarvektor gaya menjadi persamaan skalar yang mudah diselesaikan.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\\\",\\\"children\\\":\\\"Menerapkan Rumus F = m x a pada Soal Cerita\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Menerapkan rumus $F = m \\\\\\\\times a$ pada soal cerita memerlukan ketelitian dalam menyusun persamaan aljabar sederhana. Penerapan rumus ini biasanya melibatkan pencarian percepatan benda jika massa dan gaya total telah diketahui nilainya secara pasti. Variasi soal apa saja yang sering muncul dalam ujian sekolah tingkat menengah? Soal sering menampilkan bidang miring licin, sistem katrol ganda, atau gerak benda bersentuhan di atas lantai.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Perhitungan matematis yang akurat harus diuji kembali dengan melihat realitas fisik di lingkungan sekitar agar relevansi konsep tetap terjaga.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\\\",\\\"children\\\":\\\"Contoh Penerapan Hukum Newton dalam Kehidupan Sehari-hari\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Hukum Newton memiliki banyak penerapan nyata yang dapat kamu temukan dengan mudah di lingkungan sekitarmu setiap hari. Penerapan ini membuktikan bahwa rumus fisika bukan sekadar teori abstrak di dalam buku teks sekolah. Fenomena apa saja yang menunjukkan bekerjanya hukum fisika mekanik ini di sekeliling kita? Pengamatan langsung membantu memperkuat pemahaman konseptualmu sebelum menghadapi ujian akhir semester.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\\\",\\\"children\\\":\\\"Contoh Kelembaman saat Mengerem Mobil\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Contoh kelembaman saat mengerem mobil dapat dirasakan langsung oleh setiap penumpang di dalam kendaraan bermotor tersebut. Kelembaman tubuh penumpang mempertahankan kecepatan gerak maju ketika mobil secara mendadak berhenti total akibat pengereman. Mengapa sabuk pengaman diciptakan untuk mengatasi efek hukum kelembaman ini? Sabuk pengaman memberikan gaya eksternal penahan agar tubuh penumpang tidak membentur kaca depan kendaraan.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\\\",\\\"children\\\":\\\"Contoh Aksi-Reaksi saat Mendayung Perahu\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Contoh aksi-reaksi saat mendayung perahu melibatkan dorongan air oleh dayung ke belakang sebagai gaya aksi nyata. Gaya reaksi air mendorong perahu melaju ke depan dengan kecepatan yang sebanding dengan kuatnya dayungan. Prinsip kerja mesin roket luar angkasa juga menggunakan hukum aksi-reaksi gas buang pembakaran bahan bakar. Roket terdorong ke atas menembus atmosfer bumi karena semburan gas panas mengarah ke bawah secara masif.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Penerapan prinsip mekanika klasik dalam berbagai teknologi modern membuktikan keandalan rumus fisika ciptaan sang ilmuwan legendaris.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\\\",\\\"children\\\":\\\"Kesimpulan Hukum Gaya dan Gerak\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":[\\\"Hukum Newton adalah prinsip fundamental fisika yang menjelaskan hubungan antara gaya dan gerak benda secara komprehensif. Sejarah penemuan hukum ini oleh Sir Isaac Newton meletakkan dasar mekanika klasik yang sangat berpengaruh. Bunyi dan rumus ketiga hukum tersebut memberikan kerangka kerja analitis untuk menghitung dinamika suatu sistem. Cara mengerjakan soal fisika menuntut langkah sistematis mulai dari identifikasi gaya hingga penerapan persamaan matematis. Contoh penerapan dalam kehidupan sehari-hari menunjukkan bahwa mekanika klasik bekerja nyata di sekeliling kita. Tingkatkan pemahamanmu melalui materi lanjutan mengenai \\\",[\\\"$\\\",\\\"$Le\\\",null,{\\\"href\\\":\\\"/blog/ipa/rumus-gerak-lurus\\\",\\\"children\\\":\\\"Rumus Gerak Lurus\\\"}],\\\" di \\\",[\\\"$\\\",\\\"$Le\\\",null,{\\\"href\\\":\\\"/blog/ipa/\\\",\\\"children\\\":\\\"Ilmu Pengetahuan Alam\\\"}],\\\".\\\"]}]]\\n\"])</script></body></html>","rsc":"3:I[4707,[],\"\"]\n6:I[6423,[],\"\"]\n7:I[8003,[\"3433\",\"static/chunks/3433-9ddc6f7f78d9421c.js\",\"2972\",\"static/chunks/2972-8ce94bd856f9372b.js\",\"3185\",\"static/chunks/app/layout-c819fc26cf8b0e32.js\"],\"\"]\n8:I[9314,[\"3433\",\"static/chunks/3433-9ddc6f7f78d9421c.js\",\"2972\",\"static/chunks/2972-8ce94bd856f9372b.js\",\"3185\",\"static/chunks/app/layout-c819fc26cf8b0e32.js\"],\"default\"]\n9:I[6454,[\"3433\",\"static/chunks/3433-9ddc6f7f78d9421c.js\",\"2972\",\"static/chunks/2972-8ce94bd856f9372b.js\",\"3185\",\"static/chunks/app/layout-c819fc26cf8b0e32.js\"],\"Navbar\"]\na:I[482,[\"3433\",\"static/chunks/3433-9ddc6f7f78d9421c.js\",\"2972\",\"static/chunks/2972-8ce94bd856f9372b.js\",\"3185\",\"static/chunks/app/layout-c819fc26cf8b0e32.js\"],\"default\"]\nb:I[2972,[\"2972\",\"static/chunks/2972-8ce94bd856f9372b.js\",\"9064\",\"static/chunks/app/blog/%5Bkategori%5D/%5Bslug%5D/page-66ee61aaeae9a3c2.js\"],\"\"]\n4:[\"kategori\",\"ipa\",\"d\"]\n5:[\"slug\",\"hukum-newton-1-2-3\",\"d\"]\n0:[\"nUO3BwVmV7Cq5JEgg6Nsr\",[[[\"\",{\"children\":[\"blog\",{\"children\":[[\"kategori\",\"ipa\",\"d\"],{\"children\":[[\"slug\",\"hukum-newton-1-2-3\",\"d\"],{\"children\":[\"__PAGE__?{\\\"kategori\\\":\\\"ipa\\\",\\\"slug\\\":\\\"hukum-newton-1-2-3\\\"}\",{}]}]}]}]},\"$undefined\",\"$undefined\",true],[\"\",{\"children\":[\"blog\",{\"children\":[[\"kategori\",\"ipa\",\"d\"],{\"children\":[[\"slug\",\"hukum-newton-1-2-3\",\"d\"],{\"children\":[\"__PAGE__\",{},[[\"$L1\",\"$L2\",null],null],null]},[null,[\"$\",\"$L3\",null,{\"parallelRouterKey\":\"children\",\"segmentPath\":[\"children\",\"blog\",\"children\",\"$4\",\"children\",\"$5\",\"children\"],\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L6\",nul