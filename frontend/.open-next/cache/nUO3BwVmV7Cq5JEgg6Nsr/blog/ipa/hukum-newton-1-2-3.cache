{"type":"app","meta":{"headers":{"x-next-cache-tags":"_N_T_/layout,_N_T_/blog/layout,_N_T_/blog/[kategori]/layout,_N_T_/blog/[kategori]/[slug]/layout,_N_T_/blog/[kategori]/[slug]/page,_N_T_/blog/ipa/hukum-newton-1-2-3"}},"html":"<!DOCTYPE html><html lang=\"id\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/css/c70a6d8e0709b465.css\" data-precedence=\"next\"/><link rel=\"stylesheet\" href=\"/_next/static/css/7eb325243a3b1d61.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-37f8c22e297b04f8.js\"/><script src=\"/_next/static/chunks/fd9d1056-2718004965b0207a.js\" async=\"\"></script><script src=\"/_next/static/chunks/2117-c5687b942395652d.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-f30bb01764683cd9.js\" async=\"\"></script><script src=\"/_next/static/chunks/3433-9ddc6f7f78d9421c.js\" async=\"\"></script><script src=\"/_next/static/chunks/2972-8ce94bd856f9372b.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-c819fc26cf8b0e32.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/blog/%5Bkategori%5D/%5Bslug%5D/page-66ee61aaeae9a3c2.js\" async=\"\"></script><link rel=\"preload\" href=\"https://www.googletagmanager.com/gtag/js?id=G-8K10RNGN76\" as=\"script\"/><link rel=\"preload\" href=\"https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXXXXXXXX\" as=\"script\" crossorigin=\"\"/><title>Hukum Newton 1, 2, dan 3: Bunyi, Rumus, dan Contoh | TugasMu | TugasMu</title><meta property=\"og:title\" content=\"Hukum Newton 1, 2, dan 3: Bunyi, Rumus, dan Contoh\"/><meta property=\"og:type\" content=\"article\"/><meta property=\"article:published_time\" content=\"Tue Sep 22 2026 08:00:00 GMT+0800 (Central Indonesia Time)\"/><meta name=\"twitter:card\" content=\"summary\"/><meta name=\"twitter:title\" content=\"Hukum Newton 1, 2, dan 3: Bunyi, Rumus, dan Contoh\"/><link rel=\"icon\" href=\"/favicon.ico\" type=\"image/x-icon\" sizes=\"16x16\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"font-sans bg-brand-cream text-brand-navy flex flex-col min-h-screen __variable_0d7163 __variable_5667dc\"><header class=\"sticky top-0 z-50 w-full\"><div class=\"bg-brand-cream/95 backdrop-blur-md border-b border-brand-navy/10\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between\"><a class=\"flex items-center gap-2.5 group\" href=\"/\"><div class=\"w-8 h-8 rounded-lg bg-brand-navy flex items-center justify-center shadow-sm group-hover:bg-brand-lime transition-colors duration-300\"><svg class=\"w-4 h-4 fill-brand-cream group-hover:fill-brand-navy transition-colors duration-300\" viewBox=\"0 0 24 24\"><polygon points=\"13 2 3 14 12 14 11 22 21 10 12 10 13 2\"></polygon></svg></div><span class=\"font-heading font-bold text-xl text-brand-navy tracking-tight group-hover:text-brand-navy/70 transition-colors\">TugasMu</span></a><nav class=\"hidden md:flex items-center gap-1\"><a class=\"relative px-4 py-2 text-sm font-semibold rounded-full transition-all duration-200 text-brand-navy/70 hover:text-brand-navy hover:bg-brand-navy/5\" href=\"/tools\">AI Tools</a><a class=\"relative px-4 py-2 text-sm font-semibold rounded-full transition-all duration-200 text-brand-navy/70 hover:text-brand-navy hover:bg-brand-navy/5\" href=\"/harga\">Premium</a><a class=\"relative px-4 py-2 text-sm font-semibold rounded-full transition-all duration-200 text-brand-navy bg-brand-lime\" href=\"/blog\">Blog</a></nav><div class=\"hidden md:flex items-center gap-3\"><a class=\"px-5 py-2.5 rounded-full bg-brand-navy hover:bg-brand-navy/90 text-brand-cream font-bold text-sm transition-all shadow-sm hover:shadow-md active:scale-95 flex items-center gap-2\" href=\"/masuk\">Masuk / Daftar</a></div><div class=\"flex md:hidden items-center gap-3\"><button class=\"p-2 rounded-full text-brand-navy hover:bg-brand-navy/5 transition-colors\" aria-label=\"Toggle Menu\"><svg class=\"w-5 h-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\"><line x1=\"3\" y1=\"8\" x2=\"21\" y2=\"8\"></line><line x1=\"3\" y1=\"16\" x2=\"21\" y2=\"16\"></line></svg></button></div></div></div></header><div class=\"bg-slate-50 border-b\"><div class=\"container py-3\"><nav class=\"flex text-sm text-slate-500\" aria-label=\"Breadcrumb\"><ol class=\"inline-flex items-center space-x-1 md:space-x-3\"><li class=\"inline-flex items-center\"><a class=\"hover:text-slate-900 transition-colors\" href=\"/\">Home</a></li><li><div class=\"flex items-center\"><span class=\"mx-2 text-slate-400\">/</span><a class=\"hover:text-slate-900 transition-colors\" href=\"/blog\">Blog</a></div></li><li><div class=\"flex items-center\"><span class=\"mx-2 text-slate-400\">/</span><a class=\"hover:text-slate-900 transition-colors\" href=\"/blog/ipa\">Ipa</a></div></li><li><div class=\"flex items-center\"><span class=\"mx-2 text-slate-400\">/</span><span class=\"text-slate-900 font-medium\" aria-current=\"page\">Hukum newton 1 2 3</span></div></li></ol></nav></div></div><main class=\"flex-1\"><div class=\"w-full max-w-[1200px] mx-auto px-margin md:px-margin-desktop py-space-lg md:py-space-xl\"><nav aria-label=\"Breadcrumb\" class=\"flex items-center gap-space-xs text-on-surface-variant font-body-sm text-body-sm mb-space-lg overflow-x-auto whitespace-nowrap scrollbar-none\"><a class=\"hover:text-primary transition-colors flex items-center gap-1\" href=\"/\"><span class=\"material-symbols-outlined text-[16px]\">home</span><span>Home</span></a><span class=\"material-symbols-outlined text-[14px] text-outline\">chevron_right</span><a class=\"hover:text-primary transition-colors\" href=\"/blog\">Blog</a><span class=\"material-symbols-outlined text-[14px] text-outline\">chevron_right</span><a class=\"hover:text-primary transition-colors capitalize\" href=\"/blog/ipa\">ipa</a><span class=\"material-symbols-outlined text-[14px] text-outline\">chevron_right</span><span class=\"text-primary truncate max-w-[200px] md:max-w-none font-medium\">Hukum Newton 1, 2, dan 3: Bunyi, Rumus, dan Contoh</span></nav><div class=\"grid grid-cols-1 lg:grid-cols-12 gap-space-xl items-start\"><article class=\"lg:col-span-8 flex flex-col\"><div class=\"flex flex-wrap items-center gap-space-sm mb-space-md\"><span class=\"px-space-md py-1 rounded-xl bg-primary-fixed text-on-primary-fixed font-label-sm text-label-sm tracking-wide uppercase\">ipa</span><span class=\"px-space-md py-1 rounded-xl bg-surface-container text-on-surface-variant font-label-sm text-label-sm flex items-center gap-1\"><span class=\"material-symbols-outlined text-[14px] text-primary\">schedule</span>5 menit baca</span></div><h1 class=\"font-headline-lg text-headline-lg md:text-display-lg text-on-surface tracking-tight mb-space-lg leading-tight\">Hukum Newton 1, 2, dan 3: Bunyi, Rumus, dan Contoh</h1><div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-space-md p-space-md md:p-space-lg rounded-xl bg-surface-container-low mb-space-xl border border-slate-100\"><div class=\"flex items-center gap-space-md\"><div class=\"w-12 h-12 rounded-full bg-primary-container text-on-primary font-headline-sm text-headline-sm flex items-center justify-center font-bold shadow-sm ring-2 ring-primary-fixed\">TM</div><div><div class=\"flex items-center gap-1.5\"><span class=\"font-label-lg text-label-lg text-on-surface font-bold\">Tim Kurasi TugasMu</span><span class=\"material-symbols-outlined text-primary text-[16px]\" title=\"Terverifikasi\">verified</span></div><p class=\"font-body-sm text-body-sm text-on-surface-variant\">Diterbitkan pada <!-- -->22 September 2026</p></div></div><div class=\"flex items-center gap-2 pt-space-xs sm:pt-0\"><button class=\"inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-surface-container-lowest hover:bg-surface-container text-secondary font-label-md text-label-md transition-all shadow-sm\"><span class=\"material-symbols-outlined text-[18px]\">share</span><span class=\"hidden sm:inline\">Bagikan</span></button></div></div><div class=\"prose-content flex flex-col gap-space-lg text-on-surface font-body-lg text-body-lg leading-relaxed bg-surface-container-lowest p-space-lg md:p-space-xl rounded-xl shadow-sm border border-slate-100\"><h1 class=\"font-headline-lg text-headline-lg text-on-surface tracking-tight mb-space-lg leading-tight\">Hukum Newton 1, 2, dan 3: Bunyi, Rumus, dan Contoh</h1>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Hukum Newton membentuk fondasi utama mekanika klasik yang menjelaskan bagaimana gaya mempengaruhi gerak benda dalam kehidupan sehari-hari maupun <a href=\"/blog/ipa\">Ilmu Pengetahuan Alam</a>. Teman pintar belajar dapat memanfaatkan <a href=\"/tools/generator-soal\">Generator Soal TugasMu</a> untuk mengasah kemampuan analisis melalui latihan soal interaktif. Pahami konsepnya agar tugasmu dalam menyelesaikan persoalan fisika menjadi jauh lebih terstruktur dan menyenangkan.</p>\n<h2 class=\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\">Sejarah Singkat dan Pengertian Hukum Newton</h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Hukum Newton adalah sekumpulan prinsip fundamental yang dirumuskan oleh fisikawan terkemuka dunia untuk menjelaskan hubungan antara gaya yang bekerja pada suatu benda dan pergerakan yang ditimbulkannya. Bagaimana fisikawan abad ke-17 menyusun prinsip mekanika tersebut secara sistematis? Ilmuwan asal Inggris bernama Sir Isaac Newton mempublikasikan hukum ini dalam karya monumentalnya yang berjudul Philosophiæ Naturalis Principia Mathematica pada tahun 1687.</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">Penemuan Hukum Newton oleh Sir Isaac Newton</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Hukum Newton lahir dari pengamatan mendalam terhadap fenomena alam di sekitar laboratorium riset sang penemu. Penemuan ini merangkum tiga prinsip utama yang mengatur dinamika benda diam maupun benda bergerak dengan kecepatan tertentu. Pertanyaan mendasar mengenai mengapa sebuah apel jatuh ke tanah mengarahkan sang jenius pada pemahaman gravitasi universal. Gravitasi universal tersebut kemudian berkembang menjadi fondasi mekanika klasik yang bertahan hingga era modern saat ini.</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">Konsep Dasar Gaya dan Gerak dalam Fisika</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Gaya dan gerak merupakan dua variabel fisik yang saling terikat erat dalam setiap eksperimen laboratorium maupun peristiwa harian. Konsep dasar ini menyatakan bahwa perubahan posisi benda selalu dipengaruhi oleh tarikan atau dorongan luar yang bekerja secara kontinu. Mengapa benda yang didorong di atas lantai kasar lebih cepat berhenti dibandingkan lantai licin? Hambatan gesek antarpermukaan memberikan gaya perlawanan yang mengurangi kecepatan gerak benda tersebut secara drastis.</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Transisi dari pemahaman teoretis menuju perhitungan matematis memerlukan penguasaan prinsip dasar dinamika benda secara menyeluruh sebelum melangkah ke rumus lanjutan.</p>\n<h2 class=\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\">Bunyi Hukum Newton 1, 2, dan 3 beserta Rumusnya</h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Hukum Newton terbagi menjadi tiga hukum utama yang masing-masing memiliki karakteristik unik dalam menjelaskan perilaku mekanis benda. Apa saja perbedaan mendasar dari ketiga hukum tersebut dalam lembar kerja fisikamu? Perhatikan rangkuman bunyi hukum dan persamaan matematisnya melalui tabel perbandingan struktur berikut.</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">| Hukum Fisika | Bunyi Prinsip Utama | Persamaan Matematis | Keterangan Variabel |\n| --- | --- | --- | --- |\n| Hukum I Newton | Resultan gaya pada benda bernilai nol, sehingga benda diam tetap diam dan benda bergerak lurus beraturan tetap bergerak. | $\\Sigma F = 0$ | $\\Sigma F$ = Jumlah gaya (Newton) |\n| Hukum II Newton | Percepatan sebuah benda berbanding lurus dengan resultan gaya dan berbanding terbalik dengan massa benda. | $F = m \\times a$ | $F$ = Gaya, $m$ = Massa, $a$ = Percepatan |\n| Hukum III Newton | Gaya aksi dan reaksi dari dua benda besarnya sama tetapi berlawanan arah ($F_<!-- --> = -F_<!-- -->$). | $F_<!-- --> = -F_<!-- -->$ | Tanda minus menunjukkan arah berlawanan |</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">Hukum I Newton (Kelembaman/Inersia)</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Hukum I Newton menjelaskan sifat kelembaman atau kecenderungan suatu benda untuk mempertahankan keadaan gerak awalnya secara konstan. Sifat kelembaman ini membuat penumpang bus terdorong ke depan saat sopir mendadak menginjak rem darurat. Bagaimana cara menghitung besar inersia pada benda bermassa besar? Massa benda yang lebih besar memiliki kelembaman yang jauh lebih tinggi sehingga lebih sulit untuk diubah keadaan geraknya.</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">Hukum II Newton (F = m.a) dan Hukum III Newton (Aksi-Reaksi)</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Hukum II Newton menghubungkan percepatan benda dengan massa serta besar gaya total yang bekerja padanya. Hubungan matematis tersebut menunjukkan bahwa penambahan gaya dorong pada massa tetap akan memperbesar percepatan benda secara proporsional. Bagaimanakah penerapan Hukum III Newton dalam peristiwa sehari-hari? Aktivitas melompat ke depan dari atas perahu mendorong perahu tersebut bergerak mundur ke arah sebaliknya.</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Penerapan rumus matematika dalam lembar ujian menuntut ketelitian tinggi dalam mengonversi satuan besaran pokok fisika secara tepat.</p>\n<h2 class=\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\">Cara Mengerjakan Soal Fisika tentang Hukum Newton</h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Hukum Newton dapat dihitung dengan langkah-langkah sistematis yang memudahkanmu menemukan solusi akhir tanpa kebingungan. Langkah pengerjaan yang benar menghindarkanmu dari kesalahan fatal dalam menentukan arah gaya atau nilai massa. Apa saja tahapan penting yang wajib kamu lakukan saat menghadapi soal cerita ujian? Tahapan penyelesaian soal fisika meliputi identifikasi variabel, penggambaran diagram gaya, penentuan rumus, dan kalkulasi akhir.</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">Mengidentifikasi Gaya yang Bekerja pada Benda</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Mengidentifikasi gaya yang bekerja pada benda merupakan langkah awal paling krusial dalam menyelesaikan persoalan mekanika fisika. Identifikasi ini mencakup gaya berat, gaya normal, gaya gesek, serta gaya tarik tali yang terpasang pada sistem. Mengapa diagram gaya bebas sangat membantu siswa dalam menganalisis soal rumit? Diagram gaya visual menyederhanakan interaksi kompleks antarvektor gaya menjadi persamaan skalar yang mudah diselesaikan.</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">Menerapkan Rumus F = m x a pada Soal Cerita</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Menerapkan rumus $F = m \\times a$ pada soal cerita memerlukan ketelitian dalam menyusun persamaan aljabar sederhana. Penerapan rumus ini biasanya melibatkan pencarian percepatan benda jika massa dan gaya total telah diketahui nilainya secara pasti. Variasi soal apa saja yang sering muncul dalam ujian sekolah tingkat menengah? Soal sering menampilkan bidang miring licin, sistem katrol ganda, atau gerak benda bersentuhan di atas lantai.</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Perhitungan matematis yang akurat harus diuji kembali dengan melihat realitas fisik di lingkungan sekitar agar relevansi konsep tetap terjaga.</p>\n<h2 class=\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\">Contoh Penerapan Hukum Newton dalam Kehidupan Sehari-hari</h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Hukum Newton memiliki banyak penerapan nyata yang dapat kamu temukan dengan mudah di lingkungan sekitarmu setiap hari. Penerapan ini membuktikan bahwa rumus fisika bukan sekadar teori abstrak di dalam buku teks sekolah. Fenomena apa saja yang menunjukkan bekerjanya hukum fisika mekanik ini di sekeliling kita? Pengamatan langsung membantu memperkuat pemahaman konseptualmu sebelum menghadapi ujian akhir semester.</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">Contoh Kelembaman saat Mengerem Mobil</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Contoh kelembaman saat mengerem mobil dapat dirasakan langsung oleh setiap penumpang di dalam kendaraan bermotor tersebut. Kelembaman tubuh penumpang mempertahankan kecepatan gerak maju ketika mobil secara mendadak berhenti total akibat pengereman. Mengapa sabuk pengaman diciptakan untuk mengatasi efek hukum kelembaman ini? Sabuk pengaman memberikan gaya eksternal penahan agar tubuh penumpang tidak membentur kaca depan kendaraan.</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">Contoh Aksi-Reaksi saat Mendayung Perahu</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Contoh aksi-reaksi saat mendayung perahu melibatkan dorongan air oleh dayung ke belakang sebagai gaya aksi nyata. Gaya reaksi air mendorong perahu melaju ke depan dengan kecepatan yang sebanding dengan kuatnya dayungan. Prinsip kerja mesin roket luar angkasa juga menggunakan hukum aksi-reaksi gas buang pembakaran bahan bakar. Roket terdorong ke atas menembus atmosfer bumi karena semburan gas panas mengarah ke bawah secara masif.</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Penerapan prinsip mekanika klasik dalam berbagai teknologi modern membuktikan keandalan rumus fisika ciptaan sang ilmuwan legendaris.</p>\n<h2 class=\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\">Kesimpulan Hukum Gaya dan Gerak</h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Hukum Newton adalah prinsip fundamental fisika yang menjelaskan hubungan antara gaya dan gerak benda secara komprehensif. Sejarah penemuan hukum ini oleh Sir Isaac Newton meletakkan dasar mekanika klasik yang sangat berpengaruh. Bunyi dan rumus ketiga hukum tersebut memberikan kerangka kerja analitis untuk menghitung dinamika suatu sistem. Cara mengerjakan soal fisika menuntut langkah sistematis mulai dari identifikasi gaya hingga penerapan persamaan matematis. Contoh penerapan dalam kehidupan sehari-hari menunjukkan bahwa mekanika klasik bekerja nyata di sekeliling kita. Tingkatkan pemahamanmu melalui materi lanjutan mengenai <a href=\"/blog/ipa/rumus-gerak-lurus\">Rumus Gerak Lurus</a> di <a href=\"/blog/ipa\">Ilmu Pengetahuan Alam</a>.</p></div><section class=\"mt-space-xl p-space-lg md:p-space-xl rounded-xl bg-surface-container-lowest shadow-sm flex flex-col sm:flex-row items-start sm:items-center gap-space-lg border border-slate-100\"><div class=\"w-16 h-16 rounded-full bg-primary-container text-on-primary flex items-center justify-center font-headline-lg text-headline-lg font-bold shrink-0 shadow-md ring-4 ring-primary-fixed\">TM</div><div class=\"flex flex-col gap-1.5 flex-1\"><div class=\"flex flex-wrap items-center gap-2\"><h4 class=\"font-headline-sm text-headline-sm text-on-surface font-bold\">Redaksi TugasMu</h4><span class=\"px-2.5 py-0.5 rounded-full bg-secondary text-on-secondary font-label-sm text-label-sm\">Tim Edukasi</span></div><p class=\"font-body-md text-body-md text-on-surface-variant\">Tim kurator konten yang berdedikasi untuk membagikan tips belajar, pembaruan kurikulum, dan cara cerdas memanfaatkan AI bagi pelajar Indonesia.</p></div></section></article><aside class=\"lg:col-span-4 flex flex-col gap-space-lg lg:sticky lg:top-24\"><div class=\"p-space-lg rounded-xl bg-gradient-to-b from-surface-container to-surface-container-high shadow-sm flex flex-col gap-space-md border border-slate-100\"><div class=\"w-10 h-10 rounded-xl bg-primary-container text-on-primary flex items-center justify-center shadow-xs\"><span class=\"material-symbols-outlined text-[22px]\">auto_awesome</span></div><div><h4 class=\"font-headline-sm text-headline-sm text-on-surface font-bold\">Butuh Bantuan Tugas?</h4><p class=\"font-body-sm text-body-sm text-on-surface-variant mt-1\">Gunakan asisten AI TugasMu secara gratis. Buat soal, parafrase makalah, dan temukan jawaban dari PR-mu.</p></div><a class=\"w-full inline-flex items-center justify-center gap-2 bg-primary-container hover:bg-primary text-on-primary py-2.5 px-4 rounded-xl font-label-md text-label-md transition-all shadow-sm\" href=\"/tools\"><span>Buka Tools AI</span><span class=\"material-symbols-outlined text-[16px]\">arrow_forward</span></a></div></aside></div><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"headline\":\"Hukum Newton 1, 2, dan 3: Bunyi, Rumus, dan Contoh\",\"description\":\"\",\"datePublished\":\"2026-09-22T00:00:00.000Z\",\"author\":{\"@type\":\"Organization\",\"name\":\"TugasMu\"}}</script></div></main><footer class=\"bg-slate-50 border-t border-slate-200 py-10 mt-auto\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\"><div class=\"flex flex-col md:flex-row items-center justify-between gap-6\"><div class=\"flex flex-col sm:flex-row items-center gap-3 sm:gap-6 text-center sm:text-left\"><div class=\"flex items-center gap-2\"><div class=\"w-7 h-7 rounded-lg bg-sky-500 flex items-center justify-center text-white\"><svg class=\"w-3.5 h-3.5 fill-white\" viewBox=\"0 0 24 24\"><polygon points=\"13 2 3 14 12 14 11 22 21 10 12 10 13 2\"></polygon></svg></div><span class=\"font-bold text-slate-900 text-base font-heading\">TugasMu.com</span></div><span class=\"text-xs sm:text-sm text-slate-500\">© 2026 TugasMu.com. Hak cipta dilindungi.</span></div><div class=\"flex flex-wrap justify-center items-center gap-x-6 gap-y-3 text-xs sm:text-sm font-medium text-slate-500\"><a class=\"hover:text-slate-900 transition-colors\" href=\"/\">Beranda</a><a class=\"hover:text-slate-900 transition-colors\" href=\"/harga\">Premium</a><a class=\"hover:text-slate-900 transition-colors\" href=\"/blog\">Blog</a><a class=\"hover:text-slate-900 transition-colors\" href=\"/privasi\">Privacy Policy</a><a class=\"hover:text-slate-900 transition-colors\" href=\"/syarat\">Terms of Service</a><a class=\"hover:text-slate-900 transition-colors\" href=\"/kontak\">Kontak</a></div></div></div></footer><script src=\"/_next/static/chunks/webpack-37f8c22e297b04f8.js\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0]);self.__next_f.push([2,null])</script><script>se