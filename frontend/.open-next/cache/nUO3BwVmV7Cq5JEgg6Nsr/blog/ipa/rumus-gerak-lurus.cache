ldren\":[[\"$\",\"span\",null,{\"children\":\"Buka Tools AI\"}],[\"$\",\"span\",null,{\"className\":\"material-symbols-outlined text-[16px]\",\"children\":\"arrow_forward\"}]]}]]}]}]]}],[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"Article\\\",\\\"headline\\\":\\\"Gerak Lurus GLB dan GLBB: Pengertian, Rumus, dan Perbedaan\\\",\\\"description\\\":\\\"\\\",\\\"datePublished\\\":\\\"2026-09-22T00:00:00.000Z\\\",\\\"author\\\":{\\\"@type\\\":\\\"Organization\\\",\\\"name\\\":\\\"TugasMu\\\"}}\"}}]]}]\nc:[[\"$\",\"meta\",\"0\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}],[\"$\",\"meta\",\"1\",{\"charSet\":\"utf-8\"}],[\"$\",\"title\",\"2\",{\"children\":\"Gerak Lurus GLB dan GLBB: Pengertian, Rumus, dan Perbedaan | TugasMu | TugasMu\"}],[\"$\",\"meta\",\"3\",{\"property\":\"og:title\",\"content\":\"Gerak Lurus GLB dan GLBB: Pengertian, Rumus, dan Perbedaan\"}],[\"$\",\"meta\",\"4\",{\"property\":\"og:type\",\"content\":\"article\"}],[\"$\",\"meta\",\"5\",{\"property\":\"article:published_time\",\"content\":\"Tue Sep 22 2026 08:00:00 GMT+0800 (Central Indonesia Time)\"}],[\"$\",\"meta\",\"6\",{\"name\":\"twitter:card\",\"content\":\"summary\"}],[\"$\",\"meta\",\"7\",{\"name\":\"twitter:title\",\"content\":\"Gerak Lurus GLB dan GLBB: Pengertian, Rumus, dan Perbedaan\"}],[\"$\",\"link\",\"8\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}]]\n1:null\nd:[[\"$\",\"h1\",null,{\"className\":\"font-headline-lg text-headline-lg text-on-surface tracking-tight mb-space-lg leading-tight\",\"children\":\"Gerak Lurus GLB dan GLBB: Pengertian, Rumus, dan Perbedaan\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":[\"Materi fisika mengenai perpindahan posisi selalu menjadi landasan penting dalam ujian sekolah. Pahami konsepnya secara runtut agar tugasmu dapat diselesaikan dengan mudah melalui panduan materi \",[\"$\",\"$Lb\",null,{\"href\":\"/blog/ipa/\",\"children\":\"Ilmu Pengetahuan Alam\"}],\".\"]}],\"\\n\",[\"$\",\"h2\",null,{\"className\":\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\",\"children\":\"Pengertian Gerak Lurus dan Klasifikasinya\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":[\"Gerak Lurus adalah perubahan posisi suatu benda terhadap titik acuan pada lintasan yang berbentuk garis lurus. Teman pintar belajar dapat memanfaatkan \",[\"$\",\"$Lb\",null,{\"href\":\"/tools/generator-soal\",\"children\":\"Generator Soal TugasMu\"}],\" untuk membuat soal latihan fisika yang sesuai dengan kurikulum sekolahmu. Konsep perpindahan ini mendasari seluruh analisis mekanika klasik yang dipelajari di bangku sekolah.\"]}],\"\\n\",[\"$\",\"h3\",null,{\"className\":\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\",\"children\":\"Definisi Gerak Lurus dalam Kajian Fisika\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Gerak Lurus didefinisikan sebagai perpindahan objek dari satu titik awal ke titik akhir dengan arah konstan tanpa adanya belokan pada lintasan. Setiap benda yang bergerak maju mundur pada satu sumbu koordinat selalu mengikuti kaidah kinematika dasar ini.\"}],\"\\n\",[\"$\",\"h3\",null,{\"className\":\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\",\"children\":\"Pembagian Gerak Lurus: GLB dan GLBB\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Gerak Lurus terbagi menjadi dua kategori utama berdasarkan kecepatan dan percepatannya, yaitu beraturan dan berubah beraturan. Klasifikasi ini membantu kamu membedakan karakteristik laju kendaraan di jalan raya maupun benda jatuh bebas di laboratorium.\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Pemahaman mendalam mengenai klasifikasi dasar ini mempersiapkan kamu untuk menganalisis rumus matematika yang lebih kompleks pada sub bab berikutnya.\"}],\"\\n\",[\"$\",\"h2\",null,{\"className\":\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\",\"children\":\"Rumus dan Ciri-ciri GLB dan GLBB\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Gerak Lurus dapat dibedakan melalui rumus dan cirinya yang unik dalam memengaruhi besar kecepatan benda. Analisis matematis ini menjadi senjata utama untuk menaklukkan berbagai soal ujian fisika dengan akurat.\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"| Karakteristik | GLB (Beraturan) | GLBB (Berubah Beraturan) |\\r\\n| :--- | :--- | :--- |\\r\\n| Kecepatan ($v$) | Tetap / Konstan | Berubah secara beraturan |\\r\\n| Percepatan ($a$) | Nol ($a = 0$) | Tetap / Konstan ($a \\\\neq 0$) |\\r\\n| Rumus Utama | $s = v \\\\times t$ | $v_t = v_0 + a \\\\cdot t$ |\\r\\n| Contoh Kasus | Mobil berjalan stabil di jalan tol | Buah kelapa jatuh dari pohonnya |\"}],\"\\n\",[\"$\",\"h3\",null,{\"className\":\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\",\"children\":\"Ciri Gerak Lurus Beraturan (Kecepatan Konstan)\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Gerak Lurus Beraturan memiliki ciri khas berupa kecepatan yang tidak pernah berubah dari detik pertama hingga akhir perjalanan. Jarak yang ditempuh selalu berbanding lurus dengan selang waktu tempuh secara proporsional.\"}],\"\\n\",[\"$\",\"h3\",null,{\"className\":\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\",\"children\":\"Ciri Gerak Lurus Berubah Beraturan (Percepatan Konstan)\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Gerak Lurus Berubah Beraturan ditandai oleh adanya percepatan atau perlambatan yang nilainya tetap sepanjang lintasan. Pertambahan kecepatan setiap sekon berlangsung secara konstan, baik dipercepat ke arah depan maupun diperlambat saat mengerem.\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Transisi dari karakteristik nilai konstan menuju perubahan kecepatan ini menuntut ketelitian tinggi saat kamu mulai menghitung nilai numerik pada lembar kerja.\"}],\"\\n\",[\"$\",\"h2\",null,{\"className\":\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\",\"children\":\"Langkah-langkah Menghitung Kecepatan dan Jarak pada GLB\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Gerak Lurus dapat dihitung jaraknya dengan langkah sistematis agar tidak terjadi kesalahan dalam memasukkan nilai variabel. Bimbingan AI di TugasMu selalu menyarankan agar kamu menuliskan diketahui dan ditanya terlebih dahulu pada setiap lembar jawaban ujianmu.\"}],\"\\n\",[\"$\",\"h3\",null,{\"className\":\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\",\"children\":\"Menentukan Jarak, Kecepatan, dan Waktu\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Gerak Lurus memerlukan identifikasi variabel awal secara cermat sebelum rumus diterapkan ke dalam perhitungan akhir. Langkah-langkah sistematis yang wajib kamu lakukan dalam menyelesaikan persoalan hitungan meliputi:\"}],\"\\n\",[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"Menuliskan seluruh komponen yang diketahui dari soal secara lengkap dan terstruktur.\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Mengubah satuan besaran pokok ke dalam satuan internasional (SI) seperti meter dan sekon.\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Memilih persamaan matematis yang paling relevan dengan variabel yang ditanyakan.\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Melakukan perhitungan aritmatika secara teliti untuk mendapatkan hasil akhir yang benar.\"}],\"\\n\"]}],\"\\n\",[\"$\",\"h3\",null,{\"className\":\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\",\"children\":\"Menerapkan Rumus v = s/t\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Gerak Lurus menggunakan rumus dasar kecepatan $v = s/t$ di mana $v$ adalah kecepatan, $s$ adalah jarak, dan $t$ adalah waktu tempuh. Penggunaan rumus ini sangat sederhana namun membutuhkan konsistensi satuan agar hasilnya valid.\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Penguasaan rumus dasar perhitungan numerik ini menjadi bekal penting sebelum kamu mempelajari representasi visual melalui grafik koordinat.\"}],\"\\n\",[\"$\",\"h2\",null,{\"className\":\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\",\"children\":\"Contoh Grafik GLB dan GLBB yang Sering Keluar di Ujian\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Gerak Lurus sering disajikan dalam bentuk grafik koordinat cartesius pada soal-soal ujian nasional maupun seleksi masuk perguruan tinggi. Kemampuan membaca tren garis grafik akan memberikan nilai tambah yang signifikan bagi prestasi belajarmu.\"}],\"\\n\",[\"$\",\"h3\",null,{\"className\":\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\",\"children\":\"Membaca Grafik Jarak terhadap Waktu (s-t)\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Gerak Lurus pada grafik jarak terhadap waktu ($s-t$) untuk GLB digambarkan sebagai garis lurus miring ke atas dengan kemiringan (gradien) yang konstan. Kemiringan garis tersebut merepresentasikan besar kecepatan benda yang sedang diamati.\"}],\"\\n\",[\"$\",\"h3\",null,{\"className\":\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\",\"children\":\"Membaca Grafik Kecepatan terhadap Waktu (v-t)\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Gerak Lurus pada grafik kecepatan terhadap waktu ($v-t$) untuk GLBB diperlihatkan melalui garis lurus miring ke atas atau ke bawah. Luas area di bawah kurva grafik $v-t$ menunjukkan besar total jarak yang berhasil ditempuh oleh benda tersebut.\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Analisis grafik yang akurat melengkapi pemahaman konseptualmu terhadap seluruh dinamika perpindahan benda dalam ruang fisik.\"}],\"\\n\",[\"$\",\"h2\",null,{\"className\":\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\",\"children\":\"Kesimpulan GLB dan GLBB\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":[\"Gerak Lurus adalah perpindahan posisi objek pada jalur linier yang diklasifikasikan menjadi beraturan dan berubah beraturan. Rumus serta ciri khas GLB dan GLBB dapat dibedakan melalui keberadaan percepatan konstan pada sistem. Perhitungan matematis jarak dan kecepatan diselesaikan secara sistematis menggunakan variabel waktu serta jarak tempuh. Analisis grafik $s-t$ dan $v-t$ mempermudah interpretasi data eksperimen fisika di sekolah. Pelajari juga materi terkait seperti \",[\"$\",\"$Lb\",null,{\"href\":\"/blog/ipa/ikatan-kimia-ion-kovalen\",\"children\":\"Ikatan Kimia\"}],\" untuk memperkaya wawasan IPA-mu, atau gunakan \",[\"$\",\"$Lb\",null,{\"href\":\"/tools/generator-soal\",\"children\":\"Generator Soal TugasMu\"}],\" sekarang juga agar nilaimu semakin memuaskan!\"]}]]\n"}