ull,{\\\"children\\\":\\\"Buka Tools AI\\\"}],[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"material-symbols-outlined text-[16px]\\\",\\\"children\\\":\\\"arrow_forward\\\"}]]}]]}]}]]}],[\\\"$\\\",\\\"script\\\",null,{\\\"type\\\":\\\"application/ld+json\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"{\\\\\\\"@context\\\\\\\":\\\\\\\"https://schema.org\\\\\\\",\\\\\\\"@type\\\\\\\":\\\\\\\"Article\\\\\\\",\\\\\\\"headline\\\\\\\":\\\\\\\"Matriks: Operasi Dasar, Determinan, dan Cara Mengerjakan Soal\\\\\\\",\\\\\\\"description\\\\\\\":\\\\\\\"\\\\\\\",\\\\\\\"datePublished\\\\\\\":\\\\\\\"2026-09-22T00:00:00.000Z\\\\\\\",\\\\\\\"author\\\\\\\":{\\\\\\\"@type\\\\\\\":\\\\\\\"Organization\\\\\\\",\\\\\\\"name\\\\\\\":\\\\\\\"TugasMu\\\\\\\"}}\\\"}}]]}]\\n\"])</script><script>self.__next_f.push([1,\"f:[[\\\"$\\\",\\\"meta\\\",\\\"0\\\",{\\\"name\\\":\\\"viewport\\\",\\\"content\\\":\\\"width=device-width, initial-scale=1\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"charSet\\\":\\\"utf-8\\\"}],[\\\"$\\\",\\\"title\\\",\\\"2\\\",{\\\"children\\\":\\\"Matriks: Operasi Dasar, Determinan, dan Cara Mengerjakan Soal | TugasMu | TugasMu\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"3\\\",{\\\"property\\\":\\\"og:title\\\",\\\"content\\\":\\\"Matriks: Operasi Dasar, Determinan, dan Cara Mengerjakan Soal\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"4\\\",{\\\"property\\\":\\\"og:type\\\",\\\"content\\\":\\\"article\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"5\\\",{\\\"property\\\":\\\"article:published_time\\\",\\\"content\\\":\\\"Tue Sep 22 2026 08:00:00 GMT+0800 (Central Indonesia Time)\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"6\\\",{\\\"name\\\":\\\"twitter:card\\\",\\\"content\\\":\\\"summary\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"7\\\",{\\\"name\\\":\\\"twitter:title\\\",\\\"content\\\":\\\"Matriks: Operasi Dasar, Determinan, dan Cara Mengerjakan Soal\\\"}],[\\\"$\\\",\\\"link\\\",\\\"8\\\",{\\\"rel\\\":\\\"icon\\\",\\\"href\\\":\\\"/favicon.ico\\\",\\\"type\\\":\\\"image/x-icon\\\",\\\"sizes\\\":\\\"16x16\\\"}]]\\n4:null\\n\"])</script><script>self.__next_f.push([1,\"12:[[\\\"$\\\",\\\"h1\\\",null,{\\\"className\\\":\\\"font-headline-lg text-headline-lg text-on-surface tracking-tight mb-space-lg leading-tight\\\",\\\"children\\\":\\\"Matriks: Operasi Dasar, Determinan, dan Cara Mengerjakan Soal\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Matriks adalah susunan skalar berbentuk persegi panjang yang diatur menurut baris dan kolom untuk menyederhanakan kalkulasi aljabar linear. Konsep aljabar ini mempermudah siswa SMA menguraikan sistem persamaan simultan melalui transformasi notasi numerik yang terstruktur. Siswa menguasai topik ini secara cepat ketika memahami fondasi ordo, aturan operasi hitung, serta teknik determinan matriks.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\\\",\\\"children\\\":\\\"Pengertian Matriks dan Jenis-jenisnya\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":[\\\"Matriks adalah susunan bilangan yang diatur dalam baris horizontal dan kolom vertikal di dalam tanda kurung siku atau kurung biasa. Notasi tabel numerik ini mengorganisasi koefisien persamaan aljabar menjadi satu kesatuan data yang terukur rapi. TugasMu hadir sebagai teman pintar belajar yang melatih alur berpikir logis tanpa jalan pintas instan. Kamu dapat menggunakan \\\",[\\\"$\\\",\\\"$Le\\\",null,{\\\"href\\\":\\\"/tools/generator-soal\\\",\\\"children\\\":\\\"Generator Soal TugasMu\\\"}],\\\" untuk menguji pemahaman struktur baris dan kolom pada berbagai variasi tingkat kesulitan soal matriks. Mengapa susunan elemen dalam matematika dikelompokkan ke dalam kategori khusus? Karakteristik jenis matriks berdasarkan ukuran ordo dan susunan elemen penyusunnya mencakup klasifikasi pada tabel matriks:\\\"]}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"| Jenis Matriks | Ordo Tipikal | Ciri-Ciri Utama | Contoh Notasi |\\\\r\\\\n| :--- | :--- | :--- | :--- |\\\\r\\\\n| Matriks Baris | $1 \\\\\\\\times n$ | Memiliki tepat satu baris elemen horizontal | $( 2 \\u0026 5 \\u0026 -1 )$ |\\\\r\\\\n| Matriks Kolom | $m \\\\\\\\times 1$ | Memiliki tepat satu kolom elemen vertikal | $( 4 \\\\\\\\ 0 \\\\\\\\ 7 )$ |\\\\r\\\\n| Matriks Persegi | $n \\\\\\\\times n$ | Jumlah baris sama persis dengan jumlah kolom | $( 1 \\u0026 3 \\\\\\\\ 2 \\u0026 4 )$ |\\\\r\\\\n| Matriks Identitas | $n \\\\\\\\times n$ | Elemen diagonal utama bernilai 1, elemen lain bernilai 0 | $( 1 \\u0026 0 \\\\\\\\ 0 \\u0026 1 )$ |\\\\r\\\\n| Matriks Nol | $m \\\\\\\\times n$ | Seluruh elemen pada setiap posisi bernilai 0 | $( 0 \\u0026 0 \\\\\\\\ 0 \\u0026 0 )$ |\\\\r\\\\n| Matriks Diagonal | $n \\\\\\\\times n$ | Elemen di luar diagonal utama bernilai 0 | $( 5 \\u0026 0 \\\\\\\\ 0 \\u0026 -2 )$ |\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Matriks dalam tabel klasifikasi di atas membuktikan bahwa setiap bentuk memiliki karakteristik unik yang ditentukan oleh susunan baris dan kolom matriks.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\\\",\\\"children\\\":\\\"Ordo Matriks: Cara Membaca m × n\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Matriks didefinisikan ukurannya melalui konsep ordo yang dinyatakan dalam format perkalian $m \\\\\\\\times n$. Huruf $m$ melambangkan jumlah baris horizontal, sedangkan huruf $n$ melambangkan jumlah kolom vertikal. Sebagai ilustrasi dasar, matriks berordo $2 \\\\\\\\times 3$ memuat 2 baris dan 3 kolom dengan total 6 elemen angka di dalamnya. Pahami konsepnya bahwa urutan pembacaan ini tidak boleh kamu tukar, karena ordo $2 \\\\\\\\times 3$ menampilkan bentuk visual yang berbeda dibandingkan ordo $3 \\\\\\\\times 2$. Bagaimana caramu membaca letak elemen spesifik di dalam suatu matriks?\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Matriks menggunakan sistem indeks ganda $a_ij$ untuk menandai alamat setiap elemen di lembar jawaban tugasmu. Indeks pertama $i$ menunjukkan posisi baris, sedangkan indeks kedua $j$ menunjukkan posisi kolom secara berurutan. Notasi $a_21$ membimbing pikiranmu untuk menemukan angka pada baris kedua dan kolom pertama secara tepat. Ketelitian membaca alamat sel ini menghindarkanmu dari kekeliruan letak saat mengeksekusi operasi lanjutan pada matriks.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\\\",\\\"children\\\":\\\"Matriks Khusus: Identitas, Nol, dan Diagonal\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Matriks khusus memiliki pola susunan elemen unik yang menyederhanakan perhitungan aljabar linear matematika SMA. Tiga jenis matriks khusus yang sering muncul dalam lembar ujian mencakup definisi berikut:\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"ul\\\",null,{\\\"children\\\":[\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Matriks Identitas ($I$):\\\"}],\\\" Matriks persegi dengan nilai 1 pada diagonal utama dari kiri atas ke kanan bawah dan nilai 0 pada posisi lainnya.\\\"]}],\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Matriks Nol ($O$):\\\"}],\\\" Matriks berordo sembarang yang seluruh elemennya bernilai nol, berfungsi sebagai elemen netral penjumlahan.\\\"]}],\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Matriks Diagonal:\\\"}],\\\" Matriks persegi yang seluruh elemen di luar diagonal utamanya bernilai nol, sedangkan elemen diagonal utamanya memuat angka bukan nol.\\\"]}],\\\"\\\\n\\\"]}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Matriks identitas bekerja menyerupai angka 1 pada operasi perkalian bilangan real biasa, sehingga perkalian matriks apa pun dengan matriks $I$ menghasilkan matriks awal itu sendiri. Bagaimana peran matriks identitas saat kamu mencari kebalikan invers pada matriks?\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Matriks diagonal dan identitas mempercepat kalkulasi perpangkatan aljabar karena kamu cukup menghitung perpangkatan pada elemen diagonal utamanya saja. Pengenalan ciri-ciri visual ini melatih kejelian belajarmu dalam merancang strategi penyelesaian soal secara efisien. Bimbingan AI di TugasMu memposisikan pengenalan bentuk khusus ini sebagai fondasi penting sebelum kamu melangkah ke perhitungan operasi matriks.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Matriks yang telah kamu pahami definisi dan jenisnya menjadi pijakan utama untuk mempelajari aturan hitung penjumlahan, pengurangan, serta perkalian matriks.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\\\",\\\"children\\\":\\\"Operasi Penjumlahan, Pengurangan, dan Perkalian Matriks\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Matriks dapat dijumlahkan, dikurangkan, dan dikalikan asalkan memenuhi syarat dimensi ordo yang ditentukan dalam kaidah aljabar linear. Penjumlahan dan pengurangan menuntut kesamaan ukuran ordo secara mutlak, sedangkan perkalian menuntut kesesuaian antara jumlah kolom matriks pertama dan jumlah baris matriks kedua. Memahami batasan dimensi ini menghindarkan langkah awalmu dari kesalahan fatal dalam lembar kerja sekolah. Mengapa operasi hitung matriks tidak dapat dilakukan jika ordonya berbeda? Dua aturan operasional berikut menguraikan mekanisme perhitungan elemen pada setiap operasi matriks.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\\\",\\\"children\\\":\\\"Syarat dan Langkah Menjumlahkan Dua Matriks\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Matriks hanya dapat dijumlahkan atau dikurangkan jika kedua matriks memiliki ukuran ordo yang identik ($m \\\\\\\\times n$). Prosedur pengerjaannya sangat lugas: jumlahkan atau kurangkan elemen-elemen yang menempati posisi baris dan kolom yang bersesuaian ($c_ij = a_ij \\\\\\\\pm b_ij$). Sebagai contoh konkret, perhatikan penjumlahan dua matriks ordo $2 \\\\\\\\times 2$ berikut:\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"$$$\\\\r\\\\n$ ( 1 \\u0026 2 \\\\\\\\ 3 \\u0026 4 ) + ( 5 \\u0026 6 \\\\\\\\ 7 \\u0026 8 ) = ( 1+5 \\u0026 2+6 \\\\\\\\ 3+7 \\u0026 4+8 ) = ( 6 \\u0026 8 \\\\\\\\ 10 \\u0026 12 ) $\\\\r\\\\n$$\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Proses pengurangan matriks mengikuti kaidah serupa dengan mengurangkan elemen seletak secara berurutan. Mengapa kedua matriks wajib memiliki kesesuaian posisi sel sebelum kamu mengeksekusi penjumlahan matriks?\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Matriks dengan ordo berbeda tidak memiliki pasangan elemen seletak yang lengkap, sehingga operasi penjumlahannya dinyatakan tidak terdefinisi dalam matematika. Sifat penjumlahan matriks bersifat komutatif ($A + B = B + A$) dan asosiatif ($(A + B) + C = A + (B + C)$), yang membuktikan bahwa urutan penjumlahan tidak mengubah matriks hasil. Penguasaan sifat aljabar ini membantumu menyederhanakan perhitungan saat menghadapi soal kombinasi pada matriks.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\\\",\\\"children\\\":\\\"Cara Mengalikan Matriks: Baris × Kolom\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Matriks dapat dikalikan melalui dua metode: perkalian skalar dengan bilangan real dan perkalian antarmatriks menggunakan prinsip baris kali kolom. Pada perkalian skalar, kamu mengalikan bilangan pengali $k$ ke setiap elemen matriks secara langsung. Pada perkalian dua matriks $A_(m x p) \\\\\\\\times B_(p x n)$, syarat mutlaknya adalah jumlah kolom matriks pertama ($p$) harus sama dengan jumlah baris matriks kedua ($p$). Hasil perkalian tersebut akan membentuk matriks baru berordo $m \\\\\\\\times n$ melalui akumulasi hasil kali baris dan kolom matriks.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Matriks dikalikan dengan memasangkan setiap elemen pada baris matriks pertama dengan elemen pada kolom matriks kedua, lalu menjumlahkan seluruh hasil kalinya. Sebagai contoh, kalikan matriks $A = ( 1 \\u0026 2 \\\\\\\\ 3 \\u0026 4 )$ dengan matriks $B = ( 2 \\u0026 0 \\\\\\\\ 1 \\u0026 3 )$ melalui empat tahapan langkah sistematis:\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"ol\\\",null,{\\\"children\\\":[\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Hitung elemen baris 1 kolom 1 ($c_11$):\\\"}],\\\" Kalikan baris pertama $A$ dengan kolom pertama $B$, yaitu $(1 \\\\\\\\times 2) + (2 \\\\\\\\times 1) = 2 + 2 = 4$.\\\"]}],\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Hitung elemen baris 1 kolom 2 ($c_12$):\\\"}],\\\" Kalikan baris pertama $A$ dengan kolom kedua $B$, yaitu $(1 \\\\\\\\times 0) + (2 \\\\\\\\times 3) = 0 + 6 = 6$.\\\"]}],\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Hitung elemen baris 2 kolom 1 ($c_21$):\\\"}],\\\" Kalikan baris kedua $A$ dengan kolom pertama $B$, yaitu $(3 \\\\\\\\times 2) + (4 \\\\\\\\times 1) = 6 + 4 = 10$.\\\"]}],\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Hitung elemen baris 2 kolom 2 ($c_22$):\\\"}],\\\" Kalikan baris kedua $A$ dengan kolom kedua $B$, yaitu $(3 \\\\\\\\times 0) + (4 \\\\\\\\times 3) = 0 + 12 = 12$.\\\"]}],\\\"\\\\n\\\"]}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Hasil akhir operasi perkalian tersebut adalah $C = ( 4 \\u0026 6 \\\\\\\\ 10 \\u0026 12 )$. Pahami konsepnya bahwa perkalian matriks tidak bersifat komutatif ($A \\\\\\\\times B \\\\\\\\neq B \\\\\\\\times A$), sehingga perubahan posisi matriks menghasilkan nilai yang berbeda. Mengapa perkalian dua matriks bukan nol dapat menghasilkan matriks nol? Fenomena pembagi nol ini menjadi karakteristik aljabar linear yang membedakan perkalian skalar biasa dari perkalian matriks.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Matriks yang telah dikuasai operasi aritmetika dasarnya membuka jalan bagi belajarmu untuk mengeksplorasi konsep nilai skala determinan dan pembalikan invers matriks 2×2.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\\\",\\\"children\\\":\\\"Determinan dan Invers Matriks 2×2\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Matriks 2×2 memiliki nilai determinan yang menentukan apakah susunan bilangan tersebut memiliki balikan atau invers dalam aljabar linear. Determinan adalah besaran skalar tunggal yang dihitung dari selisih perkalian silang elemen diagonal matriks persegi. Nilai skalar ini menjadi parameter utama untuk memverifikasi keberadaan solusi tunggal pada sistem persamaan yang kamu kerjakan. Mengapa sebuah matriks persegi tidak dapat dibalik jika determinannya bernilai nol? Pembagian dengan bilangan nol pada formula invers menjadi alasan matematis di balik sifat khusus invers matriks.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\\\",\\\"children\\\":\\\"Rumus Determinan Matriks 2×2: ad - bc\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Matriks ordo $2 \\\\\\\\times 2$ berbentuk $A = ( a \\u0026 b \\\\\\\\ c \\u0026 d )$ memiliki nilai determinan yang dinyatakan melalui lambang $|A|$ atau $\\\\\\\\det(A)$. Rumus determinan diperoleh dengan mengurangkan hasil kali diagonal utama ($a \\\\\\\\times d$) dengan hasil kali diagonal samping ($b \\\\\\\\times c$):\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"$$$\\\\r\\\\n\\\\\\\\det(A) = ad - bc\\\\r\\\\n$$\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Sebagai ilustrasi hitung, matriks $A = ( 4 \\u0026 3 \\\\\\\\ 2 \\u0026 5 )$ menghasilkan nilai determinan $\\\\\\\\det(A) = (4 \\\\\\\\times 5) - (3 \\\\\\\\times 2) = 20 - 6 = 14$. Bagaimana interpretasi nilai determinan yang bernilai positif, negatif, atau nol pada matriks?\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Matriks dengan nilai determinan tidak sama dengan nol ($\\\\\\\\det(A) \\\\\\\\neq 0$) tergolong sebagai matriks nonsingular yang memastikan keberadaan matriks balikan. Sebaliknya, matriks dengan determinan bernilai tepat nol disebut matriks singular dan tidak memiliki invers karena pembagian dengan angka nol menghasilkan bentuk tak terdefinisi. Menghitung determinan terlebih dahulu merupakan langkah strategis yang menghemat waktu belajarmu dari perhitungan invers yang sia-sia pada lembar tugas matriks.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\\\",\\\"children\\\":\\\"Rumus Invers Matriks 2×2 dan Syaratnya\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Matriks invers dari suatu matriks persegi $A$, yang dilambangkan dengan simbol $A^-1$, adalah matriks balikan yang menghasilkan matriks identitas saat dikalikan dengan matriks semula ($A \\\\\\\\times A^-1 = I$). Rumus baku invers untuk matriks ordo $2 \\\\\\\\times 2$ dirumuskan sebagai berikut:\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"$$$\\\\r\\\\n$ A^-1 = 1/det(A) ( d \\u0026 -b \\\\\\\\ -c \\u0026 a ) = 1/(ad-bc) ( d \\u0026 -b \\\\\\\\ -c \\u0026 a ) $\\\\r\\\\n$$\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Metode praktis mengingat matriks adjoin ordo $2 \\\\\\\\times 2$ ini adalah: tukar posisi elemen diagonal utama ($a$ bertukar dengan $d$), lalu bubuhkan tanda negatif pada elemen diagonal samping ($b$ dan $c$) tanpa menggeser posisinya. Bagaimana urutan kerja menerapkan formula ini pada contoh soal invers matriks?\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Matriks $A = ( 3 \\u0026 2 \\\\\\\\ 1 \\u0026 4 )$ dapat dicari inversnya melalui tiga langkah perhitungan terstruktur:\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"ol\\\",null,{\\\"children\\\":[\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Hitung nilai determinan:\\\"}],\\\" Nilai determinan adalah $\\\\\\\\det(A) = (3 \\\\\\\\times 4) - (2 \\\\\\\\times 1) = 12 - 2 = 10$ (nilai bukan nol membuktikan invers ada).\\\"]}],\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Susun matriks adjoin:\\\"}],\\\" Tukar posisi angka 3 dan 4, serta pasang tanda negatif pada angka 2 dan 1, sehingga diperoleh adjoin $( 4 \\u0026 -2 \\\\\\\\ -1 \\u0026 3 )$.\\\"]}],\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Kalikan adjoin dengan pengali seperdeterminan:\\\"}],\\\" Hasil invers adalah $A^-1 = 1/10 ( 4 \\u0026 -2 \\\\\\\\ -1 \\u0026 3 ) = ( 0.4 \\u0026 -0.2 \\\\\\\\ -0.1 \\u0026 0.3 )$.\\\"]}],\\\"\\\\n\\\"]}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Kebenaran hasil invers ini dapat kamu buktikan langsung dengan mengalikan matriks $A$ dengan $A^-1$, yang menghasilkan matriks identitas satuan $( 1 \\u0026 0 \\\\\\\\ 0 \\u0026 1 )$. Ketelitian memproses tanda aljabar negatif pada adjoin merupakan kunci utama mengamankan poin penuh saat mengerjakan ujian matriks.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Matriks 2×2 beserta nilai determinan dan inversnya memegang peranan krusial ketika kamu menyelesaikan model persamaan variabel melalui sistem persamaan linear matriks.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\\\",\\\"children\\\":\\\"Penerapan Matriks untuk Menyelesaikan Sistem Persamaan Linear\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Matriks digunakan untuk menyelesaikan Sistem Persamaan Linear dua variabel (SPLDV) secara efisien tanpa eliminasi bertingkat yang menghabiskan banyak ruang coretan. Dalam konteks soal matematika SMA, narasi kontekstual yang melibatkan perbandingan harga atau kuantitas barang dapat kamu ubah ke dalam persamaan matriks berbentuk $AX = B$. Pendekatan aljabar modern ini menyederhanakan perhitungan banyak variabel menjadi satu kali operasi perkalian matriks invers yang sistematis. Bagaimana caramu mengubah persamaan aljabar linear menjadi representasi koefisien matriks?\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\\\",\\\"children\\\":\\\"Mengubah SPL menjadi Bentuk Matriks\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Matriks koefisien menyusun variabel aljabar dari bentuk standar $a_1x + b_1y = c_1$ dan $a_2x + b_2y = c_2$ ke dalam format persamaan matriks $AX = B$. Tiga komponen matriks penyusun sistem ini didefinisikan secara spesifik:\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"ul\\\",null,{\\\"children\\\":[\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Matriks Koefisien ($A$):\\\"}],\\\" Matriks persegi $( a_1 \\u0026 b_1 \\\\\\\\ a_2 \\u0026 b_2 )$ yang memuat seluruh angka koefisien variabel persamaan.\\\"]}],\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Matriks Variabel ($X$):\\\"}],\\\" Matriks kolom vertikal $( x \\\\\\\\ y )$ yang memuat variabel yang dicari nilainya.\\\"]}],\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Matriks Konstanta ($B$):\\\"}],\\\" Matriks kolom vertikal $( c_1 \\\\\\\\ c_2 )$ yang memuat nilai konstanta di ruas kanan persamaan.\\\"]}],\\\"\\\\n\\\"]}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Sebagai ilustrasi aljabar, sistem persamaan $2x + y = 5$ dan $3x + 4y = 10$ bertransformasi secara langsung menjadi $( 2 \\u0026 1 \\\\\\\\ 3 \\u0026 4 ) ( x \\\\\\\\ y ) = ( 5 \\\\\\\\ 10 )$. Bagaimana caramu mengisolasi matriks variabel $X$ untuk menemukan nilai penyelesaian pada matriks?\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Matriks tidak mengenal operasi pembagian aljabar, sehingga pemindahan matriks koefisien $A$ ke ruas kanan dilakukan dengan mengalikan kedua ruas dengan invers matriks $A^-1$. Karena sifat perkalian matriks tidak komutatif, matriks $A^-1$ wajib kamu posisikan di sebelah kiri matriks konstanta ($X = A^-1B$). Memposisikan invers di sisi kanan matriks konstanta ($X = B A^-1$) merupakan kekeliruan fatal yang membuat perkalian ordo tersebut tidak memenuhi persyaratan operasi matriks.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\\\",\\\"children\\\":\\\"Metode Invers Matriks untuk Mencari Solusi SPL\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Matriks invers menyelesaikan persamaan matriks koefisien $( 2 \\u0026 1 \\\\\\\\ 3 \\u0026 4 ) ( x \\\\\\\\ y ) = ( 5 \\\\\\\\ 10 )$ melalui empat langkah penyelesaian prosedural:\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"ol\\\",null,{\\\"children\\\":[\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Hitung determinan matriks koefisien:\\\"}],\\\" Nilai determinan adalah $\\\\\\\\det(A) = (2 \\\\\\\\times 4) - (1 \\\\\\\\times 3) = 8 - 3 = 5$.\\\"]}],\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Tentukan invers matriks koefisien ($A^-1$):\\\"}],\\\" Susun adjoin matriks lalu kalikan dengan skalar: $A^-1 = 1/5 ( 4 \\u0026 -1 \\\\\\\\ -3 \\u0026 2 )$.\\\"]}],\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Kalikan matriks invers dengan matriks konstanta ($X = A^-1B$):\\\"}],\\\"\\\\r\\\\n$$\\\\r\\\\n$ ( x \\\\\\\\ y ) = 1/5 ( 4 \\u0026 -1 \\\\\\\\ -3 \\u0026 2 ) ( 5 \\\\\\\\ 10 ) $\\\\r\\\\n$$\\\"]}],\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Hitung hasil perkalian baris dengan kolom:\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"ul\\\",null,{\\\"children\\\":[\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":\\\"Baris 1: $(4 \\\\\\\\times 5) + (-1 \\\\\\\\times 10) = 20 - 10 = 10 \\\\\\\\implies x = 10/5 = 2$.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":\\\"Baris 2: $(-3 \\\\\\\\times 5) + (2 \\\\\\\\times 10) = -15 + 20 = 5 \\\\\\\\implies y = 5/5 = 1$.\\\"}],\\\"\\\\n\\\"]}],\\\"\\\\n\\\"]}],\\\"\\\\n\\\"]}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Solusi nilai variabel yang memenuhi sistem persamaan tersebut adalah $x = 2$ dan $y = 1$. Bagaimana caramu memastikan keabsahan angka penyelesaian tersebut tanpa melihat kunci jawaban matriks?\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Matriks hasil penyelesaian dapat kamu verifikasi secara mandiri dengan memasukkan nilai $x = 2$ dan $y = 1$ kembali ke sistem persamaan mula-mula: $2(2) + 1 = 5$ serta $3(2) + 4(1) = 10$. Kesesuaian hasil pada kedua persamaan membuktikan bahwa kalkulasi invers matriks yang kamu jalankan menghasilkan nilai yang akurat. Kebiasaan menguji jawaban ini memperkuat ketelitian belajarmu saat menghadapi soal ujian matematika matriks.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Matriks yang diterapkan secara prosedural pada sistem persamaan linear merangkum seluruh kecakapan aljabar yang kamu butuhkan untuk menguasai evaluasi akhir matriks.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\\\",\\\"children\\\":\\\"Kesimpulan Penguasaan Konsep Matriks SMA\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Matriks adalah representasi aljabar terstruktur yang mempermudah kalkulasi data tabel, operasi variabel simultan, dan penyelesaian sistem linear bagi siswa SMA. Empat kesimpulan utama yang mengekstraksi inti pemahaman dari setiap bagian materi ini mencakup prinsip kunci berikut:\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"ul\\\",null,{\\\"children\\\":[\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Definisi dan Ordo:\\\"}],\\\" Ukuran baris horizontal dan kolom vertikal ($m \\\\\\\\times n$) menentukan identitas dimensi serta klasifikasi jenis matriks persegi, identitas, nol, dan diagonal.\\\"]}],\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Operasi Aritmetika:\\\"}],\\\" Penjumlahan dan pengurangan mensyaratkan kesamaan ordo mutlak, sedangkan perkalian baris kali kolom menuntut kesesuaian jumlah kolom matriks pertama dengan baris matriks kedua.\\\"]}],\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Determinan dan Invers 2×2:\\\"}],\\\" Nilai determinan $\\\\\\\\det(A) = ad - bc$ menguji sifat nonsingular matriks, yang menjadi syarat mutlak keberadaan invers $A^-1 = 1/det(A) ( d \\u0026 -b \\\\\\\\ -c \\u0026 a )$.\\\"]}],\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":[[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"Penyelesaian Sistem Linear:\\\"}],\\\" Transformasi SPLDV ke bentuk matriks $AX = B$ diselesaikan secara efisien menggunakan formula perkalian invers kiri pada matriks.\\\"]}],\\\"\\\\n\\\"]}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":[\\\"Matriks dan seluruh alur penyelesaiannya membuktikan bahwa matematika adalah proses melatih logika berpikir sistematis, bukan sekadar menghafal rumus instan di lembar tugasmu. Setelah menguasai aljabar matriks, kamu dapat melatih keterampilan mengonversi narasi soal cerita ke bentuk simbolik matematika lewat panduan \\\",[\\\"$\\\",\\\"$Le\\\",null,{\\\"href\\\":\\\"/blog/matematika/tips-menjawab-soal-cerita\\\",\\\"children\\\":\\\"tips menjawab soal cerita\\\"}],\\\" atau menjelajahi seluruh materi di kategori \\\",[\\\"$\\\",\\\"$Le\\\",null,{\\\"href\\\":\\\"/blog/matematika/\\\",\\\"children\\\":\\\"Matematika\\\"}],\\\".\\\"]}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":[\\\"Matematika akan terasa jauh lebih ramah saat kamu belajar bersama TugasMu, karena platform ini dirancang bukan tools curang, tapi teman pintar belajarmu. Asah ketelitianmu sekarang dengan mencoba beragam latihan soal adaptif di \\\",[\\\"$\\\",\\\"$Le\\\",null,{\\\"href\\\":\\\"/tools/generator-soal\\\",\\\"children\\\":\\\"Generator Soal TugasMu\\\"}],\\\" untuk meraih nilai ujian terbaikmu!\\\"]}]]\\n\"])</script></body></html>","rsc":"3:I[4707,[],\"\"]\n6:I[6423,[],\"\"]\n7:I[8003,[\"3433\",\"static/chunks/3433-9ddc6f7f78d9421c.js\",\"2972\",\"static/chunks/2972-8ce94bd856f9372b.js\",\"3185\",\"static/chunks/app/layout-c819fc26cf8b0e32.js\"],\"\"]\n8:I[931