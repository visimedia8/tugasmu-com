viewBox\":\"0 0 24 24\",\"children\":[\"$\",\"polygon\",null,{\"points\":\"13 2 3 14 12 14 11 22 21 10 12 10 13 2\"}]}]}],[\"$\",\"span\",null,{\"className\":\"font-bold text-slate-900 text-base font-heading\",\"children\":\"TugasMu.com\"}]]}],[\"$\",\"span\",null,{\"className\":\"text-xs sm:text-sm text-slate-500\",\"children\":\"© 2026 TugasMu.com. Hak cipta dilindungi.\"}]]}],[\"$\",\"div\",null,{\"className\":\"flex flex-wrap justify-center items-center gap-x-6 gap-y-3 text-xs sm:text-sm font-medium text-slate-500\",\"children\":[[\"$\",\"$Lb\",null,{\"href\":\"/\",\"className\":\"hover:text-slate-900 transition-colors\",\"children\":\"Beranda\"}],[\"$\",\"$Lb\",null,{\"href\":\"/harga\",\"className\":\"hover:text-slate-900 transition-colors\",\"children\":\"Premium\"}],[\"$\",\"$Lb\",null,{\"href\":\"/blog\",\"className\":\"hover:text-slate-900 transition-colors\",\"children\":\"Blog\"}],[\"$\",\"$Lb\",null,{\"href\":\"/privasi\",\"className\":\"hover:text-slate-900 transition-colors\",\"children\":\"Privacy Policy\"}],[\"$\",\"$Lb\",null,{\"href\":\"/syarat\",\"className\":\"hover:text-slate-900 transition-colors\",\"children\":\"Terms of Service\"}],[\"$\",\"$Lb\",null,{\"href\":\"/kontak\",\"className\":\"hover:text-slate-900 transition-colors\",\"children\":\"Kontak\"}]]}]]}]}]}]]}]}]]}]],null],null],[\"$Lc\",null]]]]\n2:[\"$\",\"div\",null,{\"className\":\"w-full max-w-[1200px] mx-auto px-margin md:px-margin-desktop py-space-lg md:py-space-xl\",\"children\":[[\"$\",\"nav\",null,{\"aria-label\":\"Breadcrumb\",\"className\":\"flex items-center gap-space-xs text-on-surface-variant font-body-sm text-body-sm mb-space-lg overflow-x-auto whitespace-nowrap scrollbar-none\",\"children\":[[\"$\",\"$Lb\",null,{\"className\":\"hover:text-primary transition-colors flex items-center gap-1\",\"href\":\"/\",\"children\":[[\"$\",\"span\",null,{\"className\":\"material-symbols-outlined text-[16px]\",\"children\":\"home\"}],[\"$\",\"span\",null,{\"children\":\"Home\"}]]}],[\"$\",\"span\",null,{\"className\":\"material-symbols-outlined text-[14px] text-outline\",\"children\":\"chevron_right\"}],[\"$\",\"$Lb\",null,{\"className\":\"hover:text-primary transition-colors\",\"href\":\"/blog\",\"children\":\"Blog\"}],[\"$\",\"span\",null,{\"className\":\"material-symbols-outlined text-[14px] text-outline\",\"children\":\"chevron_right\"}],[\"$\",\"$Lb\",null,{\"className\":\"hover:text-primary transition-colors capitalize\",\"href\":\"/blog/matematika\",\"children\":\"matematika\"}],[\"$\",\"span\",null,{\"className\":\"material-symbols-outlined text-[14px] text-outline\",\"children\":\"chevron_right\"}],[\"$\",\"span\",null,{\"className\":\"text-primary truncate max-w-[200px] md:max-w-none font-medium\",\"children\":\"Pecahan Campuran: Cara Menghitung dan Mengubahnya\"}]]}],[\"$\",\"div\",null,{\"className\":\"grid grid-cols-1 lg:grid-cols-12 gap-space-xl items-start\",\"children\":[[\"$\",\"article\",null,{\"className\":\"lg:col-span-8 flex flex-col\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-space-sm mb-space-md\",\"children\":[[\"$\",\"span\",null,{\"className\":\"px-space-md py-1 rounded-xl bg-primary-fixed text-on-primary-fixed font-label-sm text-label-sm tracking-wide uppercase\",\"children\":\"matematika\"}],[\"$\",\"span\",null,{\"className\":\"px-space-md py-1 rounded-xl bg-surface-container text-on-surface-variant font-label-sm text-label-sm flex items-center gap-1\",\"children\":[[\"$\",\"span\",null,{\"className\":\"material-symbols-outlined text-[14px] text-primary\",\"children\":\"schedule\"}],\"5 menit baca\"]}]]}],[\"$\",\"h1\",null,{\"className\":\"font-headline-lg text-headline-lg md:text-display-lg text-on-surface tracking-tight mb-space-lg leading-tight\",\"children\":\"Pecahan Campuran: Cara Menghitung dan Mengubahnya\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-col sm:flex-row sm:items-center justify-between gap-space-md p-space-md md:p-space-lg rounded-xl bg-surface-container-low mb-space-xl border border-slate-100\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-space-md\",\"children\":[[\"$\",\"div\",null,{\"className\":\"w-12 h-12 rounded-full bg-primary-container text-on-primary font-headline-sm text-headline-sm flex items-center justify-center font-bold shadow-sm ring-2 ring-primary-fixed\",\"children\":\"TM\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"div\",null,{\"className\":\"flex items-center gap-1.5\",\"children\":[[\"$\",\"span\",null,{\"className\":\"font-label-lg text-label-lg text-on-surface font-bold\",\"children\":\"Tim Kurasi TugasMu\"}],[\"$\",\"span\",null,{\"className\":\"material-symbols-outlined text-primary text-[16px]\",\"title\":\"Terverifikasi\",\"children\":\"verified\"}]]}],[\"$\",\"p\",null,{\"className\":\"font-body-sm text-body-sm text-on-surface-variant\",\"children\":[\"Diterbitkan pada \",\"22 September 2026\"]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"flex items-center gap-2 pt-space-xs sm:pt-0\",\"children\":[\"$\",\"button\",null,{\"className\":\"inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-surface-container-lowest hover:bg-surface-container text-secondary font-label-md text-label-md transition-all shadow-sm\",\"children\":[[\"$\",\"span\",null,{\"className\":\"material-symbols-outlined text-[18px]\",\"children\":\"share\"}],[\"$\",\"span\",null,{\"className\":\"hidden sm:inline\",\"children\":\"Bagikan\"}]]}]}]]}],[\"$\",\"div\",null,{\"className\":\"prose-content flex flex-col gap-space-lg text-on-surface font-body-lg text-body-lg leading-relaxed bg-surface-container-lowest p-space-lg md:p-space-xl rounded-xl shadow-sm border border-slate-100\",\"children\":\"$Ld\"}],[\"$\",\"section\",null,{\"className\":\"mt-space-xl p-space-lg md:p-space-xl rounded-xl bg-surface-container-lowest shadow-sm flex flex-col sm:flex-row items-start sm:items-center gap-space-lg border border-slate-100\",\"children\":[[\"$\",\"div\",null,{\"className\":\"w-16 h-16 rounded-full bg-primary-container text-on-primary flex items-center justify-center font-headline-lg text-headline-lg font-bold shrink-0 shadow-md ring-4 ring-primary-fixed\",\"children\":\"TM\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-col gap-1.5 flex-1\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap items-center gap-2\",\"children\":[[\"$\",\"h4\",null,{\"className\":\"font-headline-sm text-headline-sm text-on-surface font-bold\",\"children\":\"Redaksi TugasMu\"}],[\"$\",\"span\",null,{\"className\":\"px-2.5 py-0.5 rounded-full bg-secondary text-on-secondary font-label-sm text-label-sm\",\"children\":\"Tim Edukasi\"}]]}],[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant\",\"children\":\"Tim kurator konten yang berdedikasi untuk membagikan tips belajar, pembaruan kurikulum, dan cara cerdas memanfaatkan AI bagi pelajar Indonesia.\"}]]}]]}]]}],[\"$\",\"aside\",null,{\"className\":\"lg:col-span-4 flex flex-col gap-space-lg lg:sticky lg:top-24\",\"children\":[\"$\",\"div\",null,{\"className\":\"p-space-lg rounded-xl bg-gradient-to-b from-surface-container to-surface-container-high shadow-sm flex flex-col gap-space-md border border-slate-100\",\"children\":[[\"$\",\"div\",null,{\"className\":\"w-10 h-10 rounded-xl bg-primary-container text-on-primary flex items-center justify-center shadow-xs\",\"children\":[\"$\",\"span\",null,{\"className\":\"material-symbols-outlined text-[22px]\",\"children\":\"auto_awesome\"}]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h4\",null,{\"className\":\"font-headline-sm text-headline-sm text-on-surface font-bold\",\"children\":\"Butuh Bantuan Tugas?\"}],[\"$\",\"p\",null,{\"className\":\"font-body-sm text-body-sm text-on-surface-variant mt-1\",\"children\":\"Gunakan asisten AI TugasMu secara gratis. Buat soal, parafrase makalah, dan temukan jawaban dari PR-mu.\"}]]}],[\"$\",\"$Lb\",null,{\"href\":\"/tools\",\"className\":\"w-full inline-flex items-center justify-center gap-2 bg-primary-container hover:bg-primary text-on-primary py-2.5 px-4 rounded-xl font-label-md text-label-md transition-all shadow-sm\",\"children\":[[\"$\",\"span\",null,{\"children\":\"Buka Tools AI\"}],[\"$\",\"span\",null,{\"className\":\"material-symbols-outlined text-[16px]\",\"children\":\"arrow_forward\"}]]}]]}]}]]}],[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"Article\\\",\\\"headline\\\":\\\"Pecahan Campuran: Cara Menghitung dan Mengubahnya\\\",\\\"description\\\":\\\"\\\",\\\"datePublished\\\":\\\"2026-09-22T00:00:00.000Z\\\",\\\"author\\\":{\\\"@type\\\":\\\"Organization\\\",\\\"name\\\":\\\"TugasMu\\\"}}\"}}]]}]\nc:[[\"$\",\"meta\",\"0\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}],[\"$\",\"meta\",\"1\",{\"charSet\":\"utf-8\"}],[\"$\",\"title\",\"2\",{\"children\":\"Pecahan Campuran: Cara Menghitung dan Mengubahnya | TugasMu | TugasMu\"}],[\"$\",\"meta\",\"3\",{\"property\":\"og:title\",\"content\":\"Pecahan Campuran: Cara Menghitung dan Mengubahnya\"}],[\"$\",\"meta\",\"4\",{\"property\":\"og:type\",\"content\":\"article\"}],[\"$\",\"meta\",\"5\",{\"property\":\"article:published_time\",\"content\":\"Tue Sep 22 2026 08:00:00 GMT+0800 (Central Indonesia Time)\"}],[\"$\",\"meta\",\"6\",{\"name\":\"twitter:card\",\"content\":\"summary\"}],[\"$\",\"meta\",\"7\",{\"name\":\"twitter:title\",\"content\":\"Pecahan Campuran: Cara Menghitung dan Mengubahnya\"}],[\"$\",\"link\",\"8\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}]]\n1:null\nd:[[\"$\",\"h1\",null,{\"className\":\"font-headline-lg text-headline-lg text-on-surface tracking-tight mb-space-lg leading-tight\",\"children\":\"Pecahan Campuran: Cara Menghitung dan Mengubahnya\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Pecahan Campuran adalah bentuk bilangan matematika yang menggabungkan satu bilangan bulat utuh dengan satu pecahan biasa bernilai kurang dari satu. Bentuk penulisan ini menyederhanakan penyajian nilai kuantitas yang melebihi satuan penuh tanpa harus menuliskan pembilang angka besar yang rumit. Kamu dapat menguasai konversi bentuk serta empat operasi hitung aritmatika dasar melalui pemahaman konsep nilai pecahan campuran.\"}],\"\\n\",[\"$\",\"h2\",null,{\"className\":\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\",\"children\":\"Apa Itu Pecahan Campuran dan Bedanya dari Pecahan Biasa\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":[\"Pecahan Campuran adalah bilangan yang terdiri dari perpaduan angka bulat dan bagian pecahan biasa murni. Format penulisan angka ini merepresentasikan nilai riil dalam kehidupan sehari-hari, seperti saat kamu menakar 1 1/2 sendok teh gula atau menghitung 2 1/4 jam waktu belajar mandiri di rumah. Kamu dapat mengasah pemahaman materi ini menggunakan \",[\"$\",\"$Lb\",null,{\"href\":\"/tools/generator-soal\",\"children\":\"Generator Soal TugasMu\"}],\" untuk latihan soal pecahan terstruktur sesuai jenjang kelasmu.\"]}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Jenjang kelasmu sering menyajikan berbagai bentuk bilangan yang menuntut kejelian dalam membedakan ciri setiap pecahan secara tepat. Perbandingan karakteristik antara tiga jenis pecahan utama dapat kamu amati pada tabel berikut:\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"| Jenis Pecahan | Bentuk Umum | Contoh Angka | Karakteristik Nilai |\\r\\n| :--- | :--- | :--- | :--- |\\r\\n| Pecahan Biasa | a/b | 3/4 atau 5/3 | Terdiri dari pembilang dan penyebut tanpa bilangan bulat di depannya |\\r\\n| Pecahan Campuran | c a/b | 2 1/4 | Memiliki bilangan bulat utuh yang mendampingi pecahan biasa murni |\\r\\n| Desimal | 0,x atau x,y | 0,75 atau 2,25 | Memakai tanda koma pemisah untuk menyatakan nilai persepuluhan |\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Nilai persepuluhan pada desimal dan pecahan biasa menjadi lebih teratur saat kamu menuliskannya dalam format pecahan campuran.\"}],\"\\n\",[\"$\",\"h3\",null,{\"className\":\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\",\"children\":\"Struktur Pecahan Campuran: Bilangan Bulat + Pecahan Biasa\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Pecahan campuran memadukan dua bagian utama, yaitu bilangan bulat utuh di bagian depan dan pecahan biasa murni sebagai penyerta di sampingnya. Ambil contoh pecahan 3 2/5, angka 3 berkedudukan sebagai bilangan bulat, angka 2 sebagai pembilang, serta angka 5 sebagai penyebut. Mengapa pembilang pada bagian pecahan biasa selalu lebih kecil dari penyebutnya? Pembilang harus lebih kecil agar nilai bagian pecahan tetap berada di bawah satu satuan utuh.\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Satuan utuh tersebut mencegah terjadinya kerancuan bentuk penulisan angka karena bagian bulat sudah memuat kelipatan penuh penyebut. Nilai 3 2/5 pada hakikatnya bermakna operasi penjumlahan tersembunyi antara 3 ditambah 2/5 tanpa mengubah nilai dasarnya. Pemahaman terhadap pemisahan komponen ini akan mempermudah langkahmu saat mempelajari teknik konversi bentuk pecahan campuran.\"}],\"\\n\",[\"$\",\"h3\",null,{\"className\":\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\",\"children\":\"Cara Mengubah Pecahan Campuran ke Pecahan Biasa (dan Sebaliknya)\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Pecahan campuran dapat kamu ubah menjadi pecahan biasa maupun sebaliknya menggunakan rumus aritmatika langsung. Prosedur ini wajib kamu kuasai karena operasi perkalian dan pembagian pecahan tidak bisa dikerjakan langsung dalam format campuran. Langkah terarah mengubah pecahan campuran c a/b menjadi pecahan biasa adalah:\"}],\"\\n\",[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"Kalikan bilangan bulat c dengan angka penyebut b.\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Tambahkan hasil perkalian tersebut dengan angka pembilang a untuk memperoleh pembilang baru.\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Pertahankan angka penyebut b yang sama persis di bagian bawah tanpa perubahan.\"}],\"\\n\"]}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Tanpa perubahan penyebut, contoh pecahan 3 2/5 berubah menjadi ((3 × 5) + 2) / 5 sehingga menghasilkan pecahan biasa 17/5. Sebaliknya, kamu dapat mengubah pecahan biasa tidak murni 17/5 kembali ke bentuk campuran dengan membagi 17 dengan 5, yang menghasilkan angka 3 dengan sisa 2 sehingga tertulis 3 2/5. Lalu bagaimana cara memastikan konversi pecahan biasa ke pecahan campuran sudah benar? Kamu cukup mengalikan kembali bilangan bulat dengan penyebut lalu menambahkannya dengan sisa pembilang untuk mencocokkan nilai awal pecahan campuran.\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Pecahan campuran yang telah kamu pahami strukturnya kini siap dioperasikan melalui proses penjumlahan dan pengurangan pecahan campuran.\"}],\"\\n\",[\"$\",\"h2\",null,{\"className\":\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\",\"children\":\"Operasi Penjumlahan dan Pengurangan Pecahan Campuran\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Pecahan Campuran dapat dijumlahkan dan dikurangkan dengan dua pendekatan metode, yaitu memisahkan bilangan bulat atau mengubah seluruh bagian menjadi pecahan biasa. Pendekatan pemisahan bilangan bulat mempermudah proses hitung saat kamu berhadapan dengan bilangan utuh berukuran besar. Kamu dapat memilih metode yang paling efisien untuk mempercepat penyelesaian soal pecahan campuran.\"}],\"\\n\",[\"$\",\"h3\",null,{\"className\":\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\",\"children\":\"Cara Menjumlahkan Pecahan Campuran dengan Penyebut Berbeda\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Pecahan campuran dengan penyebut berbeda mewajibkan kamu menyamakan penyebut menggunakan nilai Kelipatan Persekutuan Terkecil (KPK). Sebagai contoh, amati penjumlahan antara 2 1/3 dan 1 1/2 berikut. Langkah terarah untuk menjumlahkan pecahan campuran 2 1/3 dan 1 1/2 dengan metode pemisahan bilangan bulat adalah:\"}],\"\\n\",[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"Pisahkan dan jumlahkan bilangan bulat dari kedua pecahan: 2 + 1 = 3.\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Tentukan KPK dari penyebut 3 dan 2, yaitu angka 6.\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Ubah pecahan biasa ke penyebut 6: 1/3 menjadi 2/6, dan 1/2 menjadi 3/6.\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Jumlahkan kedua pecahan biasa yang telah setara: 2/6 + 3/6 = 5/6.\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Gabungkan kembali hasil bilangan bulat dan pecahan: 3 + 5/6 = 3 5/6.\"}],\"\\n\"]}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Hasil 3 5/6 membuktikan bahwa pemisahan bilangan bulat menghemat energi hitung dibandingkan mengalikan angka pembilang yang besar. Pahami konsepnya agar kamu tidak terjebak kesalahan umum saat menjumlahkan penyebut secara langsung. Bagaimana jika penjumlahan pecahan biasa menghasilkan pecahan tidak murni dengan pembilang lebih besar dari penyebut? Kamu cukup mengubah kelebihan nilai pecahan tersebut menjadi bilangan bulat tambahan lalu menggabungkannya ke angka bulat utama pecahan campuran.\"}],\"\\n\",[\"$\",\"h3\",null,{\"className\":\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\",\"children\":\"Cara Mengurangkan Pecahan Campuran dengan Teknik Meminjam\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Pecahan campuran pada operasi pengurangan menuntut ketelitian ekstra saat pembilang pecahan pertama bernilai lebih kecil daripada pembilang pecahan pengurang. Kondisi ini sering terjadi pada soal seperti 4 1/5 dikurangi 1 3/5, di mana pembilang 1 tidak dapat langsung dikurangi dengan 3. Tahapan pelaksanaan teknik meminjam pada pengurangan 4 1/5 - 1 3/5 berlangsung melalui urutan berikut:\"}],\"\\n\",[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"Ambil 1 satuan dari bilangan bulat 4 sehingga menyisakan angka bulat 3.\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Ubah 1 satuan pinjaman tersebut menjadi pecahan bernilai 5/5 mengikuti nilai penyebut.\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Tambahkan pecahan 5/5 ke pecahan awal 1/5 sehingga membentuk nilai baru 6/5.\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Kurangkan bilangan bulat utama: 3 - 1 = 2.\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Kurangkan pecahan biasa: 6/5 - 3/5 = 3/5, lalu gabungkan hasil menjadi 2 3/5.\"}],\"\\n\"]}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Nilai 2 3/5 menjadi jawaban akhir yang valid tanpa perlu memunculkan angka negatif di tengah pengerjaan. Apakah teknik meminjam ini berlaku jika penyebut kedua pecahan berbeda sejak awal? Kamu wajib menyamakan penyebut kedua pecahan terlebih dahulu menggunakan KPK sebelum memutuskan perlu atau tidaknya meminjam nilai dari bilangan bulat pecahan campuran.\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Pecahan campuran yang berhasil kamu selesaikan lewat penjumlahan dan pengurangan menjadi modal penting sebelum menguasai perkalian serta pembagian pecahan campuran.\"}],\"\\n\",[\"$\",\"h2\",null,{\"className\":\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\",\"children\":\"Operasi Perkalian dan Pembagian Pecahan Campuran\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Pecahan Campuran dikalikan dan dibagi dengan cara mengubah setiap bentuk campuran menjadi pecahan biasa terlebih dahulu tanpa pengecualian. Kamu tidak boleh mengalikan bilangan bulat dengan bilangan bulat lalu pecahan dengan pecahan secara langsung karena cara tersebut menghasilkan jawaban keliru. Mengubah pecahan campuran menjadi pecahan biasa merupakan langkah wajib agar perhitunganmu berjalan sesuai hukum aljabar pecahan campuran.\"}],\"\\n\",[\"$\",\"h3\",null,{\"className\":\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\",\"children\":\"Cara Mengalikan Pecahan Campuran: Ubah ke Pecahan Biasa Dulu\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Pecahan campuran harus kamu ubah menjadi pecahan biasa sebelum menerapkan rumus perkalian pembilang dikali pembilang dan penyebut dikali penyebut. Perhatikan contoh pengerjaan perkalian antara 2 1/2 dengan 1 1/3 berikut. Urutan langkah mengalikan 2 1/2 dengan 1 1/3 secara sistematis adalah:\"}],\"\\n\",[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"Ubah 2 1/2 menjadi 5/2 dan ubah 1 1/3 menjadi 4/3.\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Kalikan kedua pembilang: 5 × 4 = 20.\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Kalikan kedua penyebut: 2 × 3 = 6.\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Bagi pembilang dan penyebut dengan angka 2 untuk penyederhanaan: 20/6 disederhanakan menjadi 10/3.\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Ubah kembali pecahan biasa 10/3 menjadi pecahan campuran: 3 1/3.\"}],\"\\n\"]}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Hasil 3 1/3 dapat kamu peroleh lebih cepat jika menerapkan teknik penyederhanaan silang sebelum mengalikan pembilang dan penyebut. Pada angka 5/2 dikali 4/3, angka 4 pada pembilang dan angka 2 pada penyebut dapat kamu bagi dengan angka 2 sehingga menyisakan perkalian 5/1 dikali 2/3 yang langsung menghasilkan 10/3. Kapan teknik penyederhanaan silang paling efektif diterapkan pada perkalian pecahan? Teknik penyederhanaan silang paling efektif diterapkan saat angka pembilang dan penyebut memiliki faktor persekutuan lebih besar dari satu pada pecahan campuran.\"}],\"\\n\",[\"$\",\"h3\",null,{\"className\":\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\",\"children\":\"Cara Membagi Pecahan Campuran dengan Teknik Kebalikan\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Pecahan campuran pada operasi pembagian diselesaikan melalui teknik inversi perkalian atau membalik posisi pembilang dan penyebut pada pecahan kedua. Aturan ini mensyaratkan kedua pecahan campuran berubah menjadi pecahan biasa sebelum kamu membalik tanda operasi bagi menjadi tanda kali. Langkah terperinci pembagian 3 1/2 dengan 1 3/4 menggunakan metode inversi kebalikan adalah:\"}],\"\\n\",[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"Ubah pecahan campuran 3 1/2 menjadi pecahan biasa 7/2.\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Ubah pecahan campuran pembagi 1 3/4 menjadi pecahan biasa 7/4.\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Balik posisi pecahan kedua dari 7/4 menjadi 4/7 dan ubah tanda bagi menjadi tanda kali.\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Kalikan kedua pecahan: (7/2) × (4/7) = (7 × 4) / (2 × 7) = 28/14.\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Bagi angka pembilang 28 dengan penyebut 14 untuk memperoleh hasil bilangan bulat 2.\"}],\"\\n\"]}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Angka 2 menunjukkan bahwa pembagian dua bilangan pecahan dapat menghasilkan bilangan bulat utuh tanpa sisa pecahan. Bagaimana jika hasil pembagian masih berupa pecahan biasa tidak murni yang tidak habis dibagi? Kamu cukup mengonversi kembali pecahan tidak murni tersebut menjadi bentuk campuran dengan membagi pembilang terhadap nilai penyebut pecahan campuran.\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Pecahan campuran yang telah kamu kuasai dari sisi operasi aritmatika teknis kini membutuhkan latihan kontekstual melalui pemecahan variasi soal cerita pecahan campuran.\"}],\"\\n\",[\"$\",\"h2\",null,{\"className\":\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\",\"children\":\"Contoh Soal Cerita Pecahan Campuran di Ujian\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Pecahan Campuran dalam soal cerita sering muncul untuk menguji kemampuan logika matematis siswa dalam menerjemahkan kalimat narasi menjadi model perhitungan matematika yang tepat. Tantangan terbesar dalam soal cerita terletak pada kejelian menentukan jenis operasi hitung yang dibutuhkan, apakah penjumlahan, pengurangan, perkalian, atau pembagian. Membiasakan diri membedah skenario narasi kontekstual akan meningkatkan kepercayaan dirimu saat menyelesaikan tugas sekolah pecahan campuran.\"}],\"\\n\",[\"$\",\"h3\",null,{\"className\":\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\",\"children\":\"Contoh Soal: Menghitung Bahan Masakan\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Pecahan campuran pada takaran resep masakan kerap menguji pemahaman penjumlahan dan pengurangan bahan secara terpadu. Perhatikan contoh soal berikut: Ibu memiliki persediaan tepung terigu sebanyak 3 1/2 kg di dapur. Ibu memakai 1 3/4 kg tepung untuk membuat martabak manis, kemudian membeli lagi sebanyak 2 1/4 kg tepung di toko bahan kue. Berapa kilogram total persediaan tepung terigu Ibu sekarang? Rincian tahap penyelesaian soal bahan kue tersebut mencakup kalkulasi berikut:\"}],\"\\n\",[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"Hitung sisa tepung setelah memasak melalui pengurangan: 3 1/2 kg - 1 3/4 kg = 7/2 kg - 7/4 kg = 14/4 kg - 7/4 kg = 7/4 kg (atau 1 3/4 kg).\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Tambahkan sisa tepung dengan tepung yang baru dibeli: 7/4 kg + 2 1/4 kg = 7/4 kg + 9/4 kg = 16/4 kg.\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Sederhanakan nilai 16/4 kg menjadi 4 kg tepung terigu utuh.\"}],\"\\n\"]}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Tepung terigu utuh seberat 4 kg tersebut menjadi jawaban akhir yang logis setelah kamu menggabungkan dua operasi pecahan bertahap. Bagaimana cara cepat memeriksa kembali apakah jawaban soal cerita bahan masakan sudah masuk akal? Kamu dapat membuat taksiran kasar dengan membulatkan pecahan ke bilangan bulat terdekat sebelum menghitung angka pasti pecahan campuran.\"}],\"\\n\",[\"$\",\"h3\",null,{\"className\":\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\",\"children\":\"Contoh Soal: Menghitung Jarak dan Waktu dengan Pecahan\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Pecahan campuran untuk perhitungan rute tempuh dan durasi waktu menguji ketelitian perkalian serta pembagian pecahan pada fenomena gerak. Amati contoh soal berikut: Sebuah sepeda motor melaju dengan kecepatan konstan 42 1/2 km per jam selama 1 1/5 jam perjalanan luar kota. Berapakah jarak tempuh total sepeda motor tersebut? Langkah komputasi jarak tempuh kendaraan tersebut diuraikan melalui tahapan berikut:\"}],\"\\n\",[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"Ubah kecepatan 42 1/2 km/jam menjadi pecahan biasa: ((42 × 2) + 1) / 2 = 85/2 km/jam.\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Ubah waktu tempuh 1 1/5 jam menjadi pecahan biasa: ((1 × 5) + 1) / 5 = 6/5 jam.\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Terapkan rumus fisika jarak sama dengan kecepatan dikali waktu: (85/2) × (6/5) km.\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Terapkan penyederhanaan silang: 85 dibagi 5 menghasilkan 17, dan 6 dibagi 2 menghasilkan 3.\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Kalikan sisa angka pembilang: 17 × 3 = 51 km jarak tempuh total.\"}],\"\\n\"]}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":[\"Jarak tempuh total sejauh 51 km ini membuktikan bahwa penyederhanaan silang menghindarkanmu dari perkalian angka ratusan yang rawan keliru. Apakah model perhitungan jarak dan waktu ini berhubungan dengan materi pelajaran lanjutan? Pemahaman pemodelan pecahan kontekstual ini menjadi pijakan sebelum kamu mendalami materi aljabar yang dibahas lengkap pada panduan \",[\"$\",\"$Lb\",null,{\"href\":\"/blog/matematika/konsep-dasar-aljabar-smp\",\"children\":\"konsep dasar aljabar smp\"}],\". Penguasaan konsep variabel tersebut saling melengkapi dengan kemampuanmu dalam menyelesaikan soal cerita pecahan campuran.\"]}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Pecahan campuran dalam berbagai studi kasus soal cerita membuktikan bahwa penguasaan konversi bentuk dan keempat operasi dasar merupakan keterampilan matematika terpadu yang saling menguatkan pemahaman materi pecahan campuran.\"}],\"\\n\",[\"$\",\"h2\",null,{\"className\":\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\",\"children\":\"Kesimpulan: Rangkuman Kunci Menghitung Pecahan Campuran\"}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":\"Pecahan Campuran menuntut penguasaan konsep yang konsisten mulai dari pemahaman struktur hingga penerapan pada soal kontekstual. Rangkuman intisari dari setiap pokok bahasan pecahan campuran mencakup empat prinsip utama:\"}],\"\\n\",[\"$\",\"ul\",null,{\"children\":[\"\\n\",[\"$\",\"li\",null,{\"children\":\"Karakteristik pecahan campuran menggabungkan bilangan bulat utuh dan pecahan biasa murni untuk menyajikan nilai kuantitas di atas satu satuan secara ringkas.\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Operasi penjumlahan dan pengurangan pecahan campuran membutuhkan penyamaan penyebut menggunakan KPK serta penerapan teknik meminjam jika pembilang pertama bernilai lebih kecil.\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Operasi perkalian dan pembagian pecahan campuran mewajibkan perubahan seluruh format menjadi pecahan biasa sebelum menerapkan perkalian langsung atau pembalikan pecahan pembagi.\"}],\"\\n\",[\"$\",\"li\",null,{\"children\":\"Penyelesaian soal cerita pecahan campuran mengandalkan ketepatan penerjemahan narasi teks ke dalam model matematika sebelum mengeksekusi operasi hitung.\"}],\"\\n\"]}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\",\"children\":[\"Hitung setiap latihan dengan tenang dan penuh keyakinan. Sebagai teman pintar belajar, TugasMu mendampingimu lewat bimbingan AI agar kamu selalu paham konsepnya secara mendalam tanpa jalan pintas yang merugikan belajarmu. Jelajahi kumpulan materi pendukung di rubrik \",[\"$\",\"$Lb\",null,{\"href\":\"/blog/matematika/\",\"children\":\"Matematika\"}],\" dan gunakan \",[\"$\",\"$Lb\",null,{\"href\":\"/tools/generator-soal\",\"children\":\"Generator Soal TugasMu\"}],\" untuk latihan soal pecahan agar nilaimu terus meningkat di sekolah. Bukan tools curang, tapi teman pintar belajarmu dalam meraih prestasi akademik impian.\"]}]]\n"}