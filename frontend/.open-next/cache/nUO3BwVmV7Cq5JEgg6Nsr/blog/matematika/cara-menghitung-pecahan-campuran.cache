content=\"Pecahan Campuran: Cara Menghitung dan Mengubahnya\"/><link rel=\"icon\" href=\"/favicon.ico\" type=\"image/x-icon\" sizes=\"16x16\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"font-sans bg-brand-cream text-brand-navy flex flex-col min-h-screen __variable_0d7163 __variable_5667dc\"><header class=\"sticky top-0 z-50 w-full\"><div class=\"bg-brand-cream/95 backdrop-blur-md border-b border-brand-navy/10\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between\"><a class=\"flex items-center gap-2.5 group\" href=\"/\"><div class=\"w-8 h-8 rounded-lg bg-brand-navy flex items-center justify-center shadow-sm group-hover:bg-brand-lime transition-colors duration-300\"><svg class=\"w-4 h-4 fill-brand-cream group-hover:fill-brand-navy transition-colors duration-300\" viewBox=\"0 0 24 24\"><polygon points=\"13 2 3 14 12 14 11 22 21 10 12 10 13 2\"></polygon></svg></div><span class=\"font-heading font-bold text-xl text-brand-navy tracking-tight group-hover:text-brand-navy/70 transition-colors\">TugasMu</span></a><nav class=\"hidden md:flex items-center gap-1\"><a class=\"relative px-4 py-2 text-sm font-semibold rounded-full transition-all duration-200 text-brand-navy/70 hover:text-brand-navy hover:bg-brand-navy/5\" href=\"/tools\">AI Tools</a><a class=\"relative px-4 py-2 text-sm font-semibold rounded-full transition-all duration-200 text-brand-navy/70 hover:text-brand-navy hover:bg-brand-navy/5\" href=\"/harga\">Premium</a><a class=\"relative px-4 py-2 text-sm font-semibold rounded-full transition-all duration-200 text-brand-navy bg-brand-lime\" href=\"/blog\">Blog</a></nav><div class=\"hidden md:flex items-center gap-3\"><a class=\"px-5 py-2.5 rounded-full bg-brand-navy hover:bg-brand-navy/90 text-brand-cream font-bold text-sm transition-all shadow-sm hover:shadow-md active:scale-95 flex items-center gap-2\" href=\"/masuk\">Masuk / Daftar</a></div><div class=\"flex md:hidden items-center gap-3\"><button class=\"p-2 rounded-full text-brand-navy hover:bg-brand-navy/5 transition-colors\" aria-label=\"Toggle Menu\"><svg class=\"w-5 h-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\"><line x1=\"3\" y1=\"8\" x2=\"21\" y2=\"8\"></line><line x1=\"3\" y1=\"16\" x2=\"21\" y2=\"16\"></line></svg></button></div></div></div></header><div class=\"bg-slate-50 border-b\"><div class=\"container py-3\"><nav class=\"flex text-sm text-slate-500\" aria-label=\"Breadcrumb\"><ol class=\"inline-flex items-center space-x-1 md:space-x-3\"><li class=\"inline-flex items-center\"><a class=\"hover:text-slate-900 transition-colors\" href=\"/\">Home</a></li><li><div class=\"flex items-center\"><span class=\"mx-2 text-slate-400\">/</span><a class=\"hover:text-slate-900 transition-colors\" href=\"/blog\">Blog</a></div></li><li><div class=\"flex items-center\"><span class=\"mx-2 text-slate-400\">/</span><a class=\"hover:text-slate-900 transition-colors\" href=\"/blog/matematika\">Matematika</a></div></li><li><div class=\"flex items-center\"><span class=\"mx-2 text-slate-400\">/</span><span class=\"text-slate-900 font-medium\" aria-current=\"page\">Cara menghitung pecahan campuran</span></div></li></ol></nav></div></div><main class=\"flex-1\"><div class=\"w-full max-w-[1200px] mx-auto px-margin md:px-margin-desktop py-space-lg md:py-space-xl\"><nav aria-label=\"Breadcrumb\" class=\"flex items-center gap-space-xs text-on-surface-variant font-body-sm text-body-sm mb-space-lg overflow-x-auto whitespace-nowrap scrollbar-none\"><a class=\"hover:text-primary transition-colors flex items-center gap-1\" href=\"/\"><span class=\"material-symbols-outlined text-[16px]\">home</span><span>Home</span></a><span class=\"material-symbols-outlined text-[14px] text-outline\">chevron_right</span><a class=\"hover:text-primary transition-colors\" href=\"/blog\">Blog</a><span class=\"material-symbols-outlined text-[14px] text-outline\">chevron_right</span><a class=\"hover:text-primary transition-colors capitalize\" href=\"/blog/matematika\">matematika</a><span class=\"material-symbols-outlined text-[14px] text-outline\">chevron_right</span><span class=\"text-primary truncate max-w-[200px] md:max-w-none font-medium\">Pecahan Campuran: Cara Menghitung dan Mengubahnya</span></nav><div class=\"grid grid-cols-1 lg:grid-cols-12 gap-space-xl items-start\"><article class=\"lg:col-span-8 flex flex-col\"><div class=\"flex flex-wrap items-center gap-space-sm mb-space-md\"><span class=\"px-space-md py-1 rounded-xl bg-primary-fixed text-on-primary-fixed font-label-sm text-label-sm tracking-wide uppercase\">matematika</span><span class=\"px-space-md py-1 rounded-xl bg-surface-container text-on-surface-variant font-label-sm text-label-sm flex items-center gap-1\"><span class=\"material-symbols-outlined text-[14px] text-primary\">schedule</span>5 menit baca</span></div><h1 class=\"font-headline-lg text-headline-lg md:text-display-lg text-on-surface tracking-tight mb-space-lg leading-tight\">Pecahan Campuran: Cara Menghitung dan Mengubahnya</h1><div class=\"flex flex-col sm:flex-row sm:items-center justify-between gap-space-md p-space-md md:p-space-lg rounded-xl bg-surface-container-low mb-space-xl border border-slate-100\"><div class=\"flex items-center gap-space-md\"><div class=\"w-12 h-12 rounded-full bg-primary-container text-on-primary font-headline-sm text-headline-sm flex items-center justify-center font-bold shadow-sm ring-2 ring-primary-fixed\">TM</div><div><div class=\"flex items-center gap-1.5\"><span class=\"font-label-lg text-label-lg text-on-surface font-bold\">Tim Kurasi TugasMu</span><span class=\"material-symbols-outlined text-primary text-[16px]\" title=\"Terverifikasi\">verified</span></div><p class=\"font-body-sm text-body-sm text-on-surface-variant\">Diterbitkan pada <!-- -->22 September 2026</p></div></div><div class=\"flex items-center gap-2 pt-space-xs sm:pt-0\"><button class=\"inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-surface-container-lowest hover:bg-surface-container text-secondary font-label-md text-label-md transition-all shadow-sm\"><span class=\"material-symbols-outlined text-[18px]\">share</span><span class=\"hidden sm:inline\">Bagikan</span></button></div></div><div class=\"prose-content flex flex-col gap-space-lg text-on-surface font-body-lg text-body-lg leading-relaxed bg-surface-container-lowest p-space-lg md:p-space-xl rounded-xl shadow-sm border border-slate-100\"><h1 class=\"font-headline-lg text-headline-lg text-on-surface tracking-tight mb-space-lg leading-tight\">Pecahan Campuran: Cara Menghitung dan Mengubahnya</h1>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Pecahan Campuran adalah bentuk bilangan matematika yang menggabungkan satu bilangan bulat utuh dengan satu pecahan biasa bernilai kurang dari satu. Bentuk penulisan ini menyederhanakan penyajian nilai kuantitas yang melebihi satuan penuh tanpa harus menuliskan pembilang angka besar yang rumit. Kamu dapat menguasai konversi bentuk serta empat operasi hitung aritmatika dasar melalui pemahaman konsep nilai pecahan campuran.</p>\n<h2 class=\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\">Apa Itu Pecahan Campuran dan Bedanya dari Pecahan Biasa</h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Pecahan Campuran adalah bilangan yang terdiri dari perpaduan angka bulat dan bagian pecahan biasa murni. Format penulisan angka ini merepresentasikan nilai riil dalam kehidupan sehari-hari, seperti saat kamu menakar 1 1/2 sendok teh gula atau menghitung 2 1/4 jam waktu belajar mandiri di rumah. Kamu dapat mengasah pemahaman materi ini menggunakan <a href=\"/tools/generator-soal\">Generator Soal TugasMu</a> untuk latihan soal pecahan terstruktur sesuai jenjang kelasmu.</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Jenjang kelasmu sering menyajikan berbagai bentuk bilangan yang menuntut kejelian dalam membedakan ciri setiap pecahan secara tepat. Perbandingan karakteristik antara tiga jenis pecahan utama dapat kamu amati pada tabel berikut:</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">| Jenis Pecahan | Bentuk Umum | Contoh Angka | Karakteristik Nilai |\r\n| :--- | :--- | :--- | :--- |\r\n| Pecahan Biasa | a/b | 3/4 atau 5/3 | Terdiri dari pembilang dan penyebut tanpa bilangan bulat di depannya |\r\n| Pecahan Campuran | c a/b | 2 1/4 | Memiliki bilangan bulat utuh yang mendampingi pecahan biasa murni |\r\n| Desimal | 0,x atau x,y | 0,75 atau 2,25 | Memakai tanda koma pemisah untuk menyatakan nilai persepuluhan |</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Nilai persepuluhan pada desimal dan pecahan biasa menjadi lebih teratur saat kamu menuliskannya dalam format pecahan campuran.</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">Struktur Pecahan Campuran: Bilangan Bulat + Pecahan Biasa</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Pecahan campuran memadukan dua bagian utama, yaitu bilangan bulat utuh di bagian depan dan pecahan biasa murni sebagai penyerta di sampingnya. Ambil contoh pecahan 3 2/5, angka 3 berkedudukan sebagai bilangan bulat, angka 2 sebagai pembilang, serta angka 5 sebagai penyebut. Mengapa pembilang pada bagian pecahan biasa selalu lebih kecil dari penyebutnya? Pembilang harus lebih kecil agar nilai bagian pecahan tetap berada di bawah satu satuan utuh.</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Satuan utuh tersebut mencegah terjadinya kerancuan bentuk penulisan angka karena bagian bulat sudah memuat kelipatan penuh penyebut. Nilai 3 2/5 pada hakikatnya bermakna operasi penjumlahan tersembunyi antara 3 ditambah 2/5 tanpa mengubah nilai dasarnya. Pemahaman terhadap pemisahan komponen ini akan mempermudah langkahmu saat mempelajari teknik konversi bentuk pecahan campuran.</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">Cara Mengubah Pecahan Campuran ke Pecahan Biasa (dan Sebaliknya)</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Pecahan campuran dapat kamu ubah menjadi pecahan biasa maupun sebaliknya menggunakan rumus aritmatika langsung. Prosedur ini wajib kamu kuasai karena operasi perkalian dan pembagian pecahan tidak bisa dikerjakan langsung dalam format campuran. Langkah terarah mengubah pecahan campuran c a/b menjadi pecahan biasa adalah:</p>\n<ul>\n<li>Kalikan bilangan bulat c dengan angka penyebut b.</li>\n<li>Tambahkan hasil perkalian tersebut dengan angka pembilang a untuk memperoleh pembilang baru.</li>\n<li>Pertahankan angka penyebut b yang sama persis di bagian bawah tanpa perubahan.</li>\n</ul>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Tanpa perubahan penyebut, contoh pecahan 3 2/5 berubah menjadi ((3 × 5) + 2) / 5 sehingga menghasilkan pecahan biasa 17/5. Sebaliknya, kamu dapat mengubah pecahan biasa tidak murni 17/5 kembali ke bentuk campuran dengan membagi 17 dengan 5, yang menghasilkan angka 3 dengan sisa 2 sehingga tertulis 3 2/5. Lalu bagaimana cara memastikan konversi pecahan biasa ke pecahan campuran sudah benar? Kamu cukup mengalikan kembali bilangan bulat dengan penyebut lalu menambahkannya dengan sisa pembilang untuk mencocokkan nilai awal pecahan campuran.</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Pecahan campuran yang telah kamu pahami strukturnya kini siap dioperasikan melalui proses penjumlahan dan pengurangan pecahan campuran.</p>\n<h2 class=\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\">Operasi Penjumlahan dan Pengurangan Pecahan Campuran</h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Pecahan Campuran dapat dijumlahkan dan dikurangkan dengan dua pendekatan metode, yaitu memisahkan bilangan bulat atau mengubah seluruh bagian menjadi pecahan biasa. Pendekatan pemisahan bilangan bulat mempermudah proses hitung saat kamu berhadapan dengan bilangan utuh berukuran besar. Kamu dapat memilih metode yang paling efisien untuk mempercepat penyelesaian soal pecahan campuran.</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">Cara Menjumlahkan Pecahan Campuran dengan Penyebut Berbeda</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Pecahan campuran dengan penyebut berbeda mewajibkan kamu menyamakan penyebut menggunakan nilai Kelipatan Persekutuan Terkecil (KPK). Sebagai contoh, amati penjumlahan antara 2 1/3 dan 1 1/2 berikut. Langkah terarah untuk menjumlahkan pecahan campuran 2 1/3 dan 1 1/2 dengan metode pemisahan bilangan bulat adalah:</p>\n<ul>\n<li>Pisahkan dan jumlahkan bilangan bulat dari kedua pecahan: 2 + 1 = 3.</li>\n<li>Tentukan KPK dari penyebut 3 dan 2, yaitu angka 6.</li>\n<li>Ubah pecahan biasa ke penyebut 6: 1/3 menjadi 2/6, dan 1/2 menjadi 3/6.</li>\n<li>Jumlahkan kedua pecahan biasa yang telah setara: 2/6 + 3/6 = 5/6.</li>\n<li>Gabungkan kembali hasil bilangan bulat dan pecahan: 3 + 5/6 = 3 5/6.</li>\n</ul>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Hasil 3 5/6 membuktikan bahwa pemisahan bilangan bulat menghemat energi hitung dibandingkan mengalikan angka pembilang yang besar. Pahami konsepnya agar kamu tidak terjebak kesalahan umum saat menjumlahkan penyebut secara langsung. Bagaimana jika penjumlahan pecahan biasa menghasilkan pecahan tidak murni dengan pembilang lebih besar dari penyebut? Kamu cukup mengubah kelebihan nilai pecahan tersebut menjadi bilangan bulat tambahan lalu menggabungkannya ke angka bulat utama pecahan campuran.</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">Cara Mengurangkan Pecahan Campuran dengan Teknik Meminjam</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Pecahan campuran pada operasi pengurangan menuntut ketelitian ekstra saat pembilang pecahan pertama bernilai lebih kecil daripada pembilang pecahan pengurang. Kondisi ini sering terjadi pada soal seperti 4 1/5 dikurangi 1 3/5, di mana pembilang 1 tidak dapat langsung dikurangi dengan 3. Tahapan pelaksanaan teknik meminjam pada pengurangan 4 1/5 - 1 3/5 berlangsung melalui urutan berikut:</p>\n<ul>\n<li>Ambil 1 satuan dari bilangan bulat 4 sehingga menyisakan angka bulat 3.</li>\n<li>Ubah 1 satuan pinjaman tersebut menjadi pecahan bernilai 5/5 mengikuti nilai penyebut.</li>\n<li>Tambahkan pecahan 5/5 ke pecahan awal 1/5 sehingga membentuk nilai baru 6/5.</li>\n<li>Kurangkan bilangan bulat utama: 3 - 1 = 2.</li>\n<li>Kurangkan pecahan biasa: 6/5 - 3/5 = 3/5, lalu gabungkan hasil menjadi 2 3/5.</li>\n</ul>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Nilai 2 3/5 menjadi jawaban akhir yang valid tanpa perlu memunculkan angka negatif di tengah pengerjaan. Apakah teknik meminjam ini berlaku jika penyebut kedua pecahan berbeda sejak awal? Kamu wajib menyamakan penyebut kedua pecahan terlebih dahulu menggunakan KPK sebelum memutuskan perlu atau tidaknya meminjam nilai dari bilangan bulat pecahan campuran.</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Pecahan campuran yang berhasil kamu selesaikan lewat penjumlahan dan pengurangan menjadi modal penting sebelum menguasai perkalian serta pembagian pecahan campuran.</p>\n<h2 class=\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\">Operasi Perkalian dan Pembagian Pecahan Campuran</h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Pecahan Campuran dikalikan dan dibagi dengan cara mengubah setiap bentuk campuran menjadi pecahan biasa terlebih dahulu tanpa pengecualian. Kamu tidak boleh mengalikan bilangan bulat dengan bilangan bulat lalu pecahan dengan pecahan secara langsung karena cara tersebut menghasilkan jawaban keliru. Mengubah pecahan campuran menjadi pecahan biasa merupakan langkah wajib agar perhitunganmu berjalan sesuai hukum aljabar pecahan campuran.</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">Cara Mengalikan Pecahan Campuran: Ubah ke Pecahan Biasa Dulu</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Pecahan campuran harus kamu ubah menjadi pecahan biasa sebelum menerapkan rumus perkalian pembilang dikali pembilang dan penyebut dikali penyebut. Perhatikan contoh pengerjaan perkalian antara 2 1/2 dengan 1 1/3 berikut. Urutan langkah mengalikan 2 1/2 dengan 1 1/3 secara sistematis adalah:</p>\n<ul>\n<li>Ubah 2 1/2 menjadi 5/2 dan ubah 1 1/3 menjadi 4/3.</li>\n<li>Kalikan kedua pembilang: 5 × 4 = 20.</li>\n<li>Kalikan kedua penyebut: 2 × 3 = 6.</li>\n<li>Bagi pembilang dan penyebut dengan angka 2 untuk penyederhanaan: 20/6 disederhanakan menjadi 10/3.</li>\n<li>Ubah kembali pecahan biasa 10/3 menjadi pecahan campuran: 3 1/3.</li>\n</ul>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Hasil 3 1/3 dapat kamu peroleh lebih cepat jika menerapkan teknik penyederhanaan silang sebelum mengalikan pembilang dan penyebut. Pada angka 5/2 dikali 4/3, angka 4 pada pembilang dan angka 2 pada penyebut dapat kamu bagi dengan angka 2 sehingga menyisakan perkalian 5/1 dikali 2/3 yang langsung menghasilkan 10/3. Kapan teknik penyederhanaan silang paling efektif diterapkan pada perkalian pecahan? Teknik penyederhanaan silang paling efektif diterapkan saat angka pembilang dan penyebut memiliki faktor persekutuan lebih besar dari satu pada pecahan campuran.</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">Cara Membagi Pecahan Campuran dengan Teknik Kebalikan</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Pecahan campuran pada operasi pembagian diselesaikan melalui teknik inversi perkalian atau membalik posisi pembilang dan penyebut pada pecahan kedua. Aturan ini mensyaratkan kedua pecahan campuran berubah menjadi pecahan biasa sebelum kamu membalik tanda operasi bagi menjadi tanda kali. Langkah terperinci pembagian 3 1/2 dengan 1 3/4 menggunakan metode inversi kebalikan adalah:</p>\n<ul>\n<li>Ubah pecahan campuran 3 1/2 menjadi pecahan biasa 7/2.</li>\n<li>Ubah pecahan campuran pembagi 1 3/4 menjadi pecahan biasa 7/4.</li>\n<li>Balik posisi pecahan kedua dari 7/4 menjadi 4/7 dan ubah tanda bagi menjadi tanda kali.</li>\n<li>Kalikan kedua pecahan: (7/2) × (4/7) = (7 × 4) / (2 × 7) = 28/14.</li>\n<li>Bagi angka pembilang 28 dengan penyebut 14 untuk memperoleh hasil bilangan bulat 2.</li>\n</ul>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Angka 2 menunjukkan bahwa pembagian dua bilangan pecahan dapat menghasilkan bilangan bulat utuh tanpa sisa pecahan. Bagaimana jika hasil pembagian masih berupa pecahan biasa tidak murni yang tidak habis dibagi? Kamu cukup mengonversi kembali pecahan tidak murni tersebut menjadi bentuk campuran dengan membagi pembilang terhadap nilai penyebut pecahan campuran.</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Pecahan campuran yang telah kamu kuasai dari sisi operasi aritmatika teknis kini membutuhkan latihan kontekstual melalui pemecahan variasi soal cerita pecahan campuran.</p>\n<h2 class=\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\">Contoh Soal Cerita Pecahan Campuran di Ujian</h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Pecahan Campuran dalam soal cerita sering muncul untuk menguji kemampuan logika matematis siswa dalam menerjemahkan kalimat narasi menjadi model perhitungan matematika yang tepat. Tantangan terbesar dalam soal cerita terletak pada kejelian menentukan jenis operasi hitung yang dibutuhkan, apakah penjumlahan, pengurangan, perkalian, atau pembagian. Membiasakan diri membedah skenario narasi kontekstual akan meningkatkan kepercayaan dirimu saat menyelesaikan tugas sekolah pecahan campuran.</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">Contoh Soal: Menghitung Bahan Masakan</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Pecahan campuran pada takaran resep masakan kerap menguji pemahaman penjumlahan dan pengurangan bahan secara terpadu. Perhatikan contoh soal berikut: Ibu memiliki persediaan tepung terigu sebanyak 3 1/2 kg di dapur. Ibu memakai 1 3/4 kg tepung untuk membuat martabak manis, kemudian membeli lagi sebanyak 2 1/4 kg tepung di toko bahan kue. Berapa kilogram total persediaan tepung terigu Ibu sekarang? Rincian tahap penyelesaian soal bahan kue tersebut mencakup kalkulasi berikut:</p>\n<ul>\n<li>Hitung sisa tepung setelah memasak melalui pengurangan: 3 1/2 kg - 1 3/4 kg = 7/2 kg - 7/4 kg = 14/4 kg - 7/4 kg = 7/4 kg (atau 1 3/4 kg).</li>\n<li>Tambahkan sisa tepung dengan tepung yang baru dibeli: 7/4 kg + 2 1/4 kg = 7/4 kg + 9/4 kg = 16/4 kg.</li>\n<li>Sederhanakan nilai 16/4 kg menjadi 4 kg tepung terigu utuh.</li>\n</ul>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Tepung terigu utuh seberat 4 kg tersebut menjadi jawaban akhir yang logis setelah kamu menggabungkan dua operasi pecahan bertahap. Bagaimana cara cepat memeriksa kembali apakah jawaban soal cerita bahan masakan sudah masuk akal? Kamu dapat membuat taksiran kasar dengan membulatkan pecahan ke bilangan bulat terdekat sebelum menghitung angka pasti pecahan campuran.</p>\n<h3 class=\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\">Contoh Soal: Menghitung Jarak dan Waktu dengan Pecahan</h3>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Pecahan campuran untuk perhitungan rute tempuh dan durasi waktu menguji ketelitian perkalian serta pembagian pecahan pada fenomena gerak. Amati contoh soal berikut: Sebuah sepeda motor melaju dengan kecepatan konstan 42 1/2 km per jam selama 1 1/5 jam perjalanan luar kota. Berapakah jarak tempuh total sepeda motor tersebut? Langkah komputasi jarak tempuh kendaraan tersebut diuraikan melalui tahapan berikut:</p>\n<ul>\n<li>Ubah kecepatan 42 1/2 km/jam menjadi pecahan biasa: ((42 × 2) + 1) / 2 = 85/2 km/jam.</li>\n<li>Ubah waktu tempuh 1 1/5 jam menjadi pecahan biasa: ((1 × 5) + 1) / 5 = 6/5 jam.</li>\n<li>Terapkan rumus fisika jarak sama dengan kecepatan dikali waktu: (85/2) × (6/5) km.</li>\n<li>Terapkan penyederhanaan silang: 85 dibagi 5 menghasilkan 17, dan 6 dibagi 2 menghasilkan 3.</li>\n<li>Kalikan sisa angka pembilang: 17 × 3 = 51 km jarak tempuh total.</li>\n</ul>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Jarak tempuh total sejauh 51 km ini membuktikan bahwa penyederhanaan silang menghindarkanmu dari perkalian angka ratusan yang rawan keliru. Apakah model perhitungan jarak dan waktu ini berhubungan dengan materi pelajaran lanjutan? Pemahaman pemodelan pecahan kontekstual ini menjadi pijakan sebelum kamu mendalami materi aljabar yang dibahas lengkap pada panduan <a href=\"/blog/matematika/konsep-dasar-aljabar-smp\">konsep dasar aljabar smp</a>. Penguasaan konsep variabel tersebut saling melengkapi dengan kemampuanmu dalam menyelesaikan soal cerita pecahan campuran.</p>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Pecahan campuran dalam berbagai studi kasus soal cerita membuktikan bahwa penguasaan konversi bentuk dan keempat operasi dasar merupakan keterampilan matematika terpadu yang saling menguatkan pemahaman materi pecahan campuran.</p>\n<h2 class=\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\">Kesimpulan: Rangkuman Kunci Menghitung Pecahan Campuran</h2>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Pecahan Campuran menuntut penguasaan konsep yang konsisten mulai dari pemahaman struktur hingga penerapan pada soal kontekstual. Rangkuman intisari dari setiap pokok bahasan pecahan campuran mencakup empat prinsip utama:</p>\n<ul>\n<li>Karakteristik pecahan campuran menggabungkan bilangan bulat utuh dan pecahan biasa murni untuk menyajikan nilai kuantitas di atas satu satuan secara ringkas.</li>\n<li>Operasi penjumlahan dan pengurangan pecahan campuran membutuhkan penyamaan penyebut menggunakan KPK serta penerapan teknik meminjam jika pembilang pertama bernilai lebih kecil.</li>\n<li>Operasi perkalian dan pembagian pecahan campuran mewajibkan perubahan seluruh format menjadi pecahan biasa sebelum menerapkan perkalian langsung atau pembalikan pecahan pembagi.</li>\n<li>Penyelesaian soal cerita pecahan campuran mengandalkan ketepatan penerjemahan narasi teks ke dalam model matematika sebelum mengeksekusi operasi hitung.</li>\n</ul>\n<p class=\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\">Hitung setiap latihan dengan tenang dan penuh keyakinan. Sebagai teman pintar belajar, TugasMu mendampingimu lewat bimbingan AI agar kamu selalu paham konsepnya secara mendalam tanpa jalan pintas yang merugikan belajarmu. Jelajahi kumpulan materi pendukung di rubrik <a href=\"/blog/matematika\">Matematika</a> dan gunakan <a href=\"/tools/generator-soal\">Generator Soal TugasMu</a> untuk latihan soal pecahan agar nilaimu terus meningkat di sekolah. Bukan tools curang, tapi teman pintar belajarmu dalam meraih prestasi akademik impian.</p></div><section class=\"mt-space-xl p-space-lg md:p-space-xl rounded-xl bg-surface-container-lowest shadow-sm flex flex-col sm:flex-row items-start sm:items-center gap-space-lg border border-slate-100\"><div class=\"w-16 h-16 rounded-full bg-primary-container text-on-primary flex items-center justify-center font-headline-lg text-headline-lg font-bold shrink-0 shadow-md ring-4 ring-primary-fixed\">TM</div><div class=\"flex flex-col gap-1.5 flex-1\"><div class=\"flex flex-wrap items-center gap-2\"><h4 class=\"font-headline-sm text-headline-sm text-on-surface font-bold\">Redaksi TugasMu</h4><span class=\"px-2.5 py-0.5 rounded-full bg-secondary text-on-secondary font-label-sm text-label-sm\">Tim Edukasi</span></div><p class=\"font-body-md text-body-md text-on-surface-variant\">Tim kurator konten yang berdedikasi untuk membagikan tips belajar, pembaruan kurikulum, dan cara cerdas memanfaatkan AI bagi pelajar Indonesia.</p></div></section></article><aside class=\"lg:col-span-4 flex flex-col gap-space-lg lg:sticky lg:top-24\"><div class=\"p-space-lg rounded-xl bg-gradient-to-b from-surface-container to-surface-container-high shadow-sm flex flex-col gap-space-md border border-slate-100\"><div class=\"w-10 h-10 rounded-xl bg-primary-container text-on-primary flex items-center justify-center shadow-xs\"><span class=\"material-symbols-outlined text-[22px]\">auto_awesome</span></div><div><h4 class=\"font-headline-sm text-headline-sm text-on-surface font-bold\">Butuh Bantuan Tugas?</h4><p class=\"font-body-sm text-body-sm text-on-surface-variant mt-1\">Gunakan asisten AI TugasMu secara gratis. Buat soal, parafrase makalah, dan temukan jawaban dari PR-mu.</p></div><a class=\"w-full inline-flex items-center justify-center gap-2 bg-primary-container hover:bg-primary text-on-primary py-2.5 px-4 rounded-xl font-label-md text-label-md transition-all shadow-sm\" href=\"/tools\"><span>Buka Tools AI</span><span class=\"material-symbols-outlined text-[16px]\">arrow_forward</span></a></div></aside></div><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"headline\":\"Pecahan Campuran: Cara Menghitung dan Mengubahnya\",\"description\":\"\",\"datePublished\":\"2026-09-22T00:00:00.000Z\",\"author\":{\"@type\":\"Organization\",\"name\":\"TugasMu\"}}</script></div></main><footer class=\"bg-slate-50 border-t border-slate-200 py-10 mt-auto\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\"><div class=\"flex flex-col md:flex-row items-center justify-between gap-6\"><div class=\"flex flex-col sm:flex-row items-center gap-3 sm:gap-6 text-center sm:text-left\"><div class=\"flex items-center gap-2\"><div class=\"w-7 h-7 rounded-lg bg-sky-500 flex items-center justify-center text-white\"><svg class=\"w-3.5 h-3.5 fill-white\" viewBox=\"0 0 24 24\"><polygon points=\"13 2 3 14 12 14 11 22 21 10 12 10 13 2\"></polygon></svg></div><span class=\"font-bold text-slate-900 text-base font-heading\">TugasMu.com</span></div><span class=\"text-xs sm:text-sm text-slate-500\">© 2026 TugasMu.com. Hak cipta dilindungi.</span></div><div class=\"flex flex-wrap justify-center items-center gap-x-6 gap-y-3 text-xs sm:text-sm font-medium text-slate-500\"><a class=\"hover:text-slate-900 transition-colors\" href=\"/\">Beranda</a><a class=\"hover:text-slate-900 transition-colors\" href=\"/harga\">Premium</a><a class=\"hover:text-slate-900 transition-colors\" href=\"/blog\">Blog</a><a class=\"hover:text-slate-900 transition-colors\" href=\"/privasi\">Privacy Policy</a><a class=\"hover:text-slate-900 transition-colors\" href=\"/syarat\">Terms of Service</a><a class=\"hover:text-slate-900 transition-colors\" href=\"/kontak\">Kontak</a></div></div></div></footer><script src=\"/_next/static/chunks/webpack-37f8c22e297b04f8.js\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0]);self.__next_f.push([2,null])</script><script>self.__next_f.push([1,\"1:HL[\\\"/_next/static/css/c70a6d8e0709b465.css\\\",\\\"style\\\"]\\n2:HL[\\\"/_next/static/css/7eb325243a3b1d61.css\\\",\\\"style\\\"]\\n\"])</script><script>self.__next_f.push([1,\"3:I[2846,[],\\\"\\\"]\\n6:I[4707,[],\\\"\\\"]\\n9:I[6423,[],\\\"\\\"]\\na:I[8003,[\\\"3433\\\",\\\"static/chunks/3433-9ddc6f7f78d9421c.js\\\",\\\"2972\\\",\\\"static/chunks/2972-8ce94bd856f9372b.js\\\",\\\"3185\\\",\\\"static/chunks/app/layout-c819fc26cf8b0e32.js\\\"],\\\"\\\"]\\nb:I[9314,[\\\"3433\\\",\\\"static/chunks/3433-9ddc6f7f78d9421c.js\\\",\\\"2972\\\",\\\"static/chunks/2972-8ce94bd856f9372b.js\\\",\\\"3185\\\",\\\"static/chunks/app/layout-c819fc26cf8b0e32.js\\\"],\\\"default\\\"]\\nc:I[6454,[\\\"3433\\\",\\\"static/chunks/3433-9ddc6f7f78d9421c.js\\\",\\\"2972\\\",\\\"static/chunks/2972-8ce94bd856f9372b.js\\\",\\\"3185\\\",\\\"static/chunks/app/layout-c819fc26cf8b0e32.js\\\"],\\\"Navbar\\\"]\\nd:I[482,[\\\"3433\\\",\\\"static/chunks/3433-9ddc6f7f78d9421c.js\\\",\\\"2972\\\",\\\"static/chunks/2972-8ce94bd856f9372b.js\\\",\\\"3185\\\",\\\"static/chunks/app/layout-c819fc26cf8b0e32.js\\\"],\\\"default\\\"]\\ne:I[2972,[\\\"2972\\\",\\\"static/chunks/2972-8ce94bd856f9372b.js\\\",\\\"9064\\\",\\\"static/chunks/app/blog/%5Bkategori%5D/%5Bslug%5D/page-66ee61aaeae9a3c2.js\\\"],\\\"\\\"]\\n10:I[1060,[],\\\"\\\"]\\n7:[\\\"kategori\\\",\\\"matematika\\\",\\\"d\\\"]\\n8:[\\\"slug\\\",\\\"cara-menghitung-pecahan-campuran\\\",\\\"d\\\"]\\n11:[]\\n\"])</script><script>self.__next_f.push([1,\"0:[\\\"$\\\",\\\"$L3\\\",null,{\\\"buildId\\\":\\\"nUO3BwVmV7Cq5JEgg6Nsr\\\",\\\"assetPrefix\\\":\\\"\\\",\\\"urlParts\\\":[\\\"\\\",\\\"blog\\\",\\\"matematika\\\",\\\"cara-menghitung-pecahan-campuran\\\"],\\\"initialTree\\\":[\\\"\\\",{\\\"children\\\":[\\\"blog\\\",{\\\"children\\\":[[\\\"kategori\\\",\\\"matematika\\\",\\\"d\\\"],{\\\"children\\\":[[\\\"slug\\\",\\\"cara-menghitung-pecahan-campuran\\\",\\\"d\\\"],{\\\"children\\\":[\\\"__PAGE__?{\