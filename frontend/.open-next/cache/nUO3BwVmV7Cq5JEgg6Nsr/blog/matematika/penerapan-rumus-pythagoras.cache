\",{\\\"name\\\":\\\"viewport\\\",\\\"content\\\":\\\"width=device-width, initial-scale=1\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"charSet\\\":\\\"utf-8\\\"}],[\\\"$\\\",\\\"title\\\",\\\"2\\\",{\\\"children\\\":\\\"Rumus Pythagoras: Cara Menerapkan dan Contoh Soal Lengkap | TugasMu | TugasMu\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"3\\\",{\\\"property\\\":\\\"og:title\\\",\\\"content\\\":\\\"Rumus Pythagoras: Cara Menerapkan dan Contoh Soal Lengkap\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"4\\\",{\\\"property\\\":\\\"og:type\\\",\\\"content\\\":\\\"article\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"5\\\",{\\\"property\\\":\\\"article:published_time\\\",\\\"content\\\":\\\"Tue Sep 22 2026 08:00:00 GMT+0800 (Central Indonesia Time)\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"6\\\",{\\\"name\\\":\\\"twitter:card\\\",\\\"content\\\":\\\"summary\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"7\\\",{\\\"name\\\":\\\"twitter:title\\\",\\\"content\\\":\\\"Rumus Pythagoras: Cara Menerapkan dan Contoh Soal Lengkap\\\"}],[\\\"$\\\",\\\"link\\\",\\\"8\\\",{\\\"rel\\\":\\\"icon\\\",\\\"href\\\":\\\"/favicon.ico\\\",\\\"type\\\":\\\"image/x-icon\\\",\\\"sizes\\\":\\\"16x16\\\"}]]\\n4:null\\n\"])</script><script>self.__next_f.push([1,\"12:[[\\\"$\\\",\\\"h1\\\",null,{\\\"className\\\":\\\"font-headline-lg text-headline-lg text-on-surface tracking-tight mb-space-lg leading-tight\\\",\\\"children\\\":\\\"Rumus Pythagoras: Cara Menerapkan dan Contoh Soal Lengkap\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Rumus Pythagoras adalah prinsip dasar geometri yang menetapkan hubungan kuadrat antara panjang sisi tegak dan sisi miring pada bidang segitiga siku-siku. Kamu dapat menggunakan persamaan kuadrat ini untuk mencari ukuran jarak yang belum diketahui serta memverifikasi ketegaklurusan sudut 90 derajat secara akurat. Pemahaman konseptual ini melatih ketajaman logikamu sebelum menguji variasi angka yang lebih rumit menggunakan Rumus Pythagoras.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\\\",\\\"children\\\":\\\"Apa Itu Rumus Pythagoras dan Cara Membuktikannya\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":[\\\"Rumus Pythagoras menyatakan bahwa pada segitiga siku-siku, kuadrat sisi miring selalu sama dengan jumlah kuadrat kedua sisi siku-sikunya. Kamu dapat memanfaatkan \\\",[\\\"$\\\",\\\"$Le\\\",null,{\\\"href\\\":\\\"/tools/generator-soal\\\",\\\"children\\\":\\\"Generator Soal TugasMu\\\"}],\\\" untuk latihan soal Pythagoras agar penguasaan teorimu semakin terasah secara konsisten. Bimbingan AI di platform ini membantumu memahami logika pembuktian angka tanpa harus sekadar menghafal hasil akhir. Pahami konsepnya dari akar geometris agar kamu mampu menuntaskan tugas sekolah secara mandiri. Mengapa dalil geometri kuno ini selalu diajarkan melalui perumusan simbol aljabar Rumus Pythagoras?\\\"]}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\\\",\\\"children\\\":\\\"Bunyi Teorema Pythagoras: a² + b² = c²\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Rumus Pythagoras merumuskan relasi matematis antara panjang sisi alas $a$, sisi tegak $b$, dan sisi miring $c$ melalui notasi aljabar $a^2 + b^2 = c^2$. Tiga komponen utama yang menyusun formula dasar ini mencakup elemen struktural berikut:\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"ul\\\",null,{\\\"children\\\":[\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":\\\"Sisi alas ($a$): garis horizontal yang membentuk salah satu kaki penyiku pada sudut 90 derajat.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":\\\"Sisi tegak ($b$): garis vertikal yang tegak lurus terhadap alas segitiga.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"li\\\",null,{\\\"children\\\":\\\"Hipotenusa ($c$): sisi miring terpanjang yang posisinya selalu berseberangan langsung dengan sudut siku-siku.\\\"}],\\\"\\\\n\\\"]}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Sudut siku-siku menjadi patokan utama saat kamu mengidentifikasi letak hipotenusa dalam segitiga rotasi acak. Banyak siswa keliru memasukkan angka karena salah menentukan sisi terpanjang saat posisi segitiga diputar miring. Kamu cukup mencari kotak tanda 90 derajat, lalu tarik garis lurus ke sisi di depannya untuk menemukan nilai $c$. Bagaimana langkah konkret yang dapat kamu ambil untuk membuktikan kebenaran persamaan kuadrat ini menggunakan luas bidang datar Rumus Pythagoras?\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\\\",\\\"children\\\":\\\"Bukti Visual Pythagoras dengan Luas Persegi\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Rumus Pythagoras dapat kamu buktikan secara visual menggunakan susunan empat segitiga siku-siku kongruen di dalam sebuah persegi besar berukuran sisi $(a + b)$. Luas persegi luar tersebut setara dengan $(a + b)^2$, yang jika dijabarkan menghasilkan $a^2 + 2ab + b^2$. Di bagian dalam bingkai tersebut, empat segitiga siku-siku memiliki luas total $4 \\\\\\\\times (\\\\\\\\frac{1}{2} \\\\\\\\times a \\\\\\\\times b) = 2ab$, menyisakan sebuah persegi miring di area tengah dengan luas $c^2$. Pengurangan luas total dengan luas empat segitiga menghasilkan identitas $a^2 + b^2 = c^2$ secara visual tanpa manipulasi rumus yang rumit. Apakah visualisasi geometris ini juga konsisten saat diuji pada berbagai ukuran segitiga siku-siku?\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Ukuran segitiga siku-siku dengan perbandingan sisi berapapun akan selalu menghasilkan kecocokan luas bidang kuadrat yang identik. Bukti visual ini menepis anggapan bahwa rumus matematika hanyalah susunan huruf abstrak tanpa pijakan fisik nyata. Kamu kini memiliki fondasi visual yang kokoh untuk memahami alasan di balik penjumlahan dua nilai kuadrat sisi penyiku Rumus Pythagoras.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Rumus Pythagoras yang telah terbukti secara geometris ini menuntaskan fondasi konseptualmu sebelum melangkah ke teknik pengerjaan teknis menggunakan Rumus Pythagoras.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\\\",\\\"children\\\":\\\"3 Jenis Penggunaan Rumus Pythagoras dalam Soal\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Rumus Pythagoras digunakan dalam tiga variasi soal utama yang mencakup pencarian sisi miring, penentuan sisi tegak, serta uji relasi segitiga. Tiga variasi tersebut menuntut manipulasi aljabar yang terarah agar kamu tidak keliru menentukan operasi tambah atau kurang. Tabel berikut merangkum tiga variasi penggunaan rumus Pythagoras beserta formula dan fungsi evaluasinya:\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"| Jenis Penggunaan | Rumus Operasi | Kondisi yang Diketahui | Tujuan Perhitungan |\\\\r\\\\n| :--- | :--- | :--- | :--- |\\\\r\\\\n| Mencari Sisi Miring | $c = \\\\\\\\sqrt{a^2 + b^2}$ | Panjang sisi $a$ dan sisi $b$ | Menentukan hipotenusa terpanjang |\\\\r\\\\n| Mencari Sisi Tegak | $a = \\\\\\\\sqrt{c^2 - b^2}$ atau $b = \\\\\\\\sqrt{c^2 - a^2}$ | Panjang hipotenusa $c$ dan satu sisi tegak | Menentukan panjang kaki penyiku yang hilang |\\\\r\\\\n| Menguji Jenis Segitiga | Perbandingan $a^2 + b^2$ terhadap $c^2$ | Panjang ketiga sisi segitiga ($a, b, c$) | Memvalidasi segitiga bernilai siku-siku, lancip, atau segitiga tumpul |\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Segitiga tumpul, lancip, maupun siku-siku dapat kamu uji secara presisi menggunakan perbandingan kuadrat sisi tersebut. Pemilihan formula yang tepat memandu langkah pengerjaanmu saat menghadapi lembar latihan berdurasi terbatas yang menuntut ketelitian penerapan Rumus Pythagoras.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\\\",\\\"children\\\":\\\"Mencari Sisi Miring (Hipotenusa)\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Rumus Pythagoras untuk mencari sisi miring dipakai saat nilai panjang kedua sisi siku-siku telah tertera pada diagram soal. Kamu menjumlahkan hasil kuadrat dari sisi alas dan sisi tegak, kemudian menarik akar pangkat dua dari hasil penjumlahan tersebut. Contohnya, sebuah segitiga memiliki sisi siku-siku $a = 6\\\\\\\\text{ cm}$ dan $b = 8\\\\\\\\text{ cm}$. Perhitungan hipotenusa berlangsung lewat langkah berurutan: kuadratkan sisi alas $6^2 = 36$, kuadratkan sisi tegak $8^2 = 64$, jumlahkan nilainya menjadi $36 + 64 = 100$, lalu tarik nilai $\\\\\\\\sqrt{100} = 10\\\\\\\\text{ cm}$. Bagaimana jika angka yang diketahui pada lembar soal justru memuat nilai sisi miring bersama salah satu sisi tegak Rumus Pythagoras?\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\\\",\\\"children\\\":\\\"Mencari Sisi Tegak yang Belum Diketahui\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Rumus Pythagoras untuk mencari sisi tegak membutuhkan operasi pengurangan kuadrat, bukan penjumlahan. Kesalahan umum siswa terjadi ketika mereka menjumlahkan kuadrat sisi miring dengan sisi tegak yang diketahui, padahal sisi miring selalu menempati nilai kuadrat tertinggi. Jika hipotenusa $c = 13\\\\\\\\text{ cm}$ dan sisi tegak $a = 5\\\\\\\\text{ cm}$, kamu mencari sisi $b$ lewat formula $b^2 = c^2 - a^2$. Masukkan nilainya menjadi $b^2 = 13^2 - 5^2 = 169 - 25 = 144$, sehingga diperoleh $b = \\\\\\\\sqrt{144} = 12\\\\\\\\text{ cm}$. Apakah ada metode pintas untuk menyelesaikan perhitungan akar kuadrat ini tanpa harus menghitung perkalian manual yang panjang melalui penguasaan Rumus Pythagoras?\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Rumus Pythagoras menyediakan pola bilangan aljabar yang dapat kamu tuntaskan jauh lebih cepat saat kamu menguasai himpunan angka khusus dalam Rumus Pythagoras.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\\\",\\\"children\\\":\\\"Tripel Pythagoras yang Wajib Dihafal\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Rumus Pythagoras memiliki tripel bilangan bulat positif yang secara otomatis memenuhi persamaan $a^2 + b^2 = c^2$ tanpa menghasilkan nilai pecahan atau bentuk desimal tak berhingga. Menghafal kombinasi angka ini memangkas waktu pengerjaan ujian secara signifikan karena kamu tidak perlu menghitung akar kuadrat dari awal. TugasMu merancang bimbingan AI untuk membantumu mengenali pola kelipatan angka ini secara otomatis dalam latihan mandiri. Tabel berikut menyajikan empat keluarga tripel Pythagoras primitif beserta pola kelipatan skalarnya:\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":[\\\"| Tripel Primitif ($a, b, c$) | Kelipatan 2× | Kelipatan 3× | Kelipatan 4× | Kelipatan 5× |\\\\r\\\\n| :--- | :--- | :--- | :--- | :--- |\\\\r\\\\n| \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"3, 4, 5\\\"}],\\\" | 6, 8, 10 | 9, 12, 15 | 12, 16, 20 | 15, 20, 25 |\\\\r\\\\n| \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"5, 12, 13\\\"}],\\\" | 10, 24, 26 | 15, 36, 39 | 20, 48, 52 | 25, 60, 65 |\\\\r\\\\n| \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"7, 24, 25\\\"}],\\\" | 14, 48, 50 | 21, 72, 75 | 28, 96, 100 | 35, 120, 125 |\\\\r\\\\n| \\\",[\\\"$\\\",\\\"strong\\\",null,{\\\"children\\\":\\\"8, 15, 17\\\"}],\\\" | 16, 30, 34 | 24, 45, 51 | 32, 60, 68 | 40, 75, 85 |\\\"]}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Angka 85 dan seluruh kombinasi kelipatan pada tabel di atas menjadi perangkat hitung cepat yang mempermudah penyelesaian soal geometri bertingkat berbasis Rumus Pythagoras.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\\\",\\\"children\\\":\\\"Tripel 3-4-5 dan Kelipatannya\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Rumus Pythagoras menghasilkan kelompok angka 3-4-5 sebagai kombinasi tripel primitif paling mendasar yang paling sering diujikan di tingkat sekolah menengah. Ketika kamu melihat segitiga siku-siku dengan panjang sisi tegak 9 cm dan hipotenusa 15 cm, kamu tidak perlu menguras waktu menghitung $15^2 - 9^2$. Kamu cukup membagi kedua angka dengan faktor persekutuan 3, sehingga menghasilkan angka perbandingan 3 dan 5. Berdasarkan pola dasar 3-4-5, sisi yang belum diketahui pastilah $4 \\\\\\\\times 3 = 12\\\\\\\\text{ cm}$. Bagaimana cara kamu mendeteksi kombinasi angka jika lembar evaluasi memuat angka di luar kelipatan 3-4-5 pada Rumus Pythagoras?\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\\\",\\\"children\\\":\\\"Tripel 5-12-13 dan Tripel Lainnya\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Rumus Pythagoras juga membentuk kelompok tripel 5-12-13, 7-24-25, dan 8-15-17 sebagai kombinasi primitif yang kerap menjadi pembeda nilai dalam tes seleksi akademik. Kelompok 5-12-13 sering disamarkan dalam bentuk kelipatan dua menjadi 10-24-26 atau bentuk desimal seperti 2,5 - 6 - 6,5. Jika kamu menjumpai angka hipotenusa 25 dengan salah satu sisi penyiku bernilai 7, kamu langsung mengetahui sisi penyiku pasangannya bernilai 24 tanpa mencoret buram hitungan. Penguasaan tripel alternatif ini menghemat energimu saat mengerjakan soal ruang dimensi tiga yang rumit. Apakah pola relasi segitiga siku-siku ini hanya berlaku pada lembar kertas ujian atau berfungsi langsung di lapangan menggunakan Rumus Pythagoras?\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Rumus Pythagoras mentransformasikan kalkulasi angka teoretis ini menjadi instrumen praktis saat kamu menghadapi tantangan spasial di dunia nyata melalui penerapan terpadu Rumus Pythagoras.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\\\",\\\"children\\\":\\\"Penerapan Rumus Pythagoras dalam Kehidupan Nyata\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Rumus Pythagoras diterapkan dalam kehidupan sehari-hari oleh para insinyur, tukang bangunan, hingga desainer perangkat visual untuk mengukur bentang fisik yang sulit dijangkau meteran manual. Pemanfaatan di lapangan membuktikan bahwa matematika hadir sebagai alat bantu nyata untuk memecahkan hambatan teknis di sekitarmu. Kamu dapat mengamati pemanfaatan prinsip ketegaklurusan sudut 90 derajat dalam pemasangan keramik lantai hingga penentuan kemiringan atap rumah tinggal. Pahami konsepnya agar kamu menyadari fungsi kalkulasi ini dalam mempermudah aktivitas kerja manusia. Dua contoh nyata yang mempraktikkan perhitungan segitiga siku-siku ini tampak pada sektor rancang bangun Rumus Pythagoras.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\\\",\\\"children\\\":\\\"Menghitung Tinggi Gedung dengan Bayangan dan Tangga\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Rumus Pythagoras mempermudah teknisi menentukan jangkauan vertikal tangga kerja tanpa harus memanjat dinding terlebih dahulu. Apabila sebuah tangga sepanjang 5 meter disandarkan pada dinding dengan jarak kaki tangga ke dasar tembok sejauh 3 meter, teknisi dapat mengetahui titik puncak dinding secara presisi. Posisi tangga bertindak sebagai hipotenusa ($c = 5\\\\\\\\text{ m}$), sedangkan jarak di atas tanah berfungsi sebagai sisi alas horizontal ($a = 3\\\\\\\\text{ m}$). Melalui formula $b = \\\\\\\\sqrt{5^2 - 3^2} = \\\\\\\\sqrt{25 - 9} = \\\\\\\\sqrt{16}$, tinggi dinding yang tergapai berada tepat pada ketinggian 4 meter. Bagaimana kalkulasi geometris serupa diterapkan saat kamu memilih perangkat elektronik berbasis Rumus Pythagoras?\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h3\\\",null,{\\\"className\\\":\\\"font-headline-sm text-headline-sm text-on-surface font-bold mt-space-md mb-space-sm\\\",\\\"children\\\":\\\"Menghitung Diagonal Layar TV dan Lapangan\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Rumus Pythagoras menjadi acuan standar produsen teknologi saat menentukan ukuran diagonal layar televisi, monitor komputer, maupun ponsel pintar. Label ukuran 55 inci pada kardus televisi tidak merujuk pada lebar mendatar atau tinggi tegak fisik layar, melainkan bentang diagonal dari sudut kiri bawah menuju sudut kanan atas. Jika sebuah layar monitor memiliki lebar 40 inci dan tinggi 30 inci, ukuran diagonalnya dihitung lewat $\\\\\\\\sqrt{40^2 + 30^2} = \\\\\\\\sqrt{1600 + 900} = \\\\\\\\sqrt{2500} = 50\\\\\\\\text{ inci}$. Prinsip garis diagonal ini juga memandu atlet saat berlari melintasi sudut lapangan untuk memotong jarak tempuh secepat mungkin. Apakah sintesis menyeluruh dari konsep dasar hingga implementasi fisik ini telah menyempurnakan pemahamanmu terhadap Rumus Pythagoras?\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":\\\"Rumus Pythagoras membuktikan konsistensi hubungan matematis antara pembuktian teoretis di kelas dan pemecahan tantangan fungsional dalam kehidupan sehari-hari lewat aplikasi Rumus Pythagoras.\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"font-headline-md text-headline-md text-on-surface font-bold mt-space-lg mb-space-sm\\\",\\\"children\\\":\\\"Kesimpulan Evaluasi Rumus Pythagoras\\\"}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":[\\\"Rumus Pythagoras merangkum empat esensi utama geometri: validasi visual luas persegi, kepraktisan aljabar dalam tiga variasi rumus, kecepatan hitung tripel bilangan bulat, serta keakuratan pengukuran diagonal di dunia nyata. Empat pilar konseptual tersebut menegaskan bahwa penguasaan matematika berakar pada logika penalaran relasi antarbidang, bukan hafalan rumus yang kaku. Kamu dapat memperluas kompetensi spasialmu dengan membaca artikel saudara mengenai \\\",[\\\"$\\\",\\\"$Le\\\",null,{\\\"href\\\":\\\"/blog/matematika/rumus-bangun-ruang-lengkap\\\",\\\"children\\\":\\\"rumus bangun ruang lengkap\\\"}],\\\" yang tersimpan rapi di direktori \\\",[\\\"$\\\",\\\"$Le\\\",null,{\\\"href\\\":\\\"/blog/matematika/\\\",\\\"children\\\":\\\"Matematika\\\"}],\\\" TugasMu. Mengapa evaluasi rutin melalui soal interaktif menjadi penentu utama penguasaan materi belajarmu di sekolah?\\\"]}],\\\"\\\\n\\\",[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"font-body-md text-body-md text-on-surface-variant leading-relaxed mb-space-md\\\",\\\"children\\\":[\\\"Sekolah sering menguji variasi soal tak terduga yang menuntut kecepatan berpikir dan ketelitian kalkulasi tingkat tinggi. TugasMu hadir bukan tools curang, tapi teman pintar belajarmu yang mengasah alur berpikir logis langkah demi langkah. Manfaatkan \\\",[\\\"$\\\",\\\"$Le\\\",null,{\\\"href\\\":\\\"/tools/generator-soal\\\",\\\"children\\\":\\\"Generator Soal TugasMu\\\"}],\\\" untuk menguji pemahamanmu lewat ratusan variasi soal matematika interaktif dengan bimbingan AI sekarang juga!\\\"]}]]\\n\"])</script></body></html>","rsc":"3:I[4707,[],\"\"]\n6:I[6423,[],\"\"]\n7:I[8003,[\"3433\",\"static/chunks/3433-9ddc6f7f78d9421c.js\",\"2972\",\"static/chunks/2972-8ce94bd856f9372b.js\",\"3185\",\"static/chunks/app/layout-c819fc26cf8b0e32.js\"],\"\"]\n8:I[9314,[\"3433\",\"static/chunks/3433-9ddc6f7f78d9421c.js\",\"2972\",\"static/chunks/2972-8ce94bd856f9372b.js\",\"3185\",\"static/chunks/app/layout-c819fc26cf8b0e32.js\"],\"default\"]\n9:I[6454,[\"3433\",\"static/chunks/3433-9ddc6f7f78d9421c.js\",\"2972\",\"static/chunks/2972-8ce94bd856f9372b.js\",\"3185\",\"static/chunks/app/layout-c819fc26cf8b0e32.js\"],\"Navbar\"]\na:I[482,[\"3433\",\"static/chunks/3433-9ddc6f7f78d9421c.js\",\"2972\",\"static/chunks/2972-8ce94bd856f9372b.js\",\"3185\",\"static/chunks/app/layout-c819fc26cf8b0e32.js\"],\"default\"]\nb:I[2972,[\"2972\",\"static/chunks/2972-8ce94bd856f9372b.js\",\"9064\",\"static/chunks/app/blog/%5Bkategori%5D/%5Bslug%5D/page-66ee61aaeae9a3c2.js\"],\"\"]\n4:[\"kategori\",\"matematika\",\"d\"]\n5:[\"slug\",\"penerapan-rumus-pythagoras\",\"d\"]\n0:[\"nUO3BwVmV7Cq5JEgg6Nsr\",[[[\"\",{\"children\":[\"blog\",{\"children\":[[\"kategori\",\"matematika\",\"d\"],{\"children\":[[\"slug\",\"penerapan-rumus-pythagoras\",\"d\"],{\"children\":[\"__PAGE__?{\\\"kategori\\\":\\\"matematika\\\",\\\"slug\\\":\\\"penerapan-rumus-pythagoras\\\"}\",{}]}]}]}]},\"$undefined\",\"$undefined\",true],[\"\",{\"children\":[\"blog\",{\"children\":[[\"kategori\",\"matematika\",\"d\"],{\"children\":[[\"slug\",\"penerapan-rumus-pythagoras\",\"d\"],{\"children\":[\"__PAGE__\",{},[[\"$L1\",\"$L2\",null],null],null]},[null,[\"$\",\"$L3\",null,{\"parallelRouterKey\":\"children\",\"segmentPath\":[\"children\",\"blog\",\"children\",\"$4\",\"children\",\"$5\",\"children\"],\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L6\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"notFoundStyles\":\"$undef